{
  "name": "@misofm/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "scripts": {
    "codegen": "node ./codegen/generate.mjs",
    "check:generated": "node ./codegen/generate.mjs --check",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  }
}
