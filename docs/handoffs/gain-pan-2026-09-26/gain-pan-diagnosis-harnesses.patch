+#[test]
+#[ignore = "measurement harness"]
+fn replicas() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz", hz / 1e9);
+    let lane_samples = (TRACKS * QUANTUM * 2) as f64;
+    let report = |name: &str, ns: f64| {
+        println!(
+            "  {:<62} {:>8.0} ns {:>8.0} cycles/block {:>6.0} cycles/bank {:>6.3} c/ls",
+            name,
+            ns,
+            ns * hz / 1e9,
+            ns * hz / 1e9 / BANKS as f64,
+            ns * hz / 1e9 / lane_samples
+        );
+    };
+    let mut row = Row::new();
+
+    // Reference: gather, input, fader, matrix, fold.
+    row.gather();
+    row.input();
+    row.fader();
+    row.matrix();
+    row.fold();
+    let reference = (bits(&row.master_left), bits(&row.master_right));
+    // Raw kernels must equal the public bank path.
+    row.gather();
+    row.input();
+    row.raw_gain_mute();
+    row.raw_matrix();
+    row.fold();
+    assert_eq!(
+        (bits(&row.master_left), bits(&row.master_right)),
+        reference,
+        "raw kernels"
+    );
+    row.gather();
+    row.input();
+    row.fused_fader_matrix();
+    row.fold();
+    assert_eq!(
+        (bits(&row.master_left), bits(&row.master_right)),
+        reference,
+        "fused pair"
+    );
+    row.gather();
+    row.input();
+    row.fold_with_fader_matrix();
+    assert_eq!(
+        (bits(&row.master_left), bits(&row.master_right)),
+        reference,
+        "fader+matrix inside the fold"
+    );
+    row.gather();
+    row.input();
+    row.fader();
+    row.raw_matrix_general();
+    row.fold();
+    assert_eq!(
+        (bits(&row.master_left), bits(&row.master_right)),
+        reference,
+        "select-free matrix on an identity-free bank"
+    );
+    row.gather();
+    row.input();
+    row.fader();
+    row.raw_matrix_swapped();
+    row.fold();
+    assert_eq!(
+        (bits(&row.master_left), bits(&row.master_right)),
+        reference,
+        "swapped stores"
+    );
+    println!("every candidate is bit-identical to gather, input, fader, matrix, fold");
+
+    const BATCHES: usize = 30;
+    const PER_BATCH: usize = 200;
+    for repeat in 0..3 {
+        println!("repeat {repeat}:");
+        let gather = time_min(BATCHES, PER_BATCH, || row.gather());
+        report("gather (8 banks, tile transpose planar->AoSoA)", gather);
+        let g_in = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.input();
+        });
+        report(
+            "input bank (identity sections), gather subtracted",
+            g_in - gather,
+        );
+        let g_f = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.fader();
+        });
+        report(
+            "fader bank process (settled), gather subtracted",
+            g_f - gather,
+        );
+        let g_m = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.matrix();
+        });
+        report(
+            "matrix bank process (settled), gather subtracted",
+            g_m - gather,
+        );
+        let g_fm = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.fused_fader_matrix();
+        });
+        report(
+            "fused fader+matrix (try_process_settled), gather subtracted",
+            g_fm - gather,
+        );
+        let g_rg = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.raw_gain_mute();
+        });
+        report("raw gain_mute_block x2, gather subtracted", g_rg - gather);
+        let g_rm = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.raw_matrix();
+        });
+        report("raw matrix2x2_block, gather subtracted", g_rm - gather);
+        let g_rfm = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.raw_fader_matrix();
+        });
+        report("raw fader_matrix_block, gather subtracted", g_rfm - gather);
+        let g_gen = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.raw_matrix_general();
+        });
+        report(
+            "select-free matrix (identity-free bank), gather subtracted",
+            g_gen - gather,
+        );
+        let g_sw = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.raw_matrix_swapped();
+        });
+        report(
+            "matrix with swapped stores, gather subtracted",
+            g_sw - gather,
+        );
+        let chain_general = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.input();
+            row.fader();
+            row.raw_matrix_general();
+            row.fold();
+        });
+        report(
+            "gather, input, fader, select-free matrix, fold",
+            chain_general,
+        );
+        let fold = time_min(BATCHES, PER_BATCH, || row.fold());
+        report("fold (transpose + route + accumulate)", fold);
+        let fold_fm = time_min(BATCHES, PER_BATCH, || row.fold_with_fader_matrix());
+        report("fold with fader+matrix inside", fold_fm);
+        let chain = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.input();
+            row.fader();
+            row.matrix();
+            row.fold();
+        });
+        report("today's chain: gather, input, fader, matrix, fold", chain);
+        let chain_pair = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.input();
+            row.fused_fader_matrix();
+            row.fold();
+        });
+        report("paired: gather, input, fader+matrix, fold", chain_pair);
+        let chain_fold = time_min(BATCHES, PER_BATCH, || {
+            row.gather();
+            row.input();
+            row.fold_with_fader_matrix();
+        });
+        report("gather, input, fold{fader+matrix}", chain_fold);
+    }
+    let _ = BuiltinLaneSelector::Both;
+}
