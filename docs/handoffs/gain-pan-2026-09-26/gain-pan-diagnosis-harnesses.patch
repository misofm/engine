+/// Ramp cost: every lane of every bank mid-ramp for the whole measurement (window 2^23 samples),
+/// against the same banks settled.
+#[test]
+#[ignore = "measurement harness"]
+fn ramps() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz", hz / 1e9);
+    let report = |name: &str, ns: f64| {
+        println!(
+            "  {:<62} {:>8.0} ns {:>8.0} cycles/block {:>6.0} cycles/bank",
+            name,
+            ns,
+            ns * hz / 1e9,
+            ns * hz / 1e9 / BANKS as f64,
+        );
+    };
+    let mut row = Row::new();
+    let mut ramping = Row::new();
+    for (bank, b) in ramping.banks.iter_mut().enumerate() {
+        for lane in 0..W {
+            let t = (bank * W + lane) as u32;
+            b.fader
+                .set_fader_db(lane, BuiltinLaneSelector::Both, -12.0 + unit(t), 1 << 23)
+                .expect("fader");
+            b.matrix
+                .set_target_smoothed(
+                    lane,
+                    pan_matrix(-0.5 + 0.1 * unit(t + 9), 0.3).expect("pan"),
+                    1 << 23,
+                )
+                .expect("matrix");
+        }
+    }
+    const BATCHES: usize = 30;
+    const PER_BATCH: usize = 200;
+    for repeat in 0..3 {
+        println!("repeat {repeat}:");
+        let gather = time_min(BATCHES, PER_BATCH, || row.gather());
+        for (name, rows) in [("settled", &mut row), ("ramping", &mut ramping)] {
+            let f = time_min(BATCHES, PER_BATCH, || {
+                rows.gather();
+                rows.fader();
+            });
+            report(
+                &format!("{name}: fader bank, gather subtracted"),
+                f - gather,
+            );
+            let m = time_min(BATCHES, PER_BATCH, || {
+                rows.gather();
+                rows.matrix();
+            });
+            report(
+                &format!("{name}: matrix bank, gather subtracted"),
+                m - gather,
+            );
+        }
+    }
+}
