diff --git a/crates/host-core/tests/dualmono_probe.rs b/crates/host-core/tests/dualmono_probe.rs
new file mode 100644
index 00000000..b1daf347
--- /dev/null
+++ b/crates/host-core/tests/dualmono_probe.rs
@@ -0,0 +1,283 @@
+//! Dual-mono research probe (2026-09-27): does a bank chain that sits **after** a per-node
+//! upstream effect collapse on the session's structural witness alone?
+//!
+//! The collapse is armed per chain from `session_structural_symmetry` (SOURCE + input delay) and
+//! the chain's own slots' witnesses. A per-node effect between two bank chains of one track is in
+//! neither. If that per-node effect makes L and R differ (asymmetric parameters), the later chain
+//! still collapses and duplicates the left plane into the right one.
+//!
+//! Oracle: the same document with the collapse forced off. Any bit difference is wrong audio.
+
+use core::num::{NonZeroU32, NonZeroUsize};
+
+use builtins::MeterTap;
+use engine::realtime::{PlanarBufferMut, RenderIo, RenderTime};
+use host_core::{
+    HostConsoleRequest, HostPrepareCaps, HostShapePolicy, SourceSubmission,
+    prepare_host_session_with_console,
+};
+use session::{
+    EffectIdentity, EffectParam, ParameterChannel, ParameterUnit, StableId,
+    canonical_session_json, parse_session_json,
+};
+
+const BANK: &str = include_str!("../../../fixtures/session/v1/parametric-eq-bank-console.json");
+const QUANTUM: usize = 128;
+const RATE: u32 = 48_000;
+
+fn caps() -> HostPrepareCaps {
+    HostPrepareCaps {
+        shape: HostShapePolicy::AnyLaunchRate,
+        source_ring_frames: 4_096,
+        maximum_source_channels: None,
+        maximum_automation_spans_per_block: 128,
+        maximum_tracks: 100,
+        maximum_sources: 100,
+        maximum_routes: 100,
+        maximum_effects: 100,
+        maximum_graph_session_plus_plan_bytes: 100_000_000,
+        maximum_source_total_bytes: 10_000_000,
+        maximum_source_overhead_bytes: 10_000_000,
+        maximum_effect_state_bytes: 100_000_000,
+        maximum_effect_scratch_bytes: 100_000_000,
+        maximum_builtin_retained_bytes: 100_000_000,
+        maximum_named_allocation_bytes: 100_000_000,
+        maximum_meter_streams: 64,
+        maximum_meter_items: 1 << 16,
+        maximum_meter_bytes: 1 << 24,
+    }
+}
+
+fn console() -> HostConsoleRequest {
+    HostConsoleRequest {
+        control_queue_depth: Some(NonZeroUsize::new(8).expect("depth")),
+        meter_period_frames: Some(NonZeroU32::new(QUANTUM as u32).expect("period")),
+        meter_queue_depth: NonZeroUsize::new(16).expect("meter depth"),
+        meter_tap: MeterTap::PostMatrix,
+        observation_taps: 0,
+        master_track: None,
+    }
+}
+
+fn signal(index: usize) -> f32 {
+    let mut state = (index as u64).wrapping_mul(0x9e37_79b9_7f4a_7c15) ^ 0x1234_5678;
+    state ^= state >> 33;
+    state = state.wrapping_mul(0xff51_afd7_ed55_8ccd);
+    state ^= state >> 29;
+    (((state >> 40) as f32) / 16_777_216.0) - 0.5
+}
+
+/// The eight-track EQ bank fixture, every track mono-mapped, with a per-node `miso.delay` in the
+/// dynamic rack (`left_ms`, `right_ms`) and a second, banked EQ in `simd2`.
+fn document(left_ms: f32, right_ms: f32) -> String {
+    let mut model = parse_session_json(BANK).expect("bank fixture parses");
+    model.automation.clear();
+    for track in &mut model.tracks {
+        track.right_source_channel = track.left_source_channel;
+        let eq = track.simd1.effects[0].clone();
+        let mut second = eq.clone();
+        second.id = StableId::parse("eq2").expect("id");
+        track.simd2.effects = vec![second];
+        let mut delay = eq;
+        delay.id = StableId::parse("dly").expect("id");
+        delay.identity = EffectIdentity::Native {
+            effect_id: StableId::parse("miso.delay").expect("delay id"),
+        };
+        delay.params = vec![
+            EffectParam {
+                parameter_id: 1,
+                channel: ParameterChannel::Left,
+                unit: ParameterUnit::Milliseconds,
+                value: left_ms,
+            },
+            EffectParam {
+                parameter_id: 1,
+                channel: ParameterChannel::Right,
+                unit: ParameterUnit::Milliseconds,
+                value: right_ms,
+            },
+        ];
+        track.dynamic.effects = vec![delay];
+    }
+    canonical_session_json(&model).expect("probe canonicalizes")
+}
+
+fn render(document: &str, blocks: usize, forced_off: bool) -> ([Vec<f32>; 2], [u64; 2]) {
+    let (_, mut prepared, mut handles) =
+        prepare_host_session_with_console(document, &caps(), &console()).unwrap_or_else(
+            |failure| panic!("prepare: {}", String::from_utf8_lossy(failure.as_bytes())),
+        );
+    prepared.plan.force_mono_collapse_off(forced_off);
+    let mut out = [Vec::new(), Vec::new()];
+    for block in 0..blocks {
+        let base = block * QUANTUM;
+        let plane: Vec<f32> = (0..QUANTUM).map(|frame| signal(base + frame)).collect();
+        prepared
+            .sources
+            .submit(
+                b"fixture-source",
+                SourceSubmission {
+                    generation: 1,
+                    start_frame: base as u64,
+                    sample_rate_hz: RATE,
+                    planes: &[&plane, &plane],
+                    frames: QUANTUM as u32,
+                    end_of_region: false,
+                },
+            )
+            .expect("source block");
+        let mut samples = [0.0_f32; QUANTUM * 2];
+        let buffer =
+            PlanarBufferMut::try_new(&mut samples, 2, QUANTUM, QUANTUM).expect("output planes");
+        prepared
+            .plan
+            .render(
+                RenderIo {
+                    input: None,
+                    output: buffer,
+                },
+                RenderTime {
+                    absolute_sample: base as u64,
+                },
+            )
+            .expect("render");
+        out[0].extend_from_slice(&samples[..QUANTUM]);
+        out[1].extend_from_slice(&samples[QUANTUM..]);
+        for meter in handles.meters.iter_mut() {
+            let _ = meter.consumer.try_pop();
+        }
+    }
+    (out, prepared.plan.bank_collapse_counters())
+}
+
+fn first_difference(a: &[Vec<f32>; 2], b: &[Vec<f32>; 2]) -> Option<(usize, usize, f32, f32)> {
+    for plane in 0..2 {
+        for (index, (x, y)) in a[plane].iter().zip(b[plane].iter()).enumerate() {
+            if x.to_bits() != y.to_bits() {
+                return Some((plane, index, *x, *y));
+            }
+        }
+    }
+    None
+}
+
+#[test]
+fn probe_symmetric_per_node_delay_between_chains() {
+    let document = document(5.0, 5.0);
+    let (armed, armed_counters) = render(&document, 16, false);
+    let (dual, dual_counters) = render(&document, 16, true);
+    eprintln!("symmetric: armed counters {armed_counters:?}, dual counters {dual_counters:?}");
+    assert_eq!(first_difference(&armed, &dual), None, "symmetric delay");
+}
+
+#[test]
+fn probe_asymmetric_per_node_delay_between_chains() {
+    let document = document(5.0, 7.0);
+    let (armed, armed_counters) = render(&document, 16, false);
+    let (dual, dual_counters) = render(&document, 16, true);
+    let diff = first_difference(&armed, &dual);
+    eprintln!(
+        "asymmetric: armed counters {armed_counters:?}, dual counters {dual_counters:?}, \
+         first difference {diff:?}"
+    );
+    assert_eq!(diff, None, "asymmetric per-node delay: collapsed render differs from dual");
+}
+
+/// No per-node effect at all: an asymmetric EQ in `simd1`, a symmetric EQ in `simd2`, and the
+/// console meter leased at `tap`. A stage meter at `PostSimd1` splits the cohort's strip into two
+/// chains (it declines the #208 merge); at `PostMatrix` the strip is one chain.
+fn eq_document(left_db: f32, right_db: f32) -> String {
+    let mut model = parse_session_json(BANK).expect("bank fixture parses");
+    model.automation.clear();
+    for track in &mut model.tracks {
+        track.right_source_channel = track.left_source_channel;
+        let eq = track.simd1.effects[0].clone();
+        let mut second = eq.clone();
+        second.id = StableId::parse("eq2").expect("id");
+        track.simd2.effects = vec![second];
+        let first = &mut track.simd1.effects[0];
+        first.params.retain(|param| param.parameter_id != 4);
+        for (channel, value) in [
+            (ParameterChannel::Left, left_db),
+            (ParameterChannel::Right, right_db),
+        ] {
+            first.params.push(EffectParam {
+                parameter_id: 4,
+                channel,
+                unit: ParameterUnit::Db,
+                value,
+            });
+        }
+    }
+    canonical_session_json(&model).expect("probe canonicalizes")
+}
+
+fn render_tap(document: &str, blocks: usize, forced_off: bool, tap: MeterTap) -> ([Vec<f32>; 2], [u64; 2]) {
+    let mut request = console();
+    request.meter_tap = tap;
+    let (_, mut prepared, mut handles) =
+        prepare_host_session_with_console(document, &caps(), &request).unwrap_or_else(
+            |failure| panic!("prepare: {}", String::from_utf8_lossy(failure.as_bytes())),
+        );
+    prepared.plan.force_mono_collapse_off(forced_off);
+    let mut out = [Vec::new(), Vec::new()];
+    for block in 0..blocks {
+        let base = block * QUANTUM;
+        let plane: Vec<f32> = (0..QUANTUM).map(|frame| signal(base + frame)).collect();
+        prepared
+            .sources
+            .submit(
+                b"fixture-source",
+                SourceSubmission {
+                    generation: 1,
+                    start_frame: base as u64,
+                    sample_rate_hz: RATE,
+                    planes: &[&plane, &plane],
+                    frames: QUANTUM as u32,
+                    end_of_region: false,
+                },
+            )
+            .expect("source block");
+        let mut samples = [0.0_f32; QUANTUM * 2];
+        let buffer =
+            PlanarBufferMut::try_new(&mut samples, 2, QUANTUM, QUANTUM).expect("output planes");
+        prepared
+            .plan
+            .render(
+                RenderIo {
+                    input: None,
+                    output: buffer,
+                },
+                RenderTime {
+                    absolute_sample: base as u64,
+                },
+            )
+            .expect("render");
+        out[0].extend_from_slice(&samples[..QUANTUM]);
+        out[1].extend_from_slice(&samples[QUANTUM..]);
+        for meter in handles.meters.iter_mut() {
+            while meter.consumer.try_pop().is_ok() {}
+        }
+    }
+    (out, prepared.plan.bank_collapse_counters())
+}
+
+#[test]
+fn probe_asymmetric_eq_one_chain() {
+    let document = eq_document(6.0, -6.0);
+    let (armed, armed_counters) = render_tap(&document, 16, false, MeterTap::PostMatrix);
+    let (dual, dual_counters) = render_tap(&document, 16, true, MeterTap::PostMatrix);
+    let diff = first_difference(&armed, &dual);
+    eprintln!("one chain: armed {armed_counters:?}, dual {dual_counters:?}, diff {diff:?}");
+    assert_eq!(diff, None);
+}
+
+#[test]
+fn probe_asymmetric_eq_split_by_post_simd1_meter() {
+    let document = eq_document(6.0, -6.0);
+    let (armed, armed_counters) = render_tap(&document, 16, false, MeterTap::PostSimd1);
+    let (dual, dual_counters) = render_tap(&document, 16, true, MeterTap::PostSimd1);
+    let diff = first_difference(&armed, &dual);
+    eprintln!("split chains: armed {armed_counters:?}, dual {dual_counters:?}, diff {diff:?}");
+    assert_eq!(diff, None, "asymmetric simd1 EQ + PostSimd1 meter: collapsed differs from dual");
+}
