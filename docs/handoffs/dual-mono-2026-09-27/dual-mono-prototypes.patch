+++ b/tools/console-workload/examples/dualmono_research.rs
@@ -0,0 +1,283 @@
+//! RESEARCH PROTOTYPE (dual-mono, 2026-09-27; reverted, recorded as a patch). Not a gate.
+//!
+//! Paired, in-process timing of the mono collapse on the standing fixtures and on the dogfood
+//! first-listen session (81 stems, 18 of them bit-identical dual mono), at the native eight-lane
+//! width and at the four-lane width the browser runs. One invocation, one warmup, two measured
+//! rounds; arms alternate observation by observation, rotating their order.
+//!
+//! Every group first renders `CHECK_BLOCKS` fresh blocks per arm and prints a digest, so an arm
+//! that is claimed to be the same audio can be seen to be the same bits. The `noseam` arms skip
+//! the collapse's seam copy (timing-only upper bound, bits intentionally wrong).
+
+#![allow(unsafe_code)]
+
+use std::time::Instant;
+
+use console_workload::{PlanConfig, SessionRuntime, Workload};
+use lane::Backend;
+use session::{SessionModel, parse_session_json};
+
+const MONO_FIXTURE: &str =
+    include_str!("../../../fixtures/session/v1/console-sixty-four-track-mono.json");
+const DOGFOOD: &str =
+    "/home/bl/misofm/agents/stems/mixes/first-listen-v1/render-001/session.json";
+const CHECK_BLOCKS: u64 = 64;
+const WARMUP_BLOCKS: u64 = 500;
+const OBSERVATIONS: usize = 3000;
+const ROUNDS: u32 = 2;
+
+struct Arm {
+    name: String,
+    runtime: SessionRuntime,
+    digest: u64,
+    next_block: u64,
+}
+
+fn fnv(hash: &mut u64, data: &[f32]) {
+    for value in data {
+        for byte in value.to_bits().to_le_bytes() {
+            *hash ^= u64::from(byte);
+            *hash = hash.wrapping_mul(0x0100_0000_01b3);
+        }
+    }
+}
+
+fn arm(name: &str, runtime: SessionRuntime) -> Arm {
+    Arm {
+        name: name.to_owned(),
+        runtime,
+        digest: 0xcbf2_9ce4_8422_2325,
+        next_block: 0,
+    }
+}
+
+fn percentile(sorted: &[u64], p: f64) -> u64 {
+    let index = ((sorted.len() as f64 - 1.0) * p).round() as usize;
+    sorted[index]
+}
+
+fn measure(group: &str, backend: &str, arms: &mut [Arm]) {
+    for arm in arms.iter_mut() {
+        for _ in 0..CHECK_BLOCKS {
+            arm.runtime.render(arm.next_block).expect("render");
+            arm.next_block += 1;
+            fnv(&mut arm.digest, arm.runtime.research_output());
+        }
+    }
+    let preflight = std::env::var_os("DUALMONO_PREFLIGHT").is_some();
+    let (warmup, observations) = if preflight { (4, 8) } else { (WARMUP_BLOCKS, OBSERVATIONS) };
+    for _ in 0..warmup {
+        for arm in arms.iter_mut() {
+            arm.runtime.render(arm.next_block).expect("render");
+            arm.next_block += 1;
+        }
+    }
+    let count = arms.len();
+    for round in 1..=ROUNDS {
+        let mut samples: Vec<Vec<u64>> = vec![Vec::with_capacity(observations); count];
+        for observation in 0..observations {
+            for offset in 0..count {
+                let index = (observation + offset) % count;
+                let arm = &mut arms[index];
+                let start = Instant::now();
+                arm.runtime.render(arm.next_block).expect("render");
+                let elapsed = start.elapsed().as_nanos() as u64;
+                arm.next_block += 1;
+                samples[index].push(elapsed);
+            }
+        }
+        for (arm, mut times) in arms.iter().zip(samples) {
+            times.sort_unstable();
+            let mean = times.iter().sum::<u64>() as f64 / times.len() as f64;
+            println!(
+                "{group}\t{backend}\t{}\tround={round}\tp50_ns={}\tp10_ns={}\tp90_ns={}\tmean_ns={:.0}\tdigest={:016x}\tshape={:?}\tcollapse={:?}",
+                arm.name,
+                percentile(&times, 0.5),
+                percentile(&times, 0.1),
+                percentile(&times, 0.9),
+                mean,
+                arm.digest,
+                arm.runtime.bank_shape(),
+                arm.runtime.bank_collapse_counters(),
+            );
+        }
+    }
+}
+
+fn skip_seam(on: bool) {
+    // SAFETY: single-threaded research driver; the variable is read once per chain at bind.
+    unsafe {
+        if on {
+            std::env::set_var("MISO_ENGINE_RESEARCH_SKIP_SEAM_COPY", "1");
+        } else {
+            std::env::remove_var("MISO_ENGINE_RESEARCH_SKIP_SEAM_COPY");
+        }
+    }
+}
+
+fn set(name: &str, on: bool) {
+    // SAFETY: single-threaded research driver; read off render.
+    unsafe {
+        if on {
+            std::env::set_var(name, "1");
+        } else {
+            std::env::remove_var(name);
+        }
+    }
+}
+
+fn remainder(on: bool) {
+    // SAFETY: single-threaded research driver; read once per compile, off render.
+    unsafe {
+        if on {
+            std::env::set_var("MISO_ENGINE_RESEARCH_MONO_REMAINDER", "1");
+        } else {
+            std::env::remove_var("MISO_ENGINE_RESEARCH_MONO_REMAINDER");
+        }
+    }
+}
+
+fn fixture_group(backend: Backend, name: &str) {
+    let build = |workload| SessionRuntime::build_with_dispatch(workload, PlanConfig::BASELINE, backend);
+    let mut arms = vec![
+        arm("console", build(Workload::SixtyFourTrackConsole)),
+        arm("mono", build(Workload::SixtyFourTrackConsoleMono)),
+        arm("mono_dual", build(Workload::SixtyFourTrackConsoleMonoDual)),
+        arm("half_mono", build(Workload::SixtyFourTrackConsoleHalfMono)),
+    ];
+    skip_seam(true);
+    arms.push(arm("mono_noseam", build(Workload::SixtyFourTrackConsoleMono)));
+    skip_seam(false);
+    measure("fixture64", name, &mut arms);
+}
+
+/// The dogfood model, and which of its tracks read a bit-identical dual-mono stem.
+fn dogfood(identical: &[String]) -> (SessionModel, Vec<bool>) {
+    let text = std::fs::read_to_string(DOGFOOD).expect("dogfood session (read-only)");
+    // The first-listen session predates the BLAKE3 stem identity; the digest is only a label here.
+    let text = text.replace("\"sha256:", "\"blake3:");
+    let model = parse_session_json(&text).expect("dogfood session parses");
+    let dual_mono = model
+        .tracks
+        .iter()
+        .map(|track| {
+            let source = model
+                .sources
+                .iter()
+                .find(|source| source.id == track.source_id)
+                .expect("track source");
+            identical.iter().any(|content| *content == source.content)
+        })
+        .collect();
+    (model, dual_mono)
+}
+
+/// Give every dogfood track the standing strip (EQ + compressor on `simd1`, limiter on `simd2`)
+/// with the mono fixture's channel-symmetric parameters, cycling its 64 strips.
+fn with_standing_strip(mut model: SessionModel) -> SessionModel {
+    let strips = parse_session_json(MONO_FIXTURE).expect("mono fixture");
+    for (index, track) in model.tracks.iter_mut().enumerate() {
+        let strip = &strips.tracks[index % strips.tracks.len()];
+        track.simd1 = strip.simd1.clone();
+        track.dynamic = strip.dynamic.clone();
+        track.simd2 = strip.simd2.clone();
+    }
+    model
+}
+
+fn dogfood_group(group: &str, backend: Backend, name: &str, model: &SessionModel, dual_mono: &[bool]) {
+    let stereo_feed: Vec<(usize, usize)> = dual_mono
+        .iter()
+        .map(|mono| if *mono { (0, 0) } else { (0, 1) })
+        .collect();
+    let mut folded = model.clone();
+    for (track, mono) in folded.tracks.iter_mut().zip(dual_mono) {
+        if *mono {
+            track.right_source_channel = track.left_source_channel;
+        }
+    }
+    let mut arms = vec![
+        arm(
+            "as_is_dual_mono_declared_stereo",
+            SessionRuntime::research_build(model, backend, false, &stereo_feed),
+        ),
+        arm(
+            "folded_collapse",
+            SessionRuntime::research_build(&folded, backend, false, &stereo_feed),
+        ),
+        arm(
+            "folded_forced_off",
+            SessionRuntime::research_build(&folded, backend, true, &stereo_feed),
+        ),
+    ];
+    skip_seam(true);
+    arms.push(arm(
+        "folded_noseam",
+        SessionRuntime::research_build(&folded, backend, false, &stereo_feed),
+    ));
+    skip_seam(false);
+    remainder(true);
+    arms.push(arm(
+        "folded_remainder_collapse",
+        SessionRuntime::research_build(&folded, backend, false, &stereo_feed),
+    ));
+    arms.push(arm(
+        "folded_remainder_forced_off",
+        SessionRuntime::research_build(&folded, backend, true, &stereo_feed),
+    ));
+    if std::env::var_os("DUALMONO_UNARMED").is_some() {
+        set("MISO_ENGINE_RESEARCH_NO_ARM", true);
+        arms.push(arm(
+            "folded_remainder_unarmed",
+            SessionRuntime::research_build(&folded, backend, false, &stereo_feed),
+        ));
+        remainder(false);
+        arms.push(arm(
+            "folded_unarmed",
+            SessionRuntime::research_build(&folded, backend, false, &stereo_feed),
+        ));
+        set("MISO_ENGINE_RESEARCH_NO_ARM", false);
+        // Keep only the arms this diagnosis compares.
+        arms.retain(|arm| {
+            matches!(
+                arm.name.as_str(),
+                "as_is_dual_mono_declared_stereo"
+                    | "folded_collapse"
+                    | "folded_unarmed"
+                    | "folded_remainder_collapse"
+                    | "folded_remainder_unarmed"
+            )
+        });
+    }
+    remainder(false);
+    measure(group, name, &mut arms);
+}
+
+fn main() {
+    let identical: Vec<String> = std::fs::read_to_string(
+        std::env::args().nth(1).expect("path to the identical-sha list"),
+    )
+    .expect("identical list")
+    .lines()
+    .map(|line| line.replace("sha256:", "blake3:"))
+    .collect();
+    let (model, dual_mono) = dogfood(&identical);
+    eprintln!(
+        "dogfood tracks {}, bit-identical dual mono {}",
+        model.tracks.len(),
+        dual_mono.iter().filter(|mono| **mono).count()
+    );
+    let strip = with_standing_strip(model.clone());
+    // Only the width this build banks every effect at: a native Simd4 *dispatch* in an eight-lane
+    // build renders every effect per node (the factories refuse a width other than
+    // `Backend::current()`), so the four-lane leg is a separate `--cfg miso_native_simd4` build.
+    let backend = Backend::current();
+    let name = if backend == Backend::Simd4 { "Simd4" } else { "Simd8" };
+    {
+        if std::env::var_os("DUALMONO_UNARMED").is_none() {
+            fixture_group(backend, name);
+        }
+        dogfood_group("dogfood81_builtins", backend, name, &model, &dual_mono);
+        dogfood_group("dogfood81_strip", backend, name, &strip, &dual_mono);
+    }
+}
