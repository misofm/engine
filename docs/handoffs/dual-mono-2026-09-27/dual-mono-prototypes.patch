 impl SessionRuntime {
+    /// RESEARCH PROTOTYPE (dual-mono, 2026-09-27; reverted, recorded as a patch). Compiles,
+    /// prepares and binds an arbitrary model on the bound feed, with an explicit per-track feed
+    /// mapping (`feed[i]` is which frozen tone channel each plane of model track `i` receives) and
+    /// the collapse joined exactly as `build_full` joins it.
+    ///
+    /// The feed is separate from the declaration so that a stereo-declared track `(0, 1)` can be
+    /// fed two bit-identical planes -- a dual-mono file -- and compared against the same track
+    /// folded to `(0, 0)`.
+    #[doc(hidden)]
+    pub fn research_build(
+        model: &SessionModel,
+        dispatch: Backend,
+        forced_off: bool,
+        feed: &[(usize, usize)],
+    ) -> Self {
+        assert_eq!(feed.len(), model.tracks.len(), "one feed mapping per track");
+        let session = compile_session(model, compile_caps()).expect("compiled research session");
+        let registry = launch_native_effect_registry().expect("launch effect registry");
+        let effects = prepare_native_session_effects(&session, &registry, effect_caps())
+            .expect("prepared research effects");
+        let builtins = builtins_compiler::prepare_session_builtins(&session, &[], builtin_caps())
+            .expect("prepared research builtins");
+        let artifact = GraphCompiler::compile_with_builtins(GraphBuiltinsCompileRequest {
+            dispatch,
+            plan_id: PLAN_ID,
+            effects,
+            builtins,
+            caps: graph_caps(),
+        })
+        .unwrap_or_else(|_| panic!("research graph"));
+        let envelope = artifact.envelope();
+        let index = |track_id: &str| {
+            model
+                .tracks
+                .iter()
+                .position(|track| track.id.as_str() == track_id)
+                .expect("research track id")
+        };
+        let nodes = artifact
+            .external_binding_nodes()
+            .map(|node| match node {
+                GraphNodeId::TrackStage {
+                    track_id,
+                    stage: TrackStage::Input,
+                } => {
+                    let track = index(track_id.as_str());
+                    let block = source_block(track, false);
+                    GraphNodeBinding::new(
+                        node.clone(),
+                        Box::new(FrozenGraphSource::from_block(&block, feed[track])),
+                    )
+                }
+                _ => GraphNodeBinding::identity(node.clone()),
+            })
+            .collect();
+        let bound = artifact
+            .into_bound(GraphRuntimeBindings {
+                envelope,
+                nodes,
+                observers: Vec::new(),
+            })
+            .unwrap_or_else(|_| panic!("research graph bindings"));
+        let mut plan = bound.plan;
+        let structural = builtins_compiler::session_structural_symmetry(&session);
+        let eligible: BTreeSet<&str> = structural
+            .iter()
+            .filter(|(_, witness)| witness.eligible())
+            .map(|(track, _)| track.as_ref())
+            .collect();
+        if std::env::var_os("MISO_ENGINE_RESEARCH_NO_ARM").is_none() {
+            plan.arm_mono_collapse(&|track: &str| eligible.contains(track));
+        }
+        plan.force_mono_collapse_off(forced_off);
+        Self {
+            plan,
+            output: Box::new(OutputPlanes([0.0; QUANTUM * 2])),
+            meter_consumers: bound.meter_consumers,
+            controls: Vec::new(),
+            observations: Vec::new(),
+            structural_symmetry: builtins_compiler::session_structural_symmetry(&session),
+        }
+    }
+
+    /// RESEARCH PROTOTYPE: the last rendered block's planes, for bit comparisons.
+    #[doc(hidden)]
+    #[must_use]
+    pub fn research_output(&self) -> &[f32] {
+        &self.output.0
+    }
