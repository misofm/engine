+#[inline(never)]
+#[unsafe(no_mangle)]
+pub fn zz_pass8(words: &[f32], frames: usize, seeds: &[f64; 8], out: &mut [f64; 8], pk: &mut [f32; 8]) {
+    let r = meter_block::<Simd8>(words, frames, <Simd8 as Widen>::F64::load(seeds));
+    r.energy.store(out);
+    r.peak.add(r.clipped).add(r.sanitized).store(pk);
+}
+
+#[inline(never)]
+#[unsafe(no_mangle)]
+pub fn zz_pass4(words: &[f32], frames: usize, seeds: &[f64; 8], out: &mut [f64; 8], pk: &mut [f32; 8]) {
+    let r = meter_block::<Simd4>(words, frames, <Simd4 as Widen>::F64::load(seeds));
+    r.energy.store(out);
+    r.peak.add(r.clipped).add(r.sanitized).store(pk);
+}
+
+#[inline(never)]
+#[unsafe(no_mangle)]
+pub fn zz_energy_only8(words: &[f32], frames: usize, e: &mut [f64; 8]) {
+    let mut acc = <Simd8 as Widen>::F64::load(e);
+    for f in words[..frames * 8].chunks_exact(8) {
+        let w = Simd8::load(f).widen();
+        acc = acc.add(w.mul(w));
+    }
+    acc.store(e);
+}
