+/// VERIFICATION: shape of graph's `#[inline(never)] fn bank_meter_pass` at Simd4.
+#[inline(never)]
+fn zz_bank_meter_pass(
+    left: &[f32],
+    right: &[f32],
+    frames: usize,
+    seeds: &[[f64; 8]; 2],
+    peak: &mut [[f32; 8]; 2],
+    clipped: &mut [[f32; 8]; 2],
+    energy: &mut [[f64; 8]; 2],
+) {
+    use lane::kernels::builtins::meter_block;
+    use lane::{Lane, LaneF64, Simd4, Widen};
+    for (p, words) in [left, right].into_iter().enumerate() {
+        let Some(words) = words.get(..frames.saturating_mul(4)) else { return };
+        let frames = words.len() / 4;
+        let r = meter_block::<Simd4>(words, frames, <Simd4 as Widen>::F64::load(&seeds[p][..4]));
+        r.peak.store(&mut peak[p][..4]);
+        r.clipped.add(r.sanitized).store(&mut clipped[p][..4]);
+        r.energy.store(&mut energy[p][..4]);
+    }
+}
