+/// VERIFICATION: widen mismatches over `count` patterns from `start` at Simd4 (w=4) or Simd8.
+#[unsafe(no_mangle)]
+pub extern "C" fn miso_gate_zz_widen(start: u32, count: u32, eight: u32) -> u32 {
+    use lane::{Lane, LaneF64, Simd4, Simd8, Widen};
+    let mut mm = 0u32;
+    let w: u32 = if eight != 0 { 8 } else { 4 };
+    let mut p = start;
+    let mut done = 0u32;
+    while done < count {
+        let mut src = [0f32; 8];
+        for i in 0..w as usize {
+            src[i] = f32::from_bits(p.wrapping_add(i as u32));
+        }
+        let mut out = [0f64; 8];
+        if eight != 0 {
+            core::hint::black_box(Simd8::load(&src).widen()).store(&mut out);
+        } else {
+            core::hint::black_box(Simd4::load(&src[..4]).widen()).store(&mut out[..4]);
+        }
+        let out = core::hint::black_box(out);
+        for i in 0..w as usize {
+            match zz_oracle_widen(src[i]) {
+                Some(b) => mm += u32::from(out[i].to_bits() != b),
+                None => mm += u32::from(!out[i].is_nan()),
+            }
+        }
+        p = p.wrapping_add(w);
+        done += w;
+    }
+    mm
+}
