+/// VERIFICATION PROTOTYPE of #943 P1's kernel.
+#[inline(always)]
+pub fn meter_sample_peak_block<L: Lane>(words: &[f32], frames: usize, mut peak: L) -> L {
+    debug_assert!(words.len() >= frames * L::WIDTH);
+    for frame in words[..frames * L::WIDTH].chunks_exact(L::WIDTH) {
+        let a = L::load(frame).abs();
+        let c = L::select(
+            L::mask_and(a.ge(L::splat(f32::MIN_POSITIVE)), a.lt(L::splat(f32::INFINITY))),
+            a,
+            L::zero(),
+        );
+        peak = L::max(c, peak);
+    }
+    peak
+}
+
+/// VERIFICATION PROTOTYPE of #950 item 1.
+#[allow(missing_docs)]
+pub struct MeterBlock<L: crate::Widen> {
+    pub peak: L,
+    pub clipped: L,
+    pub sanitized: L,
+    pub energy: L::F64,
+}
+
+/// VERIFICATION PROTOTYPE of #950 item 1, frozen order as briefed.
+#[inline(always)]
+pub fn meter_block<L: crate::Widen>(words: &[f32], frames: usize, mut energy: L::F64) -> MeterBlock<L> {
+    use crate::LaneF64;
+    debug_assert!(words.len() >= frames * L::WIDTH);
+    let mut peak = L::zero();
+    let mut clipped = L::zero();
+    let mut sanitized = L::zero();
+    let one = L::splat(1.0);
+    for frame in words[..frames * L::WIDTH].chunks_exact(L::WIDTH) {
+        let a = L::load(frame).abs();
+        let c = L::select(
+            L::mask_and(a.ge(L::splat(f32::MIN_POSITIVE)), a.lt(L::splat(f32::INFINITY))),
+            a,
+            L::zero(),
+        );
+        peak = L::max(c, peak);
+        sanitized = sanitized.add(one.andnot(a.eq(c)));
+        clipped = clipped.add(one.andnot(L::mask_not(c.ge(one))));
+        let w = c.widen();
+        energy = energy.add(w.mul(w));
+    }
+    MeterBlock { peak, clipped, sanitized, energy }
+}
