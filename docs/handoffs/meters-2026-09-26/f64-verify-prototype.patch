+/// VERIFICATION: meter_block<Simd4> against the scalar ALL oracle over carried random blocks.
+#[unsafe(no_mangle)]
+pub extern "C" fn miso_gate_zz_meter_chain(seed: u32, blocks: u32) -> u32 {
+    use lane::kernels::builtins::meter_block;
+    use lane::{Lane, LaneF64, Simd4, Widen};
+    let mut x = seed | 1;
+    let mut next = || {
+        x ^= x << 13;
+        x ^= x >> 17;
+        x ^= x << 5;
+        x
+    };
+    let mut seeds = [0f64; 4];
+    for s in seeds.iter_mut() {
+        *s = f64::from(next() % 100_000) * 0.37;
+    }
+    let mut mm = 0;
+    for b in 0..blocks {
+        let frames = [1usize, 2, 3, 127, 128, 129][(b % 6) as usize];
+        let mut words = [0f32; 4 * 129];
+        for v in words[..frames * 4].iter_mut() {
+            let r = next();
+            *v = if r % 3 == 0 { f32::from_bits(next()) } else { ((r % 2001) as f32 - 1000.0) * 1.3e-3 * (1 + r % 7) as f32 };
+        }
+        let r = core::hint::black_box(meter_block::<Simd4>(&words[..frames * 4], frames, <Simd4 as Widen>::F64::load(&seeds)));
+        let mut en = [0f64; 4];
+        let mut pk = [0f32; 4];
+        let mut cl = [0f32; 4];
+        let mut sa = [0f32; 4];
+        r.energy.store(&mut en);
+        r.peak.store(&mut pk);
+        r.clipped.store(&mut cl);
+        r.sanitized.store(&mut sa);
+        for l in 0..4 {
+            let mut e = seeds[l];
+            let mut p = 0f32;
+            let mut c = 0u32;
+            let mut s = 0u32;
+            for f in 0..frames {
+                let v = words[f * 4 + l];
+                let valid = v.is_finite() && !v.is_subnormal();
+                let q = if valid { v } else { 0.0 };
+                let a = q.abs();
+                p = if a > p { a } else { p };
+                e += f64::from(q) * f64::from(q);
+                s += u32::from(!valid);
+                c += u32::from(a >= 1.0);
+            }
+            mm += u32::from(en[l].to_bits() != e.to_bits())
+                + u32::from(pk[l].to_bits() != p.to_bits())
+                + u32::from(cl[l] as u32 != c)
+                + u32::from(sa[l] as u32 != s);
+            seeds[l] = en[l];
+        }
+    }
+    mm
+}
