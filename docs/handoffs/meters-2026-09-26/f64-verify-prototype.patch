+
+fn zz_oracle_widen(x: f32) -> Option<u64> {
+    let bits = x.to_bits();
+    let s = u64::from(bits >> 31) << 63;
+    let e = u64::from((bits >> 23) & 0xFF);
+    let m = bits & 0x7F_FFFF;
+    if e == 0 && m == 0 {
+        return Some(s);
+    }
+    if e == 0 {
+        let k = m.leading_zeros() - 9;
+        return Some(s | (896 - u64::from(k)) << 52 | u64::from((m << (k + 1)) & 0x7F_FFFF) << 29);
+    }
+    if e == 255 {
+        return if m == 0 { Some(s | 0x7FF << 52) } else { None };
+    }
+    Some(s | (e + 896) << 52 | u64::from(m) << 29)
+}
