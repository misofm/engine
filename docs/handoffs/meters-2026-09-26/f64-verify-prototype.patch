+//! VERIFICATION HARNESS (throwaway) for #949 / #950.
+#![allow(missing_docs, clippy::all, clippy::pedantic)]
+
+use core::hint::black_box;
+use lane::kernels::builtins::{meter_block, meter_sample_peak_block};
+use lane::{Lane, LaneF64, Simd4, Simd8, Widen};
+use std::time::Instant;
+
+fn oracle_widen(x: f32) -> Option<u64> {
+    let bits = x.to_bits();
+    let s = u64::from(bits >> 31) << 63;
+    let e = u64::from((bits >> 23) & 0xFF);
+    let m = bits & 0x7F_FFFF;
+    if e == 0 && m == 0 {
+        return Some(s);
+    }
+    if e == 0 {
+        let k = m.leading_zeros() - 9;
+        let mant = u64::from((m << (k + 1)) & 0x7F_FFFF) << 29;
+        return Some(s | (896 - u64::from(k)) << 52 | mant);
+    }
+    if e == 255 {
+        if m == 0 {
+            return Some(s | 0x7FF << 52);
+        }
+        return None; // NaN
+    }
+    Some(s | (e + 896) << 52 | u64::from(m) << 29)
+}
+
+fn check_widen_range<L: Widen>(start: u64, end: u64) -> u64 {
+    let w = L::WIDTH;
+    let mut mismatches = 0u64;
+    let mut src = [0f32; 8];
+    let mut out = [0f64; 8];
+    let mut p = start;
+    while p < end {
+        for i in 0..w {
+            src[i] = f32::from_bits(((p + i as u64) & 0xFFFF_FFFF) as u32);
+        }
+        let v = black_box(L::load(&src[..w]).widen());
+        v.store(&mut out[..w]);
+        let out = black_box(out);
+        for i in 0..w {
+            let x = src[i];
+            match oracle_widen(x) {
+                Some(bits) => {
+                    if out[i].to_bits() != bits {
+                        mismatches += 1;
+                    }
+                }
+                None => {
+                    if !out[i].is_nan() {
+                        mismatches += 1;
+                    }
+                }
+            }
+        }
+        p += w as u64;
+    }
+    mismatches
+}
+
+#[test]
+fn widen_exhaustive_release() {
+    if cfg!(debug_assertions) {
+        return;
+    }
+    for (name, width) in [("Simd4", 4usize), ("Simd8", 8usize)] {
+        let t = Instant::now();
+        let threads = 4u64;
+        let chunk = (1u64 << 32) / threads;
+        let total: u64 = std::thread::scope(|s| {
+            let hs: Vec<_> = (0..threads)
+                .map(|t| {
+                    s.spawn(move || {
+                        if width == 4 {
+                            check_widen_range::<Simd4>(t * chunk, (t + 1) * chunk)
+                        } else {
+                            check_widen_range::<Simd8>(t * chunk, (t + 1) * chunk)
+                        }
+                    })
+                })
+                .collect();
+            hs.into_iter().map(|h| h.join().unwrap()).sum()
+        });
+        eprintln!("widen {name}: {total} mismatches in {:?}", t.elapsed());
+        assert_eq!(total, 0);
+    }
+    // f32 oracle arm
+    assert_eq!(check_widen_range::<f32>(0, 1 << 20), 0);
+}
+
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        let mut x = self.0;
+        x ^= x >> 12;
+        x ^= x << 25;
+        x ^= x >> 27;
+        self.0 = x;
+        x.wrapping_mul(0x2545_F491_4F6C_DD1D)
+    }
+}
+
+fn f64_pool() -> Vec<f64> {
+    let mut v = vec![
+        0.0,
+        -0.0,
+        f64::from_bits(1),
+        -f64::from_bits(1),
+        f64::from_bits(0x000F_FFFF_FFFF_FFFF),
+        -f64::from_bits(0x000F_FFFF_FFFF_FFFF),
+        f64::MIN_POSITIVE,
+        -f64::MIN_POSITIVE,
+        1.0,
+        -1.0,
+        1.0 + f64::EPSILON,
+        f64::MAX,
+        -f64::MAX,
+        f64::INFINITY,
+        f64::NEG_INFINITY,
+        f64::NAN,
+        f64::from_bits(0x7FF0_0000_0000_0001), // sNaN
+        1.0 + f64::EPSILON / 2.0 * 0.0 + 2f64.powi(-53) * 0.0,
+        2f64.powi(53),
+        1.0,
+    ];
+    // tie-rounding pair: 2^53 + 1 is a tie
+    v.push(9007199254740992.0);
+    v.push(1.0);
+    v
+}
+
+fn check_binop<F: LaneF64>(a: &[f64], b: &[f64], op: u8) -> u64 {
+    let w = F::WIDTH;
+    let mut out = [0f64; 8];
+    let va = F::load(&a[..w]);
+    let vb = F::load(&b[..w]);
+    let r = black_box(if op == 0 { va.add(vb) } else { va.mul(vb) });
+    r.store(&mut out[..w]);
+    let out = black_box(out);
+    let mut mm = 0;
+    for i in 0..w {
+        let e = if op == 0 { a[i] + b[i] } else { a[i] * b[i] };
+        if e.is_nan() {
+            if !out[i].is_nan() {
+                mm += 1;
+            }
+        } else if e.to_bits() != out[i].to_bits() {
+            mm += 1;
+        }
+    }
+    mm
+}
+
+#[test]
+fn add_mul_identity() {
+    let pool = f64_pool();
+    let mut mm = 0;
+    let mut a = [0f64; 8];
+    let mut b = [0f64; 8];
+    for &x in &pool {
+        for &y in &pool {
+            for i in 0..8 {
+                a[i] = black_box(x);
+                b[i] = black_box(y);
+            }
+            // vary lane position
+            a.rotate_left(3);
+            for op in 0..2 {
+                mm += check_binop::<wide::f64x4>(&a, &b, op);
+                mm += check_binop::<wide::f64x8>(&a, &b, op);
+                mm += check_binop::<f64>(&a, &b, op);
+            }
+        }
+    }
+    let mut rng = Rng(0x1234_5678_9ABC_DEF1);
+    let n = if cfg!(debug_assertions) { 20_000 } else { 1_000_000 };
+    for _ in 0..n {
+        for i in 0..8 {
+            a[i] = f64::from_bits(rng.next());
+            b[i] = f64::from_bits(rng.next());
+        }
+        for op in 0..2 {
+            mm += check_binop::<wide::f64x4>(&a, &b, op);
+            mm += check_binop::<wide::f64x8>(&a, &b, op);
+        }
+    }
+    assert_eq!(mm, 0);
+}
+
+// ---------- meter_block vs scalar ALL oracle ----------
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct Lane1 {
+    peak: f32,
+    clipped: u32,
+    sanitized: u32,
+    energy: f64,
+}
+
+fn oracle_lane(samples: &[f32], seed: f64) -> Lane1 {
+    let mut p = 0.0f32;
+    let mut e = seed;
+    let mut cl = 0;
+    let mut sa = 0;
+    for &x in samples {
+        let valid = x.is_finite() && !x.is_subnormal();
+        let s = if valid { x } else { 0.0 };
+        let a = s.abs();
+        p = if a > p { a } else { p };
+        e += f64::from(s) * f64::from(s);
+        sa += u32::from(!valid);
+        cl += u32::from(a >= 1.0);
+    }
+    Lane1 { peak: p, clipped: cl, sanitized: sa, energy: e }
+}
+
+fn run_block<L: Widen>(words: &[f32], frames: usize, seeds: &[f64]) -> Vec<Lane1> {
+    let w = L::WIDTH;
+    let r = meter_block::<L>(words, frames, <L::F64 as LaneF64>::load(&seeds[..w]));
+    let r = black_box(r);
+    let mut pk = [0f32; 8];
+    let mut cl = [0f32; 8];
+    let mut sa = [0f32; 8];
+    let mut en = [0f64; 8];
+    r.peak.store(&mut pk[..w]);
+    r.clipped.store(&mut cl[..w]);
+    r.sanitized.store(&mut sa[..w]);
+    r.energy.store(&mut en[..w]);
+    let p1 = black_box(meter_sample_peak_block::<L>(words, frames, L::zero()));
+    let mut pk1 = [0f32; 8];
+    p1.store(&mut pk1[..w]);
+    for l in 0..w {
+        assert_eq!(pk[l].to_bits(), pk1[l].to_bits(), "peak != P1 peak");
+    }
+    (0..w)
+        .map(|l| Lane1 {
+            peak: pk[l],
+            clipped: cl[l] as u32,
+            sanitized: sa[l] as u32,
+            energy: en[l],
+        })
+        .collect()
+}
+
+fn hostile_pool() -> Vec<f32> {
+    let mut v = vec![
+        f32::NAN,
+        f32::from_bits(0xFFC0_0001),
+        f32::from_bits(0x7F80_0001),
+        f32::INFINITY,
+        f32::NEG_INFINITY,
+        0.0,
+        -0.0,
+        f32::from_bits(1),
+        -f32::from_bits(1),
+        f32::from_bits(0x007F_FFFF),
+        -f32::from_bits(0x007F_FFFF),
+        f32::MIN_POSITIVE,
+        -f32::MIN_POSITIVE,
+        1.0,
+        -1.0,
+        f32::from_bits(0x3F80_0001),
+        f32::from_bits(0x3F7F_FFFF),
+        1e30,
+        -1e30,
+        1e38,
+        f32::MAX,
+        -f32::MAX,
+    ];
+    for k in -34..=5 {
+        v.push(2f32.powi(k));
+        v.push(-2f32.powi(k) * 1.37);
+    }
+    v
+}
+
+fn meter_block_case<L: Widen>(seed: u64) -> u64 {
+    let w = L::WIDTH;
+    let pool = hostile_pool();
+    let mut rng = Rng(seed);
+    let mut mism = 0;
+    for &frames in &[1usize, 2, 3, 127, 128, 129] {
+        for mode in 0..3 {
+            let mut seeds = [0f64; 8];
+            for l in 0..8 {
+                seeds[l] = f64::from_bits(rng.next() >> 2) % 1e6 + (rng.next() % 1000) as f64;
+                if mode == 2 {
+                    seeds[l] = 0.0;
+                }
+            }
+            for _block in 0..64 {
+                let mut words = vec![0f32; frames * w];
+                for (i, x) in words.iter_mut().enumerate() {
+                    *x = match mode {
+                        0 => pool[(rng.next() % pool.len() as u64) as usize],
+                        1 => {
+                            let t = i as f32 * 0.01 + seed as f32;
+                            (t.sin() * 0.9) as f32
+                        }
+                        _ => f32::from_bits(rng.next() as u32),
+                    };
+                }
+                let got = run_block::<L>(&words, frames, &seeds);
+                for l in 0..w {
+                    let lane: Vec<f32> = (0..frames).map(|f| words[f * w + l]).collect();
+                    let want = oracle_lane(&lane, seeds[l]);
+                    let scalar = {
+                        let r = meter_block::<f32>(&lane, frames, seeds[l]);
+                        Lane1 {
+                            peak: r.peak,
+                            clipped: r.clipped as u32,
+                            sanitized: r.sanitized as u32,
+                            energy: r.energy,
+                        }
+                    };
+                    let g = got[l];
+                    for other in [scalar, g] {
+                        if other.peak.to_bits() != want.peak.to_bits()
+                            || other.clipped != want.clipped
+                            || other.sanitized != want.sanitized
+                            || other.energy.to_bits() != want.energy.to_bits()
+                        {
+                            mism += 1;
+                            if mism < 5 {
+                                eprintln!("mismatch frames={frames} mode={mode} lane={l} got={other:?} want={want:?}");
+                            }
+                        }
+                    }
+                    seeds[l] = g.energy;
+                }
+            }
+        }
+    }
+    mism
+}
+
+#[test]
+fn meter_block_identity() {
+    assert_eq!(meter_block_case::<Simd4>(7), 0);
+    assert_eq!(meter_block_case::<Simd8>(11), 0);
+}
+
+#[test]
+fn square_exact_witness() {
+    let mut rng = Rng(99);
+    let mut xs: Vec<f32> = hostile_pool().into_iter().filter(|x| x.is_finite()).collect();
+    for _ in 0..100_000 {
+        let x = f32::from_bits(rng.next() as u32);
+        if x.is_finite() {
+            xs.push(x);
+        }
+    }
+    let mut mm = 0;
+    for chunk in xs.chunks_exact(8) {
+        let v = black_box(Simd8::load(chunk).widen());
+        let sq = black_box(v.mul(v));
+        let mut out = [0f64; 8];
+        sq.store(&mut out);
+        for i in 0..8 {
+            let x = chunk[i];
+            let bits = x.to_bits();
+            let e = ((bits >> 23) & 0xFF) as i32;
+            let m = bits & 0x7F_FFFF;
+            let (mm_, ee) = if e == 0 { (m as u64, -149i32) } else { ((m | 0x80_0000) as u64, e - 150) };
+            let want = ((mm_ * mm_) as f64) * f64::from_bits(((2 * ee + 1023) as u64) << 52);
+            if out[i].to_bits() != want.to_bits() {
+                mm += 1;
+            }
+        }
+    }
+    assert_eq!(mm, 0);
+}
