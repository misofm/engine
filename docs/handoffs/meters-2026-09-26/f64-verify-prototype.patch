+++ b/crates/builtins/tests/zz_banked.rs
@@ -0,0 +1,510 @@
+//! VERIFICATION HARNESS (throwaway) for #950: arm A (scalar observe_input) against arm B (seed,
+//! banked pass, commit), every snapshot field compared by bits. Also: two meters per member (the
+//! seed comes from the first), and an in-process microbenchmark.
+#![allow(missing_docs, clippy::all, clippy::pedantic)]
+
+use core::hint::black_box;
+use core::num::{NonZeroU32, NonZeroU64, NonZeroUsize};
+use std::time::Instant;
+
+use builtins::*;
+use lane::kernels::builtins::meter_block;
+use lane::{LaneF64, Simd4, Simd8, Widen};
+
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        let mut x = self.0;
+        x ^= x >> 12;
+        x ^= x << 25;
+        x ^= x >> 27;
+        self.0 = x;
+        x.wrapping_mul(0x2545_F491_4F6C_DD1D)
+    }
+    fn below(&mut self, n: u64) -> u64 {
+        self.next() % n
+    }
+}
+
+fn hostile_pool() -> Vec<f32> {
+    let mut v = vec![
+        f32::NAN,
+        f32::from_bits(0xFFC0_0001),
+        f32::INFINITY,
+        f32::NEG_INFINITY,
+        0.0,
+        -0.0,
+        f32::from_bits(1),
+        -f32::from_bits(1),
+        f32::from_bits(0x007F_FFFF),
+        f32::MIN_POSITIVE,
+        -f32::MIN_POSITIVE,
+        1.0,
+        -1.0,
+        f32::from_bits(0x3F80_0001),
+        f32::from_bits(0x3F7F_FFFF),
+        1e30,
+        -1e30,
+        1e38,
+        f32::MAX,
+        -f32::MAX,
+    ];
+    for k in -34..=5 {
+        v.push(2f32.powi(k) * 1.13);
+        v.push(-2f32.powi(k) * 0.77);
+    }
+    v
+}
+
+#[derive(Clone, Copy)]
+struct Cfg {
+    period: u32,
+    metrics: MeterMetricSet,
+    hold: u32,
+    decay: f32,
+}
+
+fn prepare(cfg: Cfg, handle: u64) -> PreparedMeter {
+    MeterAccumulator::prepare_selected(
+        MeterHandle(NonZeroU64::new(handle).unwrap()),
+        MeterConfig {
+            period_frames: NonZeroU32::new(cfg.period).unwrap(),
+            peak_hold_frames: cfg.hold,
+            peak_decay_db_per_second: cfg.decay,
+            queue_capacity: NonZeroUsize::new(4096).unwrap(),
+            reset_generation: 3,
+        },
+        48_000,
+        cfg.metrics,
+    )
+    .unwrap()
+}
+
+fn lane_bits(l: &MeterLaneSnapshot) -> [u64; 6] {
+    [
+        u64::from(l.sample_peak.to_bits()),
+        l.rms.to_bits(),
+        l.energy.to_bits(),
+        u64::from(l.held_peak.to_bits()),
+        l.clipped_samples,
+        l.sanitized_samples,
+    ]
+}
+
+fn snap_key(s: &MeterSnapshot) -> Vec<u64> {
+    let mut v = vec![
+        s.handle.0.get(),
+        u64::from(s.present_metrics.bits()),
+        s.reset_generation,
+        s.observation_generation,
+        s.window_sequence,
+        s.start_sample,
+        s.end_sample,
+        u64::from(s.frames),
+        s.cumulative_clipped_samples,
+        s.cumulative_sanitized_samples,
+        s.cumulative_discontinuities,
+        s.cumulative_dropped_snapshots,
+    ];
+    v.extend(lane_bits(&s.left));
+    v.extend(lane_bits(&s.right));
+    v
+}
+
+#[derive(Clone, Copy, Debug)]
+enum Ev {
+    Block(usize),
+    Skip(u64),
+    Restart,
+    Reset(bool),
+}
+
+/// Mutation switch for liveness: 0 = as briefed, 1 = K-1 (seed + zero-seeded partial),
+/// 2 = zero seeds, 3 = K-2 (seed ignores discontinuity -- emulated by passing pre-preamble energy).
+std::thread_local! { static MUTATION: std::cell::Cell<u8> = const { std::cell::Cell::new(0) }; }
+fn mutation() -> u8 {
+    MUTATION.with(|m| m.get())
+}
+
+/// A member: a list of meters observing the same lane.
+struct Member {
+    a: Vec<PreparedMeter>,
+    b: Vec<PreparedMeter>,
+}
+
+struct Totals {
+    snapshots: u64,
+    commits: u64,
+    mismatches: u64,
+}
+
+fn run_pass<L: Widen>(words: &[f32], frames: usize, seeds: &[f64; 8]) -> ([f32; 8], [f32; 8], [f32; 8], [f64; 8]) {
+    let w = L::WIDTH;
+    let r = meter_block::<L>(words, frames, <L::F64 as LaneF64>::load(&seeds[..w]));
+    let r = black_box(r);
+    let mut pk = [0f32; 8];
+    let mut cl = [0f32; 8];
+    let mut sa = [0f32; 8];
+    let mut en = [0f64; 8];
+    r.peak.store(&mut pk[..w]);
+    r.clipped.store(&mut cl[..w]);
+    r.sanitized.store(&mut sa[..w]);
+    r.energy.store(&mut en[..w]);
+    (pk, cl, sa, en)
+}
+
+fn stream<L: Widen>(
+    members: &mut [Member],
+    events: &[Ev],
+    tone: bool,
+    rng: &mut Rng,
+    pool: &[f32],
+    totals: &mut Totals,
+) {
+    let w = L::WIDTH;
+    assert_eq!(members.len(), w);
+    let mut t: u64 = 1_000;
+    let mut generation = 0;
+    let mut phase = 0.0f32;
+    for ev in events {
+        match *ev {
+            Ev::Skip(n) => t += n,
+            Ev::Restart => {
+                generation += 1;
+                for m in members.iter_mut() {
+                    for p in m.a.iter_mut().chain(m.b.iter_mut()) {
+                        p.accumulator.restart_observation(generation);
+                    }
+                }
+            }
+            Ev::Reset(full) => {
+                let kind = if full {
+                    BuiltinResetKind::FullToPrepared
+                } else {
+                    BuiltinResetKind::DiscontinuityKeepTargets
+                };
+                for m in members.iter_mut() {
+                    for p in m.a.iter_mut().chain(m.b.iter_mut()) {
+                        p.accumulator.reset(kind);
+                    }
+                }
+            }
+            Ev::Block(frames) => {
+                let mut planes = [vec![0f32; frames * w], vec![0f32; frames * w]];
+                for (pi, plane) in planes.iter_mut().enumerate() {
+                    for f in 0..frames {
+                        for l in 0..w {
+                            plane[f * w + l] = if tone {
+                                let amp = 0.3 + 0.1 * l as f32 + 0.05 * pi as f32;
+                                amp * (phase + f as f32 * (0.013 + 0.001 * l as f32) + pi as f32).sin()
+                            } else if rng.below(4) == 0 {
+                                f32::from_bits(rng.next() as u32)
+                            } else {
+                                pool[rng.below(pool.len() as u64) as usize]
+                            };
+                        }
+                    }
+                }
+                phase += frames as f32 * 0.013;
+                // Arm A.
+                for (l, m) in members.iter_mut().enumerate() {
+                    for p in m.a.iter_mut() {
+                        let input =
+                            MeterInput::strided(&planes[0], &planes[1], frames, w, l).unwrap();
+                        p.accumulator.observe_input(input, t).unwrap();
+                    }
+                }
+                // Arm B: seeds from the first accepting observer, in binding order.
+                let mut seeds = [[0f64; 8]; 2];
+                for (l, m) in members.iter().enumerate() {
+                    for p in m.b.iter() {
+                        if let Some(s) = p.accumulator.banked_seed(t, frames) {
+                            seeds[0][l] = s[0];
+                            seeds[1][l] = s[1];
+                            break;
+                        }
+                    }
+                }
+                let zero = [0f64; 8];
+                let run_seeds = if mutation() == 1 || mutation() == 2 { [&zero, &zero] } else { [&seeds[0], &seeds[1]] };
+                let left = run_pass::<L>(&planes[0], frames, run_seeds[0]);
+                let right = run_pass::<L>(&planes[1], frames, run_seeds[1]);
+                for (l, m) in members.iter_mut().enumerate() {
+                    for p in m.b.iter_mut() {
+                        let mut energy = [left.3[l], right.3[l]];
+                        if mutation() == 1 {
+                            energy = [seeds[0][l] + left.3[l], seeds[1][l] + right.3[l]];
+                        }
+                        let block = MeterBankedBlock {
+                            sample_peak: [left.0[l], right.0[l]],
+                            clipped: [left.1[l] as u64, right.1[l] as u64],
+                            sanitized: [left.2[l] as u64, right.2[l] as u64],
+                            energy_seed: [seeds[0][l], seeds[1][l]],
+                            energy,
+                        };
+                        let input =
+                            MeterInput::strided(&planes[0], &planes[1], frames, w, l).unwrap();
+                        p.accumulator.observe_input_banked(input, t, Some(block)).unwrap();
+                    }
+                }
+                totals.commits += zz_banked_commits_take();
+                t += frames as u64;
+            }
+        }
+        // Drain and compare.
+        for m in members.iter_mut() {
+            for (pa, pb) in m.a.iter_mut().zip(m.b.iter_mut()) {
+                loop {
+                    let sa = pa.consumer.try_pop();
+                    let sb = pb.consumer.try_pop();
+                    match (sa, sb) {
+                        (Ok(x), Ok(y)) => {
+                            totals.snapshots += 1;
+                            if snap_key(&x) != snap_key(&y) {
+                                totals.mismatches += 1;
+                                if totals.mismatches < 4 {
+                                    eprintln!("MISMATCH\n A {x:?}\n B {y:?}");
+                                }
+                            }
+                        }
+                        (Err(_), Err(_)) => break,
+                        _ => {
+                            totals.mismatches += 1;
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+const PERIODS: [u32; 9] = [1, 64, 127, 128, 129, 300, 512, 1536, 4096];
+fn metric_sets() -> [MeterMetricSet; 9] {
+    let p = MeterMetricSet::SAMPLE_PEAK.bits();
+    let e = MeterMetricSet::ENERGY_RMS.bits();
+    let c = MeterMetricSet::COUNTS.bits();
+    let h = MeterMetricSet::HELD_PEAK.bits();
+    [
+        MeterMetricSet::ALL,
+        MeterMetricSet::from_bits_retain(e),
+        MeterMetricSet::from_bits_retain(c),
+        MeterMetricSet::from_bits_retain(h),
+        MeterMetricSet::from_bits_retain(p),
+        MeterMetricSet::from_bits_retain(p | e),
+        MeterMetricSet::from_bits_retain(p | c),
+        MeterMetricSet::from_bits_retain(e | h),
+        MeterMetricSet::from_bits_retain(c | h),
+    ]
+}
+const BALLISTICS: [(u32, f32); 4] = [(0, 0.0), (7, 0.0), (0, 12.0), (100, 60.0)];
+
+fn random_events(rng: &mut Rng, n: usize) -> Vec<Ev> {
+    let sizes = [1usize, 2, 3, 63, 64, 127, 128, 129, 256, 300, 511];
+    (0..n)
+        .map(|_| match rng.below(20) {
+            0 => Ev::Skip(1 + rng.below(40)),
+            1 => Ev::Restart,
+            2 => Ev::Reset(rng.below(2) == 0),
+            3 => Ev::Block(0),
+            4..=11 => Ev::Block(128),
+            _ => Ev::Block(sizes[rng.below(sizes.len() as u64) as usize]),
+        })
+        .collect()
+}
+
+fn sweep<L: Widen>(per_member: usize, same_config_twins: bool) -> Totals {
+    let w = L::WIDTH;
+    let pool = hostile_pool();
+    let mut totals = Totals { snapshots: 0, commits: 0, mismatches: 0 };
+    let mut rng = Rng(0xDEAD_BEEF_1234_5679 ^ w as u64);
+    let mut fixed: Vec<Ev> = (0..48).map(|_| Ev::Block(128)).collect();
+    fixed.insert(20, Ev::Skip(7));
+    for &period in &PERIODS {
+        for metrics in metric_sets() {
+            for &(hold, decay) in &BALLISTICS {
+                for tone in [false, true] {
+                    for random in [false, true] {
+                        let events = if random { random_events(&mut rng, 150) } else { fixed.clone() };
+                        let mut handle = 1;
+                        let mut members: Vec<Member> = (0..w)
+                            .map(|_| {
+                                let mut a = Vec::new();
+                                let mut b = Vec::new();
+                                for k in 0..per_member {
+                                    // Second meter on a member: same config (twin) or a different
+                                    // period, so its energy differs from the seed source's.
+                                    let cfg = if k == 0 || same_config_twins {
+                                        Cfg { period, metrics, hold, decay }
+                                    } else {
+                                        Cfg { period: if period == 512 { 1536 } else { 512 }, metrics: MeterMetricSet::ALL, hold: 0, decay: 0.0 }
+                                    };
+                                    a.push(prepare(cfg, handle));
+                                    b.push(prepare(cfg, handle));
+                                    handle += 1;
+                                }
+                                Member { a, b }
+                            })
+                            .collect();
+                        stream::<L>(&mut members, &events, tone, &mut rng, &pool, &mut totals);
+                    }
+                }
+            }
+        }
+    }
+    totals
+}
+
+#[test]
+fn zz_banked_differential() {
+    for (name, t) in [
+        ("f32", sweep::<f32>(1, false)),
+        ("Simd4", sweep::<Simd4>(1, false)),
+        ("Simd8", sweep::<Simd8>(1, false)),
+        ("Simd8 twins", sweep::<Simd8>(2, true)),
+        ("Simd8 mixed pair", sweep::<Simd8>(2, false)),
+        ("Simd4 mixed pair", sweep::<Simd4>(2, false)),
+    ] {
+        eprintln!(
+            "{name}: snapshots {} commits {} mismatches {}",
+            t.snapshots, t.commits, t.mismatches
+        );
+        assert_eq!(t.mismatches, 0, "{name}");
+    }
+}
+
+#[test]
+fn zz_banked_mutations_go_red() {
+    for m in [1u8, 2] {
+        MUTATION.with(|x| x.set(m));
+        let t = sweep::<Simd8>(1, false);
+        eprintln!("mutation {m}: snapshots {} commits {} mismatches {}", t.snapshots, t.commits, t.mismatches);
+        MUTATION.with(|x| x.set(0));
+        assert!(t.mismatches > 0, "mutation {m} stayed green");
+    }
+}
+
+/// Commit counters as briefed (M2).
+#[test]
+fn zz_commit_counters() {
+    let tone_events: Vec<Ev> = (0..64).map(|_| Ev::Block(128)).collect();
+    let pool = hostile_pool();
+    let mut rng = Rng(5);
+    for (period, want) in [(512u32, Some(512u64)), (64, Some(0)), (1536, Some(512)), (300, None)] {
+        let mut totals = Totals { snapshots: 0, commits: 0, mismatches: 0 };
+        let mut members: Vec<Member> = (0..8)
+            .map(|l| {
+                let cfg = Cfg { period, metrics: MeterMetricSet::ALL, hold: 0, decay: 0.0 };
+                Member { a: vec![prepare(cfg, l + 1)], b: vec![prepare(cfg, l + 1)] }
+            })
+            .collect();
+        stream::<Simd8>(&mut members, &tone_events, true, &mut rng, &pool, &mut totals);
+        eprintln!("period {period}: commits {} snapshots {} mismatches {}", totals.commits, totals.snapshots, totals.mismatches);
+        assert_eq!(totals.mismatches, 0);
+        match want {
+            Some(n) => assert_eq!(totals.commits, n),
+            None => assert!(totals.commits > 0 && totals.commits < 512),
+        }
+    }
+}
+
+// ---------------- Microbenchmark (direction only) ----------------
+
+fn bench_arm<L: Widen>(banked: bool, period: u32, blocks: usize, rounds: usize) -> Vec<f64> {
+    let w = L::WIDTH;
+    let frames = 128;
+    let mut planes = [vec![0f32; frames * w], vec![0f32; frames * w]];
+    for (pi, plane) in planes.iter_mut().enumerate() {
+        for f in 0..frames {
+            for l in 0..w {
+                plane[f * w + l] = (0.3 + 0.05 * l as f32) * ((f as f32) * 0.021 + l as f32 + pi as f32).sin();
+            }
+        }
+    }
+    let cfg = Cfg { period, metrics: MeterMetricSet::ALL, hold: 0, decay: 0.0 };
+    let mut meters: Vec<PreparedMeter> = (0..w).map(|l| prepare(cfg, l as u64 + 1)).collect();
+    let mut out = Vec::new();
+    let mut t = 0u64;
+    for round in 0..=rounds {
+        let start = Instant::now();
+        for _ in 0..blocks {
+            if banked {
+                let mut seeds = [[0f64; 8]; 2];
+                for l in 0..w {
+                    if let Some(s) = meters[l].accumulator.banked_seed(t, frames) {
+                        seeds[0][l] = s[0];
+                        seeds[1][l] = s[1];
+                    }
+                }
+                let left = run_pass::<L>(black_box(&planes[0]), frames, &seeds[0]);
+                let right = run_pass::<L>(black_box(&planes[1]), frames, &seeds[1]);
+                for l in 0..w {
+                    let block = MeterBankedBlock {
+                        sample_peak: [left.0[l], right.0[l]],
+                        clipped: [left.1[l] as u64, right.1[l] as u64],
+                        sanitized: [left.2[l] as u64, right.2[l] as u64],
+                        energy_seed: [seeds[0][l], seeds[1][l]],
+                        energy: [left.3[l], right.3[l]],
+                    };
+                    let input = MeterInput::strided(&planes[0], &planes[1], frames, w, l).unwrap();
+                    meters[l].accumulator.observe_input_banked(input, t, Some(block)).unwrap();
+                }
+            } else {
+                for l in 0..w {
+                    let input = MeterInput::strided(black_box(&planes[0]), black_box(&planes[1]), frames, w, l).unwrap();
+                    meters[l].accumulator.observe_input(input, t).unwrap();
+                }
+            }
+            t += frames as u64;
+            for m in meters.iter_mut() {
+                while m.consumer.try_pop().is_ok() {}
+            }
+        }
+        let ns = start.elapsed().as_nanos() as f64 / blocks as f64;
+        if round > 0 {
+            out.push(ns);
+        }
+    }
+    zz_banked_commits_take();
+    out
+}
+
+#[test]
+#[ignore]
+fn zz_bench() {
