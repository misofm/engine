+/// VERIFY PROTOTYPE (#943 interface item 1), policy-clean form.
+#[inline(always)]
+pub fn meter_sample_peak_block<L: Lane>(words: &[f32], frames: usize, peak: L) -> L {
+    debug_assert!(words.len() >= frames * L::WIDTH);
+    let lo = L::splat(f32::MIN_POSITIVE);
+    let hi = L::splat(f32::INFINITY);
+    let mut peak = peak;
+    for frame in words[..frames * L::WIDTH].chunks_exact(L::WIDTH) {
+        let a = L::load(frame).abs();
+        let c = L::select(L::mask_and(a.ge(lo), a.lt(hi)), a, L::zero());
+        peak = L::max(c, peak);
+    }
+    peak
+}
