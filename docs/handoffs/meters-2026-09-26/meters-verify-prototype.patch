+// ---- microbenchmark (direction only) ----
+#[test]
+#[ignore]
+fn bench_per_bank() {
+    use std::hint::black_box;
+    use std::time::Instant;
+    fn run<L: Lane>(period: u32, metrics: MeterMetricSet, rounds: usize) -> (f64, f64) {
+        let w = L::WIDTH;
+        let frames = 128;
+        let mut left = vec![0.0f32; frames * w];
+        let mut right = vec![0.0f32; frames * w];
+        for (i, x) in left.iter_mut().enumerate() {
+            *x = 0.5 * ((i as f32) * 0.013).sin();
+        }
+        for (i, x) in right.iter_mut().enumerate() {
+            *x = 0.4 * ((i as f32) * 0.017).cos();
+        }
+        let mut a: Vec<PreparedMeter> = (0..w)
+            .map(|l| meter(metrics, period, 0, 0.0, l as u64 + 1))
+            .collect();
+        let mut b: Vec<PreparedMeter> = (0..w)
+            .map(|l| meter(metrics, period, 0, 0.0, l as u64 + 1))
+            .collect();
+        let mut ta = Vec::with_capacity(rounds);
+        let mut tb = Vec::with_capacity(rounds);
+        let mut sample = 0u64;
+        const INNER: usize = 64;
+        for _ in 0..rounds {
+            let t = Instant::now();
+            for k in 0..INNER {
+                for lane in 0..w {
+                    let input =
+                        MeterInput::strided(black_box(&left), black_box(&right), frames, w, lane)
+                            .unwrap();
+                    a[lane].accumulator.observe_input(input, sample + (k * frames) as u64).unwrap();
+                }
+            }
+            ta.push(t.elapsed().as_nanos() as f64 / INNER as f64);
+            let t = Instant::now();
+            for k in 0..INNER {
+                let pl = meter_sample_peak_block::<L>(black_box(&left), frames, L::zero());
+                let pr = meter_sample_peak_block::<L>(black_box(&right), frames, L::zero());
+                let mut peaks = [[0.0f32; 8]; 2];
+                pl.store(&mut peaks[0]);
+                pr.store(&mut peaks[1]);
+                for lane in 0..w {
+                    let input =
+                        MeterInput::strided(black_box(&left), black_box(&right), frames, w, lane)
+                            .unwrap();
+                    b[lane]
+                        .accumulator
+                        .observe_input_with_block_peak(
+                            input,
+                            sample + (k * frames) as u64,
+                            Some([peaks[0][lane], peaks[1][lane]]),
+                        )
+                        .unwrap();
+                }
+            }
+            tb.push(t.elapsed().as_nanos() as f64 / INNER as f64);
+            sample += (INNER * frames) as u64;
+            for m in a.iter_mut().chain(b.iter_mut()) {
+                while m.consumer.try_pop().is_ok() {}
+            }
+        }
+        ta.sort_by(|x, y| x.partial_cmp(y).unwrap());
+        tb.sort_by(|x, y| x.partial_cmp(y).unwrap());
+        (ta[ta.len() / 2], tb[tb.len() / 2])
+    }
+    for (name, (a, b)) in [
+        ("Simd8 SAMPLE_PEAK period 1536", run::<Simd8>(1536, MeterMetricSet::SAMPLE_PEAK, 3000)),
+        ("Simd8 SAMPLE_PEAK period 512", run::<Simd8>(512, MeterMetricSet::SAMPLE_PEAK, 3000)),
+        ("Simd4 SAMPLE_PEAK period 1536", run::<Simd4>(1536, MeterMetricSet::SAMPLE_PEAK, 3000)),
+        ("Simd8 ALL period 512 (pass wasted)", run::<Simd8>(512, MeterMetricSet::ALL, 3000)),
+    ] {
+        eprintln!("{name}: scalar {a:.0} ns/bank/block, pass+merge {b:.0} ns/bank/block, ratio {:.2}x", a / b);
+    }
+}
