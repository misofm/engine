@@ -0,0 +1,558 @@
+//! Throwaway verification harness for issue #943 (not for commit).
+#![allow(clippy::all, clippy::pedantic, missing_docs)]
+
+use builtins::{
+    BuiltinResetKind, MeterAccumulator, MeterConfig, MeterHandle, MeterInput, MeterMetricSet,
+    MeterSnapshot, PreparedMeter,
+};
+use lane::{Lane, Simd4, Simd8};
+use std::num::{NonZeroU32, NonZeroU64, NonZeroUsize};
+
+// ---- the brief's kernel, verbatim order ----
+#[inline(always)]
+fn meter_sample_peak_block<L: Lane>(words: &[f32], frames: usize, peak: L) -> L {
+    debug_assert!(words.len() >= frames * L::WIDTH);
+    let mut peak = peak;
+    for f in 0..frames {
+        let a = L::load(&words[f * L::WIDTH..]).abs();
+        let c = L::select(
+            L::mask_and(
+                a.ge(L::splat(f32::MIN_POSITIVE)),
+                a.lt(L::splat(f32::INFINITY)),
+            ),
+            a,
+            L::zero(),
+        );
+        peak = L::max(c, peak);
+    }
+    peak
+}
+
+#[inline(always)]
+fn sanitize<L: Lane>(x: L) -> L {
+    let a = x.abs();
+    L::select(
+        L::mask_and(
+            a.ge(L::splat(f32::MIN_POSITIVE)),
+            a.lt(L::splat(f32::INFINITY)),
+        ),
+        a,
+        L::zero(),
+    )
+}
+
+/// The scalar meter, as written in `observe_selected_segment`: sanitize, then abs.
+fn meter_oracle(x: f32) -> f32 {
+    let s = if x.is_finite() && !x.is_subnormal() { x } else { 0.0 };
+    s.abs()
+}
+
+fn to_vec<L: Lane>(v: L) -> Vec<f32> {
+    let mut out = vec![0.0f32; L::WIDTH];
+    v.store(&mut out);
+    out
+}
+
+fn exhaustive<L: Lane>() -> (u64, u64) {
+    let w = L::WIDTH as u64;
+    let mut buf = vec![0.0f32; L::WIDTH];
+    let mut out = vec![0.0f32; L::WIDTH];
+    let mut mismatches = 0u64;
+    let mut checked = 0u64;
+    let mut base: u64 = 0;
+    while base <= u32::MAX as u64 {
+        for i in 0..L::WIDTH {
+            buf[i] = f32::from_bits((base + i as u64) as u32);
+        }
+        let c = sanitize(L::load(&buf));
+        c.store(&mut out);
+        for i in 0..L::WIDTH {
+            let want = meter_oracle(buf[i]);
+            if out[i].to_bits() != want.to_bits() {
+                mismatches += 1;
+                if mismatches < 5 {
+                    eprintln!(
+                        "mismatch w={} x={:#010x} got={:#010x} want={:#010x}",
+                        L::WIDTH,
+                        buf[i].to_bits(),
+                        out[i].to_bits(),
+                        want.to_bits()
+                    );
+                }
+            }
+            checked += 1;
+        }
+        base += w;
+    }
+    (checked, mismatches)
+}
+
+#[test]
+#[ignore]
+fn exhaustive_sanitization_equals_normal_or_zero_on_every_bit_pattern() {
+    let h8 = std::thread::spawn(exhaustive::<Simd8>);
+    let h4 = std::thread::spawn(exhaustive::<Simd4>);
+    let h1 = std::thread::spawn(exhaustive::<f32>);
+    for (name, h) in [("Simd8", h8), ("Simd4", h4), ("f32", h1)] {
+        let (checked, mismatches) = h.join().unwrap();
+        eprintln!("{name}: checked {checked} patterns, mismatches {mismatches}");
+        assert_eq!(checked, 1u64 << 32);
+        assert_eq!(mismatches, 0);
+    }
+}
+
+// ---- hostile value pool ----
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 << 13;
+        self.0 ^= self.0 >> 7;
+        self.0 ^= self.0 << 17;
+        self.0
+    }
+    fn below(&mut self, n: usize) -> usize {
+        (self.next() % n as u64) as usize
+    }
+}
+
+fn pool() -> Vec<f32> {
+    let mut v = vec![
+        f32::NAN,
+        -f32::NAN,
+        f32::from_bits(0x7FC0_0001),
+        f32::from_bits(0xFF80_0001),
+        f32::from_bits(0x7F80_0001),
+        f32::INFINITY,
+        f32::NEG_INFINITY,
+        0.0,
+        -0.0,
+        f32::from_bits(1),
+        f32::from_bits(0x8000_0001),
+        f32::from_bits(0x007F_FFFF),
+        f32::from_bits(0x807F_FFFF),
+        f32::MIN_POSITIVE,
+        -f32::MIN_POSITIVE,
+        1.0,
+        -1.0,
+        f32::from_bits(0x3F7F_FFFF),
+        f32::from_bits(0x3F80_0001),
+        f32::MAX,
+        -f32::MAX,
+        1.0e30,
+        -1.0e30,
+        1.0e38,
+    ];
+    for k in -34..=5 {
+        v.push((2.0f32).powi(k));
+        v.push(-(2.0f32).powi(k));
+    }
+    v
+}
+
+fn fill(rng: &mut Rng, pool: &[f32], words: &mut [f32], hostile: bool, phase: f32) {
+    let n = words.len();
+    for (i, w) in words.iter_mut().enumerate() {
+        if hostile && rng.below(3) != 0 {
+            *w = pool[rng.below(pool.len())];
+        } else if hostile {
+            // random bit pattern
+            *w = f32::from_bits(rng.next() as u32);
+        } else {
+            let lane = (i % 8) as f32;
+            *w = (0.3 + 0.05 * lane) * ((i as f32 + phase) * (0.01 + 0.002 * lane)).sin();
+        }
+    }
+    let _ = n;
+}
+
+fn serial_peak(words: &[f32], frames: usize, stride: usize, lane: usize, mut p: f32) -> f32 {
+    for f in 0..frames {
+        let x = words[f * stride + lane];
+        let s = if x.is_finite() && !x.is_subnormal() { x } else { 0.0 };
+        let a = s.abs();
+        p = if a > p { a } else { p };
+    }
+    p
+}
+
+fn deinterleave(words: &[f32], frames: usize, stride: usize, lane: usize) -> Vec<f32> {
+    (0..frames).map(|f| words[f * stride + lane]).collect()
+}
+
+fn kernel_identity<L: Lane>(seed: u64) -> u64 {
+    let pool = pool();
+    let mut rng = Rng(seed);
+    let w = L::WIDTH;
+    let mut compared = 0;
+    for &frames in &[1usize, 2, 3, 127, 128, 129] {
+        for hostile in [true, false] {
+            let mut carried = L::zero();
+            let mut carried_serial = vec![0.0f32; w];
+            let mut carried_scalar = vec![0.0f32; w];
+            let mut window_merge = vec![0.0f32; w];
+            for block in 0..64 {
+                let mut words = vec![0.0f32; frames * w];
+                fill(&mut rng, &pool, &mut words, hostile, block as f32 * 7.0);
+                carried = meter_sample_peak_block::<L>(&words, frames, carried);
+                let partial = to_vec(meter_sample_peak_block::<L>(&words, frames, L::zero()));
+                let got = to_vec(carried);
+                for lane in 0..w {
+                    carried_serial[lane] =
+                        serial_peak(&words, frames, w, lane, carried_serial[lane]);
+                    let de = deinterleave(&words, frames, w, lane);
+                    carried_scalar[lane] =
+                        meter_sample_peak_block::<f32>(&de, frames, carried_scalar[lane]);
+                    // F4 reassociation: seeded +0 partial merged with the select form.
+                    let q = partial[lane];
+                    window_merge[lane] =
+                        if q > window_merge[lane] { q } else { window_merge[lane] };
+                    assert_eq!(got[lane].to_bits(), carried_serial[lane].to_bits());
+                    assert_eq!(got[lane].to_bits(), carried_scalar[lane].to_bits());
+                    assert_eq!(window_merge[lane].to_bits(), carried_serial[lane].to_bits());
+                    compared += 1;
+                }
+            }
+        }
+    }
+    // A lane fed only invalid values ends at +0.0.
+    let invalid = [f32::NAN, f32::INFINITY, -0.0, f32::from_bits(1), f32::from_bits(0x807F_FFFF)];
+    let mut words = vec![0.0f32; 128 * w];
+    for (i, x) in words.iter_mut().enumerate() {
+        *x = invalid[i % invalid.len()];
+    }
+    let r = to_vec(meter_sample_peak_block::<L>(&words, 128, L::zero()));
+    for lane in 0..w {
+        assert_eq!(r[lane].to_bits(), 0);
+    }
+    compared
+}
+
+#[test]
+fn g1_kernel_identity_and_reassociation() {
+    let a = kernel_identity::<Simd8>(0x9E37_79B9_7F4A_7C15);
+    let b = kernel_identity::<Simd4>(0x1234_5678_9ABC_DEF1);
+    let c = kernel_identity::<f32>(0xDEAD_BEEF_CAFE_F00D);
+    eprintln!("kernel identity: compared {a} (Simd8) {b} (Simd4) {c} (f32) lane-blocks");
+}
+
+/// Domain argument, witnessed: select-max is associative/commutative on {+0} U [MIN_POSITIVE, MAX]
+/// but NOT once -0.0 or NaN enter; the sanitizer is what makes the reassociation exact.
+#[test]
+fn select_max_associativity_domain() {
+    let m = |a: f32, b: f32| if a > b { a } else { b };
+    let mut d: Vec<f32> = pool()
+        .into_iter()
+        .map(meter_oracle)
+        .collect();
+    d.push(0.0);
+    d.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    d.dedup_by(|a, b| a.to_bits() == b.to_bits());
+    for &a in &d {
+        for &b in &d {
+            assert_eq!(m(a, b).to_bits(), m(b, a).to_bits());
+            for &c in &d {
+                assert_eq!(m(m(a, b), c).to_bits(), m(a, m(b, c)).to_bits());
+            }
+        }
+    }
+    // Outside the domain: -0.0 breaks commutativity (bits), NaN breaks associativity.
+    assert_ne!(m(0.0, -0.0).to_bits(), m(-0.0, 0.0).to_bits());
+    // NaN: m(m(NaN,2),1) = m(2,1) = 2 but m(NaN, m(2,1)) = m(NaN,2) = 2; m(1, NaN) = NaN vs m(NaN, 1) = 1.
+    assert_ne!(m(1.0, f32::NAN).to_bits(), m(f32::NAN, 1.0).to_bits());
+    eprintln!("domain size {} associative+commutative", d.len());
+}
+
+// ---- accumulator differential ----
+fn meter(metrics: MeterMetricSet, period: u32, hold: u32, decay: f32, h: u64) -> PreparedMeter {
+    MeterAccumulator::prepare_selected(
+        MeterHandle(NonZeroU64::new(h).unwrap()),
+        MeterConfig {
+            period_frames: NonZeroU32::new(period).unwrap(),
+            peak_hold_frames: hold,
+            peak_decay_db_per_second: decay,
+            queue_capacity: NonZeroUsize::new(4096).unwrap(),
+            reset_generation: 0,
+        },
+        48_000,
+        metrics,
+    )
+    .unwrap_or_else(|e| panic!("{e:?}"))
+}
+
+fn snap_bits(s: &MeterSnapshot) -> Vec<u64> {
+    let lane = |l: &builtins::MeterLaneSnapshot| {
+        vec![
+            u64::from(l.sample_peak.to_bits()),
+            l.rms.to_bits(),
+            l.energy.to_bits(),
+            u64::from(l.held_peak.to_bits()),
+            l.clipped_samples,
+            l.sanitized_samples,
+        ]
+    };
+    let mut v = vec![
+        s.handle.0.get(),
+        u64::from(s.present_metrics.bits()),
+        s.reset_generation,
+        s.observation_generation,
+        s.window_sequence,
+        s.start_sample,
+        s.end_sample,
+        u64::from(s.frames),
+        s.cumulative_clipped_samples,
+        s.cumulative_sanitized_samples,
+        s.cumulative_discontinuities,
+        s.cumulative_dropped_snapshots,
+    ];
+    v.extend(lane(&s.left));
+    v.extend(lane(&s.right));
+    v
+}
+
+#[derive(Clone, Copy, Debug)]
+enum Event {
+    Block(usize),
+    Skip(u64),
+    Restart(u64),
+    Reset(bool),
+}
+
+fn run_differential(
+    metrics: MeterMetricSet,
+    period: u32,
+    hold: u32,
+    decay: f32,
+    events: &[Event],
+    hostile: bool,
+    seed: u64,
+) -> (u64, u64) {
+    const W: usize = 8;
+    let pool = pool();
+    let mut rng = Rng(seed);
+    let mut a: Vec<PreparedMeter> = (0..W)
+        .map(|l| meter(metrics, period, hold, decay, l as u64 + 1))
+        .collect();
+    let mut b: Vec<PreparedMeter> = (0..W)
+        .map(|l| meter(metrics, period, hold, decay, l as u64 + 1))
+        .collect();
+    let mut sample = 0u64;
+    let mut snapshots = 0u64;
+    let _ = builtins::verify_fast_merges_take();
+    for (i, ev) in events.iter().enumerate() {
+        match *ev {
+            Event::Block(frames) => {
+                let mut left = vec![0.0f32; frames * W];
+                let mut right = vec![0.0f32; frames * W];
+                fill(&mut rng, &pool, &mut left, hostile, i as f32 * 3.0);
+                fill(&mut rng, &pool, &mut right, hostile, i as f32 * 5.0 + 1.0);
+                let pl = to_vec(meter_sample_peak_block::<Simd8>(&left, frames, Simd8::zero()));
+                let pr = to_vec(meter_sample_peak_block::<Simd8>(&right, frames, Simd8::zero()));
+                for lane in 0..W {
+                    let input = MeterInput::strided(&left, &right, frames, W, lane).unwrap();
+                    a[lane].accumulator.observe_input(input, sample).unwrap();
+                    let input = MeterInput::strided(&left, &right, frames, W, lane).unwrap();
+                    b[lane]
+                        .accumulator
+                        .observe_input_with_block_peak(input, sample, Some([pl[lane], pr[lane]]))
+                        .unwrap();
+                }
+                sample += frames as u64;
+            }
+            Event::Skip(n) => sample += n,
+            Event::Restart(g) => {
+                for lane in 0..W {
+                    a[lane].accumulator.restart_observation(g);
+                    b[lane].accumulator.restart_observation(g);
+                }
+            }
+            Event::Reset(full) => {
+                let k = if full {
+                    BuiltinResetKind::FullToPrepared
+                } else {
+                    BuiltinResetKind::DiscontinuityKeepTargets
+                };
+                for lane in 0..W {
+                    a[lane].accumulator.reset(k);
+                    b[lane].accumulator.reset(k);
+                }
+            }
+        }
+        for lane in 0..W {
+            loop {
+                let x = a[lane].consumer.try_pop().ok();
+                let y = b[lane].consumer.try_pop().ok();
+                match (x, y) {
+                    (None, None) => break,
+                    (Some(x), Some(y)) => {
+                        assert_eq!(
+                            snap_bits(&x),
+                            snap_bits(&y),
+                            "metrics={:?} period={period} event={i} lane={lane}",
+                            metrics.bits()
+                        );
+                        snapshots += 1;
+                    }
+                    (x, y) => panic!(
+                        "snapshot count differs: {:?} vs {:?} (metrics={} period={period} event={i})",
+                        x.map(|s| s.window_sequence),
+                        y.map(|s| s.window_sequence),
+                        metrics.bits()
+                    ),
+                }
+            }
+        }
+    }
+    (snapshots, builtins::verify_fast_merges_take())
+}
+
+#[test]
+fn g2_accumulator_fast_path_is_bit_identical() {
+    let peak = MeterMetricSet::SAMPLE_PEAK;
+    let sets = [
+        peak,
+        MeterMetricSet::ALL,
+        MeterMetricSet::from_bits_retain(peak.bits() | MeterMetricSet::COUNTS.bits()),
+        MeterMetricSet::from_bits_retain(peak.bits() | MeterMetricSet::ENERGY_RMS.bits()),
+        MeterMetricSet::from_bits_retain(peak.bits() | MeterMetricSet::HELD_PEAK.bits()),
+        MeterMetricSet::HELD_PEAK,
+        MeterMetricSet::COUNTS,
+    ];
+    let mut rng = Rng(0x5151_7272_9393_A4A4);
+    let mut total_snaps = 0;
+    let mut total_merges = 0;
+    for &period in &[1u32, 64, 127, 128, 129, 300, 512, 1536, 4096] {
+        for &metrics in &sets {
+            for (hold, decay) in [(0u32, 0.0f32), (7, 0.0), (0, 12.0), (100, 60.0)] {
+                for hostile in [true, false] {
+                    // fixed 128-block stream
+                    let fixed: Vec<Event> = (0..64).map(|_| Event::Block(128)).collect();
+                    let (s, m) =
+                        run_differential(metrics, period, hold, decay, &fixed, hostile, rng.next());
+                    total_snaps += s;
+                    total_merges += m;
+                    if metrics != peak {
+                        assert_eq!(m, 0, "non-SAMPLE_PEAK set must never merge");
+                    }
+                    // random stream with discontinuities, restarts, resets, zero-frame blocks
+                    let mut evs = Vec::new();
+                    for _ in 0..200 {
+                        let r = rng.below(20);
+                        evs.push(match r {
+                            0 => Event::Skip(1 + rng.below(700) as u64),
+                            1 => Event::Restart(rng.next() % 1000),
+                            2 => Event::Reset(rng.below(2) == 0),
+                            3 => Event::Block(0),
+                            _ => Event::Block(
+                                [1usize, 2, 3, 63, 64, 127, 128, 128, 128, 129, 256, 300, 511][
+                                    rng.below(13)
+                                ],
+                            ),
+                        });
+                    }
+                    let (s, m) =
+                        run_differential(metrics, period, hold, decay, &evs, hostile, rng.next());
+                    total_snaps += s;
+                    total_merges += m;
+                    if metrics != peak {
+                        assert_eq!(m, 0);
+                    }
+                }
+            }
+        }
+    }
+    eprintln!("G2 differential: {total_snaps} snapshots bit-identical, {total_merges} fast merges");
+    assert!(total_merges > 0);
+}
