+#[test]
+fn g2_merge_counter_expectations() {
+    let fixed: Vec<Event> = (0..64).map(|_| Event::Block(128)).collect();
+    for (period, expect) in [(512u32, Some(8 * 64u64)), (64, Some(0)), (300, None), (1536, Some(512))] {
+        let (_, m) =
+            run_differential(MeterMetricSet::SAMPLE_PEAK, period, 0, 0.0, &fixed, false, 7);
+        eprintln!("period {period}: {m} merges of {} lane-blocks", 8 * 64);
+        match expect {
+            Some(e) => assert_eq!(m, e),
+            None => assert!(m > 0 && m < 512),
+        }
