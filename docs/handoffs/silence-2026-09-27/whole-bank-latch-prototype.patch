@@ -0,0 +1,206 @@
+//! THROWAWAY silence-research harness (docs/handoffs/silence-2026-09-27). Not for commit as is.
+//!
+//! Run: CARGO_INCREMENTAL=0 taskset -c <cpu> cargo test --release -p console-workload
+//!      --test silence_profile -- --ignored --nocapture --test-threads 1
+#![allow(clippy::disallowed_methods)]
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use console_workload::{PlanConfig, SessionRuntime, Workload};
+use graph::test_only_phase_profile as gp;
+use lane::Backend;
+use rack::test_only_chain_probe as cp;
+
+fn calibrate_ghz() -> f64 {
+    // Dependent scalar f32 add chain without black_box inside the loop body: the loop-carried
+    // `x + d` is one vaddss (3 cycles on Zen 3) per step.
+    let mut best = f64::MAX;
+    for _ in 0..20 {
+        let n = 4_000_000u64;
+        let mut x = black_box(1.0f32);
+        let d = black_box(1.0e-30f32);
+        let t = Instant::now();
+        for _ in 0..n {
+            x += d;
+        }
+        let ns = t.elapsed().as_nanos() as f64;
+        black_box(x);
+        best = best.min(ns / n as f64);
+    }
+    3.0 / best
+}
+
+fn p50(v: &mut [u64]) -> u64 {
+    v.sort_unstable();
+    v[v.len() / 2]
+}
+
+fn time_blocks(rt: &mut SessionRuntime, start: u64, blocks: u64) -> (u64, u64, u64) {
+    let mut v = Vec::with_capacity(blocks as usize);
+    for b in 0..blocks {
+        let t = Instant::now();
+        rt.render(start + b).unwrap();
+        v.push(t.elapsed().as_nanos() as u64);
+    }
+    let min = *v.iter().min().unwrap();
+    let p = p50(&mut v);
+    let p95 = v[v.len() * 95 / 100];
+    (min, p, p95)
+}
+
+const PHASES: [&str; gp::COUNT] = [
+    "enter",
+    "source",
+    "bound",
+    "route",
+    "output",
+    "identity_copy",
+    "identity_alias",
+    "other_op",
+    "bank",
+    "exit",
+];
+const SUB: [&str; cp::COUNT] = [
+    "drain",
+    "decide",
+    "gather",
+    "slot0",
+    "slot1",
+    "slot2",
+    "slot3",
+    "slot4",
+    "slot5",
+    "slot6",
+    "slot7",
+    "scatter+fold",
+    "aux",
+    "members",
+];
+
+fn profile(workload: Workload, backend: Backend, warmup: u64, blocks: u64) {
+    let mut rt = SessionRuntime::build_with_dispatch(workload, PlanConfig::BASELINE, backend);
+    for b in 0..warmup {
+        rt.render(b).unwrap();
+    }
+    let mut t = warmup;
+    println!(
+        "\n=== {} at {:?}: shape {:?} ===",
+        workload.kind(),
+        backend,
+        rt.bank_shape()
+    );
+    for r in 0..3 {
+        let (min, p, p95) = time_blocks(&mut rt, t, blocks);
+        t += blocks;
+        println!("probes off, repeat {r}: min {min} ns  p50 {p} ns  p95 {p95} ns");
+    }
+    gp::reset();
+    gp::enable(true);
+    let (_, p_g, _) = time_blocks(&mut rt, t, blocks);
+    t += blocks;
+    gp::enable(false);
+    let (nanos, nblocks, probes) = gp::snapshot();
+    println!("graph phases (probes on, p50 {p_g} ns, {probes} probes over {nblocks} blocks):");
+    for (i, n) in nanos.iter().enumerate() {
+        if *n > 0 {
+            println!(
+                "  {:>15}: {:>9.1} ns/block",
+                PHASES[i],
+                *n as f64 / nblocks as f64
+            );
+        }
+    }
+    let runs = gp::runs();
+    let runs: Vec<_> = runs
+        .iter()
+        .filter(|(k, n)| *k < gp::COUNT && *n > 0)
+        .map(|(k, n)| format!("{}x{}", n, PHASES[*k]))
+        .collect();
+    println!("  unit runs: {}", runs.join(", "));
+    cp::reset();
+    cp::enable(true);
+    let (_, p_c, _) = time_blocks(&mut rt, t, blocks);
+    cp::enable(false);
+    let (nanos, calls) = cp::snapshot();
+    println!(
+        "chain sub-phases (chain probes on, p50 {p_c} ns, {calls} chain runs = {:.1}/block):",
+        calls as f64 / blocks as f64
+    );
+    let mut total = 0.0;
+    for (i, n) in nanos.iter().enumerate() {
+        let per = *n as f64 / blocks as f64;
+        total += if i == cp::MEMBERS { 0.0 } else { per };
+        if *n > 0 {
+            println!(
+                "  {:>13}: {:>9.1} ns/block  {:>8.1} ns/chain",
+                SUB[i],
+                per,
+                *n as f64 / calls as f64
+            );
+        }
+    }
+    println!("  chain total (excl members): {total:.1} ns/block");
+}
+
+fn or_bits(words: &[f32]) -> u32 {
+    let mut bits = 0_u32;
+    for value in words {
+        bits |= value.to_bits();
+    }
+    bits
+}
+#[inline(always)]
+fn block_is_positive_zero(io: &[f32]) -> bool {
+    let (head, rest) = io.split_at(io.len().min(32));
+    if or_bits(head) != 0 {
+        return false;
+    }
+    for chunk in rest.chunks(128) {
+        if or_bits(chunk) != 0 {
+            return false;
+        }
+    }
+    true
+}
+
+#[test]
+#[ignore = "throwaway silence-research profile"]
+fn silence_profile() {
+    let ghz = calibrate_ghz();
+    println!("calibrated clock (3-cycle dependent vaddss chain): {ghz:.3} GHz");
+    for words in [256usize, 512, 1024] {
+        let block = vec![0.0f32; words];
+        let mut best = f64::MAX;
+        for _ in 0..40 {
+            let t = Instant::now();
+            let mut acc = 0u32;
+            for _ in 0..2000 {
+                acc += u32::from(block_is_positive_zero(black_box(&block)));
+            }
+            black_box(acc);
+            best = best.min(t.elapsed().as_nanos() as f64 / 2000.0);
+        }
+        println!("block_is_positive_zero({words} words, silent): {best:.1} ns");
+    }
+    let only = std::env::var("SILENCE_ONLY").ok();
+    let run = |name: &str| only.as_deref().is_none_or(|o| o == name);
+    if run("idle8") {
+        profile(Workload::SixtyFourTrackIdle, Backend::Simd8, 512, 4000);
+    }
+    if run("idle4") {
+        profile(Workload::SixtyFourTrackIdle, Backend::Simd4, 512, 4000);
+    }
+    if run("console8") {
+        profile(Workload::SixtyFourTrackConsole, Backend::Simd8, 64, 4000);
+    }
+    if run("console4") {
+        profile(Workload::SixtyFourTrackConsole, Backend::Simd4, 64, 4000);
+    }
+    if run("builtins8") {
+        profile(Workload::SixtyFourTrackBuiltinsOnly, Backend::Simd8, 512, 2000);
+    }
+    if run("ring8") {
+        profile(Workload::SixtyFourTrackGainPanRing, Backend::Simd8, 64, 2000);
+    }
+}
