+/// All tracks silent for `quiet` blocks, then all live for `loud` blocks, repeated.
+fn downbeats(quiet: usize, loud: usize, cycles: usize) -> Pattern {
+    let blocks = (quiet + loud) * cycles;
+    let mut live = vec![0u8; 64 * blocks];
+    for track in 0..64 {
+        for cycle in 0..cycles {
+            let start = cycle * (quiet + loud) + quiet;
+            live[track * blocks + start..track * blocks + start + loud].fill(1);
+        }
+    }
+    Pattern {
+        blocks,
+        live,
+        order: (0..64).collect(),
+    }
+}
