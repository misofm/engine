+/// Chunk-interleaved A/B over a long pattern: both arms advance through the same blocks, 500 at a
+/// time, alternating which arm goes first, so host drift lands on both arms equally.
+fn ab_interleaved(label: &str, workload: Workload, backend: Backend, pattern: impl Fn() -> Pattern, blocks: u64) {
+    let mut runtimes = [build(workload, backend, pattern()), build(workload, backend, pattern())];
+    let mut times: [Vec<u64>; 2] = [Vec::with_capacity(blocks as usize), Vec::with_capacity(blocks as usize)];
+    let mut skips = [0u64; 2];
+    let chunk = 500u64;
+    let mut start = 0u64;
+    let mut flip = false;
+    while start < blocks {
+        let end = (start + chunk).min(blocks);
+        let order = if flip { [1usize, 0] } else { [0usize, 1] };
+        for arm in order {
+            knob::set_declined(arm == 0);
+            knob::reset();
+            for b in start..end {
+                let t = Instant::now();
+                runtimes[arm].render(b).unwrap();
+                times[arm].push(t.elapsed().as_nanos() as u64);
+            }
+            skips[arm] += knob::counts().0;
+        }
+        flip = !flip;
+        start = end;
+    }
+    knob::set_declined(false);
+    for arm in 0..2 {
+        let v = &mut times[arm];
+        let mean = v.iter().sum::<u64>() as f64 / v.len() as f64;
+        println!(
+            "{label:>44} {backend:?} {:>8}: mean {:>9.0} ns  p50 {:>8} ns  p95 {:>8} ns  p99 {:>8} ns  max {:>8} ns  skips/block {:.2}",
+            if arm == 0 { "declined" } else { "latched" },
+            mean,
+            p(v, 0.5),
+            p(v, 0.95),
+            p(v, 0.99),
+            p(v, 1.0),
+            skips[arm] as f64 / blocks as f64
+        );
+    }
+}
