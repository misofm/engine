diff --git a/crates/parametric-eq/tests/silence_snapshot_cost.rs b/crates/parametric-eq/tests/silence_snapshot_cost.rs
new file mode 100644
index 00000000..9349e592
--- /dev/null
+++ b/crates/parametric-eq/tests/silence_snapshot_cost.rs
@@ -0,0 +1,100 @@
+#![allow(clippy::disallowed_methods)]
+//! THROWAWAY silence-research timing (not for commit): the cost of the generic slot latch's state
+//! comparison on a W8 EQ bank -- eight `snapshot_track_state_payload` calls into preallocated
+//! buffers plus a byte compare -- against one `process_bank` on silence and on tone.
+
+mod support;
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use effect_contract::{
+    BankWidth, EffectBankProcessBlock, NativeEffectFactory, PrepareEffectBankRequest,
+    StatePayloadOutput, StatePayloadSizes,
+};
+use lane::Backend;
+use parametric_eq::ParametricEqFactory;
+use support::{COMMON_BYTES, LANE_BYTES, request, values};
+
+#[test]
+#[ignore = "throwaway silence-research timing"]
+fn eq_bank_snapshot_cost() {
+    let backend = Backend::current();
+    let width = BankWidth::for_backend(backend).expect("native width");
+    let lanes = width.lanes() as usize;
+    let prepared: Vec<_> = (0..lanes).map(|_| values()).collect();
+    let requests: Vec<_> = prepared.iter().map(|v| request(v, false)).collect();
+    let mut bank = ParametricEqFactory
+        .bind_homogeneous_bank(PrepareEffectBankRequest {
+            backend,
+            width,
+            requests: &requests,
+        })
+        .unwrap()
+        .unwrap();
+    let sizes = StatePayloadSizes {
+        common_bytes: COMMON_BYTES as u32,
+        left_bytes: LANE_BYTES as u32,
+        right_bytes: LANE_BYTES as u32,
+    };
+    let per_track = COMMON_BYTES + 2 * LANE_BYTES;
+    let mut before = vec![0u8; per_track * lanes];
+    let mut after = vec![0u8; per_track * lanes];
+    let offsets = vec![0_u32; lanes + 1];
+    let mut left = vec![0.0f32; 128 * lanes];
+    let mut right = vec![0.0f32; 128 * lanes];
+    let snap = |bank: &dyn effect_contract::PreparedNativeEffectBank, out: &mut [u8]| {
+        for (track, chunk) in out.chunks_exact_mut(per_track).enumerate() {
+            let (common, rest) = chunk.split_at_mut(COMMON_BYTES);
+            let (l, r) = rest.split_at_mut(LANE_BYTES);
+            bank.snapshot_track_state_payload(
+                track as u32,
+                StatePayloadOutput::new(common, l, r, sizes).unwrap(),
+            )
+            .unwrap();
+        }
+    };
+    let mut best = [f64::MAX; 3];
+    for _ in 0..30 {
+        let t = Instant::now();
+        for _ in 0..200 {
+            snap(&*bank, &mut before);
+            snap(&*bank, &mut after);
+            black_box(before == after);
+        }
+        best[0] = best[0].min(t.elapsed().as_nanos() as f64 / 200.0);
+        let t = Instant::now();
+        for i in 0..200 {
+            left.fill(0.0);
+            right.fill(0.0);
+            bank.process_bank(
+                EffectBankProcessBlock::new(
+                    &mut left, &mut right, None, 128, width, i * 128, &[], &offsets, 128,
+                )
+                .unwrap(),
+            );
+        }
+        best[1] = best[1].min(t.elapsed().as_nanos() as f64 / 200.0);
+        let t = Instant::now();
+        for i in 0..200 {
+            for (k, (l, r)) in left.iter_mut().zip(right.iter_mut()).enumerate() {
+                *l = ((k as f32) * 0.01).sin() * 0.3;
+                *r = -*l;
+            }
+            bank.process_bank(
+                EffectBankProcessBlock::new(
+                    &mut left, &mut right, None, 128, width, i * 128, &[], &offsets, 128,
+                )
+                .unwrap(),
+            );
+        }
+        best[2] = best[2].min(t.elapsed().as_nanos() as f64 / 200.0);
+    }
+    println!(
+        "EQ W{lanes}: payload {} B/bank; two snapshots + compare {:.0} ns; process_bank silent-settled {:.0} ns; process_bank tone (+ fill) {:.0} ns",
+        per_track * lanes,
+        best[0],
+        best[1],
+        best[2]
+    );
+}
