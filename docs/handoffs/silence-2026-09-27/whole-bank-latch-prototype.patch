+
+/// `true` when every word of `words` is exactly `+0.0` (#942's shape).
+#[inline(always)]
+pub fn words_are_positive_zero(words: &[f32]) -> bool {
+    #[inline]
+    fn or_bits(words: &[f32]) -> u32 {
+        let mut bits = 0_u32;
+        for value in words {
+            bits |= value.to_bits();
+        }
+        bits
+    }
+    let (head, rest) = words.split_at(words.len().min(32));
+    if or_bits(head) != 0 {
+        return false;
+    }
+    for chunk in rest.chunks(128) {
+        if or_bits(chunk) != 0 {
+            return false;
+        }
+    }
+    true
+}
