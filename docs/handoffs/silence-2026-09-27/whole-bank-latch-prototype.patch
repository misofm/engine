+/// THROWAWAY silence-research probe (not for commit): sub-phase timing inside a bank chain.
+#[doc(hidden)]
+pub mod test_only_chain_probe {
+    use core::cell::Cell;
+    use std::time::Instant;
+    pub const DRAIN: usize = 0;
+    pub const DECIDE: usize = 1;
+    pub const GATHER: usize = 2;
+    pub const SLOT0: usize = 3;
+    pub const SCATTER: usize = 11;
+    pub const AUX: usize = 12;
+    pub const MEMBERS: usize = 13;
+    pub const COUNT: usize = 14;
+    thread_local! {
+        static ENABLED: Cell<bool> = const { Cell::new(false) };
+        static NANOS: Cell<[u64; COUNT]> = const { Cell::new([0; COUNT]) };
+        static CALLS: Cell<u64> = const { Cell::new(0) };
+    }
+    pub fn enable(on: bool) { ENABLED.with(|v| v.set(on)); }
+    pub fn enabled() -> bool { ENABLED.with(Cell::get) }
+    pub fn reset() { NANOS.with(|v| v.set([0; COUNT])); CALLS.with(|v| v.set(0)); }
+    pub fn snapshot() -> ([u64; COUNT], u64) { (NANOS.with(Cell::get), CALLS.with(Cell::get)) }
+    pub fn add(phase: usize, nanos: u64) { NANOS.with(|v| { let mut a = v.get(); a[phase] += nanos; v.set(a); }); }
+    pub struct Probe { last: Instant, nanos: [u64; COUNT] }
+    impl Probe {
+        #[inline]
+        pub fn start() -> Option<Self> {
+            ENABLED.with(Cell::get).then(|| Self { last: Instant::now(), nanos: [0; COUNT] })
+        }
+        #[inline]
+        pub fn lap(&mut self, phase: usize) {
+            let now = Instant::now();
+            self.nanos[phase] += now.duration_since(self.last).as_nanos() as u64;
+            self.last = now;
+        }
+        pub fn finish(self) {
+            NANOS.with(|v| { let mut a = v.get(); for (x, y) in a.iter_mut().zip(self.nanos) { *x += y; } v.set(a); });
+            CALLS.with(|v| v.set(v.get() + 1));
+        }
+    }
+}
