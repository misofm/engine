+/// The silence-to-dense transition: the first loud block after a long silence, both arms, the
+/// arms alternating which renders a cycle first.
+#[test]
+#[ignore = "throwaway silence-research prototype"]
+fn silence_proto_downbeat() {
+    let (quiet, loud, cycles) = (4000usize, 64usize, 6usize);
+    for workload in [Workload::SixtyFourTrackConsole, Workload::SixtyFourTrackBuiltinsOnly] {
+        let mut runtimes = [
+            build(workload, Backend::Simd8, downbeats(quiet, loud, cycles)),
+            build(workload, Backend::Simd8, downbeats(quiet, loud, cycles)),
+        ];
+        let mut first: [Vec<u64>; 2] = [Vec::new(), Vec::new()];
+        let mut steady: [Vec<u64>; 2] = [Vec::new(), Vec::new()];
+        let mut last_quiet: [Vec<u64>; 2] = [Vec::new(), Vec::new()];
+        for cycle in 0..cycles {
+            let base = (cycle * (quiet + loud)) as u64;
+            let order = if cycle % 2 == 0 { [0usize, 1] } else { [1, 0] };
+            for arm in order {
+                knob::set_declined(arm == 0);
+                for b in 0..(quiet + loud) as u64 {
+                    let t = Instant::now();
+                    runtimes[arm].render(base + b).unwrap();
+                    let ns = t.elapsed().as_nanos() as u64;
+                    let pos = b as usize;
+                    if pos == quiet {
+                        first[arm].push(ns);
+                    } else if pos > quiet + 8 {
+                        steady[arm].push(ns);
+                    } else if pos + 1 == quiet {
+                        last_quiet[arm].push(ns);
+                    }
+                }
+            }
+        }
+        knob::set_declined(false);
+        for arm in 0..2 {
+            let label = if arm == 0 { "declined" } else { "latched" };
+            let lq = p(&mut last_quiet[arm], 0.5);
+            let f50 = p(&mut first[arm], 0.5);
+            let fmax = p(&mut first[arm], 1.0);
+            let st = p(&mut steady[arm], 0.5);
+            println!(
+                "{:>34} {label:>8}: last quiet block median {lq:>7} ns; first loud block median {f50:>7} max {fmax:>7} ns; steady loud p50 {st:>7} ns",
+                workload.kind(),
+            );
+        }
+    }
+}
