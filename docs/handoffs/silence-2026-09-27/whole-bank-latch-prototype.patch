+/// THROWAWAY silence-research prototype knobs (not for commit).
+#[doc(hidden)]
+pub mod test_only_silence {
+    use core::cell::Cell;
+    thread_local! {
+        static DECLINED: Cell<bool> = const { Cell::new(false) };
+        static SKIPS: Cell<u64> = const { Cell::new(0) };
+        static SEALS: Cell<u64> = const { Cell::new(0) };
