+/// Decompose the latched idle row: full latch, without the limiter advance, without the input
+/// scans, without both (timing only; the last three move cursor bits, never output bits).
+#[test]
+#[ignore = "throwaway silence-research prototype"]
+fn silence_proto_idle_parts() {
+    let mut runtime = build(Workload::SixtyFourTrackIdle, Backend::Simd8, all_silent(4096));
+    for b in 0..512 {
+        runtime.render(b).unwrap();
+    }
+    let mut next = 512u64;
+    for _ in 0..3 {
+        for bits in [0u8, 1, 2, 3] {
+            knob::set_timing_only(bits);
+            let mut v = Vec::with_capacity(4000);
+            for _ in 0..4000 {
+                let t = Instant::now();
+                runtime.render(next).unwrap();
+                next += 1;
+                v.push(t.elapsed().as_nanos() as u64);
+            }
+            println!("idle latched, timing-only bits {bits}: p50 {} ns", p(&mut v, 0.5));
+        }
+    }
+    knob::set_timing_only(0);
+}
