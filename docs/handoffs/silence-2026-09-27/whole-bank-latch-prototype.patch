@@ -0,0 +1,410 @@
+//! THROWAWAY silence-research prototype harness (docs/handoffs/silence-2026-09-27). Not for
+//! commit as is. Two tests:
+//!
+//! * `silence_proto_bits` -- the whole-bank latch renders the declined arm's bits on every block,
+//!   over idle, static-sparse, synthetic-transition and dogfood patterns;
+//! * `silence_proto_timing` -- A/B timings (run under the shared timing lock).
+#![allow(clippy::disallowed_methods)]
+
+use std::sync::Arc;
+use std::time::Instant;
+
+use bench_support::digest::Sha256Sink;
+use console_workload::proto_pattern::{self, Pattern};
+use console_workload::{PlanConfig, SessionRuntime, Workload};
+use lane::Backend;
+use rack::test_only_silence as knob;
+
+const SCRATCH: &str = "/tmp/claude-1002/-home-bl-misofm-engine/43895396-e183-427f-b08f-a0b72f15ae5f/scratchpad/stemsilence";
+const DOGFOOD_BLOCKS: usize = 48_895;
+
+fn dogfood(order_file: Option<&str>) -> Pattern {
+    let live = std::fs::read(format!("{SCRATCH}/pattern64.bin")).expect("pattern64.bin");
+    assert_eq!(live.len(), 64 * DOGFOOD_BLOCKS);
+    let order = match order_file {
+        None => (0..64).collect(),
+        Some(name) => std::fs::read_to_string(format!("{SCRATCH}/{name}"))
+            .expect("order file")
+            .trim()
+            .split(',')
+            .map(|t| t.parse().unwrap())
+            .collect(),
+    };
+    Pattern {
+        blocks: DOGFOOD_BLOCKS,
+        live,
+        order,
+    }
+}
+
+/// Every track silent.
+fn all_silent(blocks: usize) -> Pattern {
+    Pattern {
+        blocks,
+        live: vec![0; 64 * blocks],
+        order: (0..64).collect(),
+    }
+}
+
+/// Tracks 0..16 live, 16..64 silent: banks 2..8 silent at width 8.
+fn static_sparse(blocks: usize) -> Pattern {
+    let mut live = vec![0; 64 * blocks];
+    for track in 0..16 {
+        live[track * blocks..(track + 1) * blocks].fill(1);
+    }
+    Pattern {
+        blocks,
+        live,
+        order: (0..64).collect(),
+    }
+}
+
+/// Deterministic on/off runs of different lengths per track, including long silences so every
+/// bank settles, latches and is released by a downbeat on which many tracks enter together.
+fn transitions(blocks: usize) -> Pattern {
+    let mut live = vec![0u8; 64 * blocks];
+    let mut state = 0x9e37_79b9_u32;
+    for track in 0..64 {
+        let mut b = 0;
+        let mut on = track % 3 == 0;
+        while b < blocks {
+            state ^= state << 13;
+            state ^= state >> 17;
+            state ^= state << 5;
+            let run = if on {
+                1 + (state % 40) as usize
+            } else {
+                1 + (state % 900) as usize
+            };
+            if on {
+                for k in b..(b + run).min(blocks) {
+                    live[track * blocks + k] = 1;
+                }
+            }
+            b += run;
+            on = !on;
+        }
+        // A common downbeat every 1,500 blocks.
+        for k in (1500..blocks).step_by(1500) {
+            for j in k..(k + 8).min(blocks) {
+                live[track * blocks + j] = 1;
+            }
+        }
+    }
+    Pattern {
+        blocks,
+        live,
+        order: (0..64).collect(),
+    }
+}
+
+fn build(workload: Workload, backend: Backend, pattern: Pattern) -> SessionRuntime {
+    proto_pattern::set(Some(Arc::new(pattern)));
+    let runtime = SessionRuntime::build_with_dispatch(workload, PlanConfig::BASELINE, backend);
+    proto_pattern::set(None);
+    runtime
+}
+
+fn digest(runtime: &SessionRuntime) -> String {
+    let mut sink = Sha256Sink::new();
+    runtime.hash_output(&mut sink);
+    sink.finish_hex()
+}
+
+fn compare(label: &str, workload: Workload, backend: Backend, pattern: impl Fn() -> Pattern, blocks: u64) {
+    let mut declined = build(workload, backend, pattern());
+    let mut latched = build(workload, backend, pattern());
+    knob::reset();
+    let mut mismatches = 0u64;
+    for block in 0..blocks {
+        knob::set_declined(true);
+        declined.render(block).unwrap();
+        knob::set_declined(false);
+        latched.render(block).unwrap();
+        if digest(&declined) != digest(&latched) {
+            mismatches += 1;
+            if mismatches <= 3 {
+                println!("  {label}: MISMATCH at block {block}");
+            }
+        }
+    }
+    let (skips, seals) = knob::counts();
+    println!(
+        "{label:>40} {:?}: {blocks} blocks, mismatches {mismatches}, chain skips {skips}, seals {seals}",
+        backend
+    );
+    assert_eq!(mismatches, 0, "{label}: the latch moved a bit");
+}
+
+#[test]
+#[ignore = "throwaway silence-research prototype"]
+fn silence_proto_bits() {
+    for workload in [
+        Workload::SixtyFourTrackConsole,
+        Workload::SixtyFourTrackBuiltinsOnly,
+        Workload::SixtyFourTrackEqOnly,
+        Workload::SixtyFourTrackCompressorOnly,
+        Workload::SixtyFourTrackGainPanOnly,
+    ] {
+        let kind = workload.kind();
+        compare(&format!("{kind} all-silent"), workload, Backend::Simd8, || all_silent(4096), 1024);
+        compare(&format!("{kind} static-sparse"), workload, Backend::Simd8, || static_sparse(4096), 1024);
+        compare(&format!("{kind} transitions"), workload, Backend::Simd8, || transitions(6000), 6000);
+        compare(&format!("{kind} dogfood[0..8000]"), workload, Backend::Simd8, || dogfood(None), 8000);
+    }
+    compare(
+        "idle row (its own silent sources)",
+        Workload::SixtyFourTrackIdle,
+        Backend::Simd8,
+        || all_silent(4096),
+        1024,
+    );
+    compare(
+        "builtins_only transitions (Simd4)",
+        Workload::SixtyFourTrackBuiltinsOnly,
+        Backend::Simd4,
+        || transitions(6000),
+        6000,
+    );
+}
+
+fn p(v: &mut [u64], q: f64) -> u64 {
+    v.sort_unstable();
+    v[((v.len() - 1) as f64 * q) as usize]
+}
+
+/// Interleaved A/B: `repeats` x (declined pass, latched pass) of `blocks` blocks from `start`.
+fn ab(label: &str, workload: Workload, backend: Backend, pattern: impl Fn() -> Pattern, warmup: u64, blocks: u64, repeats: usize) {
+    let mut declined = build(workload, backend, pattern());
+    let mut latched = build(workload, backend, pattern());
+    knob::set_declined(true);
+    for b in 0..warmup {
+        declined.render(b).unwrap();
+    }
+    knob::set_declined(false);
+    for b in 0..warmup {
+        latched.render(b).unwrap();
+    }
+    let mut rows = Vec::new();
+    for _ in 0..repeats {
+        for (arm, runtime) in [(true, &mut declined), (false, &mut latched)] {
+            knob::set_declined(arm);
+            knob::reset();
+            let mut v = Vec::with_capacity(blocks as usize);
+            for b in 0..blocks {
+                let t = Instant::now();
+                runtime.render(warmup + b).unwrap();
+                v.push(t.elapsed().as_nanos() as u64);
+            }
+            let mean = v.iter().sum::<u64>() as f64 / v.len() as f64;
+            let (skips, _) = knob::counts();
+            rows.push((arm, mean, p(&mut v, 0.5), p(&mut v, 0.95), p(&mut v, 1.0), skips));
+        }
+    }
+    knob::set_declined(false);
+    for (arm, mean, p50, p95, max, skips) in rows {
+        println!(
+            "{label:>44} {backend:?} {:>8}: mean {:>9.0} ns  p50 {p50:>8} ns  p95 {p95:>8} ns  max {max:>8} ns  skips/block {:.2}",
+            if arm { "declined" } else { "latched" },
+            mean,
+            skips as f64 / blocks as f64
+        );
+    }
+}
