+/// 64-block digests of every standing workload under each flag set, against flag 0.
+#[test]
+#[ignore = "diagnosis harness"]
+fn digests() {
+    let flags_list = env_flags(&[
+        DIAG_SKIP_GATE,
+        DIAG_SKIP_CHECK,
+        DIAG_SKIP_ZEROTEST,
+        DIAG_NO_PAD,
+        DIAG_NO_PAD | DIAG_UNMASKED,
+        DIAG_PAD_GENERAL | DIAG_UNMASKED,
+    ]);
+    let digest = |workload: Workload, backend: Backend, flags: u32| {
+        set_flags(flags);
+        let mut runtime = build(workload, backend);
+        let mut sink = bench_support::digest::Sha256Sink::new();
+        for block in 0..64 {
+            runtime.render(block).expect("render");
+            runtime.hash_output(&mut sink);
+        }
+        set_flags(0);
+        sink.finish_hex()
+    };
+    let mut mismatches = 0;
+    for backend in [Backend::Scalar, Backend::Simd4, Backend::Simd8] {
+        for workload in WORKLOADS {
+            let base = digest(workload, backend, 0);
+            let mut line = format!(
+                "{:<6} {:<44} {}",
+                backend_name(backend),
+                workload.kind(),
+                &base[..16]
+            );
+            for flags in &flags_list {
+                let other = digest(workload, backend, *flags);
+                if other == base {
+                    line.push_str(" =");
+                } else {
+                    mismatches += 1;
+                    line.push_str(&format!(" DIFF[{}]", flag_name(*flags)));
+                }
+            }
+            println!("{line}");
+        }
+    }
+    println!("mismatches: {mismatches}");
+}
