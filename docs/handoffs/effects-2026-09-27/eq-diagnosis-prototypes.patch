+// node kbench.mjs kbench.wasm : wasm simd128 (V8) kernel replicas, cycles per call at HZ.
+import { readFileSync } from 'node:fs';
+const HZ = Number(process.env.HZ ?? 3.7e9);
+const bytes = readFileSync(process.argv[2]);
+const { instance } = await WebAssembly.instantiate(bytes, {});
+const run = instance.exports.kb_run;
+const CALLS = 20000;
+const W = 4, FRAMES = 128;
+const cases = [
+  [0, 'refresh (two 512-word planes)', 0, 0],
+  [1, 'fixture pass: S2 D2 masked [HPF id dry, bell]', 2, 2],
+  [2, 'S2 D2 unmasked [general id pad, bell]', 2, 2],
+  [3, 'S2 D1 unmasked [bell]', 2, 1],
+  [4, 'S2 D1 masked [bell] (mask clear)', 2, 1],
+  [5, 'skewed S2 D2 masked fixture pass', 2, 2],
+  [6, 'skewed S2 D2 unmasked, 2 live', 2, 2],
+  [7, 'S2 D2 unmasked, 2 live', 2, 2],
+  [12, 'S2 D2 x2 unmasked, 4 live', 2, 4],
+  [11, 'S2 D4 x1 unmasked, 4 live', 2, 4],
+  [8, 'S2 D2 x3 unmasked, 6 live', 2, 6],
+  [9, 'S2 D3 x2 unmasked, 6 live', 2, 6],
+  [10, 'S2 D1 x6 unmasked, 6 live', 2, 6],
+  [20, 'skewed S2 D2 x3 unmasked, 6 live', 2, 6],
+  [13, 'skewed S2 D3 x2 unmasked, 6 live', 2, 6],
+  [16, 'S1 D1 unmasked [bell] (mono)', 1, 1],
+  [17, 'S1 D2 unmasked, 2 live (mono)', 1, 2],
+  [19, 'S1 D2 x3 unmasked, 6 live (mono)', 1, 6],
+  [18, 'S1 D3 x2 unmasked, 6 live (mono)', 1, 6],
+  [14, 'elision gate, two planes', 2, 0],
+  [15, '4.4 boundary scan, two planes', 2, 0],
+  [22, 'elision gate min/max form, two planes', 2, 0],
+  [23, 'S2 D1 unmasked + separate 4.4 scan', 2, 1],
+  [24, 'S2 D1 unmasked with the 4.4 scan fused', 2, 1],
+];
+function time(id) {
+  for (let i = 0; i < 3; i++) run(id, 2000);
+  let best = Infinity;
+  for (let r = 0; r < 3; r++) {
+    const t0 = process.hrtime.bigint();
+    run(id, CALLS);
+    best = Math.min(best, Number(process.hrtime.bigint() - t0) / CALLS);
+  }
+  return best * HZ / 1e9;
+}
+const loadavg = () => readFileSync('/proc/loadavg', 'utf8').trim();
+console.log(`node ${process.version} v8 ${process.versions.v8} loadavg ${loadavg()}`);
+const refresh = time(0);
+for (const [id, name, streams, sections] of cases) {
+  const cycles = time(id);
+  const isScan = id === 14 || id === 15 || id === 22;
+  const net = id === 0 || isScan ? cycles : cycles - (streams === 1 ? refresh : refresh);
+  const ls = FRAMES * W * (streams || 2);
+  let line = `wasm ${name.padEnd(48)} ${cycles.toFixed(0).padStart(7)} cyc/call  net ${net.toFixed(0).padStart(7)}  ${(net / ls).toFixed(3)} cyc/ls`;
+  if (sections) line += `  ${(net / ls / sections).toFixed(3)} cyc/(ls x section)  ${(net / FRAMES / sections * streams / 2).toFixed(1)} cyc per frame per 2 section-chains`;
+  console.log(line);
+}
+console.log(`loadavg ${loadavg()}`);
