+/// The min/max form of `block_admits_elision`: the same predicate, fewer vector operations.
+#[inline]
+#[must_use]
+fn block_admits_elision_minmax(io: &[f32]) -> bool {
+    let mut nearest = u32::MAX;
+    let mut largest = 0_u32;
+    for value in io {
+        let bits = value.to_bits();
+        nearest = nearest.min(bits ^ NEGATIVE_ZERO_BITS);
+        largest = largest.max(bits & MAGNITUDE_MASK);
+    }
+    nearest != 0 && largest <= ELISION_MAGNITUDE_CEILING
+}
