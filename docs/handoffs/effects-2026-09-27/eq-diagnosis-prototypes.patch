+#[test]
+#[ignore = "diagnosis harness"]
+fn skew() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz, loadavg {}", hz / 1e9, loadavg());
+    skew_sweep::<Simd8>(hz);
+    skew_sweep::<Simd4>(hz);
+    println!("loadavg {}", loadavg());
+}
+
+// ---------------------------------------------------------------------------------------------
+// Prototype: the skewed cascade with its `S * D` independent chains interleaved op by op
+// ("vertical"), so the instruction stream itself carries the independence instead of relying on
+// the out-of-order window to find it. Every operation is the `Lane` method `svf_step` and the
+// output mix use, with the same receiver and the same argument, so each chain's arithmetic is
+// the shipped arithmetic.
+
+#[inline(always)]
+fn vertical_step<L: Lane, const N: usize>(
+    x: &[L; N],
+    nc1: &[L; N],
+    c: &[&SvfCoef<L>; N],
+    ic1: &mut [L; N],
+    ic2: &mut [L; N],
+) -> [L; N] {
+    let v3: [L; N] = core::array::from_fn(|n| x[n].sub(ic2[n]));
+    let a2v3: [L; N] = core::array::from_fn(|n| c[n].a2.mul(v3[n]));
+    let d1: [L; N] = core::array::from_fn(|n| nc1[n].mul(ic1[n]).add(a2v3[n]));
+    let v1: [L; N] = core::array::from_fn(|n| ic1[n].add(d1[n]));
+    let a2ic1: [L; N] = core::array::from_fn(|n| c[n].a2.mul(ic1[n]));
+    let d2: [L; N] = core::array::from_fn(|n| c[n].a3.mul(v3[n]).add(a2ic1[n]));
+    let v2: [L; N] = core::array::from_fn(|n| ic2[n].add(d2[n]));
+    let n1: [L; N] = core::array::from_fn(|n| lane::flush(ic1[n].add(d1[n].add(d1[n]))));
+    let n2: [L; N] = core::array::from_fn(|n| lane::flush(ic2[n].add(d2[n].add(d2[n]))));
+    *ic1 = n1;
+    *ic2 = n2;
+    let m0x: [L; N] = core::array::from_fn(|n| c[n].m0.mul(x[n]));
+    let inner: [L; N] = core::array::from_fn(|n| c[n].m1.mul(v1[n]).add(m0x[n]));
+    core::array::from_fn(|n| c[n].m2.mul(v2[n]).add(inner[n]))
+}
+
+/// The skewed, peeled cascade with the chains of one iteration stepped together. Chain `n` is
+/// `(stream, section) = (n / D, n % D)`. Only whole iterations use the vertical step; the short
+/// prologue and epilogue reuse `skewed_peeled`'s per-chain order.
+#[inline(always)]
+fn skewed_vertical<L: Lane, const S: usize, const D: usize, const N: usize, const MASKED: bool>(
+    io: [&mut [f32]; S],
+    frames: usize,
+    c: &[[SvfCoef<L>; D]; S],
+    s: &mut [[SvfState<L>; D]; S],
+    masks: &[[L::Mask; D]; S],
+) {
+    debug_assert_eq!(N, S * D);
+    let w = L::WIDTH;
+    let span = frames * w;
+    let mut io = io.map(|block| &mut block[..span]);
+    let nc1s: [[L; D]; S] = core::array::from_fn(|t| core::array::from_fn(|k| c[t][k].c1.neg()));
+    let nc1: [L; N] = core::array::from_fn(|n| nc1s[n / D][n % D]);
+    let coef: [&SvfCoef<L>; N] = core::array::from_fn(|n| &c[n / D][n % D]);
+    let mask: [L::Mask; N] = core::array::from_fn(|n| masks[n / D][n % D]);
+    let mut ic1: [L; N] = core::array::from_fn(|n| s[n / D][n % D].ic1);
+    let mut ic2: [L; N] = core::array::from_fn(|n| s[n / D][n % D].ic2);
+    let mut carry: [L; N] = [L::zero(); N];
+    // One chain step, used by the prologue and epilogue.
+    macro_rules! single {
+        ($i:expr, $t:expr, $k:expr) => {{
+            let (i, t, k) = ($i, $t, $k);
+            let n = t * D + k;
+            let f = i - k;
+            let x = if k == 0 {
+                L::load(&io[t][f * w..f * w + w])
+            } else {
+                carry[n - 1]
+            };
+            let mut state = SvfState { ic1: ic1[n], ic2: ic2[n] };
+            let wet = section(x, nc1[n], coef[n], &mut state);
+            ic1[n] = state.ic1;
+            ic2[n] = state.ic2;
+            let y = if MASKED { L::select(mask[n], x, wet) } else { wet };
+            if k == D - 1 {
+                y.store(&mut io[t][f * w..f * w + w]);
+            } else {
+                carry[n] = y;
+            }
+        }};
+    }
+    for i in 0..D - 1 {
+        for t in 0..S {
+            for k in (0..=i).rev() {
+                single!(i, t, k);
+            }
+        }
+    }
+    for i in D - 1..frames {
+        let x: [L; N] = core::array::from_fn(|n| {
+            let (t, k) = (n / D, n % D);
+            if k == 0 {
+                L::load(&io[t][i * w..i * w + w])
+            } else {
+                carry[n - 1]
+            }
+        });
+        let wet = vertical_step::<L, N>(&x, &nc1, &coef, &mut ic1, &mut ic2);
+        let y: [L; N] = core::array::from_fn(|n| {
+            if MASKED { L::select(mask[n], x[n], wet[n]) } else { wet[n] }
+        });
+        for n in 0..N {
+            let (t, k) = (n / D, n % D);
+            if k == D - 1 {
+                let f = i - k;
+                y[n].store(&mut io[t][f * w..f * w + w]);
+            } else {
+                carry[n] = y[n];
+            }
+        }
+    }
+    for i in frames..frames + D - 1 {
+        for t in 0..S {
+            for k in (i + 1 - frames..D).rev() {
+                single!(i, t, k);
+            }
+        }
+    }
+    for n in 0..N {
+        s[n / D][n % D] = SvfState { ic1: ic1[n], ic2: ic2[n] };
+    }
+}
+
+/// Unskewed vertical form (today's frame order, the S streams stepped together per section).
+#[inline(always)]
+fn plain_vertical<L: Lane, const S: usize, const D: usize, const MASKED: bool>(
+    io: [&mut [f32]; S],
+    frames: usize,
+    c: &[[SvfCoef<L>; D]; S],
+    s: &mut [[SvfState<L>; D]; S],
+    masks: &[[L::Mask; D]; S],
+) {
+    let w = L::WIDTH;
+    let span = frames * w;
+    let mut io = io.map(|block| &mut block[..span]);
+    let nc1: [[L; S]; D] = core::array::from_fn(|k| core::array::from_fn(|t| c[t][k].c1.neg()));
+    let mut ic1: [[L; S]; D] = core::array::from_fn(|k| core::array::from_fn(|t| s[t][k].ic1));
+    let mut ic2: [[L; S]; D] = core::array::from_fn(|k| core::array::from_fn(|t| s[t][k].ic2));
+    let coef: [[&SvfCoef<L>; S]; D] = core::array::from_fn(|k| core::array::from_fn(|t| &c[t][k]));
+    for frame in 0..frames {
+        let mut x: [L; S] = core::array::from_fn(|t| L::load(&io[t][frame * w..frame * w + w]));
+        for k in 0..D {
+            let wet = vertical_step::<L, S>(&x, &nc1[k], &coef[k], &mut ic1[k], &mut ic2[k]);
+            x = core::array::from_fn(|t| {
+                if MASKED { L::select(masks[t][k], x[t], wet[t]) } else { wet[t] }
+            });
+        }
+        for t in 0..S {
+            x[t].store(&mut io[t][frame * w..frame * w + w]);
+        }
+    }
+    for t in 0..S {
+        for k in 0..D {
+            s[t][k] = SvfState { ic1: ic1[k][t], ic2: ic2[k][t] };
+        }
+    }
+}
+
+fn vertical_identity<L: Lane, const S: usize, const D: usize, const N: usize, const MASKED: bool>(
+) -> bool {
+    let span = QUANTUM * L::WIDTH;
+    let all_ones = L::zero().eq(L::zero());
+    let none = L::zero().lt(L::zero());
+    let coef: [[SvfCoef<L>; D]; S] = core::array::from_fn(|t| {
+        core::array::from_fn(|k| {
+            if k == 0 && MASKED { identity::<L>() } else { bell::<L>(t, 3 * k + 1) }
+        })
+    });
+    let masks: [[L::Mask; D]; S] = core::array::from_fn(|_| {
+        core::array::from_fn(|k| if k == 0 && MASKED { all_ones } else { none })
+    });
+    let mut s_ref = [[SvfState::<L>::default(); D]; S];
+    let mut s_new = s_ref;
+    let mut s_plain = s_ref;
+    let mut ok = true;
+    for block in 0..40 {
+        let mut a: Vec<Vec<f32>> = (0..S).map(|t| hostile(span, block * 3 + t)).collect();
+        let mut b = a.clone();
+        let mut p = a.clone();
+        {
+            let mut each = a.iter_mut();
+            let io: [&mut [f32]; S] = core::array::from_fn(|_| each.next().unwrap().as_mut_slice());
+            svf_cascade_interleaved_with_dry_masks::<L, S, D>(io, QUANTUM, &coef, &mut s_ref, &masks);
+        }
+        {
+            let mut each = b.iter_mut();
+            let io: [&mut [f32]; S] = core::array::from_fn(|_| each.next().unwrap().as_mut_slice());
+            skewed_vertical::<L, S, D, N, MASKED>(io, QUANTUM, &coef, &mut s_new, &masks);
+        }
+        {
+            let mut each = p.iter_mut();
+            let io: [&mut [f32]; S] = core::array::from_fn(|_| each.next().unwrap().as_mut_slice());
+            plain_vertical::<L, S, D, MASKED>(io, QUANTUM, &coef, &mut s_plain, &masks);
+        }
+        for t in 0..S {
+            ok &= words_equal(&a[t], &b[t]) && words_equal(&a[t], &p[t]);
+        }
+    }
+    ok &= state_bits(&s_ref) == state_bits(&s_new) && state_bits(&s_ref) == state_bits(&s_plain);
+    let tag = core::any::type_name::<L>().rsplit("::").next().unwrap_or("");
+    println!(
+        "{tag:<6} vertical identity S{S} D{D} masked={MASKED}: {}",
+        if ok { "bit-identical" } else { "MISMATCH" }
+    );
+    ok
+}
+
+fn vertical_time<L: Lane, const S: usize, const D: usize, const N: usize, const MASKED: bool, const SKEW: bool>(
+    hz: f64,
+    name: &str,
+    sections: usize,
+) {
+    let span = QUANTUM * L::WIDTH;
+    let all_ones = L::zero().eq(L::zero());
+    let none = L::zero().lt(L::zero());
+    let source: Vec<Vec<f32>> = (0..S).map(|salt| signal(span, salt)).collect();
+    let mut blocks = source.clone();
+    let refresh = time_case(hz, || {
+        for (block, source) in blocks.iter_mut().zip(source.iter()) {
+            block.copy_from_slice(source);
+        }
+        black_box(&mut blocks);
+    });
+    let passes = sections / D;
+    let coef: Vec<[[SvfCoef<L>; D]; S]> = (0..passes)
+        .map(|pass| {
+            core::array::from_fn(|t| {
+                core::array::from_fn(|k| {
+                    if MASKED && pass == 0 && k == 0 {
+                        identity::<L>()
+                    } else {
+                        bell::<L>(t, 3 * (pass * D + k) + 1)
+                    }
+                })
+            })
+        })
+        .collect();
+    let masks: [[L::Mask; D]; S] = core::array::from_fn(|_| {
+        core::array::from_fn(|k| if MASKED && k == 0 { all_ones } else { none })
+    });
+    let mut state = vec![[[SvfState::<L>::default(); D]; S]; passes];
+    let cycles = time_case(hz, || {
+        for (block, source) in blocks.iter_mut().zip(source.iter()) {
+            block.copy_from_slice(source);
+        }
+        for pass in 0..passes {
+            let mut each = blocks.iter_mut();
+            let io: [&mut [f32]; S] = core::array::from_fn(|_| each.next().unwrap().as_mut_slice());
+            if SKEW {
+                skewed_vertical::<L, S, D, N, MASKED>(black_box(io), QUANTUM, &coef[pass], &mut state[pass], &masks);
+            } else {
+                plain_vertical::<L, S, D, MASKED>(black_box(io), QUANTUM, &coef[pass], &mut state[pass], &masks);
+            }
+        }
+    });
+    let net = cycles - refresh;
+    let lane_samples = (QUANTUM * L::WIDTH * S) as f64;
+    let tag = core::any::type_name::<L>().rsplit("::").next().unwrap_or("");
+    println!(
+        "{tag:<6} {name:<44} {cycles:>8.0} cyc/call  net {net:>8.0}  {:.3} cyc/lane-sample  {:.3} \
+         cyc/(ls x section)  {:.1} cyc/frame/pass",
+        net / lane_samples,
+        net / lane_samples / sections as f64,
+        net / (QUANTUM * passes) as f64
+    );
+    black_box(&state);
+}
+
+fn vertical_sweep<L: Lane>(hz: f64) {
+    let mut ok = true;
+    ok &= vertical_identity::<L, 2, 2, 4, false>();
+    ok &= vertical_identity::<L, 2, 2, 4, true>();
+    ok &= vertical_identity::<L, 2, 1, 2, false>();
+    ok &= vertical_identity::<L, 2, 3, 6, false>();
+    ok &= vertical_identity::<L, 1, 2, 2, false>();
+    ok &= vertical_identity::<L, 1, 4, 4, false>();
+    assert!(ok);
+    vertical_time::<L, 2, 2, 4, true, true>(hz, "skew+vertical fixture pass D2 masked", 2);
+    vertical_time::<L, 2, 2, 4, false, true>(hz, "skew+vertical 2 live D2 unmasked", 2);
+    vertical_time::<L, 2, 2, 4, false, false>(hz, "plain vertical 2 live D2 unmasked", 2);
+    vertical_time::<L, 2, 2, 4, true, false>(hz, "plain vertical fixture pass D2 masked", 2);
+    vertical_time::<L, 2, 1, 2, false, false>(hz, "plain vertical 1 live D1 unmasked", 1);
+    vertical_time::<L, 2, 3, 6, false, true>(hz, "skew+vertical 6 live D3 unmasked", 6);
+    vertical_time::<L, 2, 2, 4, false, true>(hz, "skew+vertical 6 live D2 unmasked", 6);
+    vertical_time::<L, 1, 2, 2, false, true>(hz, "skew+vertical mono 2 live D2", 2);
+    vertical_time::<L, 1, 4, 4, false, true>(hz, "skew+vertical mono 4 live D4", 4);
+    vertical_time::<L, 1, 1, 1, false, false>(hz, "plain vertical mono 1 live D1", 1);
+}
+
+#[test]
+#[ignore = "diagnosis harness"]
+fn vertical() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz, loadavg {}", hz / 1e9, loadavg());
+    vertical_sweep::<Simd8>(hz);
+    vertical_sweep::<Simd4>(hz);
+    println!("loadavg {}", loadavg());
+}
diff --git a/tools/console-workload/tests/eq_rows.rs b/tools/console-workload/tests/eq_rows.rs
new file mode 100644
index 00000000..f3ff9ad6
--- /dev/null
+++ b/tools/console-workload/tests/eq_rows.rs
@@ -0,0 +1,285 @@
+//! EQ diagnosis: clean-build row timing (no toggles). Diagnosis prototype only; never committed.
+//! Prints `p50` of `sixty_four_track_eq_only` and `sixty_four_track_builtins_only`, interleaved.
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use console_workload::{PlanConfig, QUANTUM, SessionRuntime, Workload};
+use lane::Backend;
+
+fn core_hz() -> f64 {
+    const ADDS: u64 = 300_000_000;
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let mut x = black_box(0.0_f32);
+        let d = black_box(1.0e-3_f32);
+        let start = Instant::now();
+        for _ in 0..ADDS {
+            x += d;
+        }
+        best = best.min(start.elapsed().as_secs_f64());
+        black_box(x);
+    }
+    3.0 * ADDS as f64 / best
+}
+
+fn measure(runtime: &mut SessionRuntime, observation: &mut u64, blocks: usize) -> f64 {
+    let mut samples = Vec::with_capacity(blocks);
+    for _ in 0..blocks {
+        let start = Instant::now();
+        runtime.render(*observation).expect("block");
+        samples.push(start.elapsed().as_nanos() as f64);
+        *observation += 1;
+    }
+    samples.sort_by(f64::total_cmp);
+    samples[blocks / 2]
+}
+
+#[test]
+#[ignore = "diagnosis harness"]
+fn clean_rows() {
+    let hz = core_hz();
+    let mut eq =
+        SessionRuntime::build_with_dispatch(Workload::SixtyFourTrackEqOnly, PlanConfig::BASELINE, Backend::Simd8);
+    let mut builtins = SessionRuntime::build_with_dispatch(
+        Workload::SixtyFourTrackBuiltinsOnly,
+        PlanConfig::BASELINE,
+        Backend::Simd8,
+    );
+    let (mut oe, mut ob) = (0, 0);
+    measure(&mut eq, &mut oe, 1000);
+    measure(&mut builtins, &mut ob, 1000);
+    let mut e = Vec::new();
+    let mut b = Vec::new();
+    for _ in 0..6 {
+        e.push(measure(&mut eq, &mut oe, 1500));
+        b.push(measure(&mut builtins, &mut ob, 1500));
+    }
+    e.sort_by(f64::total_cmp);
+    b.sort_by(f64::total_cmp);
+    let (em, bm) = (e[3], b[3]);
+    println!(
+        "CLEAN eq_only p50 {em:.0} ns, builtins_only p50 {bm:.0} ns, isolate {:.0} ns = {:.3} cyc/ls \
+         at {:.3} GHz; loadavg {}",
+        em - bm,
+        (em - bm) * hz / 1e9 / (64 * QUANTUM * 2) as f64,
+        hz / 1e9,
+        std::fs::read_to_string("/proc/loadavg").unwrap_or_default().trim()
+    );
+}
+
+const NEGATIVE_ZERO_BITS: u32 = 0x8000_0000;
+const MAGNITUDE_MASK: u32 = 0x7fff_ffff;
+const CEILING: u32 = 0x7149_f2ca; // 1.0e30_f32.to_bits()
+
+#[inline(never)]
+fn gate_today(io: &[f32]) -> bool {
+    let mut rejected = 0_u32;
+    for value in io {
+        let bits = value.to_bits();
+        rejected |= u32::from(bits == NEGATIVE_ZERO_BITS);
+        rejected |= u32::from((bits & MAGNITUDE_MASK) > CEILING);
+    }
+    rejected == 0
+}
+
+#[inline(never)]
+fn gate_minmax(io: &[f32]) -> bool {
+    let mut nearest = u32::MAX;
+    let mut largest = 0_u32;
+    for value in io {
+        let bits = value.to_bits();
+        nearest = nearest.min(bits ^ NEGATIVE_ZERO_BITS);
+        largest = largest.max(bits & MAGNITUDE_MASK);
+    }
+    nearest != 0 && largest <= CEILING
+}
+
+#[test]
+#[ignore = "diagnosis harness"]
+fn gate_forms() {
+    assert_eq!(CEILING, 1.0e30_f32.to_bits());
+    // Equivalence on hostile words, then timing on two 1024-word planes.
+    let words: Vec<u32> = [0_u32, 0x8000_0000, 1, 0x8000_0001, CEILING, CEILING + 1, 0x7f80_0000,
+        0xff80_0000, 0x7fc0_0000, 0xffc0_1234, 0x3f80_0000, 0xbf80_0000, CEILING | 0x8000_0000,
+        (CEILING + 1) | 0x8000_0000, u32::MAX, 0x7fff_ffff].to_vec();
+    let mut cases = 0;
+    for a in &words {
+        for b in &words {
+            let block: Vec<f32> = (0..1024).map(|i| f32::from_bits(if i == 17 { *a } else if i == 900 { *b } else { 0x3e80_0000 })).collect();
+            assert_eq!(gate_today(&block), gate_minmax(&block), "{a:08x} {b:08x}");
+            cases += 1;
+        }
+    }
+    let hz = core_hz();
+    let planes: Vec<Vec<f32>> = (0..2).map(|salt| (0..1024).map(|i| (((i * 7 + salt * 13) % 97) as f32 - 48.0) / 96.0).collect()).collect();
+    for (name, gate) in [("today", gate_today as fn(&[f32]) -> bool), ("minmax", gate_minmax as fn(&[f32]) -> bool)] {
+        let mut best = f64::MAX;
+        for _ in 0..3 {
+            let start = Instant::now();
+            let mut ok = 0;
+            for _ in 0..20_000 {
+                for plane in &planes {
+                    ok += u32::from(gate(black_box(plane)));
+                }
+            }
+            black_box(ok);
+            best = best.min(start.elapsed().as_secs_f64() / 20_000.0);
+        }
+        println!("GATE {name:<7} {:.0} cycles per two planes = {:.3} cyc/lane-sample ({cases} equivalence cases)", best * hz, best * hz / 2048.0);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Prototype: the 4.4 boundary scan folded into the last section's store (depth 1, S streams).
+
+use lane::kernels::{SvfCoef, SvfState, svf_cascade_interleaved, svf_step};
+use lane::{Lane, Simd4, Simd8};
+
+#[inline(always)]
+fn fused_d1<L: Lane, const S: usize>(
+    io: [&mut [f32]; S],
+    frames: usize,
+    c: &[[SvfCoef<L>; 1]; S],
+    s: &mut [[SvfState<L>; 1]; S],
+) -> [bool; S] {
+    let w = L::WIDTH;
+    let span = frames * w;
+    let io = io.map(|block| &mut block[..span]);
+    let mut state = *s;
+    let nc1: [L; S] = core::array::from_fn(|t| c[t][0].c1.neg());
+    let limit = L::splat(1.0e30);
+    let mut ok: [L::Mask; S] = [L::zero().eq(L::zero()); S];
+    for frame in 0..frames {
+        for t in 0..S {
+            let slot = &mut io[t][frame * w..frame * w + w];
+            let x = L::load(slot);
+            let cf = &c[t][0];
+            let (v1, v2) = svf_step(x, nc1[t], cf.a2, cf.a3, &mut state[t][0]);
+            let y = cf.m2.fma(v2, cf.m1.fma(v1, cf.m0.mul(x)));
+            ok[t] = L::mask_and(ok[t], y.abs().lt(limit));
+            y.store(slot);
+        }
+    }
+    *s = state;
+    core::array::from_fn(|t| !L::mask_any(L::mask_not(ok[t])))
+}
+
+fn check<L: Lane>(io: &[f32]) -> bool {
+    let limit = L::splat(1.0e30);
+    let mut ok = L::zero().eq(L::zero());
+    for frame in io.chunks_exact(L::WIDTH) {
+        ok = L::mask_and(ok, L::load(frame).abs().lt(limit));
+    }
+    !L::mask_any(L::mask_not(ok))
+}
+
+fn bell_coef<L: Lane>(t: usize) -> SvfCoef<L> {
+    let words = |lane: usize| -> [f32; 6] {
+        parametric_eq::design_svf(
+            parametric_eq::EqBandKind::Bell,
+            90.0 + 45.0 * lane as f32 + 20.0 * t as f32,
+            -7.5 + lane as f32,
+            0.5 + 0.15 * lane as f32,
+            1.0,
+            engine::SampleRateHz(48_000),
+        )
+        .expect("bell")
+        .to_array()
+    };
+    let lane = |index: usize| {
+        let values: Vec<f32> = (0..L::WIDTH).map(|l| words(l)[index]).collect();
+        L::load(&values)
+    };
+    SvfCoef { c1: lane(0), a2: lane(1), a3: lane(2), m0: lane(3), m1: lane(4), m2: lane(5) }
+}
+
+fn fused_sweep<L: Lane>(hz: f64) {
+    let span = QUANTUM * L::WIDTH;
+    let source: Vec<Vec<f32>> = (0..2)
+        .map(|salt| (0..span).map(|i| (((i * 7 + salt * 13) % 97) as f32 - 48.0) / 96.0).collect())
+        .collect();
+    let mut blocks = source.clone();
+    let c: [[SvfCoef<L>; 1]; 2] = [[bell_coef::<L>(0)], [bell_coef::<L>(1)]];
+    let mut s1 = [[SvfState::<L>::default(); 1]; 2];
+    let mut s2 = s1;
+    // Equivalence: outputs, states and verdicts, including a planted infinity.
+    for block in 0..20 {
+        let mut a = source.clone();
+        let mut b = source.clone();
+        if block == 7 {
+            a[1][33] = f32::INFINITY;
+            b[1][33] = f32::INFINITY;
+        }
+        {
+            let (x, y) = a.split_at_mut(1);
+            svf_cascade_interleaved::<L, 2, 1>([&mut x[0], &mut y[0]], QUANTUM, &c, &mut s1);
+        }
+        let verdict_a = [check::<L>(&a[0]), check::<L>(&a[1])];
+        let verdict_b = {
+            let (x, y) = b.split_at_mut(1);
+            fused_d1::<L, 2>([&mut x[0], &mut y[0]], QUANTUM, &c, &mut s2)
+        };
+        assert_eq!(verdict_a, verdict_b, "block {block}");
+        for t in 0..2 {
+            assert!(a[t].iter().zip(&b[t]).all(|(p, q)| p.to_bits() == q.to_bits() || (p.is_nan() && q.is_nan())));
+        }
+        if block == 7 {
+            s1 = [[SvfState::<L>::default(); 1]; 2];
+            s2 = s1;
+        }
+    }
+    let time = |f: &mut dyn FnMut()| -> f64 {
+        for _ in 0..2000 {
+            f();
+        }
+        let mut best = f64::MAX;
+        for _ in 0..3 {
+            let start = Instant::now();
+            for _ in 0..20_000 {
+                f();
+            }
+            best = best.min(start.elapsed().as_secs_f64() / 20_000.0);
+        }
+        best * hz
+    };
+    let refresh = time(&mut || {
+        for (b, s) in blocks.iter_mut().zip(&source) {
+            b.copy_from_slice(s);
+        }
+        black_box(&mut blocks);
+    });
+    let separate = time(&mut || {
+        for (b, s) in blocks.iter_mut().zip(&source) {
+            b.copy_from_slice(s);
+        }
+        let (x, y) = blocks.split_at_mut(1);
+        svf_cascade_interleaved::<L, 2, 1>(black_box([&mut x[0], &mut y[0]]), QUANTUM, &c, &mut s1);
+        black_box([check::<L>(&blocks[0]), check::<L>(&blocks[1])]);
+    });
+    let fused = time(&mut || {
+        for (b, s) in blocks.iter_mut().zip(&source) {
+            b.copy_from_slice(s);
+        }
+        let (x, y) = blocks.split_at_mut(1);
+        black_box(fused_d1::<L, 2>(black_box([&mut x[0], &mut y[0]]), QUANTUM, &c, &mut s2));
+    });
+    let ls = (2 * span) as f64;
+    println!(
+        "FUSED {:<6} D1 + separate scan {:.0} cyc ({:.3} cyc/ls), fused {:.0} cyc ({:.3} cyc/ls) net of refresh {:.0}",
+        core::any::type_name::<L>().rsplit("::").next().unwrap_or(""),
+        separate - refresh,
+        (separate - refresh) / ls,
+        fused - refresh,
+        (fused - refresh) / ls,
+        refresh
+    );
+}
+
+#[test]
+#[ignore = "diagnosis harness"]
+fn fused_check() {
+    let hz = core_hz();
+    fused_sweep::<Simd8>(hz);
+    fused_sweep::<Simd4>(hz);
+}
