--- /dev/null
+++ b/docs/handoffs/effects-2026-09-27/eq-diag-tools/probe.rs
@@ -0,0 +1,123 @@
+// Zen 3 op-mix throughput probe (diagnosis only; not in the tree).
+// rustc -O -C target-feature=+avx2,+fma probe.rs -o probe ; taskset -c 31 ./probe
+#![allow(unsafe_code)]
+use std::arch::x86_64::*;
+use std::hint::black_box;
+use std::time::Instant;
+
+const CHAINS: usize = 12;
+const REPEAT: usize = 8;
+
+macro_rules! variant {
+    ($name:expr, $ops:expr, $iters:expr, $hz:expr, |$x:ident, $c1:ident, $c2:ident, $eps:ident, $absm:ident| $body:expr) => {{
+        #[target_feature(enable = "avx2,fma")]
+        unsafe fn run(iters: u64) -> f32 {
+            let $c1 = _mm256_set1_ps(1.000_000_1);
+            let $c2 = _mm256_set1_ps(0.999_999_9);
+            let $eps = _mm256_set1_ps(1.0e-20);
+            let $absm = _mm256_castsi256_ps(_mm256_set1_epi32(0x7fff_ffff));
+            let mut a: [__m256; CHAINS] = core::array::from_fn(|i| _mm256_set1_ps(1.0 + i as f32 * 0.01));
+            for _ in 0..iters {
+                for _ in 0..REPEAT {
+                    for slot in a.iter_mut() {
+                        let $x = *slot;
+                        *slot = $body;
+                    }
+                }
+
+            }
+            let mut total = _mm256_setzero_ps();
+            for slot in a {
+                total = _mm256_add_ps(total, slot);
+            }
+            let mut out = [0.0_f32; 8];
+            _mm256_storeu_ps(out.as_mut_ptr(), total);
+            out.iter().sum()
+        }
+        let iters: u64 = $iters;
+        let mut best = f64::MAX;
+        for _ in 0..3 {
+            let start = Instant::now();
+            black_box(unsafe { run(iters) });
+            best = best.min(start.elapsed().as_secs_f64());
+        }
+        let cycles = best * $hz;
+        let ops = iters as f64 * (REPEAT * CHAINS) as f64 * $ops as f64;
+        println!("{:<44} {:.3} ops/cycle", $name, ops / cycles);
+    }};
+}
+
+fn core_hz() -> f64 {
+    const ADDS: u64 = 300_000_000;
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let mut x = black_box(0.0_f32);
+        let d = black_box(1.0e-3_f32);
+        let start = Instant::now();
+        for _ in 0..ADDS {
+            x += d;
+        }
+        best = best.min(start.elapsed().as_secs_f64());
+        black_box(x);
+    }
+    3.0 * ADDS as f64 / best
+}
+
+fn main() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz", hz / 1e9);
+    let n = 2_000_000;
+    variant!("vaddps", 1, n, hz, |x, c1, c2, eps, absm| _mm256_add_ps(x, c1));
+    variant!("vmulps", 1, n, hz, |x, c1, c2, eps, absm| _mm256_mul_ps(x, c2));
+    variant!("vmulps+vaddps", 2, n, hz, |x, c1, c2, eps, absm| _mm256_add_ps(_mm256_mul_ps(x, c2), c1));
+    variant!("vandps (x & absmask) + vaddps", 2, n, hz, |x, c1, c2, eps, absm| _mm256_add_ps(_mm256_and_ps(x, absm), c1));
+    variant!("vcmpps+vblendvps", 2, n, hz, |x, c1, c2, eps, absm| {
+        let m = _mm256_cmp_ps::<_CMP_GT_OQ>(x, c1);
+        _mm256_blendv_ps(x, c2, m)
+    });
+    variant!("flush: vandps, vcmpps, vandnps", 3, n, hz, |x, c1, c2, eps, absm| {
+        let m = _mm256_cmp_ps::<_CMP_LT_OQ>(_mm256_and_ps(x, absm), eps);
+        _mm256_andnot_ps(m, _mm256_add_ps(x, c1))
+    });
+    variant!("vaddps + flush (4 ops)", 4, n, hz, |x, c1, c2, eps, absm| {
+        let y = _mm256_add_ps(x, c1);
+        let m = _mm256_cmp_ps::<_CMP_LT_OQ>(_mm256_and_ps(y, absm), eps);
+        _mm256_andnot_ps(m, y)
+    });
+    variant!("vmulps + vaddps + flush (5 ops)", 5, n, hz, |x, c1, c2, eps, absm| {
+        let y = _mm256_add_ps(_mm256_mul_ps(x, c2), c1);
+        let m = _mm256_cmp_ps::<_CMP_LT_OQ>(_mm256_and_ps(y, absm), eps);
+        _mm256_andnot_ps(m, y)
+    });
+    variant!("vcmpps alone (x < c1 as float bits)", 1, n, hz, |x, c1, c2, eps, absm| _mm256_cmp_ps::<_CMP_LT_OQ>(x, c1));
+    variant!("vandps alone (x & c)", 1, n, hz, |x, c1, c2, eps, absm| _mm256_and_ps(x, c2));
+    variant!("vandnps alone", 1, n, hz, |x, c1, c2, eps, absm| _mm256_andnot_ps(c2, x));
+    variant!("vblendvps alone", 1, n, hz, |x, c1, c2, eps, absm| _mm256_blendv_ps(x, c2, c1));
+    // EQ section mix, 11 add : 7 mul : 4 logic : 2 cmp (24 ops), shallow dependency.
+    variant!("EQ mix 11a:7m:4l:2c (independent)", 24, n / 4, hz, |x, c1, c2, eps, absm| {
+        let a0 = _mm256_add_ps(x, c1);
+        let m0 = _mm256_mul_ps(x, c2);
+        let a1 = _mm256_add_ps(m0, c1);
+        let m1 = _mm256_mul_ps(a0, c2);
+        let a2 = _mm256_add_ps(a1, m1);
+        let m2 = _mm256_mul_ps(a1, c2);
+        let a3 = _mm256_add_ps(a2, c1);
+        let m3 = _mm256_mul_ps(a2, c2);
+        let a4 = _mm256_add_ps(m2, m3);
+        let l0 = _mm256_and_ps(a3, absm);
+        let k0 = _mm256_cmp_ps::<_CMP_LT_OQ>(l0, eps);
+        let n0 = _mm256_andnot_ps(k0, a3);
+        let l1 = _mm256_and_ps(a4, absm);
+        let k1 = _mm256_cmp_ps::<_CMP_LT_OQ>(l1, eps);
+        let n1 = _mm256_andnot_ps(k1, a4);
+        let a5 = _mm256_add_ps(n0, n1);
+        let m4 = _mm256_mul_ps(n0, c2);
+        let a6 = _mm256_add_ps(a5, m4);
+        let m5 = _mm256_mul_ps(n1, c2);
+        let a7 = _mm256_add_ps(a6, m5);
+        let m6 = _mm256_mul_ps(a7, c2);
+        let a8 = _mm256_add_ps(m6, a0);
+        let a9 = _mm256_add_ps(a8, c1);
+        _mm256_add_ps(a9, a3)
+    });
+}
