+// node --no-liftoff --print-wasm-code print_code.mjs GUEST.wasm : render a few eq_only blocks.
+import { readFileSync } from 'node:fs';
+const module = new WebAssembly.Module(readFileSync(process.argv[2]));
+const e = new WebAssembly.Instance(module, {}).exports;
+const f32 = new Float32Array(1), u32 = new Uint32Array(f32.buffer);
+e.miso_console_reset_source();
+for (let track = 0; track < 64; track++) {
+  for (let k = 0; k < 256; k++) {
+    f32[0] = Math.fround(Math.sin(track * 0.31 + (k % 128) * 0.017) * 0.5);
+    e.miso_console_push_source_word(u32[0]);
+  }
+}
+e.miso_console_prepare(4);
+for (let block = 0; block < 4; block++) e.miso_console_render(block);
