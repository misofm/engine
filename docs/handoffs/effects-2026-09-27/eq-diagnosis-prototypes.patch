+#!/usr/bin/env bash
+# Alternate the clean native variant binaries, three rounds, pinned (caller holds the lock).
+S=/tmp/claude-1002/-home-bl-misofm-engine/43895396-e183-427f-b08f-a0b72f15ae5f/scratchpad/eq-diag
+for round in 1 2 3; do
+  for variant in ${VARIANTS:-base skew nopad}; do
+    printf '%s round %s: ' "$variant" "$round"
+    taskset -c 31 "$S/eq_rows_$variant" --ignored --nocapture --test-threads 1 clean_rows 2>&1 | grep CLEAN
+  done
+done
