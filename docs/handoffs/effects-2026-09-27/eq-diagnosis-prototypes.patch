@@ -0,0 +1,53 @@
+"""Summarise innermost wasm loops of one function in `wasm-objdump -d` output.
+
+usage: python3 wasm_loops.py DIS FUNCTION_SUBSTRING [--min N]
+"""
+import re
+import sys
+from collections import Counter
+
+path, needle = sys.argv[1], sys.argv[2]
+minimum = int(sys.argv[sys.argv.index('--min') + 1]) if '--min' in sys.argv else 30
+HEADER = re.compile(r"^([0-9a-f]+) func\[(\d+)\] <(.+)>:")
+INSN = re.compile(r"^\s*[0-9a-f]+: [0-9a-f ]+\|\s*(.*)$")
+
+functions = {}
+current = None
+for line in open(path):
+    h = HEADER.match(line)
+    if h:
+        current = h.group(3)
+        functions[current] = []
+        continue
+    if current is None:
+        continue
+    m = INSN.match(line)
+    if m:
+        functions[current].append(m.group(1).strip())
+
+matches = [name for name in functions if needle in name]
+for name in matches:
+    ops = functions[name]
+    print(f"== {name[:160]} ({len(ops)} instructions)")
+    stack = []
+    loops = []
+    for index, op in enumerate(ops):
+        word = op.split()[0] if op else ''
+        if word in ('block', 'loop', 'if'):
+            stack.append((word, index, []))
+        elif word == 'end' and stack:
+            kind, start, children = stack.pop()
+            if kind == 'loop':
+                loops.append((start, index, len(children) == 0))
+            if stack:
+                stack[-1][2].append(kind)
+    for start, end, innermost in loops:
+        body = ops[start:end + 1]
+        if len(body) < minimum:
+            continue
+        counts = Counter(op.split()[0] for op in body if op)
+        vec = sum(v for k, v in counts.items() if k.startswith(('f32x4', 'v128', 'i32x4')))
+        arith = sum(v for k, v in counts.items() if re.match(r"f32x4\.(mul|add|sub|div)$", k))
+        top = ', '.join(f"{k} {v}" for k, v in counts.most_common(14))
+        print(f"  loop @{start}-{end} innermost={innermost}: {len(body)} ops, vector {vec}, f32x4 arith {arith}")
+        print(f"    {top}")
