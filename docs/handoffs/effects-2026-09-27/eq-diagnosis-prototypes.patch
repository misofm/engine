@@ -0,0 +1,80 @@
+// node wasm_variants.mjs base.wasm skew.wasm ... : eq_only and builtins_only per build, one
+// process, interleaved rounds; plus a 64-block digest per build and workload.
+import { readFileSync } from 'node:fs';
+
+const HZ = Number(process.env.HZ ?? 3.7e9);
+const TRACKS = 64, QUANTUM = 128, LANE_SAMPLES = TRACKS * QUANTUM * 2;
+const ROUNDS = Number(process.env.ROUNDS ?? 6);
+const BLOCKS = Number(process.env.BLOCKS ?? 1000);
+const WORKLOADS = (process.env.WORKLOADS ?? '4,6').split(',').map(Number);
+const f32 = new Float32Array(1), u32 = new Uint32Array(f32.buffer);
+const bits = (x) => { f32[0] = x; return u32[0]; };
+const tracksOf = (index) => (index === 3 ? 128 : index <= 1 ? 9 : 64);
+
+function arm(module, index) {
+  const e = new WebAssembly.Instance(module, {}).exports;
+  e.miso_console_reset_source();
+  for (let track = 0; track < tracksOf(index); track++) {
+    for (let k = 0; k < 2 * QUANTUM; k++) {
+      const v = Math.fround(Math.sin(track * 0.31 + (k % QUANTUM) * 0.017) * (k < QUANTUM ? 0.6 : -0.45));
+      e.miso_console_push_source_word(bits(v));
+    }
+  }
+  if (e.miso_console_prepare(index) !== 1) throw new Error('prepare');
+  return { e, observation: 0 };
+}
+
+function measure(a, blocks) {
+  const samples = new Float64Array(blocks);
+  for (let i = 0; i < blocks; i++) {
+    const t0 = process.hrtime.bigint();
+    if (a.e.miso_console_render(a.observation) !== 1) throw new Error('render');
+    samples[i] = Number(process.hrtime.bigint() - t0);
+    a.observation++;
+  }
+  samples.sort();
+  return samples[blocks >> 1];
+}
+const median = (v) => [...v].sort((x, y) => x - y)[v.length >> 1];
+const loadavg = () => readFileSync('/proc/loadavg', 'utf8').trim();
+
+const names = process.argv.slice(2);
+const modules = names.map((path) => new WebAssembly.Module(readFileSync(path)));
+console.log(`node ${process.version} v8 ${process.versions.v8} loadavg ${loadavg()}`);
+
+if (process.env.DIGESTS) {
+  const count = new WebAssembly.Instance(modules[0], {}).exports.miso_console_workload_count();
+  for (let index = 0; index < count; index++) {
+    const hexes = modules.map((m) => {
+      const a = arm(m, index);
+      for (let block = 0; block < 64; block++) {
+        a.e.miso_console_render(block);
+        a.e.miso_console_hash_output();
+      }
+      a.e.miso_console_finish_digest();
+      let hex = '';
+      for (let w = 0; w < 8; w++) hex += (a.e.miso_console_digest_word(w) >>> 0).toString(16).padStart(8, '0');
+      return hex;
+    });
+    console.log(`digest ${String(index).padStart(2)} ${hexes[0].slice(0, 16)} ${hexes.slice(1).map((h) => (h === hexes[0] ? '=' : 'DIFF')).join(' ')}`);
+  }
+}
+
+const arms = modules.map((m) => WORKLOADS.map((index) => arm(m, index)));
+for (const row of arms) for (const a of row) measure(a, 3000);
+const table = arms.map((row) => row.map(() => []));
+for (let round = 0; round < ROUNDS; round++) {
+  for (let s = 0; s < arms.length; s++) {
+    const i = (s + round) % arms.length;
+    for (let w = 0; w < WORKLOADS.length; w++) {
+      measure(arms[i][w], 64);
+      table[i][w].push(measure(arms[i][w], BLOCKS));
+    }
+  }
+}
+for (let i = 0; i < arms.length; i++) {
+  const p = table[i].map(median);
+  const iso = p.length > 1 ? `  isolate(w0-w1) ${(p[0] - p[1]).toFixed(0)} ns = ${((p[0] - p[1]) * HZ / 1e9 / LANE_SAMPLES).toFixed(3)} cyc/ls` : '';
+  console.log(`${names[i].padEnd(20)} ` + WORKLOADS.map((w, k) => `w${w} p50 ${p[k].toFixed(0)} ns [${table[i][k].map((x) => x.toFixed(0)).join(',')}]`).join('  ') + iso);
+}
+console.log(`loadavg ${loadavg()}`);
