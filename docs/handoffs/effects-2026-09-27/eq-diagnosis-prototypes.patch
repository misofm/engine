+#!/usr/bin/env bash
+# Build the clean-rows harness at base and at each minimal EQ variant. Restores lib.rs after.
+set -euo pipefail
+ROOT=/home/bl/misofm/engine/.claude/worktrees/agent-abc20584e3e1eb631
+S=/tmp/claude-1002/-home-bl-misofm-engine/43895396-e183-427f-b08f-a0b72f15ae5f/scratchpad/eq-diag
+LIB=$ROOT/crates/parametric-eq/src/lib.rs
+export CARGO_INCREMENTAL=0 CARGO_TARGET_DIR=$S/target
+cd "$ROOT"
+# eq_diag.rs needs the diag feature; park it while the clean harness builds.
+mv "$ROOT/tools/console-workload/tests/eq_diag.rs" "$S/eq_diag.rs.parked"
+trap 'mv "$S/eq_diag.rs.parked" "$ROOT/tools/console-workload/tests/eq_diag.rs"; cp "$S/eq_lib_base.rs" "$LIB"' EXIT
+build() {
+  local out
+  out=$(cargo test --release -p console-workload --test eq_rows --no-run 2>&1 | grep -o '/[^ ]*eq_rows-[0-9a-f]*' | tail -1)
+  cp "$out" "$S/eq_rows_$1"
+  echo "built $1"
+}
+cp "$S/eq_lib_base.rs" "$LIB"
+build base
+for variant in ${VARIANTS:-skew nopad}; do
+  cp "$S/eq_lib_base.rs" "$LIB"
+  python3 "$S/variant.py" "$ROOT" "$variant"
+  build "$variant"
+done
