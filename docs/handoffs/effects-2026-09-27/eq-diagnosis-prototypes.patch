@@ -0,0 +1,147 @@
+// EQ diagnosis: wasm simd128 guest under Node (V8), in-process A/B of the EQ diag toggles.
+// node wasm_ab.mjs GUEST.wasm
+import { readFileSync } from 'node:fs';
+
+const bytes = readFileSync(process.argv[2]);
+const module = new WebAssembly.Module(bytes);
+const HZ = Number(process.env.HZ ?? 3.7e9);
+const TRACKS = 64;
+const QUANTUM = 128;
+const LANE_SAMPLES = TRACKS * QUANTUM * 2;
+const EQ_ONLY = 4;
+const BUILTINS_ONLY = 6;
+const IDLE = 8;
+const ROUNDS = Number(process.env.ROUNDS ?? 6);
+const BLOCKS = Number(process.env.BLOCKS ?? 1000);
+const flagsList = (process.env.FLAGS ?? '0,1,2,32,4,8,768,2048,3584,772,812')
+  .split(',').map(Number);
+const workload = Number(process.env.WORKLOAD ?? EQ_ONLY);
+
+const f32 = new Float32Array(1);
+const u32 = new Uint32Array(f32.buffer);
+function bits(x) { f32[0] = x; return u32[0]; }
+
+function instance(index) {
+  const inst = new WebAssembly.Instance(module, {});
+  const e = inst.exports;
+  if (e.miso_console_backend() !== 1) throw new Error('guest is not simd128');
+  e.miso_console_reset_source();
+  for (let track = 0; track < TRACKS; track++) {
+    const left = [], right = [];
+    for (let frame = 0; frame < QUANTUM; frame++) {
+      const phase = Math.fround(Math.fround(frame * Math.fround(0.017)) + Math.fround(track * Math.fround(0.31)));
+      const value = Math.fround(Math.fround(Math.sin(phase)) * Math.fround(0.6));
+      left.push(value);
+      right.push(Math.fround(Math.fround(-value) * Math.fround(0.75)));
+    }
+    for (const v of left) e.miso_console_push_source_word(bits(v));
+    for (const v of right) e.miso_console_push_source_word(bits(v));
+  }
+  if (e.miso_console_prepare(index) !== 1) throw new Error('prepare ' + index);
+  return { e, observation: 0 };
+}
+
+function measure(arm, blocks) {
+  const samples = new Float64Array(blocks);
+  for (let i = 0; i < blocks; i++) {
+    const t0 = process.hrtime.bigint();
+    const ok = arm.e.miso_console_render(arm.observation);
+    const t1 = process.hrtime.bigint();
+    if (ok !== 1) throw new Error('render');
+    arm.observation++;
+    samples[i] = Number(t1 - t0);
+  }
+  samples.sort();
+  return samples[blocks >> 1];
+}
+
+function median(values) {
+  const v = [...values].sort((a, b) => a - b);
+  return v[v.length >> 1];
+}
+
+function digest(index, flags) {
+  const inst = new WebAssembly.Instance(module, {});
+  const e = inst.exports;
+  e.miso_console_reset_source();
+  for (let track = 0; track < TRACKS * (index === 3 ? 2 : 1); track++) {
+    for (let k = 0; k < 2 * QUANTUM; k++) {
+      e.miso_console_push_source_word(bits(Math.fround(Math.sin(track * 0.31 + k * 0.017) * 0.5)));
+    }
+  }
+  return { e };
+}
+
+const loadavg = () => readFileSync('/proc/loadavg', 'utf8').trim();
+console.log(`node ${process.version}, v8 ${process.versions.v8}, loadavg ${loadavg()}, HZ ${HZ}`);
+if (process.env.TIMING !== '0') {
+const eq = instance(workload);
+const control = instance(BUILTINS_ONLY);
+eq.e.miso_console_set_eq_diag(0);
+measure(eq, 3000);
+measure(control, 3000);
+for (const flags of flagsList) {
+  eq.e.miso_console_set_eq_diag(flags);
+  measure(eq, 300);
+}
+eq.e.miso_console_set_eq_diag(0);
+const table = flagsList.map(() => []);
+const controls = [];
+for (let round = 0; round < ROUNDS; round++) {
+  controls.push(measure(control, BLOCKS));
+  for (let step = 0; step < flagsList.length; step++) {
+    const index = (step + round) % flagsList.length;
+    eq.e.miso_console_set_eq_diag(flagsList[index]);
+    measure(eq, 64);
+    table[index].push(measure(eq, BLOCKS));
+  }
+}
+eq.e.miso_console_set_eq_diag(0);
+const b = median(controls);
+const base = median(table[0]);
+console.log(`workload ${workload}; builtins_only control p50 ${b.toFixed(0)} ns; loadavg ${loadavg()}`);
+for (let i = 0; i < flagsList.length; i++) {
+  const m = median(table[i]);
+  const d = m - base;
+  console.log(
+    `wasm flags ${String(flagsList[i]).padStart(5)}  p50 ${m.toFixed(0).padStart(7)} ns  vs base ${d >= 0 ? '+' : ''}${d.toFixed(0).padStart(6)} ns ` +
+    `(${(d * HZ / 1e9 / LANE_SAMPLES).toFixed(3)} cyc/ls)  isolate ${((m - b) * HZ / 1e9 / LANE_SAMPLES).toFixed(3)} cyc/ls  ` +
+    `rounds [${table[i].map((x) => x.toFixed(0)).join(', ')}]`);
+}
+}
+
+// Digests: 64 blocks of every workload under each flag set against flags 0, same staged input.
+if (process.env.DIGESTS) {
+  const digestFlags = process.env.DIGESTS.split(',').map(Number);
+  let mismatches = 0;
+  const count = new WebAssembly.Instance(module, {}).exports.miso_console_workload_count();
+  for (let index = 0; index < count; index++) {
+    const words = [];
+    for (const flags of [0, ...digestFlags]) {
+      const inst = new WebAssembly.Instance(module, {});
+      const e = inst.exports;
+      e.miso_console_reset_source();
+      const tracks = index === 3 ? 128 : (index <= 1 ? 9 : 64);
+      for (let track = 0; track < tracks; track++) {
+        for (let k = 0; k < 2 * QUANTUM; k++) {
+          const v = Math.fround(Math.sin(track * 0.31 + (k % QUANTUM) * 0.017) * (k < QUANTUM ? 0.6 : -0.45));
+          e.miso_console_push_source_word(bits(v));
+        }
+      }
+      if (e.miso_console_prepare(index) !== 1) { words.push('prepare-failed'); continue; }
+      e.miso_console_set_eq_diag(flags);
+      for (let block = 0; block < 64; block++) {
+        e.miso_console_render(block);
+        e.miso_console_hash_output();
+      }
+      e.miso_console_finish_digest();
+      let hex = '';
+      for (let w = 0; w < 8; w++) hex += (e.miso_console_digest_word(w) >>> 0).toString(16).padStart(8, '0');
+      words.push(hex);
+    }
+    const same = words.slice(1).map((w) => (w === words[0] ? '=' : 'DIFF'));
+    mismatches += same.filter((x) => x !== '=').length;
+    console.log(`digest workload ${String(index).padStart(2)} ${words[0].slice(0, 16)} ${same.join(' ')}`);
+  }
+  console.log(`wasm digest mismatches: ${mismatches}`);
+}
diff --git a/docs/handoffs/effects-2026-09-27/eq-diag-tools/wasm_variants.mjs b/docs/handoffs/effects-2026-09-27/eq-diag-tools/wasm_variants.mjs
