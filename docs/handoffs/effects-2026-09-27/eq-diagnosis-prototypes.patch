+//! Parametric-EQ diagnosis harness (`docs/handoffs/effects-2026-09-27/EQ-DIAGNOSIS.md`).
+//!
+//! Diagnosis prototype only. Ignored by default; prints measurements and asserts nothing about
+//! time. Build first, then run the binary pinned under the shared timing lock:
+//!
+//! ```text
+//! CARGO_INCREMENTAL=0 cargo test --release -p console-workload --test eq_diag --no-run
+//! flock -w 7200 LOCK taskset -c 31 target/release/deps/eq_diag-<hash> --ignored --nocapture \
+//!     --test-threads 1 <facts|rows|ab|digests|kernels>
+//! ```
+//!
+//! Cycles are derived: nanoseconds from `Instant` times a core clock calibrated in process from a
+//! dependent scalar `f32` add chain at three cycles per add (Zen 3), the plumbing-diagnosis method.
+
+use std::hint::black_box;
+use std::sync::atomic::Ordering;
+use std::time::Instant;
+
+use console_workload::{PlanConfig, QUANTUM, SessionRuntime, WORKLOADS, Workload};
+use engine::SampleRateHz;
+use graph::test_only_phase_profile as profile;
+use lane::kernels::{
+    SvfCoef, SvfState, svf_cascade_interleaved, svf_cascade_interleaved_with_dry_masks,
+};
+use lane::{Backend, Lane, Simd4, Simd8};
+use parametric_eq::{
+    DIAG_ALLOW_SIMD4, DIAG_SKEW, DIAG_ZERO_MASKS, DIAG_NO_PAD, DIAG_PAD_GENERAL, DIAG_SKIP_BANK, DIAG_SKIP_CHECK, DIAG_SKIP_GATE,
+    DIAG_SKIP_KERNEL, DIAG_SKIP_ZEROTEST, DIAG_UNMASKED, EqBandKind, design_svf,
+};
+
+const TRACKS: usize = 64;
+const FADD_LATENCY_CYCLES: f64 = 3.0;
+
+fn lane_samples() -> f64 {
+    (TRACKS * QUANTUM * 2) as f64
+}
+
+fn core_hz() -> f64 {
+    const ADDS: u64 = 300_000_000;
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let mut x = black_box(0.0_f32);
+        let d = black_box(1.0e-3_f32);
+        let start = Instant::now();
+        for _ in 0..ADDS {
+            x += d;
+        }
+        let elapsed = start.elapsed().as_secs_f64();
+        black_box(x);
+        best = best.min(elapsed);
+    }
+    FADD_LATENCY_CYCLES * ADDS as f64 / best
+}
+
+fn loadavg() -> String {
+    std::fs::read_to_string("/proc/loadavg")
+        .unwrap_or_default()
+        .trim()
+        .to_string()
+}
+
+fn set_flags(flags: u32) {
+    parametric_eq::diag::FLAGS.store(flags, Ordering::Relaxed);
+}
+
+fn flag_name(flags: u32) -> String {
+    if flags == 0 {
+        return "base".into();
+    }
+    let names = [
+        (DIAG_SKIP_BANK, "skip_bank"),
+        (DIAG_SKIP_KERNEL, "skip_kernel"),
+        (DIAG_SKIP_GATE, "skip_gate"),
+        (DIAG_SKIP_CHECK, "skip_check"),
+        (DIAG_SKIP_ZEROTEST, "skip_zerotest"),
+        (DIAG_NO_PAD, "no_pad"),
+        (DIAG_UNMASKED, "unmasked"),
+        (DIAG_PAD_GENERAL, "pad_general"),
+        (DIAG_ZERO_MASKS, "zero_masks"),
+        (DIAG_SKEW, "skew"),
+        (1 << 6, "skip_state_legs"),
+        (1 << 7, "gate_minmax"),
+    ];
+    names
+        .iter()
+        .filter(|(bit, _)| flags & bit != 0)
+        .map(|(_, name)| *name)
+        .collect::<Vec<_>>()
+        .join("+")
+}
+
+fn env_flags(default: &[u32]) -> Vec<u32> {
+    match std::env::var("EQ_DIAG_FLAGS") {
+        Ok(text) => text
+            .split(',')
+            .map(|word| word.trim().parse().expect("flag word"))
+            .collect(),
+        Err(_) => default.to_vec(),
+    }
+}
+
+fn env_backends() -> Vec<Backend> {
+    let text = std::env::var("EQ_DIAG_BACKENDS").unwrap_or_else(|_| "8,4".into());
+    text.split(',')
+        .map(|word| match word.trim() {
+            "8" => Backend::Simd8,
+            "4" => Backend::Simd4,
+            "1" => Backend::Scalar,
+            other => panic!("backend {other}"),
+        })
+        .collect()
+}
+
+/// Builds one arm. `Simd4` binds four-lane EQ banks (`DIAG_ALLOW_SIMD4` held during the build)
+/// unless `EQ_DIAG_SIMD4_SCALAR_EQ` is set, which keeps the shipped native behaviour (the EQ then
+/// renders per node at W = 1).
+fn build(workload: Workload, backend: Backend) -> SessionRuntime {
+    let allow = backend == Backend::Simd4 && std::env::var("EQ_DIAG_SIMD4_SCALAR_EQ").is_err();
+    let previous = parametric_eq::diag::FLAGS.load(Ordering::Relaxed);
+    if allow {
+        set_flags(previous | DIAG_ALLOW_SIMD4);
+    }
+    let runtime = SessionRuntime::build_with_dispatch(workload, PlanConfig::BASELINE, backend);
+    set_flags(previous);
+    runtime
+}
+
+fn backend_name(backend: Backend) -> &'static str {
+    match backend {
+        Backend::Simd8 => "Simd8",
+        Backend::Simd4 => "Simd4",
+        Backend::Scalar => "Scalar",
+    }
+}
+
+/// `(min, p50)` nanoseconds per block over `blocks` back-to-back renders.
+fn measure(runtime: &mut SessionRuntime, observation: &mut u64, blocks: usize) -> (u64, u64) {
+    let mut samples = Vec::with_capacity(blocks);
+    for _ in 0..blocks {
+        let start = Instant::now();
+        runtime.render(*observation).expect("block");
+        samples.push(u64::try_from(start.elapsed().as_nanos()).unwrap_or(u64::MAX));
+        *observation += 1;
+    }
+    samples.sort_unstable();
+    (samples[0], samples[samples.len() / 2])
+}
+
+fn median(values: &mut [f64]) -> f64 {
+    values.sort_by(f64::total_cmp);
+    values[values.len() / 2]
+}
