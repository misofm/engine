@@ -0,0 +1,42 @@
+"""Loops (backward branches) in one V8 --print-wasm-code function listing.
+
+usage: python3 v8_loops.py LISTING START_LINE END_LINE [--min N] [--dump OFFSET]
+"""
+import re
+import sys
+from collections import Counter
+
+path, first, last = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
+minimum = int(sys.argv[sys.argv.index('--min') + 1]) if '--min' in sys.argv else 30
+dump = sys.argv[sys.argv.index('--dump') + 1] if '--dump' in sys.argv else None
+LINE = re.compile(r"^0x([0-9a-f]+)\s+([0-9a-f]+)\s+[0-9a-f]+\s+(.*)$")
+insns = []
+with open(path) as handle:
+    for number, line in enumerate(handle, 1):
+        if number < first:
+            continue
+        if number > last:
+            break
+        m = LINE.match(line.rstrip())
+        if m:
+            insns.append((int(m.group(1), 16), m.group(2), m.group(3).strip()))
+index_of = {a: i for i, (a, _, _) in enumerate(insns)}
+for i, (address, offset, text) in enumerate(insns):
+    if not text.startswith('j'):
+        continue
+    target = re.search(r"0x([0-9a-f]+)", text)
+    if not target:
+        continue
+    t = int(target.group(1), 16)
+    if t <= address and t in index_of:
+        body = insns[index_of[t]:i + 1]
+        if len(body) < minimum:
+            continue
+        ops = Counter(b[2].split()[0] if not b[2].startswith('REX.W') else b[2].split()[1] for b in body)
+        vec = sum(v for k, v in ops.items() if k.startswith('v') or k.endswith('ps') or k.startswith('movdq') or k.startswith('movap') or k.startswith('movup'))
+        mem = sum(1 for b in body if '[' in b[2])
+        print(f"loop +0x{insns[index_of[t]][1]}..+0x{offset}: {len(body)} insns, vector-ish {vec}, memory operands {mem}")
+        print("   ", ", ".join(f"{k} {v}" for k, v in ops.most_common(18)))
+        if dump and insns[index_of[t]][1] == dump:
+            for b in body:
+                print("      ", b[1], b[2])
diff --git a/docs/handoffs/effects-2026-09-27/eq-diag-tools/variant.py b/docs/handoffs/effects-2026-09-27/eq-diag-tools/variant.py
new file mode 100644
--- /dev/null
+++ b/docs/handoffs/effects-2026-09-27/eq-diag-tools/variant.py
@@ -0,0 +1,165 @@
+"""Apply one minimal EQ variant to a base tree: `skew`, `nopad`, or `both`.
+
+usage: python3 variant.py ROOT VARIANT
+"""
+import sys
+
+root, variant = sys.argv[1], sys.argv[2]
+p = root + '/crates/parametric-eq/src/lib.rs'
+s = open(p).read()
+
+
+def rep(old, new, count=1):
+    global s
+    n = s.count(old)
+    assert n == count, (old[:100], n)
+    s = s.replace(old, new)
+
+
+SKEWED = '''
+/// Variant kernel: section `k` of every stream runs frame `i - k` in iteration `i`.
+#[inline(always)]
+fn skewed_cascade<L: Lane, const S: usize, const D: usize>(
+    io: [&mut [f32]; S],
+    frames: usize,
+    c: &[[SvfCoef<L>; D]; S],
+    s: &mut [[SvfState<L>; D]; S],
+    masks: &[[L::Mask; D]; S],
+) {
+    if frames < D {
+        svf_cascade_interleaved_with_dry_masks::<L, S, D>(io, frames, c, s, masks);
+        return;
+    }
+    let w = L::WIDTH;
+    let span = frames * w;
+    let mut io = io.map(|block| &mut block[..span]);
+    let mut state = *s;
+    let nc1: [[L; D]; S] = core::array::from_fn(|t| core::array::from_fn(|k| c[t][k].c1.neg()));
+    let mut carry: [[L; D]; S] = [[L::zero(); D]; S];
+    macro_rules! step {
+        ($i:expr, $t:expr, $k:expr) => {{
+            let (i, t, k) = ($i, $t, $k);
+            let f = i - k;
+            let x = if k == 0 {
+                L::load(&io[t][f * w..f * w + w])
+            } else {
+                carry[t][k - 1]
+            };
+            let coefficients = &c[t][k];
+            let (v1, v2) = lane::kernels::svf_step(
+                x,
+                nc1[t][k],
+                coefficients.a2,
+                coefficients.a3,
+                &mut state[t][k],
+            );
+            let wet = coefficients
+                .m2
+                .fma(v2, coefficients.m1.fma(v1, coefficients.m0.mul(x)));
+            let y = L::select(masks[t][k], x, wet);
+            if k == D - 1 {
+                y.store(&mut io[t][f * w..f * w + w]);
+            } else {
+                carry[t][k] = y;
+            }
+        }};
+    }
+    for i in 0..D - 1 {
+        for t in 0..S {
+            for k in (0..=i).rev() {
+                step!(i, t, k);
+            }
+        }
+    }
+    for i in D - 1..frames {
+        for t in 0..S {
+            for k in (0..D).rev() {
+                step!(i, t, k);
+            }
+        }
+    }
+    for i in frames..frames + D - 1 {
+        for t in 0..S {
+            for k in (i + 1 - frames..D).rev() {
+                step!(i, t, k);
+            }
+        }
+    }
+    *s = state;
+}
+'''
+
+if variant in ('skew', 'both'):
+    rep("""/// Reads increment `index` of a step set in the pinned order.
+fn step_word<""", SKEWED + """
+/// Reads increment `index` of a step set in the pinned order.
+fn step_word<""")
+    rep("""        svf_cascade_interleaved_with_dry_masks::<L, 2, DEPTH>(
+            [&mut *left, &mut *right],
+            frames,
+            &coefficients,
+            &mut state,
+            &dry_masks,
+        );""", """        skewed_cascade::<L, 2, DEPTH>(
+            [&mut *left, &mut *right],
+            frames,
+            &coefficients,
+            &mut state,
+            &dry_masks,
+        );""")
+
+if variant in ('nopad', 'both'):
+    # dual cascade_sections: no padding
+    rep("""    let dead = |section: usize| left_channel.identity[section] && right_channel.identity[section];
+    let depth = EFFECTIVE_CASCADE_DEPTH;""", """    let dead = |section: usize| left_channel.identity[section] && right_channel.identity[section];
+    let depth = 1;""")
+    rep("""    let (list, length) = sections;
+    debug_assert_eq!(length % DEPTH, 0);
+    for pass in 0..length / DEPTH {
+        let base = pass * DEPTH;
+        let at: [usize; DEPTH] = core::array::from_fn(|k| list[base + k]);
