+S=/tmp/claude-1002/-home-bl-misofm-engine/43895396-e183-427f-b08f-a0b72f15ae5f/scratchpad/eq-diag
+CHECK=/home/bl/misofm/engine/.claude/worktrees/agent-abc20584e3e1eb631/scripts/check-web-audioworklet-callgraph.py
