+// ---------------------------------------------------------------------------------------------
+// Prototype: the software-pipelined ("skewed") cascade. Section `k` of every stream runs frame
+// `i - k` in iteration `i`, so the sections inside one iteration are independent and the
+// per-iteration dependency chain is one section long. Each chain still sees exactly the inputs
+// it sees today, in the same order, through the same `svf_step` and output mix: a schedule
+// change, bit-identical by construction (checked below against the shipped kernel).
+
+#[inline(always)]
+fn section<L: Lane>(x: L, nc1: L, c: &SvfCoef<L>, s: &mut SvfState<L>) -> L {
+    let (v1, v2) = lane::kernels::svf_step(x, nc1, c.a2, c.a3, s);
+    c.m2.fma(v2, c.m1.fma(v1, c.m0.mul(x)))
+}
+
+#[inline(always)]
+fn skewed<L: Lane, const S: usize, const D: usize, const MASKED: bool>(
+    io: [&mut [f32]; S],
+    frames: usize,
+    c: &[[SvfCoef<L>; D]; S],
+    s: &mut [[SvfState<L>; D]; S],
+    masks: &[[L::Mask; D]; S],
+) {
+    let w = L::WIDTH;
+    let span = frames * w;
+    let mut io = io.map(|block| &mut block[..span]);
+    let mut state = *s;
+    let nc1: [[L; D]; S] = core::array::from_fn(|t| core::array::from_fn(|k| c[t][k].c1.neg()));
+    let mut carry: [[L; D]; S] = [[L::zero(); D]; S];
+    let total = frames + D - 1;
+    for i in 0..total {
+        for t in 0..S {
+            for k in (0..D).rev() {
+                if i < k || i - k >= frames {
+                    continue;
+                }
+                let f = i - k;
+                let x = if k == 0 {
+                    L::load(&io[t][f * w..f * w + w])
+                } else {
+                    carry[t][k - 1]
+                };
+                let wet = section(x, nc1[t][k], &c[t][k], &mut state[t][k]);
+                let y = if MASKED {
+                    L::select(masks[t][k], x, wet)
+                } else {
+                    wet
+                };
+                if k == D - 1 {
+                    y.store(&mut io[t][f * w..f * w + w]);
+                } else {
+                    carry[t][k] = y;
+                }
+            }
+        }
+    }
+    *s = state;
+}
+
+/// Steady-state-peeled form of [`skewed`]: prologue, a branch-free body, epilogue.
+#[inline(always)]
+fn skewed_peeled<L: Lane, const S: usize, const D: usize, const MASKED: bool>(
+    io: [&mut [f32]; S],
+    frames: usize,
+    c: &[[SvfCoef<L>; D]; S],
+    s: &mut [[SvfState<L>; D]; S],
+    masks: &[[L::Mask; D]; S],
+) {
+    let w = L::WIDTH;
+    let span = frames * w;
+    let mut io = io.map(|block| &mut block[..span]);
+    let mut state = *s;
+    let nc1: [[L; D]; S] = core::array::from_fn(|t| core::array::from_fn(|k| c[t][k].c1.neg()));
+    let mut carry: [[L; D]; S] = [[L::zero(); D]; S];
+    macro_rules! step {
+        ($i:expr, $t:expr, $k:expr) => {{
+            let (i, t, k) = ($i, $t, $k);
+            let f = i - k;
+            let x = if k == 0 {
+                L::load(&io[t][f * w..f * w + w])
+            } else {
+                carry[t][k - 1]
+            };
+            let wet = section(x, nc1[t][k], &c[t][k], &mut state[t][k]);
+            let y = if MASKED {
+                L::select(masks[t][k], x, wet)
+            } else {
+                wet
+            };
+            if k == D - 1 {
+                y.store(&mut io[t][f * w..f * w + w]);
+            } else {
+                carry[t][k] = y;
+            }
+        }};
+    }
+    debug_assert!(frames >= D);
+    for i in 0..D - 1 {
+        for t in 0..S {
+            for k in (0..=i).rev() {
+                step!(i, t, k);
+            }
+        }
+    }
+    for i in D - 1..frames {
+        for t in 0..S {
+            for k in (0..D).rev() {
+                step!(i, t, k);
+            }
+        }
+    }
+    for i in frames..frames + D - 1 {
+        for t in 0..S {
+            for k in (i + 1 - frames..D).rev() {
+                step!(i, t, k);
+            }
+        }
+    }
+    *s = state;
+}
+
+fn words_equal(a: &[f32], b: &[f32]) -> bool {
+    a.iter()
+        .zip(b)
+        .all(|(x, y)| x.to_bits() == y.to_bits() || (x.is_nan() && y.is_nan()))
+}
+
+fn hostile(len: usize, salt: usize) -> Vec<f32> {
+    (0..len)
+        .map(|index| match (index + salt) % 11 {
+            0 => -0.0,
+            1 => 1.0e-39,
+            2 => -3.0e-42,
+            3 => 0.0,
+            _ => (((index * 7 + salt * 13) % 97) as f32 - 48.0) / 96.0,
+        })
+        .collect()
+}
+
+fn state_bits<L: Lane, const S: usize, const D: usize>(s: &[[SvfState<L>; D]; S]) -> Vec<u32> {
+    let mut out = Vec::new();
+    for stream in s {
+        for section in stream {
+            let mut words = vec![0_u32; L::WIDTH];
+            section.ic1.store_bits(&mut words);
+            out.extend_from_slice(&words);
+            section.ic2.store_bits(&mut words);
+            out.extend_from_slice(&words);
+        }
+    }
+    out
+}
+
+fn skew_identity<L: Lane, const S: usize, const D: usize, const MASKED: bool>() -> bool {
+    let span = QUANTUM * L::WIDTH;
+    let all_ones = L::zero().eq(L::zero());
+    let none = L::zero().lt(L::zero());
+    let coef: [[SvfCoef<L>; D]; S] = core::array::from_fn(|t| {
+        core::array::from_fn(|k| {
+            if k == 0 && MASKED {
+                identity::<L>()
+            } else {
+                bell::<L>(t, 3 * k + 1)
+            }
+        })
+    });
+    let masks: [[L::Mask; D]; S] = core::array::from_fn(|_| {
+        core::array::from_fn(|k| if k == 0 && MASKED { all_ones } else { none })
+    });
+    let mut s_ref = [[SvfState::<L>::default(); D]; S];
+    let mut s_new = s_ref;
+    let mut s_peel = s_ref;
+    let mut ok = true;
+    for block in 0..40 {
+        let mut a: Vec<Vec<f32>> = (0..S).map(|t| hostile(span, block * 3 + t)).collect();
+        let mut b = a.clone();
+        let mut p = a.clone();
+        {
+            let mut each = a.iter_mut();
+            let io: [&mut [f32]; S] = core::array::from_fn(|_| each.next().unwrap().as_mut_slice());
+            if MASKED {
+                svf_cascade_interleaved_with_dry_masks::<L, S, D>(io, QUANTUM, &coef, &mut s_ref, &masks);
+            } else {
+                svf_cascade_interleaved::<L, S, D>(io, QUANTUM, &coef, &mut s_ref);
+            }
+        }
+        {
+            let mut each = b.iter_mut();
+            let io: [&mut [f32]; S] = core::array::from_fn(|_| each.next().unwrap().as_mut_slice());
+            skewed::<L, S, D, MASKED>(io, QUANTUM, &coef, &mut s_new, &masks);
+        }
+        {
+            let mut each = p.iter_mut();
+            let io: [&mut [f32]; S] = core::array::from_fn(|_| each.next().unwrap().as_mut_slice());
+            skewed_peeled::<L, S, D, MASKED>(io, QUANTUM, &coef, &mut s_peel, &masks);
+        }
+        for t in 0..S {
+            ok &= words_equal(&a[t], &b[t]) && words_equal(&a[t], &p[t]);
+        }
+    }
+    ok &= state_bits(&s_ref) == state_bits(&s_new) && state_bits(&s_ref) == state_bits(&s_peel);
+    let tag = core::any::type_name::<L>().rsplit("::").next().unwrap_or("");
+    println!(
+        "{tag:<6} skew identity S{S} D{D} masked={MASKED}: {}",
+        if ok { "bit-identical" } else { "MISMATCH" }
+    );
+    ok
+}
+
+fn skew_time<L: Lane, const S: usize, const D: usize, const MASKED: bool, const PEELED: bool>(
+    hz: f64,
+    name: &str,
+    sections: usize,
+) {
+    let span = QUANTUM * L::WIDTH;
+    let all_ones = L::zero().eq(L::zero());
+    let none = L::zero().lt(L::zero());
+    let source: Vec<Vec<f32>> = (0..S).map(|salt| signal(span, salt)).collect();
+    let mut blocks = source.clone();
+    let refresh = time_case(hz, || {
+        for (block, source) in blocks.iter_mut().zip(source.iter()) {
+            block.copy_from_slice(source);
+        }
+        black_box(&mut blocks);
+    });
+    let passes = sections / D;
+    let coef: Vec<[[SvfCoef<L>; D]; S]> = (0..passes)
+        .map(|pass| {
+            core::array::from_fn(|t| {
+                core::array::from_fn(|k| {
+                    if MASKED && pass == 0 && k == 0 {
+                        identity::<L>()
+                    } else {
+                        bell::<L>(t, 3 * (pass * D + k) + 1)
+                    }
+                })
+            })
+        })
+        .collect();
+    let masks: [[L::Mask; D]; S] = core::array::from_fn(|_| {
+        core::array::from_fn(|k| if MASKED && k == 0 { all_ones } else { none })
+    });
+    let mut state = vec![[[SvfState::<L>::default(); D]; S]; passes];
+    let cycles = time_case(hz, || {
+        for (block, source) in blocks.iter_mut().zip(source.iter()) {
+            block.copy_from_slice(source);
+        }
+        for pass in 0..passes {
+            let mut each = blocks.iter_mut();
+            let io: [&mut [f32]; S] = core::array::from_fn(|_| each.next().unwrap().as_mut_slice());
+            if PEELED {
+                skewed_peeled::<L, S, D, MASKED>(black_box(io), QUANTUM, &coef[pass], &mut state[pass], &masks);
+            } else {
+                skewed::<L, S, D, MASKED>(black_box(io), QUANTUM, &coef[pass], &mut state[pass], &masks);
+            }
+        }
+    });
+    let net = cycles - refresh;
+    let lane_samples = (QUANTUM * L::WIDTH * S) as f64;
+    let tag = core::any::type_name::<L>().rsplit("::").next().unwrap_or("");
+    println!(
+        "{tag:<6} {name:<44} {cycles:>8.0} cyc/call  net {net:>8.0}  {:.3} cyc/lane-sample  {:.3} \
+         cyc/(ls x section)  {:.1} cyc/frame/pass",
+        net / lane_samples,
+        net / lane_samples / sections as f64,
+        net / (QUANTUM * passes) as f64
+    );
+    black_box(&state);
+}
+
+fn skew_sweep<L: Lane>(hz: f64) {
+    let mut ok = true;
+    ok &= skew_identity::<L, 2, 2, false>();
+    ok &= skew_identity::<L, 2, 2, true>();
+    ok &= skew_identity::<L, 2, 3, false>();
+    ok &= skew_identity::<L, 1, 2, false>();
+    ok &= skew_identity::<L, 1, 3, false>();
+    assert!(ok);
+    skew_time::<L, 2, 2, true, false>(hz, "skewed fixture pass: D2 masked [HPF id, bell]", 2);
+    skew_time::<L, 2, 2, true, true>(hz, "skewed-peeled fixture pass: D2 masked", 2);
+    skew_time::<L, 2, 2, false, false>(hz, "skewed 2 live D2 unmasked", 2);
+    skew_time::<L, 2, 2, false, true>(hz, "skewed-peeled 2 live D2 unmasked", 2);
+    skew_time::<L, 2, 2, false, true>(hz, "skewed-peeled 4 live D2 unmasked", 4);
+    skew_time::<L, 2, 2, false, true>(hz, "skewed-peeled 6 live D2 unmasked", 6);
+    skew_time::<L, 2, 3, false, true>(hz, "skewed-peeled 6 live D3 unmasked", 6);
+    skew_time::<L, 2, 6, false, true>(hz, "skewed-peeled 6 live D6 unmasked", 6);
+    skew_time::<L, 2, 4, false, true>(hz, "skewed-peeled 4 live D4 unmasked", 4);
+    skew_time::<L, 1, 2, false, true>(hz, "skewed-peeled mono 2 live D2 unmasked", 2);
+    skew_time::<L, 1, 3, false, true>(hz, "skewed-peeled mono 6 live D3 unmasked", 6);
+}
