+"""Find loops (backward branches) in an objdump -d listing of one function and summarise them.
+
+usage: python3 loops.py LISTING [--min N] [--dump START]
+"""
+import re
+import sys
+from collections import Counter
+
+path = sys.argv[1]
+minimum = 20
+dump = None
+if '--min' in sys.argv:
+    minimum = int(sys.argv[sys.argv.index('--min') + 1])
+if '--dump' in sys.argv:
+    dump = int(sys.argv[sys.argv.index('--dump') + 1], 16)
+
+insns = []
+line_re = re.compile(r'^\s*([0-9a-f]+):\s+(\S.*)$')
+for line in open(path):
+    m = line_re.match(line)
+    if not m:
+        continue
+    addr = int(m.group(1), 16)
+    text = m.group(2).strip()
+    insns.append((addr, text))
+
+index_of = {a: i for i, (a, _) in enumerate(insns)}
+loops = []
+for i, (addr, text) in enumerate(insns):
+    parts = text.split()
+    if not parts or not parts[0].startswith('j'):
+        continue
+    target = re.search(r'\b([0-9a-f]+) <', text)
+    if not target:
+        continue
+    t = int(target.group(1), 16)
+    if t <= addr and t in index_of:
+        start = index_of[t]
+        body = insns[start:i + 1]
+        loops.append((t, addr, body))
+
+for t, end, body in loops:
+    if len(body) < minimum:
+        continue
+    ops = Counter(b[1].split()[0] for b in body)
+    loads = sum(1 for _, x in body if '(' in x and not x.split()[0].startswith(('lea', 'j', 'nop')))
+    print(f"loop {t:x}-{end:x}: {len(body)} insns")
+    print("   ", ", ".join(f"{k} {v}" for k, v in sorted(ops.items(), key=lambda kv: -kv[1])))
+    mem_ops = [x for _, x in body if '(' in x and not x.split()[0].startswith(('lea', 'nop'))]
+    print(f"    memory-operand instructions: {len(mem_ops)}")
+    if dump is not None and t == dump:
+        for a, x in body:
+            print(f"      {a:x}: {x}")
