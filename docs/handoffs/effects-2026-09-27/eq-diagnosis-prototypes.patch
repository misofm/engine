+/// Prototype kernel: section `k` of every stream runs frame `i - k` in iteration `i`. Each
+/// chain sees the same inputs in the same order through the same `svf_step` and output mix.
+#[inline(always)]
+fn diag_skewed<L: Lane, const S: usize, const D: usize, const MASKED: bool>(
+    io: [&mut [f32]; S],
+    frames: usize,
+    c: &[[SvfCoef<L>; D]; S],
+    s: &mut [[SvfState<L>; D]; S],
+    masks: &[[L::Mask; D]; S],
+) {
+    let w = L::WIDTH;
+    let span = frames * w;
+    let mut io = io.map(|block| &mut block[..span]);
+    let mut state = *s;
+    let nc1: [[L; D]; S] = core::array::from_fn(|t| core::array::from_fn(|k| c[t][k].c1.neg()));
+    let mut carry: [[L; D]; S] = [[L::zero(); D]; S];
+    macro_rules! step {
+        ($i:expr, $t:expr, $k:expr) => {{
+            let (i, t, k) = ($i, $t, $k);
+            let f = i - k;
+            let x = if k == 0 {
+                L::load(&io[t][f * w..f * w + w])
+            } else {
+                carry[t][k - 1]
+            };
+            let coefficients = &c[t][k];
+            let (v1, v2) = lane::kernels::svf_step(
+                x,
+                nc1[t][k],
+                coefficients.a2,
+                coefficients.a3,
+                &mut state[t][k],
+            );
+            let wet = coefficients
+                .m2
+                .fma(v2, coefficients.m1.fma(v1, coefficients.m0.mul(x)));
+            let y = if MASKED { L::select(masks[t][k], x, wet) } else { wet };
+            if k == D - 1 {
+                y.store(&mut io[t][f * w..f * w + w]);
+            } else {
+                carry[t][k] = y;
+            }
+        }};
+    }
+    if frames < D {
+        svf_cascade_interleaved_with_dry_masks::<L, S, D>(io, frames, c, s, masks);
+        return;
+    }
+    for i in 0..D - 1 {
+        for t in 0..S {
+            for k in (0..=i).rev() {
+                step!(i, t, k);
+            }
+        }
+    }
+    for i in D - 1..frames {
+        for t in 0..S {
+            for k in (0..D).rev() {
+                step!(i, t, k);
+            }
+        }
+    }
+    for i in frames..frames + D - 1 {
+        for t in 0..S {
+            for k in (i + 1 - frames..D).rev() {
+                step!(i, t, k);
+            }
+        }
+    }
+    *s = state;
+}
