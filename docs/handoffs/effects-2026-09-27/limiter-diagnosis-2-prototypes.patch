@@ -0,0 +1,13 @@
+"""Normalise an objdump listing (drop addresses, jump targets, rip displacements) for diffing."""
+import re
+import sys
+
+for line in open(sys.argv[1]):
+    m = re.match(r'^\s+[0-9a-f]+:\s+(.*)$', line)
+    if not m:
+        continue
+    t = m.group(1).strip()
+    t = re.sub(r'\b[0-9a-f]+ <[^>]*>', 'TARGET', t)
+    t = re.sub(r'\[rip\+0x[0-9a-f]+\]', '[rip+X]', t)
+    t = re.sub(r'#.*$', '', t).strip()
+    print(t)
