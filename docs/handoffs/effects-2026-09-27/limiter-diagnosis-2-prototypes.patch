@@ -0,0 +1,50 @@
+"""Extract one loop body (excluding nested loops) from an objdump intel listing as llvm-mca input.
+
+usage: mca.py LISTING START_ADDR > body.s
+Branches are kept with a local label target so llvm-mca accounts their dispatch and port use.
+Nop padding is dropped.
+"""
+import re
+import sys
+
+path = sys.argv[1]
+start = int(sys.argv[2], 16)
+ins = []
+for line in open(path):
+    m = re.match(r'^\s+([0-9a-f]+):\s+(.*)$', line)
+    if not m:
+        continue
+    text = m.group(2).strip()
+    if not text or text.startswith('(bad)'):
+        continue
+    ins.append((int(m.group(1), 16), text))
+index = {a: i for i, (a, _) in enumerate(ins)}
+loops = []
+for i, (a, t) in enumerate(ins):
+    if t.split()[0].startswith('j'):
+        m = re.search(r'\b([0-9a-f]+) <', t)
+        if m:
+            target = int(m.group(1), 16)
+            if target <= a and target in index:
+                loops.append((index[target], i))
+by_head = {}
+for a, b in loops:
+    by_head[a] = max(by_head.get(a, b), b)
+loops = sorted(by_head.items())
+head = index[start]
+end = by_head[head]
+inner = [m for m in loops if m != (head, end) and m[0] >= head and m[1] <= end]
+print('.intel_syntax noprefix')
+print('.Lloop:')
+for i in range(head, end + 1):
+    if any(m[0] <= i <= m[1] for m in inner):
+        continue
+    t = ins[i][1]
+    t = re.sub(r'\s+#.*$', '', t)
+    op = t.split()[0]
+    if op.startswith('nop') or op.startswith('data16') or 'nop' in t.split()[:3]:
+        continue
+    if op.startswith('j'):
+        t = f'{op} .Lloop'
+    t = t.replace('YMMWORD PTR', 'ymmword ptr').replace('XMMWORD PTR', 'xmmword ptr').replace('DWORD PTR', 'dword ptr').replace('QWORD PTR', 'qword ptr')
+    print('  ' + t)
