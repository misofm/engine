+"""Loop census of a V8 --print-wasm-code listing (TurboFan section only).
+
+usage: v8loops.py LISTING [min_len] [--dump OFFSET_HEX]
+Adapted from the EQ verifier's v8loops.py. Nested loops' bodies are excluded from a loop's count.
+"""
+import collections
+import re
+import sys
+
+path = sys.argv[1]
+min_len = int(sys.argv[2]) if len(sys.argv) > 2 and not sys.argv[2].startswith('--') else 20
+dump = int(sys.argv[sys.argv.index('--dump') + 1], 16) if '--dump' in sys.argv else None
+lines = open(path).read().split('\n')
+start = max(i for i, l in enumerate(lines) if l.startswith('compiler: TurboFan'))
+ins = []
+for l in lines[start:]:
+    m = re.match(r'^0x[0-9a-f]+\s+([0-9a-f]+)\s+[0-9a-f]+\s+(.*)$', l)
+    if m:
+        ins.append((int(m.group(1), 16), m.group(2).strip()))
+    elif ins and l.startswith('Safepoints') or (ins and l.startswith('RelocInfo')):
+        break
+idx = {o: i for i, (o, _) in enumerate(ins)}
+back = {}
+for i, (o, t) in enumerate(ins):
+    m = re.search(r'<\+0x([0-9a-f]+)>', t)
+    if m and t.split()[0].startswith('j'):
+        target = int(m.group(1), 16)
+        if target <= o and target in idx:
+            h = idx[target]
+            back[h] = max(back.get(h, i), i)
+loops = sorted(back.items())
+for l in loops:
+    a, b = l
+    inner = [m for m in loops if m != l and m[0] >= a and m[1] <= b]
+    body = [ins[i] for i in range(a, b + 1) if not any(m[0] <= i <= m[1] for m in inner)]
+    if len(body) < min_len:
+        continue
+    ops = collections.Counter(t.split()[0] if not t.startswith('REX') else t.split()[1] for _, t in body)
+    vec = sum(v for k, v in ops.items() if k.startswith('v') and not k.startswith('vmov') and k not in ('vpcmpeqd',))
+    vmov_mem = sum(1 for _, t in body if t.startswith('vmov') and '[' in t)
+    spill = sum(1 for _, t in body if '[rbp' in t or '[rsp' in t)
+    heap = sum(1 for _, t in body if re.search(r'\[r\w+\+r\w+', t) and 'rbp' not in t and 'rsp' not in t)
+    gpr = sum(v for k, v in ops.items() if not k.startswith('v') and not k.startswith('j'))
+    jcc = sum(v for k, v in ops.items() if k.startswith('j'))
+    keys = ('vmulps', 'vaddps', 'vsubps', 'vdivps', 'vmaxps', 'vminps', 'vandps', 'vandnps', 'vcmpps', 'vblendvps', 'vpblendvb', 'vroundps', 'vxorps', 'vpcmpeqd', 'vpsrld', 'vpslld', 'vpand', 'vpandn', 'vpor')
+    print(f'loop +{ins[a][0]:#x}..+{ins[b][0]:#x} n={len(body)} nested={len(inner)} vec={vec} vmov-mem={vmov_mem} stack-refs={spill} gpr-ops={gpr} jcc={jcc} | ' + ' '.join(f'{k}={ops[k]}' for k in keys if ops[k]))
+    if dump is not None and ins[a][0] == dump:
+        for o, t in body:
+            print(f'   +{o:#x}: {t}')
