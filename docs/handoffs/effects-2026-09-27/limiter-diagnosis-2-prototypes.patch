+//! Limiter diagnosis round 2 native driver (scratch, never committed).
+//!
+//! Modelled on the #990 verifier's harness (`scratchpad/verify-990/harness`), whose scenario
+//! generator `src/lib.rs` is reused verbatim. One binary per compile-time variant
+//! (`LIMDIAG2=<bits>` at build time); A/B is run as separate binaries, interleaved.
+#![allow(clippy::all, missing_docs)]
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use effect_contract::{
+    AutomationSpanKind, BankWidth, EffectBankProcessBlock, LinkMode, NativeEffectFactory,
+    ParameterChannel, PrepareEffectBankRequest, PreparedAutomationSpan, PreparedNativeEffectBank,
+};
+use lane::Backend;
+use ld2::{Rng, request, run_scenario, values};
+use true_peak_limiter::TruePeakLimiterFactory;
+
+fn core_hz() -> f64 {
+    const ADDS: u64 = 200_000_000;
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let mut x = black_box(0.0_f32);
+        let d = black_box(1.0e-3_f32);
+        let start = Instant::now();
+        for _ in 0..ADDS {
+            x += d;
+        }
+        best = best.min(start.elapsed().as_secs_f64());
+        black_box(x);
+    }
+    3.0 * ADDS as f64 / best
+}
+
+fn p50(values: &mut [u64]) -> u64 {
+    values.sort_unstable();
+    values[values.len() / 2]
+}
+
+fn arg<T: std::str::FromStr>(args: &[String], index: usize, default: T) -> T {
+    args.get(index).and_then(|value| value.parse().ok()).unwrap_or(default)
+}
+
+fn tracks() -> usize {
+    std::env::var("LD2_TRACKS").ok().and_then(|v| v.parse().ok()).unwrap_or(64)
+}
+const FRAMES: usize = 128;
+const STAGED: usize = 16;
+
+fn noise(seed: u64, index: u64) -> f32 {
+    let mut m = seed.wrapping_add((index + 1).wrapping_mul(0x9E37_79B9_7F4A_7C15));
+    m = (m ^ (m >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    m = (m ^ (m >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    m ^= m >> 31;
+    ((m >> 40) as f32 * (1.0 / 16_777_216.0)) * 2.0 - 1.0
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Shape {
+    /// +3 dBFS noise, link maximum, symmetric: every track limiting, the #990 linked body.
+    HotLinked,
+    /// +3 dBFS noise, dual_mono: every track limiting, the dual body.
+    HotDualMono,
+    /// +3 dBFS noise, link maximum, right ceiling 0.25 dB lower: the dual body under Maximum.
+    HotAsym,
+    /// The console tone at 0.3 (never limits), linked.
+    QuietLinked,
+    /// Both channels retargeted every block: the ramping dispatch, linked.
+    RampLinked,
+    /// Per-track lookahead 1..8 ms: the ragged per-lane body.
+    RaggedLinked,
+    /// Exact zeros: the silent fast path.
+    Silence,
+}
+
+const SHAPES: [Shape; 7] = [
+    Shape::HotLinked,
+    Shape::HotDualMono,
+    Shape::HotAsym,
+    Shape::QuietLinked,
+    Shape::RampLinked,
+    Shape::RaggedLinked,
+    Shape::Silence,
+];
+
+struct Rig {
+    banks: Vec<Box<dyn PreparedNativeEffectBank>>,
+    width: BankWidth,
+    lanes: usize,
+    staged: Vec<(Vec<f32>, Vec<f32>)>,
+    io: Vec<(Vec<f32>, Vec<f32>)>,
+    offsets: Vec<u32>,
+    shape: Shape,
+    spans: Vec<Vec<PreparedAutomationSpan>>,
+    block: usize,
+}
+
+impl Rig {
+    fn new(lanes: usize, shape: Shape) -> Self {
+        let (width, backend) = if lanes == 8 {
+            (BankWidth::Eight, Backend::Simd8)
+        } else {
+            (BankWidth::Four, Backend::Simd4)
+        };
+        let link = if shape == Shape::HotDualMono { LinkMode::DualMono } else { LinkMode::Maximum };
+        let tables: Vec<_> = (0..tracks())
+            .map(|track| {
+                let ceiling = -0.5 - 0.031_25 * track as f32;
+                let release = 60.0 + 1.25 * track as f32;
+                let lookahead = if shape == Shape::RaggedLinked { 1.0 + (track % 8) as f32 } else { 5.0 };
+                let right_ceiling = if shape == Shape::HotAsym { ceiling - 0.25 } else { ceiling };
+                values([ceiling, release, lookahead], [right_ceiling, release, lookahead])
+            })
+            .collect();
+        let banks: Vec<_> = (0..tracks() / lanes)
+            .map(|bank| {
+                let requests: Vec<_> = (0..lanes)
+                    .map(|lane| request(48_000, FRAMES as u32, false, link, &tables[bank * lanes + lane]))
+                    .collect();
+                TruePeakLimiterFactory
+                    .bind_homogeneous_bank(PrepareEffectBankRequest { backend, width, requests: &requests })
+                    .expect("bank")
+                    .expect("bound")
+            })
+            .collect();
+        let amplitude = match shape {
+            Shape::QuietLinked => 0.3,
+            Shape::Silence => 0.0,
+            _ => 1.412_537_5,
+        };
+        let mut staged = Vec::new();
+        for block in 0..STAGED {
+            for bank in 0..tracks() / lanes {
+                let mut left = vec![0.0; FRAMES * lanes];
+                let mut right = vec![0.0; FRAMES * lanes];
+                for frame in 0..FRAMES {
+                    for lane in 0..lanes {
+                        let track = (bank * lanes + lane) as u64;
+                        let at = (block * FRAMES + frame) as u64;
+                        if shape == Shape::QuietLinked {
+                            let value = ((at as f32) * 0.017 + track as f32 * 0.31).sin() * amplitude;
+                            left[frame * lanes + lane] = value;
+                            right[frame * lanes + lane] = -value * 0.75;
+                        } else {
+                            left[frame * lanes + lane] = noise(track << 20, at) * amplitude;
+                            right[frame * lanes + lane] = noise((track << 20) | 1 << 19, at) * amplitude;
+                        }
+                    }
+                }
+                staged.push((left, right));
+            }
+        }
+        let io = (0..tracks() / lanes).map(|_| (vec![0.0; FRAMES * lanes], vec![0.0; FRAMES * lanes])).collect();
+        let mut offsets = vec![0_u32; lanes + 1];
+        if shape == Shape::RampLinked {
+            for lane in 0..lanes {
+                offsets[lane + 1] = 2 * (lane as u32 + 1);
+            }
+        }
+        Self { banks, width, lanes, staged, io, offsets, shape, spans: Vec::new(), block: 0 }
+    }
+
+    fn stage(&mut self) {
+        let banks = self.banks.len();
+        let from = (self.block % STAGED) * banks;
+        for (bank, io) in self.io.iter_mut().enumerate() {
+            io.0.copy_from_slice(&self.staged[from + bank].0);
+            io.1.copy_from_slice(&self.staged[from + bank].1);
+        }
+        self.spans.clear();
+        if self.shape == Shape::RampLinked {
+            let first = (self.block * FRAMES) as u64;
+            let value = if self.block % 2 == 0 { -3.0 } else { -2.0 };
+            for _ in 0..banks {
+                let mut spans = Vec::new();
+                for _ in 0..self.lanes {
+                    for channel in [ParameterChannel::Left, ParameterChannel::Right] {
+                        spans.push(PreparedAutomationSpan {
+                            kind: AutomationSpanKind::Point,
+                            channel,
+                            parameter_index: 0,
+                            start_sample: first,
+                            end_sample: first,
+                            start_value: value,
+                            end_value: value,
+                        });
+                    }
+                }
+                self.spans.push(spans);
+            }
+        }
+    }
+
+    fn process(&mut self) {
+        let first = (self.block * FRAMES) as u64;
+        let empty: &[PreparedAutomationSpan] = &[];
+        let zero_offsets = vec![0_u32; self.lanes + 1];
+        for (index, (bank, io)) in self.banks.iter_mut().zip(self.io.iter_mut()).enumerate() {
+            let (spans, offsets) = match self.spans.get(index) {
+                Some(spans) => (spans.as_slice(), self.offsets.as_slice()),
+                None => (empty, zero_offsets.as_slice()),
+            };
+            bank.process_bank(
+                EffectBankProcessBlock::new(&mut io.0, &mut io.1, None, FRAMES as u32, self.width, first, spans, offsets, FRAMES as u32)
+                    .expect("block"),
+            );
+        }
+        self.block += 1;
+    }
+
+    fn deepest(&self) -> f32 {
+        let mut deepest = 0.0_f32;
+        let mut out = vec![effect_contract::ObservationSample::default(); self.lanes];
+        for bank in &self.banks {
+            assert!(bank.observe_resident_bank(0, &mut out));
+            for sample in &out {
+                deepest = deepest.max(sample.left).max(sample.right);
+            }
+        }
+        deepest
+    }
+
+    fn checksum(&self) -> u32 {
+        self.io.iter().fold(0_u32, |acc, io| io.0.iter().chain(io.1.iter()).fold(acc, |a, v| a.rotate_left(5) ^ v.to_bits()))
+    }
+}
+
+fn loadavg() -> String {
+    std::fs::read_to_string("/proc/loadavg").unwrap_or_default().trim().to_string()
+}
+
+fn kbench(args: &[String]) {
+    let label = args.get(2).cloned().unwrap_or_default();
+    let rounds: usize = arg(args, 3, 4);
+    let blocks: usize = arg(args, 4, 1200);
+    let hz = core_hz();
+    println!("[{label}] core {:.3} GHz, load {}", hz / 1e9, loadavg());
+    let ls = (tracks() * 2 * FRAMES) as f64;
+    let filter = std::env::var("LD2_SHAPES").unwrap_or_default();
+    let widths: Vec<usize> = std::env::var("LD2_WIDTHS").unwrap_or_else(|_| "8,4".into()).split(',').map(|w| w.parse().unwrap()).collect();
+    for lanes in widths {
+        for shape in SHAPES {
+            if !filter.is_empty() && !filter.split(',').any(|f| f == format!("{shape:?}")) {
+                continue;
+            }
+            let mut rig = Rig::new(lanes, shape);
+            for _ in 0..200 {
+                rig.stage();
+                rig.process();
+            }
+            let mut per_round = Vec::new();
+            for _ in 0..rounds {
+                let mut t = Vec::with_capacity(blocks);
+                for _ in 0..blocks {
+                    rig.stage();
+                    let start = Instant::now();
+                    rig.process();
+                    t.push(start.elapsed().as_nanos() as u64);
+                }
+                black_box(rig.checksum());
+                per_round.push(p50(&mut t) as f64 * 1e-9 * hz / ls);
+            }
+            let text: Vec<String> = per_round.iter().map(|v| format!("{v:.3}")).collect();
+            per_round.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            println!(
+                "[{label}] W{lanes} {:<13} cyc/ls med {:.3} min {:.3} rounds [{}] deepest {:.3}",
+                format!("{shape:?}"),
+                per_round[per_round.len() / 2],
+                per_round[0],
+                text.join(" "),
+                rig.deepest()
+            );
+        }
+    }
+    println!("[{label}] end load {}", loadavg());
+}
+
+fn diff(args: &[String]) {
+    let width: usize = arg(args, 2, 8);
+    let start: u64 = arg(args, 3, 0);
+    let count: u64 = arg(args, 4, 100);
+    let blocks: usize = arg(args, 5, 96);
+    let mut all = ld2::Fnv::new();
+    let mut linked = 0_u64;
+    for seed in start..start + count {
+        let o = run_scenario(seed, width, blocks);
+        all.u64(o.digest);
+        linked += u64::from(o.linked_candidates);
+        if std::env::var("LD2_VERBOSE").is_ok() {
+            println!("W{width} seed {seed} digest {:016x}", o.digest);
+        }
+    }
+    println!("W{width} seeds {start}..{} blocks {blocks}: combined {:016x} linked-candidate blocks {linked}", start + count, all.finish());
+}
+
+#[cfg(feature = "console")]
+mod console {
+    use super::*;
+    use console_workload::{PlanConfig, SOURCE_BLOCK_VALUES, SessionRuntime, SourceSignal, Workload};
+
+    pub fn hot(amplitude: f32) -> SourceSignal {
+        let mut table = vec![0.0_f32; 64 * SOURCE_BLOCK_VALUES];
+        for (index, value) in table.iter_mut().enumerate() {
+            *value = noise(0x0990_C0DE, index as u64) * amplitude;
+        }
+        SourceSignal::Injected(table)
+    }
+
+    fn source(name: &str) -> SourceSignal {
+        match name {
+            "hot20" => hot(10.0),
+            _ => SourceSignal::Local,
+        }
+    }
+
+    pub fn digests() {
+        for backend in [Backend::Simd8, Backend::Simd4] {
+            for name in ["hot20", "tone"] {
+                for workload in [Workload::SixtyFourTrackConsole, Workload::SixtyFourTrackEqCompSimd1] {
+                    let mut runtime = SessionRuntime::build_full(workload, PlanConfig::BASELINE, backend, source(name));
+                    let mut sink = bench_support::digest::Sha256Sink::new();
+                    for observation in 0..64 {
+                        runtime.render(observation).expect("render");
+                        runtime.hash_output(&mut sink);
+                    }
+                    println!("console digest {backend:?} {name} {} {}", workload.kind(), sink.finish_hex());
+                }
+            }
+        }
+    }
+
+    pub fn bench(args: &[String]) {
+        let label = args.get(2).cloned().unwrap_or_default();
+        let rounds: usize = arg(args, 3, 2);
+        let blocks: u64 = arg(args, 4, 1200);
+        let hz = core_hz();
+        println!("[{label}] core {:.3} GHz, load {}", hz / 1e9, loadavg());
+        let ls = (64 * 128 * 2) as f64;
+        let backends: Vec<Backend> = std::env::var("LD2_WIDTHS")
+            .unwrap_or_else(|_| "8,4".into())
+            .split(',')
+            .map(|w| if w == "8" { Backend::Simd8 } else { Backend::Simd4 })
+            .collect();
+        for backend in backends {
+            for name in ["hot20", "tone"] {
+                let mut medians = Vec::new();
+                for workload in [Workload::SixtyFourTrackConsole, Workload::SixtyFourTrackEqCompSimd1] {
+                    let mut runtime = SessionRuntime::build_full(workload, PlanConfig::BASELINE, backend, source(name));
+                    let mut observation = 0;
+                    for _ in 0..200 {
+                        runtime.render(observation).expect("render");
+                        observation += 1;
+                    }
+                    let mut per_round = Vec::new();
+                    for _ in 0..rounds {
+                        let mut t = Vec::with_capacity(blocks as usize);
+                        for _ in 0..blocks {
+                            let start = Instant::now();
+                            runtime.render(observation).expect("render");
+                            t.push(start.elapsed().as_nanos() as u64);
+                            observation += 1;
+                        }
+                        per_round.push(p50(&mut t) as f64 * 1e-9 * hz / ls);
+                    }
+                    let rounds_text: Vec<String> = per_round.iter().map(|v| format!("{v:.2}")).collect();
+                    per_round.sort_by(|a, b| a.partial_cmp(b).unwrap());
+                    medians.push(per_round[per_round.len() / 2]);
+                    println!("[{label}] {backend:?} {name:<5} {:<34} cyc/ls {}", workload.kind(), rounds_text.join(" "));
+                }
+                println!("[{label}] {backend:?} {name:<5} limiter isolate (console - eq_comp_simd1) {:.2}", medians[0] - medians[1]);
+            }
+        }
+        println!("[{label}] end load {}", loadavg());
+    }
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    match args.get(1).map(String::as_str) {
+        Some("diff") => diff(&args),
+        Some("kbench") => kbench(&args),
+        #[cfg(feature = "console")]
+        Some("cbench") => console::bench(&args),
+        #[cfg(feature = "console")]
+        Some("cdigests") => console::digests(),
+        _ => {
+            let _ = Rng(0);
+            eprintln!("usage: diff W start count blocks | kbench label rounds blocks | cbench label rounds blocks | cdigests");
+        }
+    }
+}
