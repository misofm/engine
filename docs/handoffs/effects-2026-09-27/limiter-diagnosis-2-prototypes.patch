+    ('tm-kbench-2.txt', 'native: tap-buffer detectors with index loops'),
+    ('unchk-kbench.txt', 'native: diagnostic unchecked rings / skipped backward pass (load 16-18)'),
+    ('vhseg-kbench.txt', 'native: van Herk segment boundary (load 20: absolute values inflated)'),
+    ('web-vhseg-1.txt', 'V8: segment boundary, fused form, diagnostics'),
+    ('web-pp-1.txt', 'V8: phase-pair detector'),
+    ('multi-1.txt', 'native: phase-pair, tap-buffer, segment-boundary variants'),
+    ('trunc-vhs.txt', 'native: truncations of base and of seed+segment-boundary'),
+    ('pads.txt', 'native: peak-array layout variants (4 KiB aliasing test)'),
+    ('bcf-1.txt', 'native: bounds-check-free linked pass (memcpy copies)'),
+    ('bcf-2.txt', 'native: bounds-check-free linked pass (lane-sized copies)'),
+    ('cold-1.txt', 'native: ramping and per-lane bodies out of line'),
+    ('web-lr-1.txt', 'V8: two-channel detector'),
+    ('st-1.txt', 'native: pass split restricted to the stationary dispatch'),
+    ('outdet-1.txt', 'native: detector out of line'),
+    ('final-native-1.txt', 'FINAL native kernel rig (load 17-20; min-of-rounds agrees with quiet-host runs)'),
+    ('final-console-1.txt', 'FINAL native console rows (in place)'),
