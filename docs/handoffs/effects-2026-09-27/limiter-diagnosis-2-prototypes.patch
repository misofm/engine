+"""Derive the limiter timing sessions from the standing 64-track console fixture.
+
+console : the fixture as is (EQ + compressor in SIMD rack 1, the limiter in SIMD rack 2)
+nolim   : the same minus the limiter (the directive's `eq_comp_simd1` isolate partner)
+lim     : the limiter alone (SIMD rack 1 empty)
+bi      : no effects (the limiter-alone partner)
+limdm   : the limiter alone with link_mode dual_mono (the dual gain body)
+"""
+import copy
+import json
+import sys
+
+src, out = sys.argv[1], sys.argv[2]
+base = json.load(open(src))
+
+
+def variant(name, simd1, simd2, link=None):
+    d = copy.deepcopy(base)
+    d['session_id'] = f'limiter-diag-2-{name}'
+    for s in d['sources']:
+        s['frames'] = '48000000'
+    for t in d['tracks']:
+        if not simd1:
+            t['simd1']['effects'] = []
+        if not simd2:
+            t['simd2']['effects'] = []
+        if link:
+            for e in t['simd2']['effects']:
+                e['link_mode'] = link
+    with open(f'{out}/web-{name}.json', 'w') as f:
+        json.dump(d, f, separators=(',', ':'))
+
+
+variant('console', True, True)
+variant('nolim', True, False)
+variant('lim', False, True)
+variant('bi', False, False)
+variant('limdm', False, True, 'dual_mono')
+print('ok')
