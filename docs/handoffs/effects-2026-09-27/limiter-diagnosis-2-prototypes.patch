+    ('split-trunc-64.txt', 'native: pass-split truncations, 64 tracks'),
+    ('split-trunc-8.txt', 'native: pass-split truncations, 8 tracks (working-set check)'),
+    ('chunk-kbench.txt', 'native: detector chunk 32/64/128 x seed x split'),
+    ('tm-kbench.txt', 'native: tap-buffer detectors, FIRST FORM (windows().step_by() iterators, cmov address selection); superseded'),
