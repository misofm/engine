+#!/bin/bash
+# usage: mca.sh LISTING ADDR [NAME] -> llvm-mca summary (znver3) of the loop at ADDR
+set -euo pipefail
+D=/tmp/claude-1002/-home-bl-misofm-engine/43895396-e183-427f-b08f-a0b72f15ae5f/scratchpad/limiter-diag-2
+listing=$1; addr=$2; name=${3:-$(basename "$listing" .s)-$addr}
+python3 "$D/py/mca.py" "$D/dis/$listing" "$addr" > "$D/mca/$name.s"
+out=$(llvm-mca -mtriple=x86_64-unknown-linux-gnu -mcpu=znver3 -iterations=300 -timeline=false \
+  -instruction-info=false -resource-pressure=false "$D/mca/$name.s" 2>&1)
+ins=$(grep -m1 "^Instructions:" <<<"$out" | awk '{print $2}')
+cyc=$(grep -m1 "^Total Cycles:" <<<"$out" | awk '{print $3}')
+rt=$(grep -m1 "Block RThroughput" <<<"$out" | awk '{print $3}')
+echo "$name: $((ins / 300)) instructions/iteration, mca $(echo "scale=1; $cyc / 300" | bc) cycles/iteration, port-bound (RThroughput) $rt"
