@@ -0,0 +1,29 @@
+// Run one limiter session long enough for TurboFan tier-up (used with --print-wasm-code-function-index).
+// usage: node --print-wasm-code-function-index=N v8dump.mjs ARM.wasm SESSION
+import { readFileSync } from 'node:fs';
+const D = '/tmp/claude-1002/-home-bl-misofm-engine/43895396-e183-427f-b08f-a0b72f15ae5f/scratchpad/limiter-diag-2';
+const [file, session] = process.argv.slice(2);
+const Q = 128;
+const e = new WebAssembly.Instance(new WebAssembly.Module(readFileSync(file)), {}).exports;
+const doc = readFileSync(`${D}/web/web-${session}.json`);
+const opt = e.miso_engine_web_v1_boot_options_ptr();
+const view = new DataView(e.memory.buffer, opt, 64);
+view.setUint32(0, 64, true); view.setUint32(4, 0x00010000, true);
+view.setUint32(8, 48000, true); view.setUint32(12, Q, true); view.setUint32(16, 8192, true);
+view.setUint32(20, 0, true); view.setBigUint64(24, 0n, true);
+for (let i = 0; i < 4; i++) view.setBigUint64(32 + i * 8, 0n, true);
+const p = e.miso_engine_web_v1_document_ptr(doc.byteLength);
+new Uint8Array(e.memory.buffer, p, doc.byteLength).set(doc);
+const handle = e.miso_engine_web_v1_boot(doc.byteLength);
+if (handle === 0) throw new Error('boot');
+const idPtr = e.miso_engine_web_v1_buffer_ptr(handle, 2), pcmPtr = e.miso_engine_web_v1_buffer_ptr(handle, 3);
+const id = new TextEncoder().encode('fixture-source');
+let frame = 0n, seed = 0x12345678;
+for (let b = 0; b < 3000; b++) {
+  new Uint8Array(e.memory.buffer, idPtr, id.length).set(id);
+  const pcm = new Float32Array(e.memory.buffer, pcmPtr, 2 * Q);
+  for (let i = 0; i < 2 * Q; i++) { seed ^= seed << 13; seed ^= seed >>> 17; seed ^= seed << 5; pcm[i] = ((seed >>> 0) / 4294967296 * 2 - 1) * 4; }
+  if (e.miso_engine_web_v1_source_submit(handle, id.length, 1n, frame, 2, Q, 0) !== 0) throw new Error('submit');
+  frame += BigInt(Q);
+  if (b >= 4 && e.miso_engine_web_v1_render(handle, Q) !== 0) throw new Error('render');
+}
