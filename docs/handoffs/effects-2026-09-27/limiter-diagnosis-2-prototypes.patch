+// ------------------------------------------------------------------------------------------------
+// wasm exports: the same scenarios, driven from Node.
+
+static mut RESULT: [u32; 12] = [0; 12];
+
+#[unsafe(no_mangle)]
+pub extern "C" fn v990_run(seed_lo: u32, seed_hi: u32, width: u32, blocks: u32) -> u32 {
+    let seed = u64::from(seed_lo) | (u64::from(seed_hi) << 32);
+    let outcome = run_scenario(seed, width as usize, blocks as usize);
+    let words = [
+        outcome.digest as u32,
+        (outcome.digest >> 32) as u32,
+        outcome.blocks,
+        outcome.linked_candidates,
+        outcome.mono_blocks,
+        outcome.restores_ok,
+        outcome.restores_err,
+        outcome.nonfinite,
+        outcome.resets,
+        outcome.spans,
+        outcome.deepest.to_bits(),
+        0,
+    ];
+    unsafe {
+        let result = &mut *core::ptr::addr_of_mut!(RESULT);
+        *result = words;
+    }
+    1
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn v990_word(index: u32) -> u32 {
+    unsafe { (*core::ptr::addr_of!(RESULT))[index as usize] }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn v990_latency(width: u32, rate: u32) -> u32 {
+    let (ok, delay) = latency_check(width as usize, rate);
+    (u32::from(ok) << 31) | (delay as u32 & 0x7FFF_FFFF)
+}
