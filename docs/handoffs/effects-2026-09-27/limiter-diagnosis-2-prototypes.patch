@@ -0,0 +1,87 @@
+"""List the loops of one function in an `objdump -d -M intel --no-show-raw-insn` listing.
+
+usage: loops.py LISTING [min_len] [--dump ADDR] [--all]
+Prints per loop: address range, instruction count (excluding nested loops' bodies), and a census.
+A loop is a backward conditional or unconditional jump; its body is [target, jump].
+"""
+import collections
+import re
+import sys
+
+path = sys.argv[1]
+min_len = int(sys.argv[2]) if len(sys.argv) > 2 and not sys.argv[2].startswith('--') else 8
+dump = None
+if '--dump' in sys.argv:
+    dump = int(sys.argv[sys.argv.index('--dump') + 1], 16)
+show_all = '--all' in sys.argv
+
+ins = []
+for line in open(path):
+    m = re.match(r'^\s+([0-9a-f]+):\s+(.*)$', line)
+    if not m:
+        continue
+    text = m.group(2).strip()
+    if not text or text.startswith('(bad)'):
+        continue
+    ins.append((int(m.group(1), 16), text))
+index = {a: i for i, (a, _) in enumerate(ins)}
+loops = []
+for i, (a, t) in enumerate(ins):
+    op = t.split()[0]
+    if op.startswith('j'):
+        m = re.search(r'\b([0-9a-f]+) <', t)
+        if m:
+            target = int(m.group(1), 16)
+            if target <= a and target in index:
+                loops.append((index[target], i))
+loops = sorted(set(loops))
+# Merge loops sharing a header (several back edges): keep the widest.
+by_head = {}
+for a, b in loops:
+    by_head[a] = max(by_head.get(a, b), b)
+loops = sorted(by_head.items())
+
+
+def nested(l):
+    return [m for m in loops if m != l and m[0] >= l[0] and m[1] <= l[1]]
+
+
+def census(body):
+    c = collections.Counter()
+    for _, t in body:
+        c[t.split()[0]] += 1
+    return c
+
+
+VMOV = ('vmovaps', 'vmovups', 'vmovdqa', 'vmovdqu', 'vmovss', 'vmovd', 'vmovq')
+
+
+def classify(body):
+    c = census(body)
+    vec = sum(v for k, v in c.items() if k.startswith('v') and not k.startswith('vmov') and not k.startswith('vbroadcast') and k not in ('vzeroupper',))
+    moves_rr = sum(1 for _, t in body if t.split()[0] in VMOV and '[' not in t)
+    loads = sum(1 for _, t in body if (t.split()[0] in VMOV or t.split()[0] == 'vbroadcastss') and ',' in t and '[' in t.split(',', 1)[1])
+    stores = sum(1 for _, t in body if t.split()[0] in VMOV and ',' in t and '[' in t.split(',', 1)[0])
+    stack = sum(1 for _, t in body if '[rsp' in t or '[rbp' in t)
+    memar = sum(1 for _, t in body if t.split()[0].startswith('v') and not t.split()[0].startswith('vmov') and not t.split()[0].startswith('vbroadcast') and '[' in t)
+    gpr_mem = sum(1 for _, t in body if not t.split()[0].startswith('v') and '[' in t and not t.split()[0].startswith('lea'))
+    return c, vec, moves_rr, loads, stores, stack, memar, gpr_mem
+
+
+for l in loops:
+    a, b = l
+    inner = nested(l)
+    body = [ins[i] for i in range(a, b + 1) if not any(m[0] <= i <= m[1] for m in inner)]
+    if len(body) < min_len:
+        continue
+    if not show_all and inner and len(body) < 30:
+        continue
+    c, vec, moves_rr, loads, stores, stack, memar, gpr_mem = classify(body)
+    keys = ['vmulps', 'vaddps', 'vsubps', 'vdivps', 'vmaxps', 'vminps', 'vandps', 'vandnps', 'vcmpltps', 'vcmpnleps', 'vcmpleps', 'vblendvps', 'vroundps', 'vbroadcastss', 'vxorps', 'vfmadd213ps', 'vfmadd231ps', 'vsqrtps']
+    ks = ' '.join(f'{k[1:]}={c[k]}' for k in dict.fromkeys(keys) if c[k])
+    scal = ' '.join(f'{k}={c[k]}' for k in ('lea', 'cmp', 'test', 'mov', 'add', 'sub', 'inc', 'shl', 'imul', 'cmov') if c[k])
+    jcc = sum(v for k, v in c.items() if k.startswith('j'))
+    print(f'loop {ins[a][0]:#x}-{ins[b][0]:#x} n={len(body)} nested={len(inner)} vec-ops={vec} rr-moves={moves_rr} vloads={loads} vstores={stores} stack={stack} mem-arith={memar} gpr-mem={gpr_mem} jcc={jcc} | {ks} | {scal}')
+    if dump is not None and ins[a][0] == dump:
+        for addr, t in body:
+            print(f'   {addr:#x}: {t}')
