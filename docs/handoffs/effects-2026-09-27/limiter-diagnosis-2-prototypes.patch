+#!/bin/bash
+# usage: abba.sh MODE ROUNDS BLOCKS PASSES bin1 bin2 ...  (run under the timing lock, pinned)
+# Runs the binaries in forward then reverse order, PASSES times, each with `MODE label ROUNDS BLOCKS`.
+set -u
+D=/tmp/claude-1002/-home-bl-misofm-engine/43895396-e183-427f-b08f-a0b72f15ae5f/scratchpad/limiter-diag-2
+mode=$1; rounds=$2; blocks=$3; passes=$4; shift 4
+bins=("$@")
+echo "abba start $(date +%T) load $(cat /proc/loadavg)"
+for ((p = 0; p < passes; p++)); do
+  order=("${bins[@]}")
+  if ((p % 2 == 1)); then
+    order=()
+    for ((i = ${#bins[@]} - 1; i >= 0; i--)); do order+=("${bins[i]}"); done
+  fi
+  for b in "${order[@]}"; do
+    taskset -c 31 "$D/bin/$b" "$mode" "$b" "$rounds" "$blocks"
+  done
+done
+echo "abba end $(date +%T) load $(cat /proc/loadavg)"
