+/// Diagnosis round 2, `P_BCF`: the steady pass 1 of a linked pair over `steady` frames with every
+/// stream an exact-length `chunks_exact` view, so the loop carries no bounds check.
+///
+/// Legal when `window < ring` and `steady <= ring - window`: then, inside the segment, the window's
+/// newest slot (`end + s`) and the box term leaving the sum (`expiring + s`) are never written before
+/// they are read, and the oldest slot (`start + s = cursor + 1 + s`) is written only at frame `s + 1`,
+/// after frame `s` read it. So the three read streams hold, at segment entry, exactly the words the
+/// frame loop would read, and are copied out once; the cursor streams are then disjoint mutable
+/// views. Every value is computed by [`linked_target_steady`]'s operations on the same operands.
+#[inline(always)]
+#[allow(clippy::too_many_arguments)]
+fn linked_pass1_bcf<L: Lane, const DISPATCH: u8>(
+    left_peaks: &[f32],
+    right_peaks: &[f32],
+    targets: &mut [f32],
+    stationary: bool,
+    hot: &mut HotChannel<L>,
+    left: &mut UniformHot<'_, L>,
+    right: &mut UniformHot<'_, L>,
+    slots: FrameSlots,
+    steady: usize,
+) {
+    let width = L::WIDTH;
+    let words = steady * width;
+    let mut end_copy = [0.0_f32; DETECTOR_CHUNK * MAXIMUM_WIDTH];
+    let mut start_copy = [0.0_f32; DETECTOR_CHUNK * MAXIMUM_WIDTH];
+    let mut expiring_copy = [0.0_f32; DETECTOR_CHUNK * MAXIMUM_WIDTH];
+    // Lane-sized copies, so the loop's loads forward from same-sized stores (a `memcpy` would not).
+    let copy = |dst: &mut [f32], src: &[f32]| {
+        for (d, s) in dst.chunks_exact_mut(width).zip(src.chunks_exact(width)) {
+            L::load(s).store(d);
+        }
+    };
+    copy(&mut end_copy[..words], &left.required_ring[slots.end * width..][..words]);
+    copy(&mut start_copy[..words], &left.required_ring[slots.start * width..][..words]);
+    copy(&mut expiring_copy[..words], &left.box_ring[slots.expiring * width..][..words]);
+    let cursor = slots.ring_cursor * width;
+    let required_left = &mut left.required_ring[cursor..][..words];
+    let required_right = &mut right.required_ring[cursor..][..words];
+    let box_left = &mut left.box_ring[cursor..][..words];
+    let box_right = &mut right.box_ring[cursor..][..words];
+    let one = L::splat(1.0);
+    let mut prefix = left.prefix;
+    let mut box_sum = hot.box_sum;
+    let window = hot.window;
+    for (((((((((left_peak, right_peak), target), newest), oldest), expired), req_l), req_r), box_l), box_r) in
+        left_peaks[..words]
+            .chunks_exact(width)
+            .zip(right_peaks[..words].chunks_exact(width))
+            .zip(targets[..words].chunks_exact_mut(width))
+            .zip(end_copy[..words].chunks_exact(width))
+            .zip(start_copy[..words].chunks_exact(width))
+            .zip(expiring_copy[..words].chunks_exact(width))
+            .zip(required_left.chunks_exact_mut(width))
+            .zip(required_right.chunks_exact_mut(width))
+            .zip(box_left.chunks_exact_mut(width))
+            .zip(box_right.chunks_exact_mut(width))
+    {
+        let limit = ramp_value::<DISPATCH, L>(stationary, &mut hot.limit);
+        let peak = L::load(right_peak).max(L::load(left_peak));
+        let required = L::select(peak.gt(limit), limit.div(peak), one);
+        required.store(req_l);
+        required.store(req_r);
+        let running = prefix.min(L::load(newest));
+        prefix = running;
+        let minimum = L::load(oldest).min(running);
+        let quantised = minimum
+            .mul(L::splat(BOX_GRID))
+            .floor()
+            .mul(L::splat(1.0 / BOX_GRID));
+        box_sum = box_sum.add(quantised).sub(L::load(expired));
+        quantised.store(box_l);
+        quantised.store(box_r);
+        one.sub(box_sum.div(window)).store(target);
+    }
+    left.prefix = prefix;
+    hot.box_sum = box_sum;
+}
