+"""Extract one function from `wasm-objdump -d` and print its normalised body or its loop census.
+
+usage: wfn.py LISTING REGEX [--body | --loops]
+--body prints the instructions with indices/offsets and function numbers stripped (for diffing).
+--loops prints, per wasm `loop` block, the number of instructions directly in it (excluding
+nested loops) and an opcode census of the interesting families.
+"""
+import collections
+import re
+import sys
+
+path, pattern = sys.argv[1], re.compile(sys.argv[2])
+mode = sys.argv[3] if len(sys.argv) > 3 else '--loops'
+funcs = []
+cur = None
+for line in open(path):
+    m = re.match(r'^[0-9a-f]+ func\[(\d+)\] <(.*)>:', line)
+    if m:
+        cur = (m.group(2), [])
+        funcs.append(cur)
+        continue
+    if cur is not None and '|' in line:
+        ins = line.split('|', 1)[1].strip()
+        ins = re.sub(r'<[^>]*>', '', ins).strip()
+        if ins:
+            cur[1].append(ins)
+matches = [f for f in funcs if pattern.search(f[0])]
+if len(matches) != 1:
+    print(f'{len(matches)} matches:', [m[0][-80:] for m in matches])
+    if not matches:
+        sys.exit(1)
+name, body = matches[0]
+if mode == '--body':
+    for ins in body:
+        print(re.sub(r'\b\d+\b', 'N', ins))
+    sys.exit(0)
+print(name[-90:], len(body), 'instructions')
+ops = collections.Counter(i.split()[0] for i in body)
+print('whole function:', ' '.join(f'{k}={ops[k]}' for k in ('loop', 'f32x4.mul', 'f32x4.add', 'f32x4.sub', 'f32x4.div', 'v128.load', 'v128.store', 'v128.bitselect', 'local.get', 'local.set', 'local.tee', 'br_if', 'i32.add', 'i32.mul', 'i32.shl')))
+# Loop census: track block nesting; a loop's direct body excludes nested loops.
+stack = []  # (kind, start_index, counter)
+loops = []
+for i, ins in enumerate(body):
+    op = ins.split()[0]
+    if op in ('block', 'loop', 'if'):
+        stack.append([op, i, collections.Counter(), 0])
+        continue
+    if op == 'end':
+        if stack:
+            kind, start, c, n = stack.pop()
+            if kind == 'loop':
+                loops.append((start, i, c, n))
+                # a nested loop's instructions are not the parent's
+            else:
+                # fold a block/if's counts into the enclosing construct
+                if stack:
+                    stack[-1][2].update(c)
+                    stack[-1][3] += n
+        continue
+    if stack:
+        stack[-1][2][op] += 1
+        stack[-1][3] += 1
+FAM = ('f32x4.mul', 'f32x4.add', 'f32x4.sub', 'f32x4.div', 'f32x4.max', 'f32x4.min', 'f32x4.pmax', 'f32x4.pmin', 'f32x4.abs', 'f32x4.floor', 'f32x4.gt', 'f32x4.lt', 'v128.bitselect', 'v128.and', 'v128.andnot', 'v128.load', 'v128.store', 'v128.const', 'local.get', 'local.set', 'local.tee', 'i32.add', 'i32.mul', 'i32.shl', 'i32.lt_u', 'i32.ge_u', 'br_if', 'br')
+for start, end, c, n in sorted(loops):
+    if n < 20:
+        continue
+    fp = sum(v for k, v in c.items() if k.startswith('f32x4.') or k.startswith('v128.') and k not in ('v128.load', 'v128.store', 'v128.const'))
+    i32 = sum(v for k, v in c.items() if k.startswith('i32.') or k.startswith('i64.'))
+    print(f'loop@{start} n={n} simd-arith={fp} i32/i64={i32} | ' + ' '.join(f'{k}={c[k]}' for k in FAM if c[k]))
