--- /dev/null
+++ b/docs/handoffs/effects-2026-09-27/limiter-diag-2-harness/scripts/detaddr.py
@@ -0,0 +1,32 @@
+"""For each detector loop (48 vmulps) in an objdump listing, print the stack offsets it loads and
+the address expression of its peak store, and flag 4 KiB-aliasing candidates (low 12 bits)."""
+import re
+import sys
+
+lines = []
+for line in open(sys.argv[1]):
+    m = re.match(r'^\s+([0-9a-f]+):\s+(.*)$', line)
+    if m:
+        lines.append((int(m.group(1), 16), m.group(2).strip()))
+idx = {a: i for i, (a, _) in enumerate(lines)}
+for i, (a, t) in enumerate(lines):
+    op = t.split()[0]
+    m = re.search(r'\b([0-9a-f]+) <', t)
+    if not (op.startswith('j') and m):
+        continue
+    target = int(m.group(1), 16)
+    if target > a or target not in idx:
+        continue
+    body = lines[idx[target]:i + 1]
+    if sum(1 for _, x in body if x.startswith('vmulps')) != 48:
+        continue
+    loads = sorted({int(x, 16) for _, s in body for x in re.findall(r'\[rsp\+0x([0-9a-f]+)\]', s)})
+    stores = [s for _, s in body if s.startswith('vmovups') and s.split(',')[0].count('[')]
+    print(f'loop {target:#x}: {len(body)} ins; stack loads {len(loads)} offsets {min(loads):#x}..{max(loads):#x}; stores: {stores}')
+    for s in stores:
+        m2 = re.search(r'\[rsp\+(\w+)\*1\+0x([0-9a-f]+)\]', s)
+        if m2:
+            base = int(m2.group(2), 16)
+            span = range(base, base + 32 * 32, 32)
+            hits = sorted({o for o in loads for b in span if ((o - b) % 4096) < 32 or ((b - o) % 4096) < 32})
+            print(f'   peak store base {base:#x} (low12 {base & 0xfff:#x}); coefficient/tap slots within 32 B of a peak store mod 4 KiB: {[hex(h) for h in hits]}')
