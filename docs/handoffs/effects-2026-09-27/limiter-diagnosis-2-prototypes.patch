@@ -0,0 +1,32 @@
+"""Summarise cbench raw output: per arm, backend and signal, the min over all rounds of the console
+and eq_comp_simd1 rows, and the limiter isolate (min console - min eq_comp)."""
+import collections
+import re
+import sys
+
+rows = collections.defaultdict(list)
+arms = []
+for line in open(sys.argv[1]):
+    m = re.match(r'^\[(\S+)\] (Simd\d) (\S+)\s+(sixty_four_track_\S+)\s+cyc/ls ([\d. ]+)$', line.strip())
+    if m:
+        arm, backend, signal, workload, vals = m.groups()
+        rows[(arm, backend, signal, workload)].extend(float(v) for v in vals.split())
+        if arm not in arms:
+            arms.append(arm)
+base = arms[0]
+print(f"{'row':<14}" + ''.join(f'{a:>30}' for a in arms))
+for backend in ('Simd8', 'Simd4'):
+    for signal in ('hot20', 'tone'):
+        line = f'{backend} {signal:<8}'
+        b = None
+        for arm in arms:
+            c = min(rows[(arm, backend, signal, 'sixty_four_track_console')])
+            e = min(rows[(arm, backend, signal, 'sixty_four_track_eq_comp_simd1')])
+            iso = c - e
+            if arm == base:
+                b = iso
+                line += f'{c:>9.2f} {e:>6.2f} iso {iso:5.2f}      '
+            else:
+                line += f'{c:>9.2f} {e:>6.2f} iso {iso:5.2f} ({100 * (iso / b - 1):+.0f}%)'
+        print(line)
+print('cells: min console, min eq_comp_simd1, limiter isolate (cycles per lane-sample)')
diff --git a/docs/handoffs/effects-2026-09-27/limiter-diag-2-harness/scripts/detaddr.py b/docs/handoffs/effects-2026-09-27/limiter-diag-2-harness/scripts/detaddr.py
