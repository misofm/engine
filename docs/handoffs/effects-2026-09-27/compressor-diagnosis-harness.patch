+
+/// Variants that must be word-identical to the real kernel on the given parameter set.
+pub fn equivalent(name: &str, params: &[f32; 7]) -> bool {
+    if name.contains("stage") {
+        return false;
+    }
+    let all_wet = params[6] == 1.0;
+    if (name.contains("wet") || name.contains("lean")) && !all_wet {
+        return false;
+    }
+    true
+}
+
+// ---------------------------------------------------------------------------------------------
+// Inputs
+// ---------------------------------------------------------------------------------------------
+
+pub fn noise_planes(lanes: usize, blocks: usize, seed: u64, amplitude: f32) -> Vec<(Vec<f32>, Vec<f32>)> {
+    let mut generator = SplitMix64::new(seed);
+    (0..blocks)
+        .map(|_| {
+            let mut left = vec![0.0_f32; FRAMES * lanes];
+            let mut right = vec![0.0_f32; FRAMES * lanes];
+            for value in left.iter_mut().chain(right.iter_mut()) {
+                *value = generator.next_bipolar_f32() * amplitude;
+            }
+            (left, right)
+        })
+        .collect()
+}
+
+/// Hostile words: signed zeros, subnormals, huge finite, infinities, NaN payloads, and ordinary
+/// audio, placed per lane so every lane sees every class over the run.
+pub fn hostile_planes(lanes: usize, blocks: usize, seed: u64) -> Vec<(Vec<f32>, Vec<f32>)> {
+    let mut generator = SplitMix64::new(seed);
+    let specials = [
+        -0.0_f32,
+        0.0,
+        f32::from_bits(1),
+        -f32::from_bits(0x0000_1234),
+        f32::MIN_POSITIVE,
+        1.0e-30,
+        1.0e29,
+        -3.0e30,
+        f32::INFINITY,
+        f32::NEG_INFINITY,
+        f32::from_bits(0x7fc0_1234),
+        f32::from_bits(0xffa0_0001),
+        1.0,
+        -1.0,
+    ];
+    (0..blocks)
+        .map(|block| {
+            let mut left = vec![0.0_f32; FRAMES * lanes];
+            let mut right = vec![0.0_f32; FRAMES * lanes];
+            for (index, value) in left.iter_mut().chain(right.iter_mut()).enumerate() {
+                let r = generator.next_u64();
+                // Specials sparsely, on a quarter of the blocks, so most blocks survive the
+                // boundary check and the recursive words keep evolving.
+                *value = if block % 4 == 3 && r % 29 == 0 {
+                    specials[(r as usize / 29 + index) % specials.len()]
+                } else if r % 7 == 0 {
+                    if r % 2 == 0 { -0.0 } else { 0.0 }
+                } else {
+                    generator.next_bipolar_f32() * if block % 3 == 0 { 1.5 } else { 0.2 }
+                };
+            }
+            (left, right)
+        })
+        .collect()
+}
+
+// ---------------------------------------------------------------------------------------------
+// verify
+// ---------------------------------------------------------------------------------------------
+
+pub fn compare_words(a: &[f32], b: &[f32]) -> (usize, usize) {
+    // (mismatching non-NaN words, NaN words that are NaN in both but differ in payload)
+    let mut hard = 0;
+    let mut nan_payload = 0;
+    for (x, y) in a.iter().zip(b) {
+        if x.to_bits() == y.to_bits() {
+            continue;
+        }
+        if x.is_nan() && y.is_nan() {
+            nan_payload += 1;
+        } else {
+            hard += 1;
+        }
+    }
+    (hard, nan_payload)
+}
+
+pub fn verify_width<L: Lane>(label: &str) -> bool {
+    let mut ok = true;
+    let links = [LinkMode::DualMono, LinkMode::Maximum, LinkMode::Average];
+    for (params_name, params) in [
+        ("fixture", FIXTURE),
+        ("compressing", COMPRESSING),
+        ("parallel", PARALLEL),
+    ] {
+        for link_mode in links {
+            for (input_name, inputs) in [
+                ("noise", noise_planes(L::WIDTH, 48, 0xC0_4455, 1.0)),
+                ("hostile", hostile_planes(L::WIDTH, 48, 0xBAD_F00D)),
+            ] {
+                for name in VARIANTS {
+                    if !equivalent(name, &params) {
+                        continue;
+                    }
+                    // DualMono-only structures are compared on DualMono only.
+                    if (name.contains("dm") || name.contains("lean") || name.contains("split"))
+                        && !matches!(link_mode, LinkMode::DualMono)
+                    {
+                        continue;
+                    }
+                    let mut real = DiagBank::<L>::new(metadata(link_mode), params);
+                    let words = real.words();
+                    let mut state = [L::zero(); 2];
+                    let mut hard = 0;
+                    let mut nan_payload = 0;
+                    let mut state_mismatch = 0;
+                    for (source_left, source_right) in &inputs {
+                        let (mut a_left, mut a_right) = (source_left.clone(), source_right.clone());
+                        let (mut b_left, mut b_right) = (source_left.clone(), source_right.clone());
+                        real.kernel(&mut a_left, &mut a_right, FRAMES);
+                        dispatch::<L>(name, &mut b_left, &mut b_right, &words, &mut state, link_mode);
+                        let (h1, n1) = compare_words(&a_left, &b_left);
+                        let (h2, n2) = compare_words(&a_right, &b_right);
+                        hard += h1 + h2;
+                        nan_payload += n1 + n2;
+                        let (real_left, real_right) = real.state_bits();
+                        let mut replica_left = [0_u32; 8];
+                        let mut replica_right = [0_u32; 8];
+                        state[0].store_bits(&mut replica_left[..L::WIDTH]);
+                        state[1].store_bits(&mut replica_right[..L::WIDTH]);
+                        if real_left != replica_left || real_right != replica_right {
+                            state_mismatch += 1;
+                        }
+                        // Mirror the boundary policy on both sides so state stays comparable.
+                        let flag_real = real.finish(&mut a_left, &mut a_right);
+                        let flag_replica = {
+                            let mut flag = 0;
+                            for (plane, index) in [(&mut b_left, 0), (&mut b_right, 1)] {
+                                let bad = plane.iter().any(|x| !(x.abs() < 1.0e30));
+                                if bad {
+                                    plane.fill(0.0);
+                                    state[index] = L::zero();
+                                    flag |= 1;
+                                }
+                            }
+                            flag
+                        };
+                        let _ = (flag_real, flag_replica);
+                        let (h3, n3) = compare_words(&a_left, &b_left);
+                        let (h4, n4) = compare_words(&a_right, &b_right);
+                        if h3 + h4 != 0 {
+                            hard += h3 + h4;
+                        }
+                        let _ = n3 + n4;
+                    }
+                    let verdict = if hard == 0 && state_mismatch == 0 { "ok" } else { "MISMATCH" };
+                    if verdict != "ok" {
+                        ok = false;
+                    }
+                    println!(
+                        "{label} {params_name:<11} {link_mode:?} {input_name:<7} {name:<16} {verdict} (non-NaN mismatches {hard}, NaN-payload-only {nan_payload}, state mismatches {state_mismatch})"
+                    );
+                }
+            }
+        }
+    }
+    ok
+}
