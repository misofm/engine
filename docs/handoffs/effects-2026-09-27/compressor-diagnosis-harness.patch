+pub const COEF_THRESHOLD: usize = 0;
+pub const COEF_INV_RATIO_MINUS_ONE: usize = 1;
+pub const COEF_HALF_KNEE: usize = 2;
+pub const COEF_INV_TWO_KNEE: usize = 3;
+pub const COEF_ATTACK: usize = 4;
+pub const COEF_RELEASE: usize = 5;
+pub const COEF_MAKEUP: usize = 6;
+pub const COEF_MIX: usize = 7;
+
+pub type Words = [[f32; 8]; 8];
+
+#[derive(Clone, Copy)]
+pub struct Coef<L: Lane> {
+    curve: GainComputerCoef<L>,
+    attack: L,
+    release: L,
+    makeup: L,
+    mix: L,
+    wet_identity: L::Mask,
+    dry_mix_zero: L::Mask,
+    makeup_zero: L::Mask,
+}
+
+impl<L: Lane> Coef<L> {
+    #[inline(always)]
+    fn load(words: &Words) -> Self {
+        let makeup = L::load(&words[COEF_MAKEUP]);
+        let mix = L::load(&words[COEF_MIX]);
+        Self {
+            curve: GainComputerCoef {
+                threshold_db: L::load(&words[COEF_THRESHOLD]),
+                inv_ratio_minus_one: L::load(&words[COEF_INV_RATIO_MINUS_ONE]),
+                half_knee_db: L::load(&words[COEF_HALF_KNEE]),
+                inv_two_knee: L::load(&words[COEF_INV_TWO_KNEE]),
+            },
+            attack: L::load(&words[COEF_ATTACK]),
+            release: L::load(&words[COEF_RELEASE]),
+            makeup,
+            mix,
+            wet_identity: mix.eq(L::splat(1.0)),
+            dry_mix_zero: mix.eq(L::zero()),
+            makeup_zero: makeup.eq(L::zero()),
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+pub struct Inv<L: Lane> {
+    k: K<L>,
+    zero: L,
+    half: L,
+    level_floor: L,
+    level_min: L,
+    level_max: L,
+    reduction_min: L,
+    linked: L::Mask,
+    averaged: L::Mask,
+    bypassed: L::Mask,
+}
+
+impl<L: Lane> Inv<L> {
+    #[inline(always)]
+    fn new(link: LinkMode) -> Self {
+        Self::new_k(link, false)
+    }
+
+    #[inline(always)]
+    fn new_k(link: LinkMode, opaque: bool) -> Self {
+        let zero = L::zero();
+        let all = zero.eq(zero);
+        let none = L::mask_not(all);
+        Self {
+            k: K::new(opaque),
+            zero,
+            half: L::splat(0.5),
+            level_floor: L::splat(1.0e-8),
+            level_min: L::splat(-160.0),
+            level_max: L::splat(24.0),
+            reduction_min: L::splat(-100.0),
+            linked: if matches!(link, LinkMode::DualMono) { none } else { all },
+            averaged: if matches!(link, LinkMode::Average) { all } else { none },
+            bypassed: none,
+        }
+    }
+}
+
+/// Structural switches of one replica.
+#[derive(Clone, Copy)]
+pub struct Shape {
+    /// `link_frame`'s select form (false) or the DualMono arm alone, `abs` per channel (true).
+    dual_mono: bool,
+    /// `gain_mix`'s masked form (false) or the all-wet arm alone, `x * g` (true).
+    wet_only: bool,
+    /// The recursive word kept in a local across the loop (true) or in the channel (false).
+    local_state: bool,
+    /// `chunks_exact` iteration (true) or `slot` indexing with its bounds checks (false).
+    chunks: bool,
+    /// Whole left block then whole right block (true) or both channels per frame (false).
+    split: bool,
+    /// Cumulative truncation of the frame law, for the stage breakdown: 0 copy, 1 link, 2 level,
+    /// 3 curve, 4 ballistic, 5 gain conversion, 6 full.
+    stage: u8,
+    /// Constants hoisted into values built once per block (see `K`).
+    consts: bool,
+    /// Interleaving: 0 none, 1 `Pair` over the channels, 2 two frames at once, 3 two passes.
+    interleave: u8,
+    /// Provably inactive clamps removed: the reduction clamp and `fast_exp2`'s argument clamp are
+    /// not removable without touching the sealed tier, so only the reduction clamp here.
+    no_reduction_clamp: bool,
+}
+
+
+/// The fast-dB tier's and the kernel's constants as values rather than immediates, built once per
+/// block. With `opaque`, each scalar passes through `black_box`, so neither backend can fold it
+/// back into a per-use immediate: x86 keeps it in a register or a stack slot, wasm in a local.
+#[derive(Clone, Copy)]
+pub struct K<L: Lane> {
+    min_positive: L,
+    one: L,
+    log2_q: [L; 6],
+    db_per_log2: L,
+    log2_per_db: L,
+    exp_lo: L,
+    exp_hi: L,
+    exp2_p: [L; 5],
+    level_floor: L,
+    level_min: L,
+    level_max: L,
+    reduction_min: L,
+}
+
+const K_DB_PER_LOG2: f32 = (20.0_f64 * core::f64::consts::LOG10_2) as f32;
+const K_LOG2_PER_DB: f32 = (core::f64::consts::LOG2_10 / 20.0) as f32;
+const K_EXP2_P: [f32; 5] = [0.693_151_3, 0.240_164_44, 0.055_799_913, 0.009_017_031, 0.001_867_13];
+const K_LOG2_Q: [f32; 6] = [
+    1.442_553_2,
+    -0.718_281_9,
+    0.458_270_82,
+    -0.279_538_15,
+    0.123_451_486,
+    -0.026_457_45,
+];
+
+impl<L: Lane> K<L> {
+    #[inline(always)]
+    fn new(opaque: bool) -> Self {
+        let s = |x: f32| {
+            if opaque {
+                L::splat(core::hint::black_box(x))
+            } else {
+                L::splat(x)
+            }
+        };
+        Self {
+            min_positive: s(f32::MIN_POSITIVE),
+            one: s(1.0),
+            log2_q: core::array::from_fn(|i| s(K_LOG2_Q[i])),
+            db_per_log2: s(K_DB_PER_LOG2),
+            log2_per_db: s(K_LOG2_PER_DB),
+            exp_lo: s(-126.0),
+            exp_hi: s(127.0),
+            exp2_p: core::array::from_fn(|i| s(K_EXP2_P[i])),
+            level_floor: s(1.0e-8),
+            level_min: s(-160.0),
+            level_max: s(24.0),
+            reduction_min: s(-100.0),
+        }
+    }
+}
+
+fn pair_k<L: Lane>(a: &K<L>) -> K<Pair<L>> {
+    let p = |x: L| Pair(x, x);
+    K {
+        min_positive: p(a.min_positive),
+        one: p(a.one),
+        log2_q: core::array::from_fn(|i| p(a.log2_q[i])),
+        db_per_log2: p(a.db_per_log2),
+        log2_per_db: p(a.log2_per_db),
+        exp_lo: p(a.exp_lo),
+        exp_hi: p(a.exp_hi),
+        exp2_p: core::array::from_fn(|i| p(a.exp2_p[i])),
+        level_floor: p(a.level_floor),
+        level_min: p(a.level_min),
+        level_max: p(a.level_max),
+        reduction_min: p(a.reduction_min),
+    }
+}
+
+/// `math::fast_db::fast_level_db`, verbatim operation order, constants from `k`.
+#[inline(always)]
+fn fast_level_db_k<L: Lane>(x: L, k: &K<L>) -> L {
+    let x = x.max(k.min_positive);
+    let (m, e) = x.frexp();
+    let t = m.sub(k.one);
+    let mut q = k.log2_q[5];
+    let mut index = 4;
+    loop {
+        q = q.mul(t).add(k.log2_q[index]);
+        if index == 0 {
+            break;
+        }
+        index -= 1;
+    }
+    e.add(t.mul(q)).mul(k.db_per_log2)
+}
+
+/// `math::fast_db::fast_gain_from_db`, verbatim operation order, constants from `k`.
+#[inline(always)]
+fn fast_gain_from_db_k<L: Lane>(db: L, k: &K<L>) -> L {
+    let x = db.mul(k.log2_per_db);
+    let x = x.max(k.exp_lo).min(k.exp_hi);
+    let xi = x.floor();
+    let f = x.sub(xi);
+    let mut p = k.exp2_p[4];
+    let mut index = 3;
+    loop {
+        p = p.mul(f).add(k.exp2_p[index]);
+        if index == 0 {
+            break;
+        }
+        index -= 1;
+    }
+    let p = k.one.add(f.mul(p));
+    p.mul(L::exp2_int_in_range(xi))
+}
+
+#[inline(always)]
+pub fn link<L: Lane>(ml: L, mr: L, inv: &Inv<L>, dual_mono: bool) -> (L, L) {
+    if dual_mono {
+        return (ml.abs(), mr.abs());
+    }
+    let magnitude_left = ml.abs();
+    let magnitude_right = mr.abs();
+    let maximum = magnitude_left.max(magnitude_right);
+    let average = magnitude_left
+        .mul(inv.half)
+        .add(magnitude_right.mul(inv.half));
+    let combined = L::select(inv.averaged, average, maximum);
+    (
+        L::select(inv.linked, combined, magnitude_left),
+        L::select(inv.linked, combined, magnitude_right),
+    )
+}
+
+/// One channel-frame after the link, truncated at `stage`.
+#[inline(always)]
+pub fn channel_frame<L: Lane>(
+    input: L,
+    detected: L,
+    coef: &Coef<L>,
+    g: &mut L,
+    inv: &Inv<L>,
+    shape: Shape,
+) -> L {
+    if shape.stage == 0 {
+        return input;
+    }
+    if shape.stage == 1 {
+        return detected;
+    }
+    let floored = detected.max(inv.level_floor);
+    let level = fast_level_db(floored).max(inv.level_min).min(inv.level_max);
+    if shape.stage == 2 {
+        return level;
+    }
+    let delta = gain_delta_db(level, &coef.curve);
+    let target = if shape.no_reduction_clamp {
+        delta
+    } else {
+        delta.max(inv.reduction_min).min(inv.zero)
+    };
+    if shape.stage == 3 {
+        return target;
+    }
+    let coefficient = L::select(target.lt(*g), coef.attack, coef.release);
+    let smoothed = flush(rms_follow(target, *g, coefficient));
+    *g = smoothed;
+    if shape.stage == 4 {
+        return smoothed;
+    }
+    let gain = fast_gain_from_db(smoothed.add(coef.makeup));
+    if shape.stage == 5 {
+        return gain;
+    }
+    let wet = input.mul(gain);
+    if shape.wet_only {
+        return wet;
+    }
+    let mixed = gain_mix_step(input, gain, coef.mix);
+    let dry_identity = L::mask_or(
+        inv.bypassed,
+        L::mask_or(
+            coef.dry_mix_zero,
+            L::mask_and(smoothed.eq(inv.zero), coef.makeup_zero),
+        ),
+    );
+    let output = L::select(coef.wet_identity, wet, mixed);
+    L::select(dry_identity, input, output)
+}
+
+
+// ---------------------------------------------------------------------------------------------
+// Pair<L>: two independent L values advanced op by op, so the emitted program order interleaves
+// two dependency chains. Every operation is L's own operation applied to each half, so the value
+// of each half is exactly what L computes.
+// ---------------------------------------------------------------------------------------------
+
+#[derive(Clone, Copy)]
+pub struct Pair<L: Lane>(L, L);
+
+impl<L: Lane> Lane for Pair<L> {
+    const WIDTH: usize = 2 * L::WIDTH;
+    const SVF_CASCADE_DEPTH: usize = 1;
+    type Mask = (L::Mask, L::Mask);
+    #[inline(always)]
+    fn splat(x: f32) -> Self {
+        Pair(L::splat(x), L::splat(x))
+    }
+    #[inline(always)]
+    fn zero() -> Self {
+        Pair(L::zero(), L::zero())
+    }
+    #[inline(always)]
+    fn load(src: &[f32]) -> Self {
+        Pair(L::load(src), L::load(&src[L::WIDTH..]))
+    }
+    #[inline(always)]
+    fn store(self, dst: &mut [f32]) {
+        self.0.store(dst);
+        self.1.store(&mut dst[L::WIDTH..]);
+    }
+    #[inline(always)]
+    fn add(self, b: Self) -> Self {
+        Pair(self.0.add(b.0), self.1.add(b.1))
+    }
+    #[inline(always)]
+    fn sub(self, b: Self) -> Self {
+        Pair(self.0.sub(b.0), self.1.sub(b.1))
+    }
+    #[inline(always)]
+    fn mul(self, b: Self) -> Self {
+        Pair(self.0.mul(b.0), self.1.mul(b.1))
+    }
+    #[inline(always)]
+    fn div(self, b: Self) -> Self {
+        Pair(self.0.div(b.0), self.1.div(b.1))
+    }
+    #[inline(always)]
+    fn sqrt(self) -> Self {
+        Pair(self.0.sqrt(), self.1.sqrt())
+    }
+    #[inline(always)]
+    fn fma(self, b: Self, c: Self) -> Self {
+        Pair(self.0.fma(b.0, c.0), self.1.fma(b.1, c.1))
+    }
+    #[inline(always)]
+    fn neg(self) -> Self {
+        Pair(self.0.neg(), self.1.neg())
+    }
+    #[inline(always)]
+    fn abs(self) -> Self {
+        Pair(self.0.abs(), self.1.abs())
+    }
+    #[inline(always)]
+    fn floor(self) -> Self {
+        Pair(self.0.floor(), self.1.floor())
+    }
+    #[inline(always)]
+    fn lt(self, b: Self) -> Self::Mask {
+        (self.0.lt(b.0), self.1.lt(b.1))
+    }
+    #[inline(always)]
+    fn le(self, b: Self) -> Self::Mask {
+        (self.0.le(b.0), self.1.le(b.1))
+    }
+    #[inline(always)]
+    fn gt(self, b: Self) -> Self::Mask {
+        (self.0.gt(b.0), self.1.gt(b.1))
+    }
+    #[inline(always)]
+    fn ge(self, b: Self) -> Self::Mask {
+        (self.0.ge(b.0), self.1.ge(b.1))
+    }
+    #[inline(always)]
+    fn eq(self, b: Self) -> Self::Mask {
+        (self.0.eq(b.0), self.1.eq(b.1))
+    }
+    #[inline(always)]
+    fn mask_and(a: Self::Mask, b: Self::Mask) -> Self::Mask {
+        (L::mask_and(a.0, b.0), L::mask_and(a.1, b.1))
+    }
+    #[inline(always)]
+    fn mask_or(a: Self::Mask, b: Self::Mask) -> Self::Mask {
+        (L::mask_or(a.0, b.0), L::mask_or(a.1, b.1))
+    }
+    #[inline(always)]
+    fn mask_not(a: Self::Mask) -> Self::Mask {
+        (L::mask_not(a.0), L::mask_not(a.1))
+    }
+    #[inline(always)]
+    fn mask_any(m: Self::Mask) -> bool {
+        L::mask_any(m.0) || L::mask_any(m.1)
+    }
+    #[inline(always)]
+    fn select(m: Self::Mask, a: Self, b: Self) -> Self {
+        Pair(L::select(m.0, a.0, b.0), L::select(m.1, a.1, b.1))
+    }
+    #[inline(always)]
+    fn andnot(self, m: Self::Mask) -> Self {
+        Pair(self.0.andnot(m.0), self.1.andnot(m.1))
+    }
+    #[inline(always)]
+    fn max(self, b: Self) -> Self {
+        Pair(self.0.max(b.0), self.1.max(b.1))
+    }
+    #[inline(always)]
+    fn min(self, b: Self) -> Self {
+        Pair(self.0.min(b.0), self.1.min(b.1))
+    }
+    #[inline(always)]
+    fn exp2_int(n: Self) -> Self {
+        Pair(L::exp2_int(n.0), L::exp2_int(n.1))
+    }
+    #[inline(always)]
+    fn exp2_int_in_range(n: Self) -> Self {
+        Pair(L::exp2_int_in_range(n.0), L::exp2_int_in_range(n.1))
+    }
+    #[inline(always)]
+    fn frexp(self) -> (Self, Self) {
+        let (m0, e0) = self.0.frexp();
+        let (m1, e1) = self.1.frexp();
+        (Pair(m0, m1), Pair(e0, e1))
+    }
+    #[inline(always)]
+    fn store_bits(self, dst: &mut [u32]) {
+        self.0.store_bits(dst);
+        self.1.store_bits(&mut dst[L::WIDTH..]);
+    }
+}
+
+pub fn pair_coef<L: Lane>(a: &Coef<L>, b: &Coef<L>) -> Coef<Pair<L>> {
+    Coef {
+        curve: GainComputerCoef {
+            threshold_db: Pair(a.curve.threshold_db, b.curve.threshold_db),
+            inv_ratio_minus_one: Pair(a.curve.inv_ratio_minus_one, b.curve.inv_ratio_minus_one),
+            half_knee_db: Pair(a.curve.half_knee_db, b.curve.half_knee_db),
+            inv_two_knee: Pair(a.curve.inv_two_knee, b.curve.inv_two_knee),
+        },
+        attack: Pair(a.attack, b.attack),
+        release: Pair(a.release, b.release),
+        makeup: Pair(a.makeup, b.makeup),
+        mix: Pair(a.mix, b.mix),
+        wet_identity: (a.wet_identity, b.wet_identity),
+        dry_mix_zero: (a.dry_mix_zero, b.dry_mix_zero),
+        makeup_zero: (a.makeup_zero, b.makeup_zero),
+    }
+}
+
+pub fn pair_inv<L: Lane>(a: &Inv<L>) -> Inv<Pair<L>> {
+    Inv {
+        k: pair_k(&a.k),
+        zero: Pair(a.zero, a.zero),
+        half: Pair(a.half, a.half),
+        level_floor: Pair(a.level_floor, a.level_floor),
+        level_min: Pair(a.level_min, a.level_min),
+        level_max: Pair(a.level_max, a.level_max),
+        reduction_min: Pair(a.reduction_min, a.reduction_min),
+        linked: (a.linked, a.linked),
+        averaged: (a.averaged, a.averaged),
+        bypassed: (a.bypassed, a.bypassed),
+    }
+}
+
+/// The frame law split at the recurrence: the target (no state), the ballistic (the state), the
+/// output (no state). `channel_frame` is exactly `output(ballistic(target))`.
+#[inline(always)]
+pub fn target_of<L: Lane>(detected: L, coef: &Coef<L>, inv: &Inv<L>, shape: Shape) -> L {
+    if shape.consts {
+        let k = &inv.k;
+        let floored = detected.max(k.level_floor);
+        let level = fast_level_db_k(floored, k).max(k.level_min).min(k.level_max);
+        let delta = gain_delta_db(level, &coef.curve);
+        return if shape.no_reduction_clamp {
+            delta
+        } else {
+            delta.max(k.reduction_min).min(inv.zero)
+        };
+    }
+    let floored = detected.max(inv.level_floor);
+    let level = fast_level_db(floored).max(inv.level_min).min(inv.level_max);
+    let delta = gain_delta_db(level, &coef.curve);
+    if shape.no_reduction_clamp {
+        delta
+    } else {
+        delta.max(inv.reduction_min).min(inv.zero)
+    }
+}
+
+#[inline(always)]
+pub fn ballistic_of<L: Lane>(target: L, g: &mut L, coef: &Coef<L>) -> L {
+    let coefficient = L::select(target.lt(*g), coef.attack, coef.release);
+    let smoothed = flush(rms_follow(target, *g, coefficient));
+    *g = smoothed;
+    smoothed
+}
+
+#[inline(always)]
+pub fn output_of<L: Lane>(input: L, smoothed: L, coef: &Coef<L>, inv: &Inv<L>, shape: Shape) -> L {
+    let gain = if shape.consts {
+        fast_gain_from_db_k(smoothed.add(coef.makeup), &inv.k)
+    } else {
+        fast_gain_from_db(smoothed.add(coef.makeup))
+    };
+    let wet = input.mul(gain);
+    if shape.wet_only {
+        return wet;
+    }
+    let mixed = gain_mix_step(input, gain, coef.mix);
+    let dry_identity = L::mask_or(
+        inv.bypassed,
+        L::mask_or(
+            coef.dry_mix_zero,
+            L::mask_and(smoothed.eq(inv.zero), coef.makeup_zero),
+        ),
+    );
+    let output = L::select(coef.wet_identity, wet, mixed);
+    L::select(dry_identity, input, output)
+}
+
+/// Interleaved replicas. `mode`: 0 = both channels as one `Pair` per frame; 1 = two frames of
+/// both channels (`Pair<Pair>`) for the target and the output, the recurrence frame by frame;
+/// 2 = two passes, every frame's target first (stack scratch), then recurrence and output.
+#[inline(always)]
+pub fn replica_pair<L: Lane>(
+    left: &mut [f32],
+    right: &mut [f32],
+    words: &(Words, Words),
+    state: &mut [L; 2],
+    link_mode: LinkMode,
+    shape: Shape,
+    mode: u8,
+) {
+    let inv = Inv::<L>::new_k(link_mode, shape.consts);
+    let pinv = pair_inv(&inv);
+    let cl = Coef::<L>::load(&words.0);
+    let cr = Coef::<L>::load(&words.1);
+    let pc = pair_coef(&cl, &cr);
+    let width = L::WIDTH;
+    let mut g = Pair(state[0], state[1]);
+    let detect = |ml: L, mr: L| -> Pair<L> {
+        let (dl, dr) = link(ml, mr, &inv, shape.dual_mono);
+        Pair(dl, dr)
+    };
+    match mode {
+        0 => {
+            for (l, r) in left
+                .chunks_exact_mut(width)
+                .zip(right.chunks_exact_mut(width))
+            {
+                let x = Pair(L::load(l), L::load(r));
+                let d = detect(x.0, x.1);
+                let t = target_of(d, &pc, &pinv, shape);
+                let s = ballistic_of(t, &mut g, &pc);
+                let y = output_of(x, s, &pc, &pinv, shape);
+                y.0.store(l);
+                y.1.store(r);
+            }
+        }
+        1 => {
+            let qc = pair_coef(&pc, &pc);
+            let qinv = pair_inv(&pinv);
+            for (l, r) in left
+                .chunks_exact_mut(2 * width)
+                .zip(right.chunks_exact_mut(2 * width))
+            {
+                let (l0, l1) = l.split_at_mut(width);
+                let (r0, r1) = r.split_at_mut(width);
+                let xa = Pair(L::load(l0), L::load(r0));
+                let xb = Pair(L::load(l1), L::load(r1));
+                let d = Pair(detect(xa.0, xa.1), detect(xb.0, xb.1));
+                let t = target_of(d, &qc, &qinv, shape);
+                let sa = ballistic_of(t.0, &mut g, &pc);
+                let sb = ballistic_of(t.1, &mut g, &pc);
+                let y = output_of(Pair(xa, xb), Pair(sa, sb), &qc, &qinv, shape);
+                y.0.0.store(l0);
+                y.0.1.store(r0);
+                y.1.0.store(l1);
+                y.1.1.store(r1);
+            }
+        }
+        3 => {
+            // Four frames of both channels per iteration.
+            let qc = pair_coef(&pc, &pc);
+            let qinv = pair_inv(&pinv);
+            let oc = pair_coef(&qc, &qc);
+            let oinv = pair_inv(&qinv);
+            for (l, r) in left
+                .chunks_exact_mut(4 * width)
+                .zip(right.chunks_exact_mut(4 * width))
+            {
+                let x: [Pair<L>; 4] = core::array::from_fn(|k| {
+                    Pair(
+                        L::load(&l[k * width..]),
+                        L::load(&r[k * width..]),
+                    )
+                });
+                let d = Pair(
+                    Pair(detect(x[0].0, x[0].1), detect(x[1].0, x[1].1)),
+                    Pair(detect(x[2].0, x[2].1), detect(x[3].0, x[3].1)),
+                );
+                let t = target_of(d, &oc, &oinv, shape);
+                let s0 = ballistic_of(t.0.0, &mut g, &pc);
+                let s1 = ballistic_of(t.0.1, &mut g, &pc);
+                let s2 = ballistic_of(t.1.0, &mut g, &pc);
+                let s3 = ballistic_of(t.1.1, &mut g, &pc);
+                let y = output_of(
+                    Pair(Pair(x[0], x[1]), Pair(x[2], x[3])),
+                    Pair(Pair(s0, s1), Pair(s2, s3)),
+                    &oc,
+                    &oinv,
+                    shape,
+                );
+                let ys = [y.0.0, y.0.1, y.1.0, y.1.1];
+                for (k, value) in ys.iter().enumerate() {
+                    value.0.store(&mut l[k * width..]);
+                    value.1.store(&mut r[k * width..]);
+                }
+            }
+        }
+        4 | 5 => {
+            // Pass 1: every frame's target, two frames of both channels per iteration.
+            let qc = pair_coef(&pc, &pc);
+            let qinv = pair_inv(&pinv);
+            let mut targets = [Pair(L::zero(), L::zero()); FRAMES];
+            for ((l, r), t) in left
+                .chunks_exact(2 * width)
+                .zip(right.chunks_exact(2 * width))
+                .zip(targets.chunks_exact_mut(2))
+            {
+                let d = Pair(
+                    detect(L::load(l), L::load(r)),
+                    detect(L::load(&l[width..]), L::load(&r[width..])),
+                );
+                let v = target_of(d, &qc, &qinv, shape);
+                t[0] = v.0;
+                t[1] = v.1;
+            }
+            if mode == 4 {
+                // Pass 2: the recurrence alone, in place over the targets.
+                for t in targets.iter_mut() {
+                    *t = ballistic_of(*t, &mut g, &pc);
+                }
+                // Pass 3: the output, two frames per iteration.
+                for ((l, r), s) in left
+                    .chunks_exact_mut(2 * width)
+                    .zip(right.chunks_exact_mut(2 * width))
+                    .zip(targets.chunks_exact(2))
+                {
+                    let (l0, l1) = l.split_at_mut(width);
+                    let (r0, r1) = r.split_at_mut(width);
+                    let x = Pair(Pair(L::load(l0), L::load(r0)), Pair(L::load(l1), L::load(r1)));
+                    let y = output_of(x, Pair(s[0], s[1]), &qc, &qinv, shape);
+                    y.0.0.store(l0);
+                    y.0.1.store(r0);
+                    y.1.0.store(l1);
+                    y.1.1.store(r1);
+                }
+            } else {
+                // Pass 2: recurrence and output, two frames per iteration.
+                for ((l, r), t) in left
+                    .chunks_exact_mut(2 * width)
+                    .zip(right.chunks_exact_mut(2 * width))
+                    .zip(targets.chunks_exact(2))
+                {
+                    let (l0, l1) = l.split_at_mut(width);
+                    let (r0, r1) = r.split_at_mut(width);
+                    let x = Pair(Pair(L::load(l0), L::load(r0)), Pair(L::load(l1), L::load(r1)));
+                    let sa = ballistic_of(t[0], &mut g, &pc);
+                    let sb = ballistic_of(t[1], &mut g, &pc);
+                    let y = output_of(x, Pair(sa, sb), &qc, &qinv, shape);
+                    y.0.0.store(l0);
+                    y.0.1.store(r0);
+                    y.1.0.store(l1);
+                    y.1.1.store(r1);
+                }
+            }
+        }
+        _ => {
+            let mut targets = [Pair(L::zero(), L::zero()); FRAMES];
+            for ((l, r), t) in left
+                .chunks_exact(width)
+                .zip(right.chunks_exact(width))
+                .zip(targets.iter_mut())
+            {
+                *t = target_of(detect(L::load(l), L::load(r)), &pc, &pinv, shape);
+            }
+            for ((l, r), t) in left
+                .chunks_exact_mut(width)
+                .zip(right.chunks_exact_mut(width))
+                .zip(targets.iter())
+            {
+                let x = Pair(L::load(l), L::load(r));
+                let s = ballistic_of(*t, &mut g, &pc);
+                let y = output_of(x, s, &pc, &pinv, shape);
+                y.0.store(l);
+                y.1.store(r);
+            }
+        }
+    }
+    state[0] = g.0;
+    state[1] = g.1;
+}
+
+/// The replica block body. `#[inline(always)]` so every call site below is its own function.
+#[inline(always)]
+pub fn replica<L: Lane>(
+    left: &mut [f32],
+    right: &mut [f32],
+    words: &(Words, Words),
+    state: &mut [L; 2],
+    link_mode: LinkMode,
+    shape: Shape,
+) {
+    if shape.interleave != 0 {
+        replica_pair::<L>(left, right, words, state, link_mode, shape, shape.interleave - 1);
+        return;
+    }
+    if shape.consts {
+        // Chunked, local state, the split frame law with hoisted constants.
+        let inv = Inv::<L>::new_k(link_mode, true);
+        let cl = Coef::<L>::load(&words.0);
+        let cr = Coef::<L>::load(&words.1);
+        let (mut gl, mut gr) = (state[0], state[1]);
+        for (l, r) in left
+            .chunks_exact_mut(L::WIDTH)
+            .zip(right.chunks_exact_mut(L::WIDTH))
+        {
+            let ml = L::load(l);
+            let mr = L::load(r);
+            let (dl, dr) = link(ml, mr, &inv, shape.dual_mono);
+            let tl = target_of(dl, &cl, &inv, shape);
+            let sl = ballistic_of(tl, &mut gl, &cl);
+            output_of(ml, sl, &cl, &inv, shape).store(l);
+            let tr = target_of(dr, &cr, &inv, shape);
+            let sr = ballistic_of(tr, &mut gr, &cr);
+            output_of(mr, sr, &cr, &inv, shape).store(r);
+        }
+        state[0] = gl;
+        state[1] = gr;
+        return;
+    }
+    let inv = Inv::<L>::new(link_mode);
+    let cl = Coef::<L>::load(&words.0);
+    let cr = Coef::<L>::load(&words.1);
+    let width = L::WIDTH;
+    let frames = left.len() / width;
+    if shape.split {
+        // DualMono only: the channels share nothing.
+        for (plane, coef, index) in [(&mut *left, &cl, 0), (&mut *right, &cr, 1)] {
+            let mut g = state[index];
+            for chunk in plane.chunks_exact_mut(width) {
+                let x = L::load(chunk);
+                let detected = link(x, x, &inv, true).0;
+                channel_frame(x, detected, coef, &mut g, &inv, shape).store(chunk);
+            }
+            state[index] = g;
+        }
+        return;
+    }
+    if shape.chunks {
+        let (mut gl, mut gr) = (state[0], state[1]);
+        for (l, r) in left
+            .chunks_exact_mut(width)
+            .zip(right.chunks_exact_mut(width))
+        {
+            let ml = L::load(l);
+            let mr = L::load(r);
+            let (dl, dr) = link(ml, mr, &inv, shape.dual_mono);
+            if shape.local_state {
+                channel_frame(ml, dl, &cl, &mut gl, &inv, shape).store(l);
+                channel_frame(mr, dr, &cr, &mut gr, &inv, shape).store(r);
+            } else {
+                channel_frame(ml, dl, &cl, &mut state[0], &inv, shape).store(l);
+                channel_frame(mr, dr, &cr, &mut state[1], &inv, shape).store(r);
+            }
+        }
+        if shape.local_state {
+            state[0] = gl;
+            state[1] = gr;
+        }
+        return;
+    }
+    let (mut gl, mut gr) = (state[0], state[1]);
+    for frame in 0..frames {
+        let slot = frame * width;
+        let ml = L::load(&left[slot..]);
+        let mr = L::load(&right[slot..]);
+        let (dl, dr) = link(ml, mr, &inv, shape.dual_mono);
+        if shape.local_state {
+            channel_frame(ml, dl, &cl, &mut gl, &inv, shape).store(&mut left[slot..]);
+            channel_frame(mr, dr, &cr, &mut gr, &inv, shape).store(&mut right[slot..]);
+        } else {
+            channel_frame(ml, dl, &cl, &mut state[0], &inv, shape).store(&mut left[slot..]);
+            channel_frame(mr, dr, &cr, &mut state[1], &inv, shape).store(&mut right[slot..]);
+        }
+    }
+    if shape.local_state {
+        state[0] = gl;
+        state[1] = gr;
+    }
+}
+
+pub const BASE: Shape = Shape {
+    dual_mono: false,
+    wet_only: false,
+    local_state: false,
+    chunks: false,
+    split: false,
+    stage: 6,
+    interleave: 0,
+    consts: false,
+    no_reduction_clamp: false,
+};
+
+/// The named replica variants. Each gets its own non-inlined function per width via the macro.
+macro_rules! variants {
+    ($($name:ident = $shape:expr;)*) => {
+        $(
+            #[inline(never)]
+            pub fn $name<L: Lane>(
+                left: &mut [f32],
+                right: &mut [f32],
+                words: &(Words, Words),
+                state: &mut [L; 2],
+                link_mode: LinkMode,
+            ) {
+                replica::<L>(left, right, words, state, link_mode, $shape);
+            }
+        )*
+        pub const VARIANTS: &[&str] = &[$(stringify!($name)),*];
+        pub fn dispatch<L: Lane>(
+            name: &str,
+            left: &mut [f32],
+            right: &mut [f32],
+            words: &(Words, Words),
+            state: &mut [L; 2],
+            link_mode: LinkMode,
+        ) {
+            match name {
+                $(stringify!($name) => $name::<L>(left, right, words, state, link_mode),)*
+                _ => panic!("unknown variant {name}"),
+            }
+        }
+    };
+}
+
+variants! {
+    r_base = BASE;
+    r_stage0_copy = Shape { stage: 0, ..BASE };
+    r_stage1_link = Shape { stage: 1, ..BASE };
+    r_stage2_level = Shape { stage: 2, ..BASE };
+    r_stage3_curve = Shape { stage: 3, ..BASE };
+    r_stage4_ballistic = Shape { stage: 4, ..BASE };
+    r_stage5_gain = Shape { stage: 5, ..BASE };
+    r_local = Shape { local_state: true, ..BASE };
+    r_chunks = Shape { chunks: true, ..BASE };
+    r_chunks_local = Shape { chunks: true, local_state: true, ..BASE };
+    r_dm = Shape { dual_mono: true, ..BASE };
+    r_wet = Shape { wet_only: true, ..BASE };
+    r_dm_wet = Shape { dual_mono: true, wet_only: true, ..BASE };
+    r_lean = Shape { dual_mono: true, wet_only: true, chunks: true, local_state: true, ..BASE };
+    r_lean_noclamp = Shape { dual_mono: true, wet_only: true, chunks: true, local_state: true, no_reduction_clamp: true, ..BASE };
+    r_split = Shape { split: true, ..BASE };
+    r_split_wet = Shape { split: true, wet_only: true, ..BASE };
+    r_cl_dm = Shape { chunks: true, local_state: true, dual_mono: true, ..BASE };
+    r_cl_wet = Shape { chunks: true, local_state: true, wet_only: true, ..BASE };
+    r_lean_stage0 = Shape { dual_mono: true, wet_only: true, chunks: true, local_state: true, stage: 0, ..BASE };
+    r_lean_stage1 = Shape { dual_mono: true, wet_only: true, chunks: true, local_state: true, stage: 1, ..BASE };
+    r_lean_stage2 = Shape { dual_mono: true, wet_only: true, chunks: true, local_state: true, stage: 2, ..BASE };
+    r_lean_stage3 = Shape { dual_mono: true, wet_only: true, chunks: true, local_state: true, stage: 3, ..BASE };
+    r_lean_stage4 = Shape { dual_mono: true, wet_only: true, chunks: true, local_state: true, stage: 4, ..BASE };
+    r_lean_stage5 = Shape { dual_mono: true, wet_only: true, chunks: true, local_state: true, stage: 5, ..BASE };
+    r_pair = Shape { interleave: 1, ..BASE };
+    r_pair_dm = Shape { interleave: 1, dual_mono: true, ..BASE };
+    r_pair_lean = Shape { interleave: 1, dual_mono: true, wet_only: true, ..BASE };
+    r_quad = Shape { interleave: 2, ..BASE };
+    r_quad_lean = Shape { interleave: 2, dual_mono: true, wet_only: true, ..BASE };
+    r_twopass = Shape { interleave: 3, ..BASE };
+    r_twopass_lean = Shape { interleave: 3, dual_mono: true, wet_only: true, ..BASE };
+    r_quad_dm = Shape { interleave: 2, dual_mono: true, ..BASE };
+    r_quad_wet = Shape { interleave: 2, wet_only: true, ..BASE };
+    r_oct = Shape { interleave: 4, ..BASE };
+    r_oct_lean = Shape { interleave: 4, dual_mono: true, wet_only: true, ..BASE };
+    r_3pass = Shape { interleave: 5, ..BASE };
+    r_3pass_lean = Shape { interleave: 5, dual_mono: true, wet_only: true, ..BASE };
+    r_2passq = Shape { interleave: 6, ..BASE };
+    r_2passq_lean = Shape { interleave: 6, dual_mono: true, wet_only: true, ..BASE };
+    r_quad_lean_noclamp = Shape { interleave: 2, dual_mono: true, wet_only: true, no_reduction_clamp: true, ..BASE };
+    r_k = Shape { consts: true, ..BASE };
+    r_k_wet = Shape { consts: true, wet_only: true, ..BASE };
+    r_k_lean = Shape { consts: true, wet_only: true, dual_mono: true, ..BASE };
+    r_k_pair = Shape { consts: true, interleave: 1, ..BASE };
+    r_k_quad = Shape { consts: true, interleave: 2, ..BASE };
+    r_k_quad_wet = Shape { consts: true, interleave: 2, wet_only: true, ..BASE };
+    r_k_quad_lean = Shape { consts: true, interleave: 2, dual_mono: true, wet_only: true, ..BASE };
+    r_k_oct = Shape { consts: true, interleave: 4, ..BASE };
+    r_k_oct_wet = Shape { consts: true, interleave: 4, wet_only: true, ..BASE };
+    r_k_oct_lean = Shape { consts: true, interleave: 4, dual_mono: true, wet_only: true, ..BASE };
