@@ -0,0 +1,40 @@
+import re, subprocess, sys
+from collections import Counter
+
+# usage: x86_loops.py binary start_hex size_hex : classify every innermost loop of one function.
+binary, start, size = sys.argv[1], int(sys.argv[2], 16), int(sys.argv[3], 16)
+out = subprocess.run(['objdump', '-d', '--no-show-raw-insn', '-C', f'--start-address={start}',
+                      f'--stop-address={start + size}', binary], capture_output=True, text=True).stdout
+code = []
+for line in out.split('\n'):
+    m = re.match(r'\s*([0-9a-f]+):\s+(\S+)\s*(.*)', line)
+    if m:
+        code.append((int(m.group(1), 16), m.group(2), m.group(3)))
+loops = []
+for addr, op, args in code:
+    if op.startswith('j'):
+        m = re.match(r'([0-9a-f]+)\s', args)
+        if m and int(m.group(1), 16) < addr:
+            loops.append((int(m.group(1), 16), addr))
+inner = [l for l in loops if not any(l2 != l and l[0] <= l2[0] and l2[1] <= l[1] for l2 in loops)]
+
+
+def cat(op, args):
+    mem = '(' in args
+    if op in ('vbroadcastss', 'vbroadcastsd', 'vpbroadcastd'):
+        return 'broadcast'
+    if op in ('vmovups', 'vmovaps', 'vmovss', 'vmovdqu', 'vmovdqa'):
+        return 'vec move (mem)' if mem else 'vec move (reg)'
+    if op.startswith('v'):
+        return 'vec alu' + (' +mem' if mem else '')
+    return 'scalar'
+
+
+for lo, hi in sorted(inner):
+    body = [(op, args) for addr, op, args in code if lo <= addr <= hi and not op.startswith(('nop', 'data16', 'cs'))]
+    if len(body) < 20:
+        continue
+    c = Counter(cat(op, args) for op, args in body)
+    print(f'loop {lo:#x}-{hi:#x}: {len(body)} instructions')
+    for k in sorted(c):
+        print(f'    {k:20s}{c[k]:5d}')
