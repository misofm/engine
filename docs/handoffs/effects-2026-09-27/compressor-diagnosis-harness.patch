+import re, sys
+from collections import Counter
+
+# usage: v8_loops.py listing.txt index [index ...]
+path = sys.argv[1]
+wanted = [int(x) for x in sys.argv[2:]]
+text = open(path).read().split('\n')
+funcs = {}
+cur = None
+name = None
+for line in text:
+    if line.startswith('name: '):
+        name = line[6:]
+    elif line.startswith('index: '):
+        cur = int(line[7:])
+        funcs[cur] = (name, [])
+    elif cur is not None:
+        m = re.match(r'^0x[0-9a-f]+\s+([0-9a-f]+)\s+[0-9a-f]+\s+(.*)$', line)
+        if m:
+            off = int(m.group(1), 16)
+            ins = m.group(2).strip()
+            funcs[cur][1].append((off, ins))
+
+
+def cat(ins):
+    op = ins.replace('REX.W ', '').split()[0]
+    if op.startswith('v'):
+        op = op[1:]
+    mem = '[' in ins
+    if op in ('movaps', 'movups', 'movdqu', 'movdqa', 'movss', 'movd', 'movq') and ('xmm' in ins):
+        return 'xmm move/load/store' + (' (mem)' if mem else ' (reg)')
+    if 'xmm' in ins:
+        return 'xmm alu' + (' +mem' if mem else '')
+    if op.startswith('j'):
+        return 'branch'
+    return 'scalar' + (' mem' if mem else '')
+
+
+for index in wanted:
+    if index not in funcs:
+        print('missing', index)
+        continue
+    name, code = funcs[index]
+    offs = [o for o, _ in code]
+    loops = []
+    for i, (o, ins) in enumerate(code):
+        m = re.match(r'^(j\w+)\s+0x[0-9a-f]+\s+<\+0x([0-9a-f]+)>', ins)
+        if m:
+            target = int(m.group(2), 16)
+            if target < o:
+                loops.append((target, o))
+    # innermost = smallest range containing no other loop; take the largest of those
+    inner = [l for l in loops if not any(l2 != l and l[0] <= l2[0] and l2[1] <= l[1] for l2 in loops)]
+    for best in sorted(inner):
+        body = [(o, ins) for o, ins in code if best[0] <= o <= best[1]]
+        if len(body) < 20:
+            continue
+        c = Counter(cat(ins) for _, ins in body)
+        ops = Counter(ins.replace('REX.W ', '').split()[0] for _, ins in body if 'xmm' in ins)
+        short = re.sub(r'_R.*replicas\d+', '', name)[:40]
+        print(f'[{index}] {short}: loop {best[0]:#x}-{best[1]:#x}, {len(body)} instructions')
+        for k in sorted(c):
+            print(f'    {k:28s}{c[k]:5d}')
+        print('    top xmm ops:', ops.most_common(16))
