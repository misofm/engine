diff --git a/tools/console-workload/tests/compressor_diag.rs b/tools/console-workload/tests/compressor_diag.rs
new file mode 100644
index 00000000..3d639c84
--- /dev/null
+++ b/tools/console-workload/tests/compressor_diag.rs
@@ -0,0 +1,278 @@
+//! Compressor diagnosis harness (docs/handoffs/effects-2026-09-27/COMPRESSOR-DIAGNOSIS.md).
+//!
+//! Ignored by default: it prints measurements and asserts nothing about time. Build outside the
+//! timing lock, run the binary pinned:
+//!
+//! ```text
+//! CARGO_INCREMENTAL=0 cargo test --release -p console-workload --test compressor_diag --no-run
+//! taskset -c 31 <target>/release/deps/compressor_diag-<hash> --ignored --nocapture \
+//!     --test-threads 1 <rows|digests>
+//! ```
+//!
+//! * `rows` renders `sixty_four_track_compressor_only` and `sixty_four_track_builtins_only`,
+//!   interleaved in rounds, at `Simd8` and at `Simd4` dispatch, and reports p50/min nanoseconds and
+//!   derived cycles per block, the isolate (compressor minus builtins) and the graph phase split.
+//! * `digests` prints the 64-block output digest of every standing console workload at both
+//!   dispatch widths, so a class-A prototype can be checked against the base bits.
+//!
+//! Cycles are derived, not counted: the core clock is calibrated from a dependent chain of scalar
+//! `f32` adds at three cycles each (Zen 3), timed by the same monotonic clock.
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use console_workload::{PlanConfig, QUANTUM, SessionRuntime, WORKLOADS, Workload};
+use graph::test_only_phase_profile as profile;
+use lane::Backend;
+
+const WARMUP_BLOCKS: u64 = 512;
+const ROUND_BLOCKS: usize = 2000;
+const ROUNDS: usize = 5;
+const TRACKS: usize = 64;
+const FADD_LATENCY_CYCLES: f64 = 3.0;
+
+fn core_hz() -> f64 {
+    const ADDS: u64 = 300_000_000;
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let mut x = black_box(0.0_f32);
+        let d = black_box(1.0e-3_f32);
+        let start = Instant::now();
+        for _ in 0..ADDS {
+            x += d;
+        }
+        let elapsed = start.elapsed().as_secs_f64();
+        black_box(x);
+        best = best.min(elapsed);
+    }
+    FADD_LATENCY_CYCLES * ADDS as f64 / best
+}
+
+fn loadavg() -> String {
+    std::fs::read_to_string("/proc/loadavg")
+        .unwrap_or_default()
+        .split_whitespace()
+        .take(3)
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+struct Arm {
+    name: &'static str,
+    runtime: SessionRuntime,
+    observation: u64,
+    p50: Vec<u64>,
+    min: Vec<u64>,
+}
+
+impl Arm {
+    fn new(name: &'static str, workload: Workload, dispatch: Backend) -> Self {
+        let mut runtime = SessionRuntime::build_with_dispatch(workload, PlanConfig::BASELINE, dispatch);
+        println!(
+            "  {name}: bank_shape [chains, slots] = {:?}, units = {}",
+            runtime.bank_shape(),
+            runtime.unit_eligibility().len(),
+        );
+        let mut observation = 0;
+        for _ in 0..WARMUP_BLOCKS {
+            runtime.render(observation).expect("warmup");
+            observation += 1;
+        }
+        let transposes = runtime.bank_transposes();
+        println!(
+            "  {name}: bank transposes per block = {}",
+            transposes as f64 / WARMUP_BLOCKS as f64
+        );
+        Self {
+            name,
+            runtime,
+            observation,
+            p50: Vec::new(),
+            min: Vec::new(),
+        }
+    }
+
+    fn round(&mut self) {
+        let mut samples = Vec::with_capacity(ROUND_BLOCKS);
+        for _ in 0..ROUND_BLOCKS {
+            let start = Instant::now();
+            let result = self.runtime.render(self.observation);
+            let elapsed = u64::try_from(start.elapsed().as_nanos()).unwrap_or(u64::MAX);
+            result.expect("block");
+            self.observation += 1;
+            samples.push(elapsed);
+        }
+        samples.sort_unstable();
+        self.p50.push(samples[samples.len() / 2]);
+        self.min.push(samples[0]);
+    }
+
+    fn profile(&mut self, hz: f64) {
+        profile::enable(true);
+        profile::reset();
+        for _ in 0..ROUND_BLOCKS {
+            self.runtime.render(self.observation).expect("block");
+            self.observation += 1;
+        }
+        profile::enable(false);
+        let (nanos, blocks, probes) = profile::snapshot();
+        let names = [
+            "enter", "source", "bound", "route", "output", "id-copy", "id-alias", "other", "bank",
+            "exit",
+        ];
+        let mut line = format!(
+            "  {} phases ({:.1} probes/block):",
+            self.name,
+            probes as f64 / blocks as f64
+        );
+        for (index, name) in names.iter().enumerate() {
+            let ns = nanos[index] as f64 / blocks as f64;
+            if ns > 0.0 {
+                line.push_str(&format!(" {name} {:.0}c", ns * hz / 1e9));
+            }
+        }
+        println!("{line}");
+    }
+}
+
+fn median(values: &[u64]) -> f64 {
+    let mut sorted = values.to_vec();
+    sorted.sort_unstable();
+    sorted[sorted.len() / 2] as f64
+}
+
+fn rows_at(dispatch: Backend, hz: f64) {
+    println!("== dispatch {dispatch:?}, loadavg {}", loadavg());
+    let modes: Vec<u8> = std::env::var("DIAG_MODES")
+        .unwrap_or_else(|_| "0".into())
+        .split(',')
+        .map(|m| m.parse().expect("mode"))
+        .collect();
+    let mut arms = [
+        match std::env::var("DIAG_ROW").as_deref() {
+            Ok("mono") => Arm::new("console_mono", Workload::SixtyFourTrackConsoleMono, dispatch),
+            Ok("console") => Arm::new("console", Workload::SixtyFourTrackConsole, dispatch),
+            _ => Arm::new(
+                "compressor_only",
+                Workload::SixtyFourTrackCompressorOnly,
+                dispatch,
+            ),
+        },
+        Arm::new("builtins_only", Workload::SixtyFourTrackBuiltinsOnly, dispatch),
+    ];
+    let mut by_mode: Vec<Vec<u64>> = vec![Vec::new(); modes.len()];
+    for _ in 0..ROUNDS {
+        for (index, mode) in modes.iter().enumerate() {
+            compressor::diag::set_mode(*mode);
+            arms[0].round();
+            arms[0].p50.pop();
+            arms[0].min.pop();
+            arms[0].round();
+            by_mode[index].push(*arms[0].p50.last().expect("p50"));
+        }
+        compressor::diag::set_mode(0);
+        arms[1].round();
+    }
+    let lane_samples_m = (TRACKS * QUANTUM * 2) as f64;
+    for (index, mode) in modes.iter().enumerate() {
+        let deltas: Vec<i64> = by_mode[index]
+            .iter()
+            .zip(&arms[1].p50)
+            .map(|(a, b)| *a as i64 - *b as i64)
+            .collect();
+        let mut sorted = deltas.clone();
+        sorted.sort_unstable();
+        let delta = sorted[sorted.len() / 2] as f64;
+        println!(
+            "  mode {mode:>2}: compressor_only p50 per round {:?} ns; isolate median {delta:.0} ns = {:.3} c/ls",
+            by_mode[index],
+            delta * hz / 1e9 / lane_samples_m
+        );
+    }
+    let lane_samples = (TRACKS * QUANTUM * 2) as f64;
+    for arm in &arms {
+        println!(
+            "  {:<16} p50 per round {:?} ns; min per round {:?} ns; median p50 {:.0} ns = {:.0} cycles = {:.3} c/ls",
+            arm.name,
+            arm.p50,
+            arm.min,
+            median(&arm.p50),
+            median(&arm.p50) * hz / 1e9,
+            median(&arm.p50) * hz / 1e9 / lane_samples
+        );
+    }
+    let deltas: Vec<i64> = arms[0]
+        .p50
+        .iter()
+        .zip(&arms[1].p50)
+        .map(|(a, b)| *a as i64 - *b as i64)
+        .collect();
+    let mut sorted = deltas.clone();
+    sorted.sort_unstable();
+    let delta = sorted[sorted.len() / 2] as f64;
+    println!(
+        "  isolate per round {deltas:?} ns; median {delta:.0} ns = {:.0} cycles/block = {:.3} cycles/lane-sample",
+        delta * hz / 1e9,
+        delta * hz / 1e9 / lane_samples
+    );
+    for arm in &mut arms {
+        arm.profile(hz);
+    }
+    println!("  loadavg after {}", loadavg());
+}
+
+#[test]
+#[ignore = "measurement harness; run pinned with --ignored --nocapture"]
+fn rows() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz, loadavg {}", hz / 1e9, loadavg());
+    let only = std::env::var("DIAG_DISPATCH").unwrap_or_default();
+    if only.is_empty() || only == "8" {
+        rows_at(Backend::Simd8, hz);
+    }
+    if only.is_empty() || only == "4" {
+        rows_at(Backend::Simd4, hz);
+    }
+    println!("core clock after {:.3} GHz", core_hz() / 1e9);
+}
+
+#[test]
+#[ignore = "writes the native source table for the wasm console host (DIAG_SOURCE_OUT)"]
+fn dump_sources() {
+    let path = std::env::var("DIAG_SOURCE_OUT").expect("DIAG_SOURCE_OUT");
+    let mut bytes = Vec::new();
+    for track in 0..128 {
+        for value in console_workload::source_block(track, false) {
+            bytes.extend_from_slice(&value.to_bits().to_le_bytes());
+        }
+    }
+    std::fs::write(path, bytes).expect("write");
+    for (index, workload) in WORKLOADS.iter().enumerate() {
+        println!("{index} {} tracks={}", workload.kind(), workload.tracks());
+    }
+}
+
+#[test]
+#[ignore = "digest harness; run with --ignored --nocapture"]
+fn digests() {
+    let mode: u8 = std::env::var("DIAG_MODE").map_or(0, |m| m.parse().expect("mode"));
+    compressor::diag::set_mode(mode);
+    println!("kernel prototype mode {mode}");
+    for dispatch in [Backend::Simd8, Backend::Simd4] {
+        for workload in WORKLOADS {
+            let mut runtime =
+                SessionRuntime::build_with_dispatch(workload, PlanConfig::BASELINE, dispatch);
+            let mut digest = bench_support::digest::Sha256Sink::new();
+            for block in 0..64 {
+                runtime.render(block).expect("render");
+                runtime.hash_output(&mut digest);
+            }
+            println!(
+                "{:?} {:<44} {}",
+                dispatch,
+                workload.kind(),
+                digest.finish_hex()
+            );
+        }
+    }
+}
