index 00000000..b49df53d
--- /dev/null
+++ b/tools/compressor-diag-guest/src/lib.rs
@@ -0,0 +1,156 @@
+//! DIAGNOSIS ONLY (docs/handoffs/effects-2026-09-27/COMPRESSOR-DIAGNOSIS.md).
+//!
+//! The compressor kernel at the wasm build's own width (`Simd4` under `+simd128`) and the
+//! replicas of `crates/compressor/examples/diag_support/replicas.rs`, as `u32`-in/`u32`-out
+//! exports. The host holds the clock around `run`, which renders `blocks` blocks of one arm.
+#![allow(unsafe_code, missing_docs, clippy::all)]
+
+#[path = "../../../crates/compressor/examples/diag_support/replicas.rs"]
+mod replicas;
+
+use compressor::diag::DiagBank;
+use effect_contract::LinkMode;
+use lane::{Backend, Lane};
+use replicas::*;
+use std::sync::Mutex;
+
+type W = lane::Simd4;
+
+struct Arm {
+    real: DiagBank<W>,
+    words: (Words, Words),
+    state: [W; 2],
+    source: (Vec<f32>, Vec<f32>),
+    left: Vec<f32>,
+    right: Vec<f32>,
+    bank: Option<BankArm>,
+    /// `usize::MAX - 3` public bank contract, `usize::MAX - 2` empty, `usize::MAX - 1` real render, `usize::MAX` real kernel, else a
+    /// replica index.
+    which: usize,
+}
+
+static ARM: Mutex<Option<Arm>> = Mutex::new(None);
+
+#[unsafe(no_mangle)]
+pub extern "C" fn diag_backend() -> u32 {
+    match Backend::current() {
+        Backend::Scalar => 0,
+        Backend::Simd4 => 1,
+        Backend::Simd8 => 2,
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn diag_variant_count() -> u32 {
+    VARIANTS.len() as u32
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn diag_variant_name_len(index: u32) -> u32 {
+    VARIANTS.get(index as usize).map_or(0, |name| name.len() as u32)
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn diag_variant_name_byte(index: u32, at: u32) -> u32 {
+    VARIANTS
+        .get(index as usize)
+        .and_then(|name| name.as_bytes().get(at as usize))
+        .map_or(0, |byte| u32::from(*byte))
+}
+
+/// `which`: 0 empty, 1 real render, 2 real kernel, 3 + i replica i. `params`: 0 fixture,
+/// 1 compressing, 2 parallel.
+#[unsafe(no_mangle)]
+pub extern "C" fn diag_prepare(which: u32, params: u32) -> u32 {
+    let values = match params {
+        0 => FIXTURE,
+        1 => COMPRESSING,
+        _ => PARALLEL,
+    };
+    let real = DiagBank::<W>::new(metadata(LinkMode::DualMono), values);
+    let words = real.words();
+    let source = noise_planes(W::WIDTH, 1, 0x5EED_0003, 0.5).remove(0);
+    let which = match which {
+        1000 => usize::MAX - 3,
+        1001 => usize::MAX - 4,
+        1002 => usize::MAX - 5,
+        1003 => usize::MAX - 6,
+        0 => usize::MAX - 2,
+        1 => usize::MAX - 1,
+        2 => usize::MAX,
+        n => (n - 3) as usize,
+    };
+    if which < usize::MAX - 6 && which >= VARIANTS.len() {
+        return 0;
+    }
+    *ARM.lock().unwrap_or_else(std::sync::PoisonError::into_inner) = Some(Arm {
+        real,
+        words,
+        state: [W::zero(); 2],
+        bank: BankArm::new(values),
+        left: source.0.clone(),
+        right: source.1.clone(),
+        source,
+        which,
+    });
+    1
+}
+
+/// Renders `blocks` blocks of the prepared arm, each from a fresh copy of the source.
+#[unsafe(no_mangle)]
+pub extern "C" fn diag_run(blocks: u32) -> u32 {
+    let mut guard = ARM.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let Some(arm) = guard.as_mut() else {
+        return 0;
+    };
+    for _ in 0..blocks {
+        arm.left.copy_from_slice(&arm.source.0);
+        arm.right.copy_from_slice(&arm.source.1);
+        match arm.which {
+            w if w == usize::MAX - 4 => arm.real.kernel_mono(&mut arm.left, FRAMES),
+            w if w == usize::MAX - 5 => {
+                if let Some(bank) = arm.bank.as_mut() {
+                    bank.process_ramp(&mut arm.left, &mut arm.right, 0);
+                }
+            }
+            w if w == usize::MAX - 6 => {
+                if let Some(bank) = arm.bank.as_mut() {
+                    bank.process_ramp_lanes(&mut arm.left, &mut arm.right, 0, 1);
+                }
+            }
+            w if w == usize::MAX - 3 => {
+                if let Some(bank) = arm.bank.as_mut() {
+                    bank.process(&mut arm.left, &mut arm.right);
+                }
+            }
+            w if w == usize::MAX - 2 => {}
+            w if w == usize::MAX - 1 => arm.real.render(&mut arm.left, &mut arm.right, FRAMES),
+            w if w == usize::MAX => arm.real.kernel(&mut arm.left, &mut arm.right, FRAMES),
+            index => dispatch::<W>(
+                VARIANTS[index],
+                &mut arm.left,
+                &mut arm.right,
+                &arm.words,
+                &mut arm.state,
+                LinkMode::DualMono,
+            ),
+        }
+    }
+    arm.left[0].to_bits() ^ arm.right[FRAMES].to_bits()
+}
+
+/// Runs the replica verification at this build's width and the scalar oracle. `1` if every
+/// equivalent replica matched the real kernel word for word.
+#[unsafe(no_mangle)]
+pub extern "C" fn diag_verify() -> u32 {
+    let a = verify_width::<W>("wasm");
+    let b = verify_width::<f32>("wasm-scalar");
+    u32::from(a && b)
+}
+
+/// Selects the kernel prototype mode (`compressor::diag::MODE`).
+#[unsafe(no_mangle)]
+pub extern "C" fn diag_set_mode(mode: u32) -> u32 {
+    compressor::diag::set_mode(mode as u8);
+    1
+}
