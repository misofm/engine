index 00000000..fe4423a3
--- /dev/null
+++ b/tools/compressor-diag-guest/host/wasm_loops.py
@@ -0,0 +1,71 @@
+import re, sys
+from collections import Counter
+
+# usage: wasm_loops.py guest.dis func_index [func_index ...]
+path = sys.argv[1]
+wanted = set(int(x) for x in sys.argv[2:])
+funcs = {}
+current = None
+for line in open(path):
+    m = re.match(r'^[0-9a-f]+ func\[(\d+)\] <(.*)>:', line)
+    if m:
+        current = int(m.group(1))
+        funcs[current] = (m.group(2), [])
+        continue
+    if current is None:
+        continue
+    if '|' in line:
+        op = line.split('|', 1)[1].strip()
+        if op:
+            funcs[current][1].append(op)
+
+
+def classify(op):
+    name = op.split()[0]
+    if name.startswith('f32x4.') or name.startswith('i32x4.') or name.startswith('v128.') or name.startswith('i8x16') or name.startswith('i16x8') or name.startswith('i64x2') or name.startswith('f64x2'):
+        if name in ('v128.load', 'v128.store') or name.startswith('v128.load') or name.startswith('v128.store'):
+            return 'v128 load/store'
+        if name == 'v128.const':
+            return 'v128.const'
+        if 'splat' in name:
+            return 'splat'
+        return 'simd arithmetic'
+    if name.startswith('local.') or name.startswith('global.'):
+        return 'local/global'
+    if 'load' in name or 'store' in name:
+        return 'scalar load/store'
+    if name in ('br', 'br_if', 'br_table', 'loop', 'block', 'end', 'if', 'else', 'return', 'unreachable', 'call', 'select'):
+        return 'control'
+    return 'scalar alu'
+
+
+for index in sorted(wanted):
+    name, ops = funcs[index]
+    # find innermost loops
+    stack = []
+    loops = []
+    for i, op in enumerate(ops):
+        head = op.split()[0]
+        if head in ('block', 'loop', 'if'):
+            stack.append((head, i, []))
+        elif head == 'end':
+            if not stack:
+                continue
+            kind, start, children = stack.pop()
+            if kind == 'loop':
+                loops.append((start, i, any(c for c in children)))
+                if stack:
+                    stack[-1][2].append(True)
+            else:
+                if stack and any(children):
+                    stack[-1][2].append(True)
+    innermost = [(s, e) for s, e, nested in loops if not nested]
+    s, e = max(innermost, key=lambda r: r[1] - r[0])
+    body = ops[s:e + 1]
+    c = Counter(classify(op) for op in body)
+    simd = Counter(op.split()[0] for op in body if classify(op) == 'simd arithmetic')
+    short = re.sub(r'_R.*replicas\d+', '', name)[:60]
+    print(f'func[{index}] {short}: loop of {len(body)} ops')
+    for k in sorted(c):
+        print(f'    {k:20s}{c[k]:5d}')
+    print('    top simd:', simd.most_common(14))
