+import sys, re
+
+# usage: classify.py file start_hex end_hex [a-b ...]  (address ranges on the executed path)
+f, start, end = sys.argv[1], int(sys.argv[2], 16), int(sys.argv[3], 16)
+extra = [(int(a, 16), int(b, 16)) for a, b in (x.split('-') for x in sys.argv[4:])]
+ranges = [(start, end)] + extra
+cats = {}
+lines = []
+for line in open(f):
+    m = re.match(r'\s*([0-9a-f]+):\s+(\S+)\s*(.*)', line)
+    if not m:
+        continue
+    addr = int(m.group(1), 16)
+    op = m.group(2)
+    args = m.group(3)
+    if not any(a <= addr <= b for a, b in ranges):
+        continue
+    if op.startswith('data16') or op.startswith('nop') or op.startswith('cs'):
+        continue
+    memarg = '(' in args
+    if op in ('vbroadcastss', 'vbroadcastsd', 'vpbroadcastd'):
+        c = 'broadcast'
+    elif op in ('vmovups', 'vmovaps', 'vmovss', 'vinsertps', 'vmovdqu', 'vmovdqa',
+                'vextractf128', 'vinsertf128', 'vperm2f128', 'movups', 'movaps', 'movss'):
+        c = 'vec-mem-move' if memarg else 'vec-reg-move'
+    elif op.startswith('v'):
+        c = 'vec-alu'
+        if memarg:
+            cats['  (vec-alu with mem operand)'] = cats.get('  (vec-alu with mem operand)', 0) + 1
+    else:
+        c = 'scalar'
+    cats[c] = cats.get(c, 0) + 1
+    lines.append((c, op))
+tot = sum(v for k, v in cats.items() if not k.startswith(' '))
+for k in sorted(cats):
+    print(f"{k:32s}{cats[k]:5d}")
+print(f"{'total':32s}{tot:5d}")
+ops = {}
+for c, op in lines:
+    if c == 'vec-alu':
+        ops[op] = ops.get(op, 0) + 1
+print(sorted(ops.items(), key=lambda x: -x[1]))
