diff --git a/crates/compressor/examples/diag_kernel.rs b/crates/compressor/examples/diag_kernel.rs
new file mode 100644
index 00000000..26332913
--- /dev/null
+++ b/crates/compressor/examples/diag_kernel.rs
@@ -0,0 +1,336 @@
+//! Compressor kernel diagnosis harness (docs/handoffs/effects-2026-09-27/COMPRESSOR-DIAGNOSIS.md).
+//!
+//! DIAGNOSIS ONLY. An example rather than a test so that it is built with the shipped release
+//! profile (fat LTO, one codegen unit, `panic = "abort"`), exactly like `lane_sample_timing`.
+//!
+//! ```text
+//! CARGO_INCREMENTAL=0 cargo build --release -p compressor --example diag_kernel
+//! taskset -c 31 <target>/release/examples/diag_kernel verify   # replicas vs the real kernel
+//! taskset -c 31 <target>/release/examples/diag_kernel time     # timing table
+//! ```
+//!
+//! Every replica below is the kernel's frame law transcribed from `crates/compressor/src/kernel.rs`
+//! with one structural change each. `verify` checks each against the real kernel (reached through
+//! the `compressor::diag` hook) word for word on fixture, compressing and hostile inputs, output
+//! and recursive state, before anything is timed.
+#![allow(clippy::disallowed_methods, clippy::too_many_arguments, missing_docs)]
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use effect_contract::LinkMode;
+use lane::{Lane, Simd4, Simd8};
+
+#[path = "diag_support/replicas.rs"]
+mod replicas;
+use compressor::diag::DiagBank;
+use replicas::*;
+
+const FADD_LATENCY_CYCLES: f64 = 3.0;
+
+/// Kernel prototype modes timed as `real_kernel_m*` rows (see `compressor::diag::MODE`).
+const MODES: [u8; 10] = [1, 3, 5, 7, 9, 11, 13, 15, 31, 47];
+
+fn core_hz() -> f64 {
+    const ADDS: u64 = 300_000_000;
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let mut x = black_box(0.0_f32);
+        let d = black_box(1.0e-3_f32);
+        let start = Instant::now();
+        for _ in 0..ADDS {
+            x += d;
+        }
+        let elapsed = start.elapsed().as_secs_f64();
+        black_box(x);
+        best = best.min(elapsed);
+    }
+    FADD_LATENCY_CYCLES * ADDS as f64 / best
+}
+
+fn loadavg() -> String {
+    std::fs::read_to_string("/proc/loadavg")
+        .unwrap_or_default()
+        .split_whitespace()
+        .take(3)
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+// time
+// ---------------------------------------------------------------------------------------------
+
+const BLOCKS_PER_ROUND: usize = 4096;
+const ROUNDS: usize = 3;
+
+fn per_block_p50(mut samples: Vec<u64>) -> u64 {
+    samples.sort_unstable();
+    samples[samples.len() / 2]
+}
+
+/// Times one closure per block, the input copied in outside the clock.
+fn time_blocks(
+    source: &(Vec<f32>, Vec<f32>),
+    left: &mut [f32],
+    right: &mut [f32],
+    mut body: impl FnMut(&mut [f32], &mut [f32]),
+) -> u64 {
+    let mut samples = Vec::with_capacity(BLOCKS_PER_ROUND);
+    for _ in 0..BLOCKS_PER_ROUND {
+        left.copy_from_slice(&source.0);
+        right.copy_from_slice(&source.1);
+        let start = Instant::now();
+        body(left, right);
+        samples.push(u64::try_from(start.elapsed().as_nanos()).unwrap_or(u64::MAX));
+    }
+    per_block_p50(samples)
+}
+
+fn time_width<L: Lane>(label: &str, hz: f64, params: [f32; 7], filter: &str) {
+    let source = noise_planes(L::WIDTH, 1, 0x5EED_0003, 0.5).remove(0);
+    let mut left = vec![0.0_f32; FRAMES * L::WIDTH];
+    let mut right = vec![0.0_f32; FRAMES * L::WIDTH];
+    let channel_frames = (FRAMES * 2) as f64;
+    let lane_samples = channel_frames * L::WIDTH as f64;
+    let mut rows: Vec<(String, Vec<u64>)> = Vec::new();
+    let mut names: Vec<String> = vec![
+        "real_render".into(),
+        "real_kernel".into(),
+        "real_finish".into(),
+        "empty".into(),
+    ];
+    for mode in MODES {
+        names.push(format!("real_kernel_m{mode}"));
+    }
+    names.push("real_render_m15".into());
+    names.push("real_kernel_mono".into());
+    for mode in [1u8, 5, 9, 13, 15] {
+        names.push(format!("real_mono_m{mode}"));
+    }
+    names.push("real_bank".into());
+    names.push("real_bank_m15".into());
+    for parameter in [0u32, 1, 3, 5] {
+        names.push(format!("real_bank_ramp_p{parameter}"));
+    }
+    names.push("real_bank_ramp1lane_p0".into());
+    names.push("real_render_silent".into());
+    names.extend(VARIANTS.iter().map(|name| (*name).to_string()));
+    names.retain(|name| filter.is_empty() || name.contains(filter) || name.starts_with("real") || name == "empty");
+    for name in &names {
+        rows.push((name.clone(), Vec::new()));
+    }
+    let mut real_render = DiagBank::<L>::new(metadata(LinkMode::DualMono), params);
+    let mut real_kernel = DiagBank::<L>::new(metadata(LinkMode::DualMono), params);
+    let mut real_finish = DiagBank::<L>::new(metadata(LinkMode::DualMono), params);
+    let words = real_kernel.words();
+    let mut bank = if lane::Backend::current().width() == L::WIDTH {
+        BankArm::new(params)
+    } else {
+        None
+    };
+    let mut states: Vec<[L; 2]> = vec![[L::zero(); 2]; names.len()];
+    // Warm every arm once.
+    for _ in 0..64 {
+        real_render.render(&mut left, &mut right, FRAMES);
+        real_kernel.kernel(&mut left, &mut right, FRAMES);
+    }
+    for _ in 0..ROUNDS {
+        for (index, name) in names.iter().enumerate() {
+            let p50 = match name.as_str() {
+                "real_render" => time_blocks(&source, &mut left, &mut right, |l, r| {
+                    real_render.render(l, r, FRAMES)
+                }),
+                "real_render_silent" => {
+                    let zero = (vec![0.0_f32; source.0.len()], vec![0.0_f32; source.1.len()]);
+                    let mut silent = DiagBank::<L>::new(metadata(LinkMode::DualMono), params);
+                    for _ in 0..4096 {
+                        left.copy_from_slice(&zero.0);
+                        right.copy_from_slice(&zero.1);
+                        silent.render(&mut left, &mut right, FRAMES);
+                    }
+                    time_blocks(&zero, &mut left, &mut right, |l, r| silent.render(l, r, FRAMES))
+                }
+                "real_bank_ramp1lane_p0" => match bank.as_mut() {
+                    Some(bank) => time_blocks(&source, &mut left, &mut right, |l, r| {
+                        bank.process_ramp_lanes(l, r, 0, 1)
+                    }),
+                    None => 0,
+                },
+                ramp if ramp.starts_with("real_bank_ramp_p") => match bank.as_mut() {
+                    Some(bank) => {
+                        let parameter: u32 = ramp["real_bank_ramp_p".len()..].parse().expect("p");
+                        time_blocks(&source, &mut left, &mut right, |l, r| {
+                            bank.process_ramp(l, r, parameter)
+                        })
+                    }
+                    None => 0,
+                },
+                "real_bank" | "real_bank_m15" => match bank.as_mut() {
+                    Some(bank) => {
+                        compressor::diag::set_mode(if name == "real_bank" { 0 } else { 15 });
+                        let p50 = time_blocks(&source, &mut left, &mut right, |l, r| bank.process(l, r));
+                        compressor::diag::set_mode(0);
+                        p50
+                    }
+                    None => 0,
+                },
+                moded if moded.starts_with("real_mono_m") => {
+                    let mode: u8 = moded["real_mono_m".len()..].parse().expect("mode");
+                    compressor::diag::set_mode(mode);
+                    let p50 = time_blocks(&source, &mut left, &mut right, |l, _r| {
+                        real_kernel.kernel_mono(l, FRAMES)
+                    });
+                    compressor::diag::set_mode(0);
+                    p50
+                }
+                "real_kernel_mono" => time_blocks(&source, &mut left, &mut right, |l, _r| {
+                    real_kernel.kernel_mono(l, FRAMES)
+                }),
+                "real_render_m15" => {
+                    compressor::diag::set_mode(15);
+                    let p50 = time_blocks(&source, &mut left, &mut right, |l, r| {
+                        real_render.render(l, r, FRAMES)
+                    });
+                    compressor::diag::set_mode(0);
+                    p50
+                }
+                moded if moded.starts_with("real_kernel_m") => {
+                    let mode: u8 = moded["real_kernel_m".len()..].parse().expect("mode");
+                    compressor::diag::set_mode(mode);
+                    let p50 = time_blocks(&source, &mut left, &mut right, |l, r| {
+                        real_kernel.kernel(l, r, FRAMES)
+                    });
+                    compressor::diag::set_mode(0);
+                    p50
+                }
+                "real_kernel" => time_blocks(&source, &mut left, &mut right, |l, r| {
+                    real_kernel.kernel(l, r, FRAMES)
+                }),
+                "real_finish" => time_blocks(&source, &mut left, &mut right, |l, r| {
+                    black_box(real_finish.finish(l, r));
+                }),
+                "empty" => time_blocks(&source, &mut left, &mut right, |l, r| {
+                    black_box((l, r));
+                }),
+                variant => {
+                    let state = &mut states[index];
+                    time_blocks(&source, &mut left, &mut right, |l, r| {
+                        dispatch::<L>(variant, l, r, &words, state, LinkMode::DualMono)
+                    })
+                }
+            };
+            rows[index].1.push(p50);
+        }
+    }
+    let empty = {
+        let row = rows.iter().find(|(name, _)| name == "empty").expect("empty row");
+        per_block_p50(row.1.clone()) as f64
+    };
+    println!(
+        "== {label}: p50 ns per block (rounds), then median minus the empty-clock row, as cycles per channel-frame and per lane-sample; clock {:.3} GHz; loadavg {}",
+        hz / 1e9,
+        loadavg()
+    );
+    for (name, samples) in &rows {
+        let median = per_block_p50(samples.clone()) as f64;
+        let net = if name == "empty" { median } else { median - empty };
+        let cycles = net * hz / 1e9;
+        println!(
+            "  {name:<20} {samples:?}  net {net:>8.0} ns  {:>7.2} c/channel-frame  {:>6.3} c/lane-sample",
+            cycles / channel_frames,
+            cycles / lane_samples
+        );
+    }
+}
+
+fn verify_mono<L: Lane>(label: &str) -> bool {
+    let mut ok = true;
+    for params in [FIXTURE, COMPRESSING, PARALLEL] {
+        for link_mode in [LinkMode::DualMono, LinkMode::Maximum, LinkMode::Average] {
+            for inputs in [
+                noise_planes(L::WIDTH, 48, 0xC0_4455, 1.0),
+                hostile_planes(L::WIDTH, 48, 0xBAD_F00D),
+            ] {
+                for mode in [1u8, 3, 5, 7, 9, 11, 13, 15] {
+                    let mut base = DiagBank::<L>::new(metadata(link_mode), params);
+                    let mut proto = DiagBank::<L>::new(metadata(link_mode), params);
+                    let mut bad = 0;
+                    for (source, _) in &inputs {
+                        let mut a = source.clone();
+                        let mut b = source.clone();
+                        compressor::diag::set_mode(0);
+                        base.kernel_mono(&mut a, FRAMES);
+                        compressor::diag::set_mode(mode);
+                        proto.kernel_mono(&mut b, FRAMES);
+                        compressor::diag::set_mode(0);
+                        for (x, y) in a.iter().zip(&b) {
+                            if x.to_bits() != y.to_bits() && !(x.is_nan() && y.is_nan()) {
+                                bad += 1;
+                            }
+                        }
+                        if base.state_bits() != proto.state_bits() {
+                            bad += 1;
+                        }
+                        let mut dummy_a = vec![0.0; a.len()];
+                        let mut dummy_b = vec![0.0; b.len()];
+                        base.finish(&mut a, &mut dummy_a);
+                        proto.finish(&mut b, &mut dummy_b);
+                    }
+                    if bad != 0 {
+                        ok = false;
+                        println!("{label} mono mode {mode} {link_mode:?}: {bad} mismatches");
+                    }
+                }
+            }
+        }
+    }
+    ok
+}
+
+fn main() {
+    let mut args = std::env::args().skip(1);
+    let mode = args.next().unwrap_or_default();
+    let filter = args.next().unwrap_or_default();
+    match mode.as_str() {
+        "verify" => {
+            let mode: u8 = filter.parse().unwrap_or(0);
+            compressor::diag::set_mode(mode);
+            println!("verify with kernel prototype mode {mode}");
+            let a = verify_width::<Simd8>("Simd8");
+            let b = verify_width::<Simd4>("Simd4");
+            let c = verify_width::<f32>("Scalar");
+            println!("verify: {}", if a && b && c { "ALL OK" } else { "FAILED" });
+            if !(a && b && c) {
+                std::process::exit(1);
+            }
+        }
+        "verify_mono" => {
+            let a = verify_mono::<Simd8>("Simd8");
+            let b = verify_mono::<Simd4>("Simd4");
+            let c = verify_mono::<f32>("Scalar");
+            println!("verify_mono: {}", if a && b && c { "ALL OK" } else { "FAILED" });
+        }
+        "time" => {
+            let hz = core_hz();
+            time_width::<Simd8>("Simd8 fixture", hz, FIXTURE, &filter);
+            time_width::<Simd4>("Simd4 fixture", hz, FIXTURE, &filter);
+            println!("clock after {:.3} GHz, loadavg {}", core_hz() / 1e9, loadavg());
+        }
+        "time8" => {
+            let hz = core_hz();
+            time_width::<Simd8>("Simd8 fixture", hz, FIXTURE, &filter);
+        }
+        "time4" => {
+            let hz = core_hz();
+            time_width::<Simd4>("Simd4 fixture", hz, FIXTURE, &filter);
+        }
+        "time_parallel" => {
+            let hz = core_hz();
+            time_width::<Simd8>("Simd8 parallel", hz, PARALLEL, &filter);
+            time_width::<Simd4>("Simd4 parallel", hz, PARALLEL, &filter);
+        }
+        _ => {
+            eprintln!("usage: diag_kernel <verify|time|time8|time4|time_parallel> [filter]");
+            std::process::exit(2);
+        }
+    }
+}
diff --git a/crates/compressor/examples/diag_probe.rs b/crates/compressor/examples/diag_probe.rs
new file mode 100644
index 00000000..fdec304c
--- /dev/null
+++ b/crates/compressor/examples/diag_probe.rs
@@ -0,0 +1,132 @@
+//! DIAGNOSIS ONLY: Zen 3 pipe-sharing probe for the compressor's op mix
+//! (docs/handoffs/effects-2026-09-27/COMPRESSOR-DIAGNOSIS.md). Twelve independent 256-bit
+//! accumulators, one inline-asm instruction per accumulator per step, so every dependency chain is
+//! longer than any latency and nothing can be folded.
+#![allow(unsafe_code, missing_docs, unreachable_pub, clippy::all)]
+
+#[cfg(target_arch = "x86_64")]
+mod probe {
+    use std::arch::asm;
+    use std::arch::x86_64::{__m256, _mm256_set1_ps};
+    use std::hint::black_box;
+    use std::time::Instant;
+
+    macro_rules! stream {
+        ($name:ident, [$($ins:literal),+]) => {
+            #[inline(never)]
+            pub fn $name(iterations: u64) -> f64 {
+                // SAFETY: AVX2 is pinned at compile time for this workspace; the asm touches only
+                // the named registers.
+                unsafe {
+                    let mut a: [__m256; 12] = [_mm256_set1_ps(black_box(1.0)); 12];
+                    let k: __m256 = _mm256_set1_ps(black_box(1.0000001));
+                    let m: __m256 = _mm256_set1_ps(black_box(-0.0));
+                    let start = Instant::now();
+                    for _ in 0..iterations {
+                        $(
+                            asm!(concat!($ins, " /* {k} {m} */"), a = inout(ymm_reg) a[0], k = in(ymm_reg) k, m = in(ymm_reg) m, options(nomem, nostack, pure));
+                            asm!(concat!($ins, " /* {k} {m} */"), a = inout(ymm_reg) a[1], k = in(ymm_reg) k, m = in(ymm_reg) m, options(nomem, nostack, pure));
+                            asm!(concat!($ins, " /* {k} {m} */"), a = inout(ymm_reg) a[2], k = in(ymm_reg) k, m = in(ymm_reg) m, options(nomem, nostack, pure));
+                            asm!(concat!($ins, " /* {k} {m} */"), a = inout(ymm_reg) a[3], k = in(ymm_reg) k, m = in(ymm_reg) m, options(nomem, nostack, pure));
+                            asm!(concat!($ins, " /* {k} {m} */"), a = inout(ymm_reg) a[4], k = in(ymm_reg) k, m = in(ymm_reg) m, options(nomem, nostack, pure));
+                            asm!(concat!($ins, " /* {k} {m} */"), a = inout(ymm_reg) a[5], k = in(ymm_reg) k, m = in(ymm_reg) m, options(nomem, nostack, pure));
+                            asm!(concat!($ins, " /* {k} {m} */"), a = inout(ymm_reg) a[6], k = in(ymm_reg) k, m = in(ymm_reg) m, options(nomem, nostack, pure));
+                            asm!(concat!($ins, " /* {k} {m} */"), a = inout(ymm_reg) a[7], k = in(ymm_reg) k, m = in(ymm_reg) m, options(nomem, nostack, pure));
+                            asm!(concat!($ins, " /* {k} {m} */"), a = inout(ymm_reg) a[8], k = in(ymm_reg) k, m = in(ymm_reg) m, options(nomem, nostack, pure));
+                            asm!(concat!($ins, " /* {k} {m} */"), a = inout(ymm_reg) a[9], k = in(ymm_reg) k, m = in(ymm_reg) m, options(nomem, nostack, pure));
+                            asm!(concat!($ins, " /* {k} {m} */"), a = inout(ymm_reg) a[10], k = in(ymm_reg) k, m = in(ymm_reg) m, options(nomem, nostack, pure));
+                            asm!(concat!($ins, " /* {k} {m} */"), a = inout(ymm_reg) a[11], k = in(ymm_reg) k, m = in(ymm_reg) m, options(nomem, nostack, pure));
+                        )+
+                    }
+                    let elapsed = start.elapsed().as_secs_f64();
+                    black_box(a);
+                    let ops = [$($ins),+].len() as f64 * 12.0 * iterations as f64;
+                    ops / elapsed
+                }
+            }
+        };
+    }
+
+    stream!(mul, ["vmulps {a}, {a}, {k}"]);
+    stream!(add, ["vaddps {a}, {a}, {k}"]);
+    stream!(max, ["vmaxps {a}, {a}, {k}"]);
+    stream!(cmp, ["vcmpltps {a}, {a}, {k}"]);
+    stream!(blend, ["vblendvps {m}, {k}, {a}, {a}"]);
+    stream!(and, ["vandps {a}, {a}, {k}"]);
+    stream!(round, ["vroundps {a}, {a}, 9"]);
+    stream!(shift, ["vpslld {a}, {a}, 1"]);
+    stream!(mul_add, ["vmulps {a}, {a}, {k}", "vaddps {a}, {a}, {k}"]);
+    stream!(mul_max, ["vmulps {a}, {a}, {k}", "vmaxps {a}, {a}, {k}"]);
+    stream!(add_max, ["vaddps {a}, {a}, {k}", "vmaxps {a}, {a}, {k}"]);
+    stream!(mul_cmp, ["vmulps {a}, {a}, {k}", "vcmpltps {a}, {a}, {k}"]);
+    stream!(add_cmp, ["vaddps {a}, {a}, {k}", "vcmpltps {a}, {a}, {k}"]);
+    stream!(mul_blend, ["vmulps {a}, {a}, {k}", "vblendvps {m}, {k}, {a}, {a}"]);
+    stream!(add_blend, ["vaddps {a}, {a}, {k}", "vblendvps {m}, {k}, {a}, {a}"]);
+    stream!(mul_and, ["vmulps {a}, {a}, {k}", "vandps {a}, {a}, {k}"]);
+    stream!(add_and, ["vaddps {a}, {a}, {k}", "vandps {a}, {a}, {k}"]);
+    stream!(mul_add_and, ["vmulps {a}, {a}, {k}", "vaddps {a}, {a}, {k}", "vandps {a}, {a}, {k}"]);
+    stream!(mul_add_max, ["vmulps {a}, {a}, {k}", "vaddps {a}, {a}, {k}", "vmaxps {a}, {a}, {k}"]);
+    stream!(mul_round, ["vmulps {a}, {a}, {k}", "vroundps {a}, {a}, 9"]);
+    stream!(add_round, ["vaddps {a}, {a}, {k}", "vroundps {a}, {a}, 9"]);
+    stream!(mul_shift, ["vmulps {a}, {a}, {k}", "vpslld {a}, {a}, 1"]);
+    stream!(add_shift, ["vaddps {a}, {a}, {k}", "vpslld {a}, {a}, 1"]);
+
+    pub fn run(hz: f64) {
+        let rows: [(&str, fn(u64) -> f64); 23] = [
+            ("vmulps", mul),
+            ("vaddps", add),
+            ("vmaxps", max),
+            ("vcmpltps", cmp),
+            ("vblendvps", blend),
+            ("vandps", and),
+            ("vroundps", round),
+            ("vpslld", shift),
+            ("mul+add", mul_add),
+            ("mul+max", mul_max),
+            ("add+max", add_max),
+            ("mul+cmp", mul_cmp),
+            ("add+cmp", add_cmp),
+            ("mul+blend", mul_blend),
+            ("add+blend", add_blend),
+            ("mul+and", mul_and),
+            ("add+and", add_and),
+            ("mul+add+and", mul_add_and),
+            ("mul+add+max", mul_add_max),
+            ("mul+round", mul_round),
+            ("add+round", add_round),
+            ("mul+shift", mul_shift),
+            ("add+shift", add_shift),
+        ];
+        for (name, f) in rows {
+            let mut best = 0.0_f64;
+            for _ in 0..3 {
+                best = best.max(f(20_000_000));
+            }
+            println!("  {name:<12} {:.3} ops/cycle", best / hz);
+        }
+    }
+}
+
+fn core_hz() -> f64 {
+    const ADDS: u64 = 300_000_000;
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let mut x = std::hint::black_box(0.0_f32);
+        let d = std::hint::black_box(1.0e-3_f32);
+        let start = std::time::Instant::now();
+        for _ in 0..ADDS {
+            x += d;
+        }
+        let elapsed = start.elapsed().as_secs_f64();
+        std::hint::black_box(x);
+        best = best.min(elapsed);
+    }
+    3.0 * ADDS as f64 / best
+}
+
+fn main() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz", hz / 1e9);
+    #[cfg(target_arch = "x86_64")]
+    probe::run(hz);
+}
