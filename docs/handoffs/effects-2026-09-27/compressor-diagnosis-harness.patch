+/// DIAGNOSIS ONLY (docs/handoffs/effects-2026-09-27): exposes the kernel at any lane width.
+#[doc(hidden)]
+pub mod diag {
+    use super::{Instance, Lane, MAX_WIDTH, PARAMETER_COUNT, kernel};
+    use effect_contract::{LinkMode, PreparedEffectMetadata};
+
+    /// Which settled-body prototype the kernel runs, read once per block. 0 is today's body.
+    /// Bit 0: loop hygiene (chunks, local state, detector hoisted); bit 1: DualMono link arm;
+    /// bit 2: all-wet output arm; bit 3: two-pass (targets first, 32-frame chunks).
+    pub static MODE: core::sync::atomic::AtomicU8 = core::sync::atomic::AtomicU8::new(0);
+
+    /// Sets [`MODE`].
+    pub fn set_mode(mode: u8) {
+        MODE.store(mode, core::sync::atomic::Ordering::Relaxed);
+    }
+
+    /// One prepared instance at width `L`, driven without the bank contract.
+    pub struct DiagBank<L: Lane> {
+        instance: Instance<L>,
+    }
+
+    impl<L: Lane> DiagBank<L> {
+        /// Builds an instance whose every lane and channel carries `values`.
+        pub fn new(metadata: PreparedEffectMetadata, values: [f32; PARAMETER_COUNT]) -> Self {
+            let defaults = [values; MAX_WIDTH];
+            Self {
+                instance: Instance::new(metadata, &defaults, &defaults),
+            }
+        }
+
+        /// The whole `Instance::render` path: admission, kernel, boundary scan.
+        pub fn render(&mut self, left: &mut [f32], right: &mut [f32], frames: usize) {
+            self.instance
+                .render(left, right, kernel::Detector::Main, frames, |_, _, _| {});
+        }
+
+        /// The kernel alone.
+        pub fn kernel(&mut self, left: &mut [f32], right: &mut [f32], frames: usize) {
+            let metadata = self.instance.metadata;
+            kernel::process_block::<L>(
+                left,
+                right,
+                kernel::Detector::Main,
+                frames,
+                metadata.link_mode,
+                metadata.bypass,
+                metadata.sample_rate,
+                (&mut self.instance.left, &mut self.instance.right),
+            );
+        }
+
+        /// The collapsed (mono) kernel alone.
+        pub fn kernel_mono(&mut self, left: &mut [f32], frames: usize) {
+            let metadata = self.instance.metadata;
+            kernel::process_block_mono::<L>(
+                left,
+                kernel::Detector::Main,
+                frames,
+                metadata.link_mode,
+                metadata.bypass,
+                metadata.sample_rate,
+                &mut self.instance.left,
+            );
+        }
+
+        /// The two boundary scans alone.
+        pub fn finish(&mut self, left: &mut [f32], right: &mut [f32]) -> u32 {
+            kernel::finish_channel::<L>(left, &mut self.instance.left)
+                | kernel::finish_channel::<L>(right, &mut self.instance.right)
+        }
+
+        /// Overrides the link mode (diagnosis of the link specialisation).
+        pub fn set_link(&mut self, link: LinkMode) {
+            self.instance.metadata.link_mode = link;
+        }
+
+        /// The designed coefficient words, left then right.
+        pub fn words(&self) -> ([[f32; MAX_WIDTH]; 8], [[f32; MAX_WIDTH]; 8]) {
+            (self.instance.left.words, self.instance.right.words)
+        }
+
+        /// The recursive words, left then right.
+        pub fn state_bits(&self) -> ([u32; MAX_WIDTH], [u32; MAX_WIDTH]) {
+            (
+                self.instance.left.recursive_bits(),
+                self.instance.right.recursive_bits(),
+            )
+        }
+    }
+}
