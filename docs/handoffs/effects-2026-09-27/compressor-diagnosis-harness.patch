+// DIAGNOSIS ONLY: time the compressor diag guest under Node's V8.
+// usage: node [--no-liftoff] node_host.mjs <guest.wasm> <verify|time> [filter] [params]
+import { readFileSync } from 'node:fs';
+import { loadavg } from 'node:os';
+
+const [, , path, mode = 'time', filter = '', paramsArg = '0'] = process.argv;
+const bytes = readFileSync(path);
+const module = new WebAssembly.Module(bytes);
+const imports = WebAssembly.Module.imports(module);
+if (imports.length !== 0) {
+  console.error('unexpected imports', imports);
+}
+const instance = new WebAssembly.Instance(module, {});
+const x = instance.exports;
+if (x.diag_backend() !== 1) {
+  throw new Error(`backend ${x.diag_backend()} is not Simd4`);
+}
+const names = [];
+for (let i = 0; i < x.diag_variant_count(); i++) {
+  let name = '';
+  const len = x.diag_variant_name_len(i);
+  for (let j = 0; j < len; j++) name += String.fromCharCode(x.diag_variant_name_byte(i, j));
+  names.push(name);
+}
+
+if (mode === 'verify') {
+  x.diag_set_mode(Number(filter || '0'));
+  const ok = x.diag_verify();
+  console.log(`wasm verify: ${ok === 1 ? 'ALL OK' : 'FAILED'}`);
+  process.exit(ok === 1 ? 0 : 1);
+}
+
+const FRAMES = 128;
+const LANES = 4;
+const BLOCKS_PER_CALL = 64;
+const CALLS = 48;
+const ROUNDS = 3;
+const params = Number(paramsArg);
+
+const MODES = (process.env.MODES || '1,3,5,7,9,11,13,15').split(',').map(Number);
+const arms = [
+  ['empty', 0, 0],
+  ['real_render', 1, 0],
+  ['real_kernel', 2, 0],
+  ...MODES.map((m) => [`real_kernel_m${m}`, 2, m]),
+  ['real_render_m15', 1, 15],
+  ['real_bank', 1000, 0],
+  ['real_bank_m15', 1000, 15],
+  ['real_bank_ramp_p0', 1002, 0],
+  ['real_bank_ramp1lane_p0', 1003, 0],
+  ...[0, 1, 5, 9, 13, 15].map((m) => [`real_mono_m${m}`, 1001, m]),
+  ...names.map((name, i) => [name, 3 + i, 0]),
+].filter(([name]) => !filter || name === 'empty' || name.startsWith('real') || name.includes(filter));
+
+function median(values) {
+  const sorted = [...values].sort((a, b) => a - b);
+  return sorted[Math.floor(sorted.length / 2)];
+}
+
+const results = new Map(arms.map(([name]) => [name, []]));
+for (let round = 0; round < ROUNDS; round++) {
+  for (const [name, which, mode] of arms) {
+    x.diag_set_mode(mode);
+    if (x.diag_prepare(which, params) !== 1) throw new Error(`prepare ${name}`);
+    for (let w = 0; w < 8; w++) x.diag_run(BLOCKS_PER_CALL);
+    const samples = [];
+    for (let c = 0; c < CALLS; c++) {
+      const start = process.hrtime.bigint();
+      x.diag_run(BLOCKS_PER_CALL);
+      const end = process.hrtime.bigint();
+      samples.push(Number(end - start) / BLOCKS_PER_CALL);
+    }
+    results.get(name).push(median(samples));
+  }
+}
+const hz = Number(process.env.CORE_HZ || '3.70e9');
+const empty = median(results.get('empty'));
+console.log(`== wasm simd128 under Node ${process.version} (${process.execArgv.join(' ') || 'default tiering'}), params ${params}; ns per block per round, net of the copy-only arm; clock ${hz / 1e9} GHz (native calibration); loadavg ${loadavg().map((v) => v.toFixed(2)).join(' ')}`);
+for (const [name] of arms) {
+  const rounds = results.get(name);
+  const m = median(rounds);
+  const net = name === 'empty' ? m : m - empty;
+  const cycles = (net * hz) / 1e9;
+  console.log(
+    `  ${name.padEnd(20)} [${rounds.map((v) => v.toFixed(0)).join(', ')}]  net ${net.toFixed(0).padStart(6)} ns  ${(cycles / (FRAMES * 2)).toFixed(2).padStart(7)} c/channel-frame  ${(cycles / (FRAMES * 2 * LANES)).toFixed(3).padStart(7)} c/lane-sample`,
+  );
+}
