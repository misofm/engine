@@ -0,0 +1,48 @@
+import re, sys
+from collections import defaultdict
+
+# usage: v8_slots.py listing.txt index : for the innermost loop, list stack slots written and read.
+path, index = sys.argv[1], int(sys.argv[2])
+text = open(path).read().split('\n')
+code = []
+cur = None
+for line in text:
+    if line.startswith('index: '):
+        cur = int(line[7:])
+    elif cur == index:
+        m = re.match(r'^0x[0-9a-f]+\s+([0-9a-f]+)\s+[0-9a-f]+\s+(.*)$', line)
+        if m:
+            code.append((int(m.group(1), 16), m.group(2).strip()))
+loops = []
+for o, ins in code:
+    m = re.match(r'^(j\w+)\s+0x[0-9a-f]+\s+<\+0x([0-9a-f]+)>', ins)
+    if m and int(m.group(2), 16) < o:
+        loops.append((int(m.group(2), 16), o))
+inner = [l for l in loops if not any(l2 != l and l[0] <= l2[0] and l2[1] <= l[1] for l2 in loops)]
+best = max(inner, key=lambda l: l[1] - l[0])
+body = [(o, ins) for o, ins in code if best[0] <= o <= best[1]]
+writes = defaultdict(list)
+reads = defaultdict(list)
+for pos, (o, ins) in enumerate(body):
+    ins2 = ins.replace('REX.W ', '')
+    m = re.match(r'^(\w+)\s+(.*)$', ins2)
+    if not m:
+        continue
+    op, args = m.group(1), m.group(2)
+    slots = re.findall(r'\[rbp[+-]0x[0-9a-f]+\]|\[rsp[+-]0x[0-9a-f]+\]|\[rsp\]', args)
+    if not slots:
+        continue
+    first = args.split(',')[0]
+    for s in slots:
+        if op.startswith('vmov') and s in first:
+            writes[s].append(pos)
+        else:
+            reads[s].append(pos)
+print(f'loop {best[0]:#x}-{best[1]:#x}: {len(body)} instructions')
+carried = []
+for s in sorted(set(writes) | set(reads)):
+    w, r = writes.get(s, []), reads.get(s, [])
+    kind = 'rw' if w and r else ('w' if w else 'r')
+    # loop-carried: read before the first write in program order
+    lc = bool(w and r and min(r) < min(w))
+    print(f'  {s:14s} {kind:3s} writes@{w} reads@{r}{"  LOOP-CARRIED" if lc else ""}')
diff --git a/tools/compressor-diag-guest/host/wasm_loops.py b/tools/compressor-diag-guest/host/wasm_loops.py
