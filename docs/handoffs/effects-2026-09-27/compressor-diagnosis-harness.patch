+// DIAGNOSIS ONLY: the wasm console guest's compressor_only and builtins_only rows under Node's V8,
+// with the compressor kernel prototype mode switched on the same instance between rounds.
+// usage: node [--no-liftoff] node_console.mjs <wasm_console_guest.wasm> <source.bin> [modes] [row] [control]
+import { readFileSync } from 'node:fs';
+import { loadavg } from 'node:os';
+
+const [, , path, sourcePath, modesArg = '0', rowArg = '5', controlArg = '6'] = process.argv;
+const modes = modesArg.split(',').map(Number);
+const row = Number(rowArg);
+const control = Number(controlArg);
+const source = new Uint32Array(readFileSync(sourcePath).buffer.slice(0));
+const module = new WebAssembly.Module(readFileSync(path));
+const TRACKS = 64;
+const SOURCE_BLOCK_VALUES = 256;
+const LANE_SAMPLES = TRACKS * 128 * 2;
+const WARMUP = 512;
+const ROUND_BLOCKS = 2000;
+const ROUNDS = 5;
+
+function instance(index, mode) {
+  const x = new WebAssembly.Instance(module, {}).exports;
+  if (x.miso_console_backend() !== 1) throw new Error('not Simd4');
+  x.miso_console_diag_mode(mode);
+  x.miso_console_reset_source();
+  for (let i = 0; i < TRACKS * SOURCE_BLOCK_VALUES; i++) x.miso_console_push_source_word(source[i]);
+  if (x.miso_console_prepare(index) !== 1) throw new Error(`prepare ${index}`);
+  return x;
+}
+
+function digest(index, mode, blocks = 64) {
+  const x = instance(index, mode);
+  for (let b = 0; b < blocks; b++) {
+    if (x.miso_console_render(b) !== 1) throw new Error('render');
+    x.miso_console_hash_output();
+  }
+  x.miso_console_finish_digest();
+  let hex = '';
+  for (let w = 0; w < 8; w++) hex += (x.miso_console_digest_word(w) >>> 0).toString(16).padStart(8, '0');
+  return hex;
+}
+
+const median = (v) => [...v].sort((a, b) => a - b)[Math.floor(v.length / 2)];
+function round(arm) {
+  const samples = new Array(ROUND_BLOCKS);
+  for (let i = 0; i < ROUND_BLOCKS; i++) {
+    const start = process.hrtime.bigint();
+    arm.x.miso_console_render(arm.observation++);
+    samples[i] = Number(process.hrtime.bigint() - start);
+  }
+  return median(samples);
+}
+
+const comp = { x: instance(row, 0), observation: 0 };
+const ctrl = { x: instance(control, 0), observation: 0 };
+for (const arm of [comp, ctrl]) {
+  for (let i = 0; i < WARMUP; i++) arm.x.miso_console_render(arm.observation++);
+}
+const p50 = new Map(modes.map((m) => [m, []]));
+const ctrlP50 = [];
+for (let r = 0; r < ROUNDS; r++) {
+  for (const m of modes) {
+    comp.x.miso_console_diag_mode(m);
+    round(comp); // one untimed round after a switch
+    p50.get(m).push(round(comp));
+  }
+  ctrlP50.push(round(ctrl));
+}
+const hz = Number(process.env.CORE_HZ || '3.70e9');
+const c = median(ctrlP50);
+console.log(`== wasm console row ${row} vs control ${control} under Node ${process.version} (${process.execArgv.join(' ') || 'default tiering'}), loadavg ${loadavg().map((v) => v.toFixed(2)).join(' ')}`);
+console.log(`  control p50 per round [${ctrlP50.join(', ')}] ns; median ${c}; digest64 ${digest(control, 0)}`);
+for (const m of modes) {
+  const v = median(p50.get(m));
+  const d = v - c;
+  console.log(`  mode ${String(m).padStart(2)}: p50 per round [${p50.get(m).join(', ')}] ns; median ${v} ns; isolate ${d} ns = ${((d * hz) / 1e9 / LANE_SAMPLES).toFixed(3)} c/ls; digest64 ${digest(row, m)}`);
+}
