+/// Diagnosis micro-benchmark: nanoseconds per channel-frame of the detector pass alone, over an
+/// L1-resident `chunk_frames` input, `reps` times.
+#[doc(hidden)]
+pub fn diag_detector_ns<L: Lane>(variant: u32, chunk_frames: usize, reps: usize) -> f64 {
+    let coef = LimiterCoef::<L>::new(true, false);
+    let z = L::zero();
+    let mut history = History::<L> {
+        t0: z, t1: z, t2: z, t3: z, t4: z, t5: z, t6: z, t7: z, t8: z, t9: z, t10: z, t11: z,
+    };
+    let io: Vec<f32> = (0..chunk_frames * L::WIDTH)
+        .map(|i| ((i as f32) * 0.013).sin() * 0.3)
+        .collect();
+    let mut peaks = vec![0.0_f32; chunk_frames * L::WIDTH];
+    let start = std::time::Instant::now();
+    for _ in 0..reps {
+        match variant {
+            0 => detector_chunk_v::<0, L>(&mut history, &io, &coef.fir, &mut peaks),
+            V_NOZERO => detector_chunk_v::<V_NOZERO, L>(&mut history, &io, &coef.fir, &mut peaks),
+            V_TREE => detector_chunk_v::<V_TREE, L>(&mut history, &io, &coef.fir, &mut peaks),
+            V_DET2 => detector_chunk_v::<V_DET2, L>(&mut history, &io, &coef.fir, &mut peaks),
+            v if v == V_DET2 | V_NOZERO => {
+                detector_chunk_v::<{ V_DET2 | V_NOZERO }, L>(&mut history, &io, &coef.fir, &mut peaks)
+            }
+            V_DET3 => detector_block_mem::<0, L>(&mut history, &io, &coef.fir, &mut peaks),
+            v if v == V_DET3 | V_NOZERO => {
+                detector_block_mem::<V_NOZERO, L>(&mut history, &io, &coef.fir, &mut peaks)
+            }
+            _ => panic!("variant"),
+        }
+        core::hint::black_box(&mut peaks);
+        core::hint::black_box(&mut history);
+    }
+    start.elapsed().as_nanos() as f64 / (reps * chunk_frames) as f64
+}
