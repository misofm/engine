+/// The history a block of `io` leaves behind, as `frames` shifts would have left it.
+#[inline(always)]
+fn history_after<L: Lane>(history: &History<L>, io: &[f32]) -> History<L> {
+    let w = L::WIDTH;
+    let frames = io.len() / w;
+    let x = |i: usize| L::load(&io[i * w..i * w + w]);
+    if frames >= HISTORY_WORDS {
+        History {
+            t0: x(frames - 1),
+            t1: x(frames - 2),
+            t2: x(frames - 3),
+            t3: x(frames - 4),
+            t4: x(frames - 5),
+            t5: x(frames - 6),
+            t6: x(frames - 7),
+            t7: x(frames - 8),
+            t8: x(frames - 9),
+            t9: x(frames - 10),
+            t10: x(frames - 11),
+            t11: x(frames - 12),
+        }
+    } else {
+        let mut h = *history;
+        for i in 0..frames {
+            h.shift(x(i));
+        }
+        h
+    }
+}
