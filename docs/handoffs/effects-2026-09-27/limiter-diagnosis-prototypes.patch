+/// The whole block's detector with taps read from the input block itself (V_DET3).
+///
+/// Frames `0..11` need taps from before the block and run the register-history body; every later
+/// frame reads its twelve taps straight out of `io`, two frames per iteration, so each coefficient
+/// row is loaded once for two frames and the taps are loads rather than a rotating register file.
+/// Per output: the same twelve `add(mul(..))` steps from `+0.0` in increasing tap order.
+#[inline(always)]
+fn detector_block_mem<const V: u32, L: Lane>(
+    history: &mut History<L>,
+    io: &[f32],
+    fir: &[[L; 4]; HISTORY_WORDS],
+    peaks: &mut [f32],
+) {
+    let w = L::WIDTH;
+    let frames = io.len() / w;
+    let head = frames.min(HISTORY_WORDS - 1);
+    let mut h = *history;
+    for n in 0..head {
+        detector_peak_v::<V, L>(&mut h, L::load(&io[n * w..n * w + w]), fir)
+            .store(&mut peaks[n * w..n * w + w]);
+    }
+    let mut n = head;
+    while n + 2 <= frames {
+        // Thirteen frames: x[n-11] ..= x[n+1]; tap k of frame n is window slot 11 - k.
+        let win = &io[(n - 11) * w..(n + 2) * w];
+        let x = |slot: usize| L::load(&win[slot * w..slot * w + w]);
+        let mut a0 = L::zero();
+        let mut a1 = L::zero();
+        let mut a2 = L::zero();
+        let mut a3 = L::zero();
+        let mut b0 = L::zero();
+        let mut b1 = L::zero();
+        let mut b2 = L::zero();
+        let mut b3 = L::zero();
+        macro_rules! tapm {
+            ($k:literal) => {{
+                let row = &fir[$k];
+                let c0 = row[0];
+                let c1 = row[1];
+                let c2 = row[2];
+                let c3 = row[3];
+                let xa = x(11 - $k);
+                let xb = x(12 - $k);
+                if V & V_NOZERO != 0 && $k == 0 {
+                    a0 = c0.mul(xa);
+                    b0 = c0.mul(xb);
+                    a1 = c1.mul(xa);
+                    b1 = c1.mul(xb);
+                    a2 = c2.mul(xa);
+                    b2 = c2.mul(xb);
+                    a3 = c3.mul(xa);
+                    b3 = c3.mul(xb);
+                } else {
+                    a0 = a0.add(c0.mul(xa));
+                    b0 = b0.add(c0.mul(xb));
+                    a1 = a1.add(c1.mul(xa));
+                    b1 = b1.add(c1.mul(xb));
+                    a2 = a2.add(c2.mul(xa));
+                    b2 = b2.add(c2.mul(xb));
+                    a3 = a3.add(c3.mul(xa));
+                    b3 = b3.add(c3.mul(xb));
+                }
+            }};
+        }
+        tapm!(0);
+        tapm!(1);
+        tapm!(2);
+        tapm!(3);
+        tapm!(4);
+        tapm!(5);
+        tapm!(6);
+        tapm!(7);
+        tapm!(8);
+        tapm!(9);
+        tapm!(10);
+        tapm!(11);
+        let mut pa = x(5).abs();
+        for phase in [a0, a1, a2, a3] {
+            pa = pa.max(phase.abs());
+        }
+        let mut pb = x(6).abs();
+        for phase in [b0, b1, b2, b3] {
+            pb = pb.max(phase.abs());
+        }
+        pa.store(&mut peaks[n * w..n * w + w]);
+        pb.store(&mut peaks[(n + 1) * w..(n + 1) * w + w]);
+        n += 2;
+    }
+    if n < frames {
+        // One odd frame: rebuild its history from the block and take the register body.
+        let mut t = h;
+        if n >= HISTORY_WORDS {
+            let x = |i: usize| L::load(&io[i * w..i * w + w]);
+            t = History {
+                t0: x(n - 1),
+                t1: x(n - 2),
+                t2: x(n - 3),
+                t3: x(n - 4),
+                t4: x(n - 5),
+                t5: x(n - 6),
+                t6: x(n - 7),
+                t7: x(n - 8),
+                t8: x(n - 9),
+                t9: x(n - 10),
+                t10: x(n - 11),
+                t11: x(n - 12),
+            };
+        } else {
+            for i in head..n {
+                t.shift(L::load(&io[i * w..i * w + w]));
+            }
+        }
+        detector_peak_v::<V, L>(&mut t, L::load(&io[n * w..n * w + w]), fir)
+            .store(&mut peaks[n * w..n * w + w]);
+    }
+    if frames >= HISTORY_WORDS {
+        let x = |i: usize| L::load(&io[i * w..i * w + w]);
+        h = History {
+            t0: x(frames - 1),
+            t1: x(frames - 2),
+            t2: x(frames - 3),
+            t3: x(frames - 4),
+            t4: x(frames - 5),
+            t5: x(frames - 6),
+            t6: x(frames - 7),
+            t7: x(frames - 8),
+            t8: x(frames - 9),
+            t9: x(frames - 10),
+            t10: x(frames - 11),
+            t11: x(frames - 12),
+        };
+    }
+    *history = h;
+}
