+#[test]
+#[ignore = "measurement harness"]
+fn identities() {
+    for width in [8, 4] {
+        for signal in [Signal::Console, Signal::Hot] {
+            let shape = Shape { width, banks: 2, ragged: false, link: LinkMode::Maximum };
+            for variant in CLASS_A
+                .iter()
+                .copied()
+                .chain([
+                    BEST,
+                    BEST | V_ASSERT,
+                    BEST & !V_LINKED,
+                    COMBO_A,
+                    COMBO_A | V_LINKED,
+                    COMBO_A | V_SPLIT,
+                    COMBO_A | V_LINKED | V_F64DIV,
+                    V_LINKED | V_F64DIV,
+                ])
+            {
+                let same = identity(shape, signal, variant, 400);
+                println!(
+                    "identity W{width} {} {:<50} {}",
+                    if signal == Signal::Hot { "hot    " } else { "console" },
+                    name(variant),
+                    if same { "SAME" } else { "DIFFERENT" }
+                );
+            }
+        }
+        // Independent link: the linked variant must decline, and every other must still match.
+        let shape = Shape { width, banks: 2, ragged: false, link: LinkMode::DualMono };
+        for variant in [V_LINKED, COMBO_A | V_LINKED] {
+            println!(
+                "identity W{width} hot dual_mono {:<44} {}",
+                name(variant),
+                if identity(shape, Signal::Hot, variant, 400) { "SAME" } else { "DIFFERENT" }
+            );
+        }
+    }
+}
