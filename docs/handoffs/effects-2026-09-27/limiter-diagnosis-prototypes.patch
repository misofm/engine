+//! Limiter diagnosis, console level (docs/handoffs/effects-2026-09-27/LIMITER-DIAGNOSIS.md).
+//! Throwaway, ignored, reverted after use. Run pinned under the timing lock:
+//!
+//! ```text
+//! CARGO_INCREMENTAL=0 taskset -c 31 cargo test --release -p console-workload \
+//!     --test limiter_diag_console -- --ignored --nocapture --test-threads 1
+//! ```
+
+use std::hint::black_box;
+use std::sync::atomic::Ordering;
+use std::time::Instant;
+
+use bench_support::digest::Sha256Sink;
+use console_workload::{PlanConfig, SessionRuntime, Workload};
+use lane::Backend;
+use true_peak_limiter::{
+    DIAG_VARIANT, V_DET2, V_FISSION, V_FUSEDCHECK, V_HOIST, V_LEANSTATE, V_LINKED, V_MAXDIV,
+    V_NOSCATTER, V_NOZERO, V_SCREEN, V_TREE, X_NOOP,
+};
+
+fn core_hz() -> f64 {
+    const ADDS: u64 = 200_000_000;
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let mut x = black_box(0.0_f32);
+        let d = black_box(1.0e-3_f32);
+        let start = Instant::now();
+        for _ in 0..ADDS {
+            x += d;
+        }
+        best = best.min(start.elapsed().as_secs_f64());
+        black_box(x);
+    }
+    3.0 * ADDS as f64 / best
+}
+
+fn loadavg() -> String {
+    std::fs::read_to_string("/proc/loadavg").unwrap_or_default().trim().to_string()
+}
+
+const SMALL_A: u32 = V_HOIST | V_NOZERO | V_MAXDIV | V_NOSCATTER;
+
+fn digest(workload: Workload, backend: Backend, variant: u32) -> String {
+    DIAG_VARIANT.store(variant, Ordering::Relaxed);
+    let mut runtime = SessionRuntime::build_with_dispatch(workload, PlanConfig::BASELINE, backend);
+    let mut sink = Sha256Sink::new();
+    for block in 0..200 {
+        runtime.render(block).expect("render");
+        runtime.hash_output(&mut sink);
+    }
+    DIAG_VARIANT.store(0, Ordering::Relaxed);
+    sink.finish_hex()
+}
+
+#[test]
+#[ignore = "measurement harness"]
+fn console_digests() {
+    for backend in [Backend::Simd8, Backend::Simd4] {
+        let base = digest(Workload::SixtyFourTrackConsole, backend, 0);
+        for variant in [
+            V_LINKED,
+            SMALL_A,
+            SMALL_A | V_LINKED | V_LEANSTATE,
+            SMALL_A | V_LINKED | V_LEANSTATE | V_DET2,
+            V_LINKED | V_HOIST | V_NOZERO | V_FUSEDCHECK | V_MAXDIV | V_NOSCATTER,
+        ] {
+            let got = digest(Workload::SixtyFourTrackConsole, backend, variant);
+            println!(
+                "console digest {backend:?} variant {variant:#x}: {}",
+                if got == base { "SAME" } else { "DIFFERENT" }
+            );
+        }
+        for variant in [V_SCREEN, SMALL_A | V_LINKED | V_LEANSTATE | V_SCREEN] {
+            let got = digest(Workload::SixtyFourTrackConsole, backend, variant);
+            println!("console digest {backend:?} variant {variant:#x}: {}", if got == base { "SAME" } else { "DIFFERENT" });
+        }
+        let tree = digest(Workload::SixtyFourTrackConsole, backend, V_TREE);
+        println!(
+            "console digest {backend:?} TREE (class B, expected to differ): {}",
+            if tree == base { "SAME" } else { "DIFFERENT" }
+        );
+    }
+}
+
+fn p50(mut v: Vec<u64>) -> u64 {
+    v.sort_unstable();
+    v[v.len() / 2]
+}
+
+#[test]
+#[ignore = "measurement harness"]
+fn console_rows() {
+    let hz = core_hz();
+    for backend in [Backend::Simd8, Backend::Simd4] {
+        println!(
+            "== {backend:?}: core clock {:.3} GHz, loadavg [{}]",
+            hz / 1e9,
+            loadavg()
+        );
+        let mut console =
+            SessionRuntime::build_with_dispatch(Workload::SixtyFourTrackConsole, PlanConfig::BASELINE, backend);
+        let mut eq_comp = SessionRuntime::build_with_dispatch(
+            Workload::SixtyFourTrackEqCompSimd1,
+            PlanConfig::BASELINE,
+            backend,
+        );
+        let mut legacy = SessionRuntime::build_with_dispatch(
+            Workload::SixtyFourTrackConsoleLegacy,
+            PlanConfig::BASELINE,
+            backend,
+        );
+        // (label, which runtime, variant)
+        let arms: Vec<(&str, usize, u32)> = vec![
+            ("eq_comp_simd1", 1, 0),
+            ("console_legacy (two chains)", 2, 0),
+            ("console", 0, 0),
+            ("console, limiter NOOP", 0, X_NOOP),
+            ("console LINKED", 0, V_LINKED),
+            ("console SMALL_A", 0, SMALL_A),
+            ("console LINKED+SMALL_A+LEANSTATE", 0, SMALL_A | V_LINKED | V_LEANSTATE),
+            ("console LEANSTATE+NOSCATTER", 0, V_LEANSTATE | V_NOSCATTER),
+            ("console SCREEN", 0, V_SCREEN),
+            ("console LINKED+SMALL_A+LEANSTATE+SCREEN", 0, SMALL_A | V_LINKED | V_LEANSTATE | V_SCREEN),
+        ];
+        let mut observation = [0_u64; 3];
+        let render = |which: usize, rts: &mut [&mut SessionRuntime; 3], observation: &mut [u64; 3]| {
+            rts[which].render(observation[which]).expect("render");
+            observation[which] += 1;
+        };
+        let mut rts = [&mut console, &mut eq_comp, &mut legacy];
+        for _ in 0..300 {
+            for which in 0..3 {
+                render(which, &mut rts, &mut observation);
+            }
+        }
+        let mut results: Vec<Vec<u64>> = vec![Vec::new(); arms.len()];
+        for round in 0..4 {
+            let order: Vec<usize> = if round % 2 == 0 {
+                (0..arms.len()).collect()
+            } else {
+                (0..arms.len()).rev().collect()
+            };
+            for index in order {
+                let (_, which, variant) = arms[index];
+                DIAG_VARIANT.store(variant, Ordering::Relaxed);
+                for _ in 0..50 {
+                    render(which, &mut rts, &mut observation);
+                }
+                let mut samples = Vec::with_capacity(1500);
+                for _ in 0..1500 {
+                    let start = Instant::now();
+                    rts[which].render(observation[which]).expect("render");
+                    samples.push(start.elapsed().as_nanos() as u64);
+                    observation[which] += 1;
+                }
+                results[index].push(p50(samples));
+            }
+        }
+        DIAG_VARIANT.store(0, Ordering::Relaxed);
+        let lane_samples = 64.0 * 128.0 * 2.0;
+        let eq = p50(results[0].clone()) as f64;
+        for (index, (label, _, _)) in arms.iter().enumerate() {
+            let med = p50(results[index].clone()) as f64;
+            println!(
+                "  {label:<40} p50 {:>8.0} ns  {:>6.3} cyc/lane-sample  minus eq_comp {:>6.3} cyc/lane-sample   rounds {:?}",
+                med,
+                med * hz / 1e9 / lane_samples,
+                (med - eq) * hz / 1e9 / lane_samples,
+                results[index]
+            );
+        }
+    }
+}
