+/// Two consecutive detector frames interleaved: the same twelve-step tap-major chain per phase and
+/// per frame, in the same order, but eight independent accumulator chains per iteration instead of
+/// four, so the scheduler always holds ready work from the other frame.
+#[inline(always)]
+fn detector_pair<const V: u32, L: Lane>(
+    history: &mut History<L>,
+    xa: L,
+    xb: L,
+    fir: &[[L; 4]; HISTORY_WORDS],
+) -> (L, L) {
+    history.shift(xa);
+    let h = *history;
+    let mut a0 = L::zero();
+    let mut a1 = L::zero();
+    let mut a2 = L::zero();
+    let mut a3 = L::zero();
+    let mut b0 = L::zero();
+    let mut b1 = L::zero();
+    let mut b2 = L::zero();
+    let mut b3 = L::zero();
+    macro_rules! tap2 {
+        ($index:literal, $sa:expr, $sb:expr) => {{
+            let row = &fir[$index];
+            let sa = $sa;
+            let sb = $sb;
+            a0 = a0.add(row[0].mul(sa));
+            b0 = b0.add(row[0].mul(sb));
+            a1 = a1.add(row[1].mul(sa));
+            b1 = b1.add(row[1].mul(sb));
+            a2 = a2.add(row[2].mul(sa));
+            b2 = b2.add(row[2].mul(sb));
+            a3 = a3.add(row[3].mul(sa));
+            b3 = b3.add(row[3].mul(sb));
+        }};
+    }
+    if V & V_NOZERO != 0 {
+        let row = &fir[0];
+        a0 = row[0].mul(h.t0);
+        b0 = row[0].mul(xb);
+        a1 = row[1].mul(h.t0);
+        b1 = row[1].mul(xb);
+        a2 = row[2].mul(h.t0);
+        b2 = row[2].mul(xb);
+        a3 = row[3].mul(h.t0);
+        b3 = row[3].mul(xb);
+    } else {
+        tap2!(0, h.t0, xb);
+    }
+    tap2!(1, h.t1, h.t0);
+    tap2!(2, h.t2, h.t1);
+    tap2!(3, h.t3, h.t2);
+    tap2!(4, h.t4, h.t3);
+    tap2!(5, h.t5, h.t4);
+    tap2!(6, h.t6, h.t5);
+    tap2!(7, h.t7, h.t6);
+    tap2!(8, h.t8, h.t7);
+    tap2!(9, h.t9, h.t8);
+    tap2!(10, h.t10, h.t9);
+    tap2!(11, h.t11, h.t10);
+    let mut pa = h.t6.abs();
