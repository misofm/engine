+/// V_UNITY: `true` when every tap either channel's detector reads this block is strictly below
+/// `SCREEN_FACTOR * min(limit_left, limit_right)`, lane by lane (stationary ramps only).
+fn unity_screen<L: Lane>(left: &ChannelState, right: &ChannelState, left_io: &[f32], right_io: &[f32]) -> bool {
+    let mut limit = [0.0_f32; MAXIMUM_WIDTH];
+    for lane in 0..L::WIDTH {
+        let a = left.limit[lane].current;
+        let b = right.limit[lane].current;
+        limit[lane] = if a < b { a } else { b };
+    }
+    let threshold = L::load(&limit).mul(L::splat(SCREEN_FACTOR));
+    let all = L::zero().eq(L::zero());
+    let ok = block_below::<L>(&History::<L>::load(left), left_io, threshold, all);
+    if L::mask_any(L::mask_not(ok)) {
+        return false;
+    }
+    let ok = block_below::<L>(&History::<L>::load(right), right_io, threshold, ok);
+    !L::mask_any(L::mask_not(ok))
+}
