+/// `true` when every tap any frame of this block can see is strictly below `threshold`, lane by
+/// lane, on both channels. NaN fails the ordered compare, so a non-finite word always declines.
+#[inline(always)]
+fn block_below<L: Lane>(history: &History<L>, io: &[f32], threshold: L, ok: <L as Lane>::Mask) -> <L as Lane>::Mask {
+    let mut ok = ok;
+    let h = history;
+    for tap in [h.t0, h.t1, h.t2, h.t3, h.t4, h.t5, h.t6, h.t7, h.t8, h.t9, h.t10, h.t11] {
+        ok = L::mask_and(ok, tap.abs().lt(threshold));
+    }
+    // Early exit every sixteen frames: a loud block declines after its first loud chunk.
+    for chunk in io.chunks(16 * L::WIDTH) {
+        for frame in chunk.chunks_exact(L::WIDTH) {
+            ok = L::mask_and(ok, L::load(frame).abs().lt(threshold));
+        }
+        if L::mask_any(L::mask_not(ok)) {
+            return ok;
+        }
+    }
+    ok
+}
