+fn identities_ragged_frames() {
+    let pattern = [1usize, 5, 11, 12, 13, 64, 127, 128, 2, 3, 17, 31, 32, 33, 100];
+    for width in [8, 4] {
+        for signal in [Signal::Console, Signal::Hot] {
