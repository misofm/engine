+/// V_UNITY: one channel of a block at the unity fixed point. The frame body of the full kernel
+/// with `r = 1`, rings of exact `1.0`, `d = +0.0` reduces to the delay line and `y = z * 1.0`.
+fn unity_channel<L: Lane>(io: &mut [f32], state: &mut ChannelState, main: usize, main_cursor: usize, bypass: bool) {
+    let w = L::WIDTH;
+    let history = history_after::<L>(&History::<L>::load(state), io);
+    history.store(state);
+    let one = L::splat(1.0);
+    let mut cursor = main_cursor;
+    let ring = &mut state.main_ring[..main * w];
+    for frame in io.chunks_exact_mut(w) {
+        let x = L::load(frame);
+        let delayed = ring_lane::<L>(ring, cursor);
+        store_ring_lane::<L>(ring, cursor, x);
+        let y = if bypass { delayed } else { delayed.mul(one) };
+        y.store(frame);
+        cursor += 1;
+        if cursor == main {
+            cursor = 0;
+        }
+    }
+}
