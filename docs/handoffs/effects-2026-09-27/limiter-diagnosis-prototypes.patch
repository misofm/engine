diff --git a/crates/true-peak-limiter/tests/limiter_diag.rs b/crates/true-peak-limiter/tests/limiter_diag.rs
new file mode 100644
index 00000000..a5996fb5
--- /dev/null
+++ b/crates/true-peak-limiter/tests/limiter_diag.rs
@@ -0,0 +1,815 @@
+//! Limiter diagnosis harness (docs/handoffs/effects-2026-09-27/LIMITER-DIAGNOSIS.md). Throwaway,
+//! ignored by default, reverted after use. Run pinned, one invocation per timing:
+//!
+//! ```text
+//! CARGO_INCREMENTAL=0 taskset -c 31 cargo test --release -p true-peak-limiter \
+//!     --test limiter_diag -- --ignored --nocapture --test-threads 1 <name>
+//! ```
+
+use std::hint::black_box;
+use std::sync::atomic::Ordering;
+use std::time::Instant;
+
+use effect_contract::{
+    BankWidth, EffectBankProcessBlock, EffectQuality, InitialParameterValue, LinkMode,
+    NativeEffectFactory, ParameterChannel, PrepareEffectBankRequest, PrepareEffectLimits,
+    PrepareEffectRequest, PreparedNativeEffectBank, PreparedPorts, PreparedSidechainPort,
+};
+use lane::Backend;
+use true_peak_limiter::{
+    DIAG_VARIANT, TRUE_PEAK_LIMITER_DESCRIPTOR, TruePeakLimiterFactory, V_F64DIV, V_FUSEDCHECK,
+    V_ASSERT, V_DET2, V_DET3, V_FISSION, V_HEAPPEAKS, V_HOIST, V_LEANSTATE, V_SCREEN, V_SILENTFAST, V_UNITY,
+    V_TREE, V_LINKED, V_MAXDIV, V_NOSCATTER, V_NOZERO, V_SPLIT, X_DET, X_GAIN,
+    X_NODIV1,
+    X_NOFINISH, X_NOOP, X_RECIP32, X_STATE,
+};
+
+const QUANTUM: usize = 128;
+const RATE: u32 = 48_000;
+
+fn core_hz() -> f64 {
+    const ADDS: u64 = 200_000_000;
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let mut x = black_box(0.0_f32);
+        let d = black_box(1.0e-3_f32);
+        let start = Instant::now();
+        for _ in 0..ADDS {
+            x += d;
+        }
+        let elapsed = start.elapsed().as_secs_f64();
+        black_box(x);
+        best = best.min(elapsed);
+    }
+    3.0 * ADDS as f64 / best
+}
+
+fn loadavg() -> String {
+    std::fs::read_to_string("/proc/loadavg").unwrap_or_default().trim().to_string()
+}
+
+fn values(track: usize, lookahead: f32) -> [InitialParameterValue; 6] {
+    let ceiling = -0.5 - 0.031_25 * track as f32;
+    let release = 60.0 + 1.25 * track as f32;
+    let v = [ceiling, release, lookahead];
+    core::array::from_fn(|index| InitialParameterValue {
+        parameter_index: (index / 2) as u32,
+        channel: if index % 2 == 0 { ParameterChannel::Left } else { ParameterChannel::Right },
+        value: v[index / 2],
+    })
+}
+
+fn request(values: &[InitialParameterValue], link: LinkMode) -> PrepareEffectRequest<'_> {
+    let quality = TRUE_PEAK_LIMITER_DESCRIPTOR
+        .qualities
+        .iter()
+        .find(|quality| quality.sample_rate == RATE)
+        .expect("launch rate");
+    PrepareEffectRequest {
+        sample_rate: RATE,
+        quantum: QUANTUM as u32,
+        quality: EffectQuality::Normal,
+        bypass: false,
+        link_mode: link,
+        ports: PreparedPorts { sidechain: PreparedSidechainPort::None },
+        initial_values: values,
+        limits: PrepareEffectLimits {
+            maximum_total_state_bytes: quality.maximum_state.total().expect("state total"),
+            maximum_scratch_bytes: 24,
+            maximum_automation_spans_per_block: 16,
+        },
+    }
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Signal {
+    /// The console's frozen block: the fixture tone at the level the limiter sees (never limits).
+    Console,
+    /// Seeded noise at about +3 dBFS: limiting on every block.
+    Hot,
+    /// Exact zeros.
+    Silent,
+    /// Quiet noise (about -14 dBFS peak) with every fourth block at +3 dBFS: the screen engages and
+    /// declines within one run.
+    Bursty,
+    /// Quiet noise with one +3 dBFS block in every thirty-two.
+    Sparse,
+}
+
+#[derive(Clone, Copy)]
+struct Shape {
+    width: usize,
+    banks: usize,
+    ragged: bool,
+    link: LinkMode,
+}
+
+fn noise_word(state: &mut u64) -> f32 {
+    *state = state.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    let mut mixed = *state;
+    mixed = (mixed ^ (mixed >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    mixed = (mixed ^ (mixed >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    mixed ^= mixed >> 31;
+    (((mixed >> 40) as f32 * (1.0 / 16_777_216.0)) * 2.0 - 1.0) * 1.4125
+}
+
+struct Rig {
+    banks: Vec<Box<dyn PreparedNativeEffectBank>>,
+    width: usize,
+    /// Per bank, per block index (for `Hot`), the AoSoA left and right input planes.
+    input: Vec<(Vec<f32>, Vec<f32>)>,
+    io_left: Vec<Vec<f32>>,
+    io_right: Vec<Vec<f32>>,
+    blocks_in_table: usize,
+    signal: Signal,
+    block: usize,
+}
+
+impl Rig {
+    fn new(shape: Shape, signal: Signal) -> Self {
+        let width = shape.width;
+        let bank_width = if width == 8 { BankWidth::Eight } else { BankWidth::Four };
+        let backend = if width == 8 { Backend::Simd8 } else { Backend::Simd4 };
+        let mut banks = Vec::new();
+        let blocks_in_table = if matches!(signal, Signal::Hot | Signal::Bursty | Signal::Sparse) { 64 } else { 1 };
+        let mut input = Vec::new();
+        let mut state = 0x5150_0090_u64;
+        for bank in 0..shape.banks {
+            let tracks: Vec<[InitialParameterValue; 6]> = (0..width)
+                .map(|lane| {
+                    let track = bank * width + lane;
+                    let lookahead = if shape.ragged { 5.0 + 0.1 * lane as f32 } else { 5.0 };
+                    values(track % 64, lookahead)
+                })
+                .collect();
+            let requests: Vec<PrepareEffectRequest<'_>> =
+                tracks.iter().map(|v| request(v, shape.link)).collect();
+            banks.push(
+                TruePeakLimiterFactory
+                    .bind_homogeneous_bank(PrepareEffectBankRequest {
+                        backend,
+                        width: bank_width,
+                        requests: &requests,
+                    })
+                    .expect("bank binding")
+                    .expect("bank available"),
+            );
+            let words = blocks_in_table * QUANTUM * width;
+            let mut left = vec![0.0_f32; words];
+            let mut right = vec![0.0_f32; words];
+            for block in 0..blocks_in_table {
+                for frame in 0..QUANTUM {
+                    for lane in 0..width {
+                        let track = (bank * width + lane) % 64;
+                        let word = (block * QUANTUM + frame) * width + lane;
+                        match signal {
+                            Signal::Console => {
+                                let value = ((frame as f32) * 0.017 + track as f32 * 0.31).sin()
+                                    * 0.3;
+                                left[word] = value;
+                                right[word] = -value * 0.75;
+                            }
+                            Signal::Hot => {
+                                left[word] = noise_word(&mut state);
+                                right[word] = noise_word(&mut state);
+                            }
+                            Signal::Silent => {}
+                            Signal::Sparse => {
+                                let scale = if block % 32 == 31 { 1.0 } else { 0.14 };
+                                left[word] = noise_word(&mut state) * scale;
+                                right[word] = noise_word(&mut state) * scale;
+                            }
+                            Signal::Bursty => {
+                                let scale = if block % 4 == 3 { 1.0 } else { 0.14 };
+                                left[word] = noise_word(&mut state) * scale;
+                                right[word] = noise_word(&mut state) * scale;
+                            }
+                        }
+                    }
+                }
+            }
+            input.push((left, right));
+        }
+        let io_left = (0..shape.banks).map(|_| vec![0.0; QUANTUM * width]).collect();
+        let io_right = (0..shape.banks).map(|_| vec![0.0; QUANTUM * width]).collect();
+        Self { banks, width, input, io_left, io_right, blocks_in_table, signal, block: 0 }
+    }
+
+    fn stage(&mut self) {
+        let words = QUANTUM * self.width;
+        let offset = (self.block % self.blocks_in_table) * words;
+        for bank in 0..self.banks.len() {
+            self.io_left[bank].copy_from_slice(&self.input[bank].0[offset..offset + words]);
+            self.io_right[bank].copy_from_slice(&self.input[bank].1[offset..offset + words]);
+        }
+    }
+
+    fn process(&mut self) {
+        self.process_frames(QUANTUM);
+    }
+
+    fn process_frames(&mut self, frames: usize) {
+        let width = if self.width == 8 { BankWidth::Eight } else { BankWidth::Four };
+        let offsets = [0_u32; 9];
+        let words = frames * self.width;
+        for bank in 0..self.banks.len() {
+            let (left, right) = (&mut self.io_left[bank][..words], &mut self.io_right[bank][..words]);
+            self.banks[bank].process_bank(
+                EffectBankProcessBlock::new(
+                    left,
+                    right,
+                    None,
+                    frames as u32,
+                    width,
+                    (self.block * QUANTUM) as u64,
+                    &[],
+                    &offsets[..self.width + 1],
+                    QUANTUM as u32,
+                )
+                .expect("bank block"),
+            );
+        }
+        self.block += 1;
+    }
+
+    fn timed_block(&mut self) -> u64 {
+        self.stage();
+        let start = Instant::now();
+        self.process();
+        start.elapsed().as_nanos() as u64
+    }
+
+    fn lane_samples(&self) -> f64 {
+        (self.banks.len() * self.width * QUANTUM * 2) as f64
+    }
+
+    fn output_bits(&self, out: &mut Vec<u32>) {
+        for bank in 0..self.banks.len() {
+            out.extend(self.io_left[bank].iter().map(|v| v.to_bits()));
+            out.extend(self.io_right[bank].iter().map(|v| v.to_bits()));
+        }
+    }
+}
+
+fn p50(samples: &mut [u64]) -> u64 {
+    samples.sort_unstable();
+    samples[samples.len() / 2]
+}
+
+fn name(variant: u32) -> String {
+    let table = [
+        (V_LINKED, "LINKED"),
+        (V_HOIST, "HOIST"),
+        (V_NOZERO, "NOZERO"),
+        (V_FUSEDCHECK, "FUSEDCHECK"),
+        (V_F64DIV, "F64DIV"),
+        (V_MAXDIV, "MAXDIV"),
+        (V_SPLIT, "SPLIT"),
+        (V_NOSCATTER, "NOSCATTER"),
+        (X_NOOP, "x:NOOP"),
+        (X_STATE, "x:STATE"),
+        (X_DET, "x:DET"),
+        (X_NOFINISH, "x:NOFINISH"),
+        (X_RECIP32, "x:RECIP32"),
+        (X_NODIV1, "x:NODIV1"),
+        (X_GAIN, "x:GAIN"),
+        (V_DET2, "DET2"),
+        (V_ASSERT, "ASSERT"),
+        (V_DET3, "DET3"),
+        (V_TREE, "TREE(classB)"),
+        (V_HEAPPEAKS, "HEAPPEAKS"),
+        (V_LEANSTATE, "LEANSTATE"),
+        (V_SILENTFAST, "SILENTFAST"),
+        (V_FISSION, "FISSION"),
+        (V_SCREEN, "SCREEN"),
+        (V_UNITY, "UNITY"),
+    ];
+    if variant == 0 {
+        return "base".into();
+    }
+    table.iter().filter(|(bit, _)| variant & bit != 0).map(|(_, n)| *n).collect::<Vec<_>>().join("+")
+}
+
+/// Bit identity of a class-A variant against the base, from fresh banks, over `blocks` blocks.
+fn identity(shape: Shape, signal: Signal, variant: u32, blocks: usize) -> bool {
+    let run = |v: u32| {
+        DIAG_VARIANT.store(v, Ordering::Relaxed);
+        let mut rig = Rig::new(shape, signal);
+        let mut bits = Vec::new();
+        for _ in 0..blocks {
+            rig.stage();
+            rig.process();
+            rig.output_bits(&mut bits);
+        }
+        DIAG_VARIANT.store(0, Ordering::Relaxed);
+        bits
+    };
+    run(0) == run(variant)
+}
+
+fn measure(shape: Shape, signal: Signal, variants: &[u32], hz: f64) {
+    let mut rig = Rig::new(shape, signal);
+    let cycles = |ns: u64| ns as f64 * hz / 1e9;
+    const WARM: usize = 300;
+    const BLOCKS: usize = 1500;
+    const ROUNDS: usize = 4;
+    let mut table: Vec<Vec<u64>> = vec![Vec::new(); variants.len()];
+    let mut means: Vec<Vec<f64>> = vec![Vec::new(); variants.len()];
+    for _ in 0..WARM {
+        rig.stage();
+        rig.process();
+    }
+    for round in 0..ROUNDS {
+        let order: Vec<usize> = if round % 2 == 0 {
+            (0..variants.len()).collect()
+        } else {
+            (0..variants.len()).rev().collect()
+        };
+        for index in order {
+            DIAG_VARIANT.store(variants[index], Ordering::Relaxed);
+            for _ in 0..50 {
+                rig.stage();
+                rig.process();
+            }
+            let mut samples: Vec<u64> = (0..BLOCKS).map(|_| rig.timed_block()).collect();
+            means[index].push(samples.iter().sum::<u64>() as f64 / samples.len() as f64);
+            table[index].push(p50(&mut samples));
+        }
+    }
+    DIAG_VARIANT.store(0, Ordering::Relaxed);
+    let ls = rig.lane_samples();
+    let base_p50 = {
+        let mut b = table[0].clone();
+        b.sort_unstable();
+        b[b.len() / 2]
+    };
+    for (index, variant) in variants.iter().enumerate() {
+        let mut t = table[index].clone();
+        t.sort_unstable();
+        let med = t[t.len() / 2];
+        println!(
+            "  {:<58} p50/block {:>7} ns  {:>9.0} cyc/block  {:>6.0} cyc/bank-block  {:>6.3} cyc/lane-sample  delta {:+6.3}  mean {:>6.3} cyc/lane-sample  rounds {:?}",
+            name(*variant),
+            med,
+            cycles(med),
+            cycles(med) / rig.banks.len() as f64,
+            cycles(med) / ls,
+            (cycles(med) - cycles(base_p50)) / ls,
+            {
+                let m = &means[index];
+                m.iter().sum::<f64>() / m.len() as f64 * hz / 1e9 / ls
+            },
+            t
+        );
+    }
+}
+
+fn header(label: &str) -> f64 {
+    let hz = core_hz();
+    println!("== {label}: core clock {:.3} GHz, loadavg [{}]", hz / 1e9, loadavg());
+    hz
+}
+
+const CLASS_A: [u32; 11] = [
+    V_DET3,
+    V_DET2,
+    V_ASSERT,
+    V_LINKED,
+    V_HOIST,
+    V_NOZERO,
+    V_FUSEDCHECK,
+    V_F64DIV,
+    V_MAXDIV,
+    V_SPLIT,
+    V_NOSCATTER,
+];
+const COMBO_A: u32 = V_HOIST | V_NOZERO | V_FUSEDCHECK | V_MAXDIV | V_NOSCATTER;
+const BEST: u32 = V_DET2 | V_LINKED | V_HOIST | V_NOZERO | V_MAXDIV | V_NOSCATTER;
+const LEAN_BEST: u32 = V_LEANSTATE | V_LINKED | V_HOIST | V_NOZERO | V_MAXDIV | V_NOSCATTER;
+
+fn run_rows3(width: usize) {
+    let banks = 64 / width;
+    let shape = Shape { width, banks, ragged: false, link: LinkMode::Maximum };
+    let hz = header(&format!("W{width}, {banks} banks, console signal, round 3 prototypes"));
+    measure(
+        shape,
+        Signal::Console,
+        &[0, X_STATE, X_STATE | V_LEANSTATE | V_NOSCATTER, V_LEANSTATE | V_NOSCATTER, V_LINKED,
+          V_LINKED | V_HOIST | V_NOZERO | V_FUSEDCHECK | V_MAXDIV | V_NOSCATTER, LEAN_BEST, LEAN_BEST | V_DET2],
+        hz,
+    );
+    let hz = header(&format!("W{width}, {banks} banks, silent signal"));
+    measure(shape, Signal::Silent, &[0, V_SILENTFAST], hz);
+}
+
+fn run_rows4(width: usize) {
+    let banks = 64 / width;
+    let shape = Shape { width, banks, ragged: false, link: LinkMode::Maximum };
+    let hz = header(&format!("W{width}, {banks} banks, console signal, round 4 (fission)"));
+    measure(
+        shape,
+        Signal::Console,
+        &[0, V_FISSION, V_LINKED, V_FISSION | V_LINKED, (LEAN_BEST & !V_LINKED) | V_FISSION, LEAN_BEST, LEAN_BEST | V_FISSION, LEAN_BEST | V_FISSION | V_DET2],
+        hz,
+    );
+    let hz = header(&format!("W{width}, {banks} banks, dual-mono link, round 4 (fission)"));
+    measure(
+        Shape { width, banks, ragged: false, link: LinkMode::DualMono },
+        Signal::Console,
+        &[0, V_FISSION, (LEAN_BEST & !V_LINKED) | V_FISSION],
+        hz,
+    );
+}
