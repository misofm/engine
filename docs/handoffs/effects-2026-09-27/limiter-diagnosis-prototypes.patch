+fn run_rows(width: usize) {
+    let banks = 64 / width;
+    let hz = header(&format!("W{width}, {banks} banks (64 tracks), console signal"));
+    let shape = Shape { width, banks, ragged: false, link: LinkMode::Maximum };
+    measure(
