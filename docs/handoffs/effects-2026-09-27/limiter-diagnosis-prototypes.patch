+/// The E12 corpus digests (`corpus::D90_DIGESTS`) under each class-A prototype, at W4 and W8.
+#[test]
+#[ignore = "measurement harness"]
+fn corpus_digests() {
+    use lane::{Simd4, Simd8};
+    use sha2::{Digest, Sha256};
+    use true_peak_limiter::corpus;
+    fn digest<L: lane::Lane>(case: usize) -> [u8; 32] {
+        let mut out = vec![0_u32; corpus::POINTS];
+        corpus::run_case::<L>(case, &mut out);
+        let mut hasher = Sha256::new();
+        for word in &out {
+            hasher.update(word.to_le_bytes());
+        }
+        hasher.finalize().into()
+    }
+    let mut variants = vec![0];
+    variants.extend(CLASS_A);
+    variants.extend([COMBO_A, COMBO_A | V_LINKED, COMBO_A | V_SPLIT, COMBO_A | V_LINKED | V_F64DIV, V_SCREEN, V_SCREEN | V_LINKED, V_SCREEN | LEAN_BEST]);
+    for variant in variants {
+        if variant & V_DET3 != 0 {
+            continue;
+        }
+        DIAG_VARIANT.store(variant, Ordering::Relaxed);
+        let mut all = true;
+        for case in 0..corpus::CASE_COUNT {
+            all &= digest::<Simd8>(case) == corpus::D90_DIGESTS[case];
+            all &= digest::<Simd4>(case) == corpus::D90_DIGESTS[case];
+        }
+        println!("corpus {:<50} {}", name(variant), if all { "ALL PINS HOLD" } else { "MOVED" });
+    }
+    DIAG_VARIANT.store(0, Ordering::Relaxed);
+}
