+#[inline(always)]
+fn required_gain<const V: u32, L: Lane>(peak: L, limit: L) -> L {
+    if V & X_NODIV1 != 0 {
+        L::select(peak.gt(limit), limit.mul(peak), L::splat(1.0))
+    } else if V & V_MAXDIV != 0 {
+        limit.div(peak.max(limit))
+    } else {
+        L::select(peak.gt(limit), limit.div(peak), L::splat(1.0))
+    }
+}
+
+#[inline(always)]
+fn box_divide<const V: u32, L: Lane>(sum: L, window: L, diag: &DiagFrame<L>) -> L {
+    if V & V_F64DIV != 0 {
+        let mut words = [0.0_f32; MAXIMUM_WIDTH];
+        sum.store(&mut words);
+        let mut out = [0.0_f32; MAXIMUM_WIDTH];
+        for (o, w) in out.iter_mut().zip(words.iter()).take(L::WIDTH) {
+            *o = (f64::from(*w) * diag.recip) as f32;
+        }
+        L::load(&out)
+    } else if V & X_RECIP32 != 0 {
+        sum.mul(diag.recip32)
+    } else {
+        sum.div(window)
+    }
+}
+
+#[inline(always)]
+fn output_word<const V: u32, L: Lane>(bypass: <L as Lane>::Mask, diag: &DiagFrame<L>, delayed: L, gain: L) -> L {
+    if V & V_HOIST != 0 {
+        if diag.bypass { delayed } else { delayed.mul(gain) }
+    } else {
+        L::select(bypass, delayed, delayed.mul(gain))
+    }
+}
