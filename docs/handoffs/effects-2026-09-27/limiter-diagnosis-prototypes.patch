+/// Designed words the linked gain computer requires to agree, lane by lane, between the channels.
+fn gain_symmetric(left: &ChannelState, right: &ChannelState) -> bool {
+    let ramps_agree = |a: &LinearRamp, b: &LinearRamp| {
+        a.current.to_bits() == b.current.to_bits()
+            && a.target.to_bits() == b.target.to_bits()
+            && a.step.to_bits() == b.step.to_bits()
+            && a.remaining == b.remaining
+    };
+    left.lane.iter().zip(right.lane.iter()).all(|(a, b)| a == b)
+        && left.limit.iter().zip(right.limit.iter()).all(|(a, b)| ramps_agree(a, b))
+        && left.release.iter().zip(right.release.iter()).all(|(a, b)| ramps_agree(a, b))
+}
