+            for variant in [V_DET3, V_DET2, BEST, BEST & !V_LINKED, V_LINKED, COMBO_A | V_LINKED, V_LEANSTATE | V_NOSCATTER, LEAN_BEST, LEAN_BEST | V_DET2, V_SILENTFAST,
+                V_FISSION, V_FISSION | V_LINKED, LEAN_BEST | V_FISSION, (LEAN_BEST & !V_LINKED) | V_FISSION, LEAN_BEST | V_FISSION | V_DET2] {
+                let run = |v: u32| {
+                    DIAG_VARIANT.store(v, Ordering::Relaxed);
+                    let mut rig = Rig::new(shape, signal);
+                    let mut bits = Vec::new();
+                    for block in 0..600 {
+                        rig.stage();
+                        let frames = pattern[block % pattern.len()];
+                        rig.process_frames(frames);
+                        for bank in 0..rig.banks.len() {
+                            bits.extend(rig.io_left[bank][..frames * width].iter().map(|v| v.to_bits()));
+                            bits.extend(rig.io_right[bank][..frames * width].iter().map(|v| v.to_bits()));
+                        }
+                    }
+                    DIAG_VARIANT.store(0, Ordering::Relaxed);
+                    bits
+                };
+                let same = run(0) == run(variant);
+                println!("ragged-frames W{width} {} {:<50} {}", if signal == Signal::Hot { "hot    " } else { "console" }, name(variant), if same { "SAME" } else { "DIFFERENT" });
+            }
+        }
+    }
+    // Discrimination: a class-B substitution must be seen.
+    let shape = Shape { width: 8, banks: 2, ragged: false, link: LinkMode::Maximum };
+    println!("red check X_RECIP32 hot: {}", if identity(shape, Signal::Hot, X_RECIP32, 50) { "SAME (harness blind!)" } else { "DIFFERENT (harness discriminates)" });
