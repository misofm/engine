+// Limiter diagnosis round 2: time the shipped AudioWorklet artifact's render export under V8.
+// Adapted from the EQ verifier's scratch driver (scratchpad/verify-977/timing/web.mjs).
+// usage: node web.mjs time|digest ARM.wasm ...   (arm name = file basename)
+import { readFileSync } from 'node:fs';
+const D = '/tmp/claude-1002/-home-bl-misofm-engine/43895396-e183-427f-b08f-a0b72f15ae5f/scratchpad/verify-limiter-2';
+const ABI_VERSION = 0x00010000, BOOT_OPTIONS_BYTES = 64, BUFFER_SOURCE_ID = 2, BUFFER_SOURCE_PCM = 3, BUFFER_OUTPUT_PCM = 5;
+const Q = 128, GHZ = Number(process.env.GHZ || 3.7), LANE_SAMPLES = 64 * 2 * Q;
+const [mode, ...files] = process.argv.slice(2);
+const docs = Object.fromEntries(['console', 'nolim', 'lim', 'bi', 'limdm'].map((n) => [n, readFileSync(`${D}/web/web-${n}.json`)]));
+// Rows: [label, session, signal, amplitude]
+const ROWS = (process.env.ROWS || 'lim-hot,limdm-hot,bi-hot,console-hot,nolim-hot').split(',').map((r) => {
+  const [session, signal] = r.split('-');
+  const amplitude = { lim: 4.0, limdm: 4.0, bi: 4.0, console: 10.0, nolim: 10.0 }[session];
+  return [r, session, signal, signal === 'tone' ? 0.6 : amplitude];
+});
+function boot(module, docName) {
+  const e = new WebAssembly.Instance(module, {}).exports;
+  const doc = docs[docName];
+  const opt = e.miso_engine_web_v1_boot_options_ptr();
+  const view = new DataView(e.memory.buffer, opt, BOOT_OPTIONS_BYTES);
+  view.setUint32(0, BOOT_OPTIONS_BYTES, true); view.setUint32(4, ABI_VERSION, true);
+  view.setUint32(8, 48000, true); view.setUint32(12, Q, true); view.setUint32(16, 8192, true);
+  view.setUint32(20, 0, true); view.setBigUint64(24, 0n, true);
+  for (let i = 0; i < 4; i++) view.setBigUint64(32 + i * 8, 0n, true);
+  const p = e.miso_engine_web_v1_document_ptr(doc.byteLength);
+  new Uint8Array(e.memory.buffer, p, doc.byteLength).set(doc);
+  const handle = e.miso_engine_web_v1_boot(doc.byteLength);
+  if (handle === 0) {
+    const n = e.miso_engine_web_v1_boot_diagnostic_bytes();
+    throw new Error(`boot ${e.miso_engine_web_v1_boot_result()}: ${new TextDecoder().decode(new Uint8Array(e.memory.buffer, p, n))}`);
+  }
+  return {
+    e, handle,
+    idPtr: e.miso_engine_web_v1_buffer_ptr(handle, BUFFER_SOURCE_ID),
+    pcmPtr: e.miso_engine_web_v1_buffer_ptr(handle, BUFFER_SOURCE_PCM),
+    outPtr: e.miso_engine_web_v1_buffer_ptr(handle, BUFFER_OUTPUT_PCM),
+    id: new TextEncoder().encode('fixture-source'), frame: 0n, n: 0,
+    left: new Float32Array(Q), right: new Float32Array(Q), seed: 0x9E3779B9 >>> 0,
+  };
+}
+function rnd(a) { // xorshift32, deterministic per instance
+  let x = a.seed; x ^= x << 13; x >>>= 0; x ^= x >>> 17; x ^= x << 5; x >>>= 0; a.seed = x;
+  return (x / 4294967296) * 2 - 1;
+}
+function feed(a, signal, amplitude) {
+  if (signal === 'tone') {
+    for (let i = 0; i < Q; i++) { const t = (a.n * Q + i) * 0.017; a.left[i] = Math.sin(t) * amplitude; a.right[i] = -Math.sin(t) * amplitude * 0.75; }
+  } else {
+    for (let i = 0; i < Q; i++) { a.left[i] = rnd(a) * amplitude; a.right[i] = rnd(a) * amplitude; }
+  }
+  const mem = a.e.memory.buffer;
+  new Uint8Array(mem, a.idPtr, a.id.length).set(a.id);
+  const pcm = new Float32Array(mem, a.pcmPtr, 2 * Q);
+  pcm.set(a.left, 0); pcm.set(a.right, Q);
+  const r = a.e.miso_engine_web_v1_source_submit(a.handle, a.id.length, 1n, a.frame, 2, Q, 0);
+  if (r !== 0) throw new Error(`submit ${r}`);
+  a.frame += BigInt(Q); a.n++;
+}
+function render(a) {
+  const r = a.e.miso_engine_web_v1_render(a.handle, Q);
+  if (r !== 0) throw new Error(`render ${r}`);
+}
+const arms = files.map((f) => [f.split('/').pop().replace(/\.wasm$/, ''), new WebAssembly.Module(readFileSync(f))]);
+if (mode === 'digest') {
+  const blocks = Number(process.env.BLOCKS || 400);
+  for (const [name, module] of arms) {
+    const line = [];
+    for (const [label, session, signal, amplitude] of ROWS) {
+      const a = boot(module, session);
+      for (let i = 0; i < 4; i++) feed(a, signal, amplitude);
+      let h = 0x811c9dc5 >>> 0;
+      for (let b = 0; b < blocks; b++) {
+        feed(a, signal, amplitude); render(a);
+        const out = new Uint32Array(a.e.memory.buffer, a.outPtr, 2 * Q);
+        for (let i = 0; i < out.length; i++) { h ^= out[i]; h = Math.imul(h, 0x01000193) >>> 0; }
+      }
+      line.push(`${label} ${h.toString(16).padStart(8, '0')}`);
+    }
+    console.log(`digest ${name.padEnd(14)} ${line.join('  ')}`);
+  }
+  process.exit(0);
+}
+const instances = arms.map(([name, module]) => [name, ROWS.map(([label, session, signal, amplitude]) => {
+  const a = boot(module, session); a.signal = signal; a.amplitude = amplitude; return a;
+})]);
+for (const [, list] of instances) for (const a of list) for (let i = 0; i < 4; i++) feed(a, a.signal, a.amplitude);
+const measure = (a, blocks) => {
+  const s = new Float64Array(blocks);
+  for (let i = 0; i < blocks; i++) {
+    feed(a, a.signal, a.amplitude);
+    const t0 = process.hrtime.bigint();
+    render(a);
+    s[i] = Number(process.hrtime.bigint() - t0);
+  }
+  s.sort();
+  return s[blocks >> 1] / 1000;
+};
+for (const [, list] of instances) for (const a of list) measure(a, 1500);
+const ROUNDS = Number(process.env.ROUNDS || 8), BLOCKS = Number(process.env.BLOCKS || 800);
+const table = instances.map(([, list]) => list.map(() => []));
+for (let round = 0; round < ROUNDS; round++) {
+  for (let s = 0; s < instances.length; s++) {
+    const i = (s + round) % instances.length;
+    instances[i][1].forEach((a, w) => { measure(a, 64); table[i][w].push(measure(a, BLOCKS)); });
+  }
+}
+const med = (v) => { const x = [...v].sort((p, q) => p - q); return (x[(x.length - 1) >> 1] + x[x.length >> 1]) / 2; };
+const cyc = (us) => us * 1e-6 * GHZ * 1e9 / LANE_SAMPLES;
+console.log(`node ${process.version} loadavg ${readFileSync('/proc/loadavg', 'utf8').trim()} rounds ${ROUNDS} blocks ${BLOCKS}`);
+const index = Object.fromEntries(ROWS.map(([label], w) => [label, w]));
+for (const [stat, fn] of [['med', med], ['min', (v) => Math.min(...v)]]) {
+  for (let i = 0; i < instances.length; i++) {
+    const m = table[i].map(fn);
+    const iso = [];
+    if ('lim-hot' in index && 'bi-hot' in index) iso.push(`lim-bi ${cyc(m[index['lim-hot']] - m[index['bi-hot']]).toFixed(2)}`);
+    if ('limdm-hot' in index && 'bi-hot' in index) iso.push(`limdm-bi ${cyc(m[index['limdm-hot']] - m[index['bi-hot']]).toFixed(2)}`);
+    if ('console-hot' in index && 'nolim-hot' in index) iso.push(`console-nolim ${cyc(m[index['console-hot']] - m[index['nolim-hot']]).toFixed(2)}`);
+    console.log(`${stat === 'med' ? 'web' : 'wmin'} ${instances[i][0].padEnd(16)} ` + ROWS.map(([label], w) => `${label} ${m[w].toFixed(1)}us`).join(' ') + ` | cyc/ls isolates: ${iso.join(' ')}`);
+  }
+}
+console.log(`end loadavg ${readFileSync('/proc/loadavg', 'utf8').trim()}`);
