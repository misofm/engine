+    let (mut a0, mut a1, mut a2, mut a3) = (
+        zero.add(row[0].mul(t[0])),
+        zero.add(row[1].mul(t[0])),
+        zero.add(row[2].mul(t[0])),
+        zero.add(row[3].mul(t[0])),
+    );
+'''
+    PAIR_INIT = '''            let z = L::zero();
+            a0 = z.add(row[0].mul(ta[0]));
+            b0 = z.add(row[0].mul(tb[0]));
+            a1 = z.add(row[1].mul(ta[0]));
+            b1 = z.add(row[1].mul(tb[0]));
+            a2 = z.add(row[2].mul(ta[0]));
+            b2 = z.add(row[2].mul(tb[0]));
+            a3 = z.add(row[3].mul(ta[0]));
+            b3 = z.add(row[3].mul(tb[0]));
+'''
+
+HALVES = '''
+/// The first half of one frame's four Annex-2 accumulators, taps 0-5 (`t[k]` is tap `k`), in the
+/// frozen order.
+#[inline(always)]
+fn skew_first<L: Lane>(t: [L; 6], fir: &[[L; 4]; HISTORY_WORDS]) -> [L; 4] {
+    let row = &fir[0];
+''' + FIRST_INIT + '''    macro_rules! step {
+        ($k:literal) => {{
+            let row = &fir[$k];
+            let s = t[$k];
+            a0 = a0.add(row[0].mul(s));
+            a1 = a1.add(row[1].mul(s));
+            a2 = a2.add(row[2].mul(s));
+            a3 = a3.add(row[3].mul(s));
+        }};
+    }
+    step!(1);
+    step!(2);
+    step!(3);
+    step!(4);
+    step!(5);
+    [a0, a1, a2, a3]
+}
+
+/// The second half, taps 6-11 (`t[j]` is tap `6 + j`) continuing `acc`, then the peak folded in
+/// [`detector_peak`]'s order.
+#[inline(always)]
+fn skew_second<L: Lane>(acc: [L; 4], t: [L; 6], fir: &[[L; 4]; HISTORY_WORDS]) -> L {
+    let [mut a0, mut a1, mut a2, mut a3] = acc;
+    macro_rules! step {
+        ($k:literal) => {{
+            let row = &fir[$k];
+            let s = t[$k - 6];
+            a0 = a0.add(row[0].mul(s));
+            a1 = a1.add(row[1].mul(s));
+            a2 = a2.add(row[2].mul(s));
+            a3 = a3.add(row[3].mul(s));
+        }};
+    }
+    step!(6);
+    step!(7);
+    step!(8);
+    step!(9);
+    step!(10);
+    step!(11);
+    let mut peak = t[0].abs();
+    for phase in [a0, a1, a2, a3] {
+        peak = peak.max(phase.abs());
+    }
+    peak
+}
+'''
+
+if 'skewr' in parts:
+    rep(DC_BODY, '''    let width = L::WIDTH;
+    debug_assert_eq!(io.len(), peaks.len());
+    debug_assert_eq!(io.len() % width, 0);
+    // Software-pipelined by half a frame: iteration `f` finishes frame `f` (taps 6-11) and starts
+    // frame `f + 1` (taps 0-5). Every accumulator takes the same products in the same order.
+    let span = io.len() / width;
+    let mut h = *taps;
+    h.shift(L::load(&io[..width]));
+    let mut acc = skew_first([h.t0, h.t1, h.t2, h.t3, h.t4, h.t5], fir);
+    for (input, out) in io[width..].chunks_exact(width).zip(peaks.chunks_exact_mut(width)) {
+        let dropped = h.t11;
+        h.shift(L::load(input));
+        let peak = skew_second(acc, [h.t7, h.t8, h.t9, h.t10, h.t11, dropped], fir);
+        acc = skew_first([h.t0, h.t1, h.t2, h.t3, h.t4, h.t5], fir);
+        peak.store(out);
+    }
+    let last = (span - 1) * width;
+    skew_second(acc, [h.t6, h.t7, h.t8, h.t9, h.t10, h.t11], fir)
+        .store(&mut peaks[last..last + width]);
+    *taps = h;
+}
+''' + HALVES)
+
+if 'skew' in parts:
+    rep(DC_BODY, '''    let width = L::WIDTH;
+    debug_assert_eq!(io.len(), peaks.len());
+    debug_assert_eq!(io.len() % width, 0);
+    // Software-pipelined by half a frame over a tap buffer: slot j holds x[j - 11], so frame f
+    // reads its tap k at slot f + 11 - k.
+    let span = io.len() / width;
+    let mut buffer = [0.0_f32; (HISTORY_WORDS - 1 + DETECTOR_CHUNK) * MAXIMUM_WIDTH];
+    let old = [
+        taps.t10, taps.t9, taps.t8, taps.t7, taps.t6, taps.t5, taps.t4, taps.t3, taps.t2, taps.t1,
+        taps.t0,
+    ];
+    for (index, word) in old.into_iter().enumerate() {
+        word.store(&mut buffer[index * width..(index + 1) * width]);
+    }
+    let used = (HISTORY_WORDS - 1 + span) * width;
+    buffer[(HISTORY_WORDS - 1) * width..used].copy_from_slice(io);
+    let view = &buffer[..used];
+    let tap = |w: &[f32], slot: usize| L::load(&w[slot * width..(slot + 1) * width]);
+    let w0 = &view[..12 * width];
+    let mut acc = skew_first(
+        [tap(w0, 11), tap(w0, 10), tap(w0, 9), tap(w0, 8), tap(w0, 7), tap(w0, 6)],
+        fir,
+    );
+    for (f, out) in peaks.chunks_exact_mut(width).take(span - 1).enumerate() {
+        let w = &view[f * width..(f + 13) * width];
+        let peak = skew_second(
+            acc,
+            [tap(w, 5), tap(w, 4), tap(w, 3), tap(w, 2), tap(w, 1), tap(w, 0)],
+            fir,
+        );
+        acc = skew_first(
+            [tap(w, 12), tap(w, 11), tap(w, 10), tap(w, 9), tap(w, 8), tap(w, 7)],
+            fir,
+        );
+        peak.store(out);
+    }
+    let f = span - 1;
+    let w = &view[f * width..(f + 12) * width];
+    skew_second(
+        acc,
+        [tap(w, 5), tap(w, 4), tap(w, 3), tap(w, 2), tap(w, 1), tap(w, 0)],
+        fir,
+    )
+    .store(&mut peaks[f * width..(f + 1) * width]);
+    let last = |k: usize| L::load(&view[(span + 10 - k) * width..(span + 11 - k) * width]);
+    *taps = History {
+        t0: last(0),
+        t1: last(1),
+        t2: last(2),
+        t3: last(3),
+        t4: last(4),
+        t5: last(5),
+        t6: last(6),
+        t7: last(7),
+        t8: last(8),
+        t9: last(9),
+        t10: last(10),
+        t11: last(11),
+    };
+}
+''' + HALVES)
+
+if 'pair' in parts:
+    rep(DC_BODY, '''    let width = L::WIDTH;
+    debug_assert_eq!(io.len(), peaks.len());
+    debug_assert_eq!(io.len() % width, 0);
+    // Two frames per iteration, taps in registers, the eight accumulators interleaved.
+    let span = io.len() / width;
+    let pairs = span / 2;
+    let mut h = *taps;
+    for (input, out) in io
+        .chunks_exact(2 * width)
+        .zip(peaks.chunks_exact_mut(2 * width))
+        .take(pairs)
+    {
+        let e = h.t10;
+        h.shift(L::load(&input[..width]));
+        h.shift(L::load(&input[width..]));
+        let tb = [h.t0, h.t1, h.t2, h.t3, h.t4, h.t5, h.t6, h.t7, h.t8, h.t9, h.t10, h.t11];
+        let ta = [h.t1, h.t2, h.t3, h.t4, h.t5, h.t6, h.t7, h.t8, h.t9, h.t10, h.t11, e];
+        let (mut a0, mut a1, mut a2, mut a3, mut b0, mut b1, mut b2, mut b3);
+        {
+            let row = &fir[0];
+''' + PAIR_INIT + '''        }
+        macro_rules! step {
+            ($k:literal) => {{
+                let row = &fir[$k];
+                let (sa, sb) = (ta[$k], tb[$k]);
+                a0 = a0.add(row[0].mul(sa));
+                b0 = b0.add(row[0].mul(sb));
+                a1 = a1.add(row[1].mul(sa));
+                b1 = b1.add(row[1].mul(sb));
+                a2 = a2.add(row[2].mul(sa));
+                b2 = b2.add(row[2].mul(sb));
+                a3 = a3.add(row[3].mul(sa));
+                b3 = b3.add(row[3].mul(sb));
+            }};
+        }
+        step!(1);
+        step!(2);
+        step!(3);
+        step!(4);
+        step!(5);
+        step!(6);
+        step!(7);
+        step!(8);
+        step!(9);
+        step!(10);
+        step!(11);
+        let mut pa = ta[6].abs();
+        for phase in [a0, a1, a2, a3] {
+            pa = pa.max(phase.abs());
+        }
+        let mut pb = tb[6].abs();
+        for phase in [b0, b1, b2, b3] {
+            pb = pb.max(phase.abs());
+        }
+        pa.store(&mut out[..width]);
+        pb.store(&mut out[width..]);
+    }
+    if span % 2 == 1 {
+        let last = (span - 1) * width;
+        let x = L::load(&io[last..last + width]);
+        detector_peak(&mut h, x, fir).store(&mut peaks[last..last + width]);
+    }
+    *taps = h;
+}
+''')
+
+if 'splat' in parts:
+    # The pair detector with each coefficient splatted from a scalar the compiler must load, so
+    # one broadcast feeds both frames' multiplies (a folded memory operand cannot be shared).
+    assert 'pair' in parts
+    rep('''    // Two frames per iteration, taps in registers, the eight accumulators interleaved.
+''', '''    // Two frames per iteration, taps in registers, the eight accumulators interleaved; each
+    // coefficient is one broadcast shared by both frames.
+    let _ = fir;
+''')
+    rep('''        let e = h.t10;
+''', '''        let tab: &[[f32; 4]; HISTORY_WORDS] = core::hint::black_box(&ANNEX2_FIR);
+        let e = h.t10;
+''')
+    if seed:
+        rep(PAIR_INIT, '''            let c = L::splat(row[0]);
+            a0 = c.mul(ta[0]);
+            b0 = c.mul(tb[0]);
+            let c = L::splat(row[1]);
