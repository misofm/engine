+"""Clean single-change variants of the limiter, written from the pristine lib.rs.
+
+usage: variants.py ORIG OUT VARIANT[+VARIANT...]
+variants: seed, skewr, skew, pair (class A detector shapes), tree2, tree (class B), none
+"""
+import sys
+
+orig, out, spec = sys.argv[1], sys.argv[2], sys.argv[3]
+parts = set(spec.split('+')) - {'none'}
+s = open(orig).read()
+seed = 'seed' in parts
+
+
+def rep(old, new, count=1):
+    global s
+    assert s.count(old) == count, (old[:80], s.count(old))
+    s = s.replace(old, new)
+
+
+SEED_HEAD_OLD = '''    let mut phase0 = L::zero();
+    let mut phase1 = L::zero();
+    let mut phase2 = L::zero();
+    let mut phase3 = L::zero();
+    macro_rules! tap {
+        ($index:literal, $sample:expr) => {{
+            let row = &fir[$index];
+            let sample = $sample;
+            phase0 = phase0.add(row[0].mul(sample));
+            phase1 = phase1.add(row[1].mul(sample));
+            phase2 = phase2.add(row[2].mul(sample));
+            phase3 = phase3.add(row[3].mul(sample));
+        }};
+    }
+    tap!(0, history.t0);
+'''
+SEED_HEAD_NEW = '''    let row = &fir[0];
+    let sample = history.t0;
+    let mut phase0 = row[0].mul(sample);
+    let mut phase1 = row[1].mul(sample);
+    let mut phase2 = row[2].mul(sample);
+    let mut phase3 = row[3].mul(sample);
+    macro_rules! tap {
+        ($index:literal, $sample:expr) => {{
+            let row = &fir[$index];
+            let sample = $sample;
+            phase0 = phase0.add(row[0].mul(sample));
+            phase1 = phase1.add(row[1].mul(sample));
+            phase2 = phase2.add(row[2].mul(sample));
+            phase3 = phase3.add(row[3].mul(sample));
+        }};
+    }
+'''
+if seed:
+    rep(SEED_HEAD_OLD, SEED_HEAD_NEW)
+
+A2 = 'fn annex2_phases<L: Lane>(history: &History<L>, fir: &[[L; 4]; HISTORY_WORDS]) -> [L; 4] {\n'
+if 'tree2' in parts:
+    rep(A2, A2 + '''    {
+        // CLASS B: two six-tap chains per phase (taps 0-5 and 6-11), merged by one add.
+        let h = history;
+        let t = [h.t0, h.t1, h.t2, h.t3, h.t4, h.t5, h.t6, h.t7, h.t8, h.t9, h.t10, h.t11];
+        let (mut l0, mut l1, mut l2, mut l3) =
+            (fir[0][0].mul(t[0]), fir[0][1].mul(t[0]), fir[0][2].mul(t[0]), fir[0][3].mul(t[0]));
+        let (mut u0, mut u1, mut u2, mut u3) =
+            (fir[6][0].mul(t[6]), fir[6][1].mul(t[6]), fir[6][2].mul(t[6]), fir[6][3].mul(t[6]));
+        macro_rules! step2 {
+            ($k:literal) => {{
+                let (a, b) = (t[$k], t[$k + 6]);
+                l0 = l0.add(fir[$k][0].mul(a));
+                l1 = l1.add(fir[$k][1].mul(a));
+                l2 = l2.add(fir[$k][2].mul(a));
+                l3 = l3.add(fir[$k][3].mul(a));
+                u0 = u0.add(fir[$k + 6][0].mul(b));
+                u1 = u1.add(fir[$k + 6][1].mul(b));
+                u2 = u2.add(fir[$k + 6][2].mul(b));
+                u3 = u3.add(fir[$k + 6][3].mul(b));
+            }};
+        }
+        step2!(1);
+        step2!(2);
+        step2!(3);
+        step2!(4);
+        step2!(5);
+        #[allow(clippy::needless_return)]
+        return [l0.add(u0), l1.add(u1), l2.add(u2), l3.add(u3)];
+    }
+    #[allow(unreachable_code)]
+''')
+if 'tree' in parts:
+    rep(A2, A2 + '''    {
+        // CLASS B: round 1's depth-4 pairwise tree per phase.
+        let h = history;
+        let taps = [h.t0, h.t1, h.t2, h.t3, h.t4, h.t5, h.t6, h.t7, h.t8, h.t9, h.t10, h.t11];
+        let phase = |p: usize| {
+            let m = |k: usize| fir[k][p].mul(taps[k]);
+            let s01 = m(0).add(m(1));
+            let s23 = m(2).add(m(3));
+            let s45 = m(4).add(m(5));
+            let s67 = m(6).add(m(7));
+            let s89 = m(8).add(m(9));
+            let s1011 = m(10).add(m(11));
+            s01.add(s23).add(s45.add(s67)).add(s89.add(s1011))
+        };
+        #[allow(clippy::needless_return)]
+        return [phase(0), phase(1), phase(2), phase(3)];
+    }
+    #[allow(unreachable_code)]
+''')
+
+DC_BODY = '''    let width = L::WIDTH;
+    debug_assert_eq!(io.len(), peaks.len());
+    debug_assert_eq!(io.len() % width, 0);
+    let mut history = *taps;
+    for (input, output) in io.chunks_exact(width).zip(peaks.chunks_exact_mut(width)) {
+        let x = L::load(input);
+        detector_peak(&mut history, x, fir).store(output);
+    }
+    *taps = history;
+}
+'''
+
+if seed:
+    FIRST_INIT = '''    let (mut a0, mut a1, mut a2, mut a3) =
+        (row[0].mul(t[0]), row[1].mul(t[0]), row[2].mul(t[0]), row[3].mul(t[0]));
+'''
+    PAIR_INIT = '''            a0 = row[0].mul(ta[0]);
+            b0 = row[0].mul(tb[0]);
+            a1 = row[1].mul(ta[0]);
+            b1 = row[1].mul(tb[0]);
+            a2 = row[2].mul(ta[0]);
+            b2 = row[2].mul(tb[0]);
+            a3 = row[3].mul(ta[0]);
+            b3 = row[3].mul(tb[0]);
+'''
+else:
