+"""Bundle every raw timing output of the verification, in run order, with a header per file."""
+import os
+import sys
+
+D = '/tmp/claude-1002/-home-bl-misofm-engine/43895396-e183-427f-b08f-a0b72f15ae5f/scratchpad/verify-limiter-2'
+out = sys.argv[1]
+runs = [
+    ('raw-k1.txt', 'native kernel rig; SCAFFOLDED arms (pristine/seed/skewr/skewr-seed built in the diagnosis tree plus this verification\'s dead prototypes) against the clean base; load 8-10. Source of F1.'),
+    ('raw-k2.txt', 'native; clean detector shapes (seed, skewr, skewr-seed, skew-seed, pair-seed, tree2, tree); load 18-20 (contended; minima only).'),
+    ('raw-w1.txt', 'V8; clean detector shapes; load 12-14.'),
+    ('raw-k3.txt', 'native; base / pair-seed / seed repeated over 6 passes (W4 bimodality check); load 16.'),
+    ('raw-k4.txt', 'native; clean gain-loop variants (seed, vh-seed, bcf-seed, vh, unchk); load 18-20 (contended; minima only).'),
+    ('raw-w2.txt', 'V8; load 26-44: CONTAMINATED, not quoted.'),
+    ('raw-det1.txt', 'isolated detector benchmark, sequential variants; load 27: contended, not quoted.'),
+    ('raw-det2.txt', 'isolated detector benchmark, interleaved rounds; load 30: contended, not quoted.'),
+    ('raw-det3.txt', 'isolated detector benchmark; load 17; W8 seed/skew show a per-process placement outlier (F10).'),
+    ('raw-det4.txt', 'isolated detector benchmark, four processes; load 26 (process 0 contended).'),
+    ('raw-w3.txt', 'V8; seed, pair-seed, vh-seed, bcf-seed, all, unchk; load 8-12.'),
+    ('raw-k5.txt', 'native; seed, pair-seed, vh-seed, bcf-seed, all, unchk, psplat-seed; load 9-10.'),
+    ('raw-k6.txt', 'native; load 20-28: CONTAMINATED, not quoted.'),
+    ('raw-k7.txt', 'native; seed, vh-seed, bcf-seed, bcf-seed-st (stationary only); load 11-12.'),
+    ('raw-k8.txt', 'native; seed, bcf-seed-st, p2s-st, all-st; load 8-13.'),
+    ('raw-w6.txt', 'V8; seed, bcf-seed, bcf-seed-st, p2s-st, all-st; load 4-6.'),
+    ('raw-k9.txt', 'native; clean detector shapes repeated; load 4-6.'),
+    ('raw-w5.txt', 'V8; clean detector shapes repeated; load 2-4.'),
+    ('raw-det5.txt', 'isolated detector benchmark, three processes; load 5.'),
+]
+with open(out, 'w') as f:
+    f.write('Sol verification of the limiter dense-path diagnosis, round 2: raw timing outputs in run order.\n')
+    f.write('Every run held the shared timing lock and was pinned with taskset -c 31. Arm names: base = pristine\n')
+    f.write('(clean, byte-identical to c-base); c-* = clean single-change builds from the pristine tree (see\n')
+    f.write('verify-limiter-2-harness/variants*.py); n-* = truncations; "-st" = stationary dispatch only.\n')
+    f.write('Native lines: [arm] Wn shape cyc/ls med/min rounds [...]. V8 lines: "web" = per-process medians\n')
+    f.write('of rounds, "wmin" = per-process minima, both as cycles per lane-sample isolates.\n\n')
+    for name, note in runs:
+        path = f'{D}/{name}'
+        if not os.path.exists(path) or os.path.getsize(path) == 0:
+            continue
+        f.write(f'==== {name}: {note}\n')
+        f.write(open(path).read().rstrip('\n') + '\n\n')
+print('bundled')
