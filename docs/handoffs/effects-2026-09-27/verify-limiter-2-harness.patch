+"""Write the two evidence patches into the repo's handoff directory.
+
+1. verify-limiter-2-harness.patch: the verification's scripts, variant generators and the isolated
+   detector benchmark, as new files under docs/handoffs/effects-2026-09-27/verify-limiter-2-harness/.
+2. verify-limiter-2-prototype.patch: the recommended merged slice (seed + limiter-2-2 cut and pass
+   split + limiter-2-3 no-copy streams + pass-2 delay streams, stationary dispatch only) as a diff
+   of crates/true-peak-limiter/src/lib.rs against the pristine tree. Evidence only.
+"""
+import subprocess
+import sys
+
+D = '/tmp/claude-1002/-home-bl-misofm-engine/43895396-e183-427f-b08f-a0b72f15ae5f/scratchpad/verify-limiter-2'
+out_dir = sys.argv[1]
+prefix = 'docs/handoffs/effects-2026-09-27/verify-limiter-2-harness/'
+files = [
+    'README.txt', 'variants.py', 'variants2.py', 'clean.sh', 'build.sh', 'build-web.sh', 'abba.sh',
+    'diff.sh', 'quiet.sh', 'queue2.sh', 'webtime.sh', 'websumm.py', 'web.mjs', 'roster.sh',
+    'dis.sh', 'fnloops.sh', 'detrep.sh', 'test.sh', 'policy.sh', 'summ.py', 'v8all.sh', 'v8dump.mjs', 'mkpatch.py', 'bundle.py',
+    'detbench/Cargo.toml', 'detbench/rust-toolchain.toml', 'detbench/.cargo/config.toml',
+    'detbench/src/main.rs',
+]
+chunks = []
+for rel in files:
+    r = subprocess.run(['diff', '-Nu', '--label', '/dev/null', '--label', 'b/' + prefix + rel,
+                        '/dev/null', f'{D}/{rel}'], capture_output=True, text=True)
+    assert r.returncode == 1, (rel, r.stderr)
+    chunks.append(f'diff --git a/{prefix}{rel} b/{prefix}{rel}\nnew file mode 100644\n' + r.stdout.replace(
+        '--- /dev/null\n', '--- /dev/null\n', 1))
+open(f'{out_dir}/verify-limiter-2-harness.patch', 'w').write(''.join(chunks))
+lib = 'crates/true-peak-limiter/src/lib.rs'
+r = subprocess.run(['diff', '-u', '--label', 'a/' + lib, '--label', 'b/' + lib,
+                    f'{D}/lib.rs.orig', f'{D}/src/c-p2s-st.rs'], capture_output=True, text=True)
+assert r.returncode == 1
+open(f'{out_dir}/verify-limiter-2-prototype.patch', 'w').write(f'diff --git a/{lib} b/{lib}\n' + r.stdout)
+print('patches written')
