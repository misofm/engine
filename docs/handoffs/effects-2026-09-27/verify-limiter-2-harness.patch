+"""Gain-loop variants appended to variants.py's output (run after it, on the same file).
+
+usage: variants2.py FILE SPEC   (SPEC's parts: vh = change 2, bcf = change 3 no-copy (needs vh),
+                                 unchk = unchecked ring access, a diagnostic)
+"""
+import sys
+
+path, spec = sys.argv[1], sys.argv[2]
+parts = set(spec.split('+'))
+s = open(path).read()
+
+
+def rep(old, new, count=1):
+    global s
+    assert s.count(old) == count, (old[:100], s.count(old))
+    s = s.replace(old, new)
+
+
+if 'unchk' in parts:
+    rep('''fn ring_lane<L: Lane>(ring: &[f32], slot: usize) -> L {
+    let base = slot * L::WIDTH;
+    L::load(&ring[base..base + L::WIDTH])
+}''', '''#[allow(unsafe_code)]
+fn ring_lane<L: Lane>(ring: &[f32], slot: usize) -> L {
+    let base = slot * L::WIDTH;
+    // SAFETY: diagnostic build only (prices the bounds checks); never shippable.
+    L::load(unsafe { ring.get_unchecked(base..base + L::WIDTH) })
+}''')
+    rep('''fn store_ring_lane<L: Lane>(ring: &mut [f32], slot: usize, value: L) {
+    let base = slot * L::WIDTH;
+    value.store(&mut ring[base..base + L::WIDTH]);
+}''', '''#[allow(unsafe_code)]
+fn store_ring_lane<L: Lane>(ring: &mut [f32], slot: usize, value: L) {
+    let base = slot * L::WIDTH;
+    // SAFETY: diagnostic build only (prices the bounds checks); never shippable.
+    value.store(unsafe { ring.get_unchecked_mut(base..base + L::WIDTH) });
+}''')
+
+FUNCS = r'''
+/// Change 2: [`channel_frame_uniform`]'s steps 1-5 and the release target `1 - s`.
+#[inline(always)]
+fn channel_target_uniform<L: Lane>(
+    peak: L,
+    limit: L,
+    hot: &mut HotChannel<L>,
+    uniform: &mut UniformHot<'_, L>,
+    ring: usize,
+    slots: FrameSlots,
+) -> L {
+    let one = L::splat(1.0);
+    let required = L::select(peak.gt(limit), limit.div(peak), one);
+    store_ring_lane::<L>(uniform.required_ring, slots.ring_cursor, required);
+    let minimum = sliding_minimum_uniform::<L>(
+        uniform.required_ring,
+        uniform.offsets.window,
+        ring,
+        slots.end,
+        slots.start,
+        &mut uniform.prefix,
+        &mut uniform.phase,
+    );
+    let quantised = minimum
+        .mul(L::splat(BOX_GRID))
+        .floor()
+        .mul(L::splat(1.0 / BOX_GRID));
+    let expired = ring_lane::<L>(uniform.box_ring, slots.expiring);
+    hot.box_sum = hot.box_sum.add(quantised).sub(expired);
+    store_ring_lane::<L>(uniform.box_ring, slots.ring_cursor, quantised);
+    let smoothed = hot.box_sum.div(hot.window);
+    one.sub(smoothed)
+}
