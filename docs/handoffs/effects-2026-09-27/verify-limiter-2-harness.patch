+                    .chunks_exact_mut(width)
+                    .zip(right_segment.chunks_exact_mut(width))
+                    .zip(targets_l.chunks_exact(width))
+                    .zip(targets_r.chunks_exact(width))
+                    .enumerate()
+                {
+                    let release_left = ramp_value::<DISPATCH, L>(stationary, &mut hot_left.release);
+                    let release_right =
+                        ramp_value::<DISPATCH, L>(stationary, &mut hot_right.release);
+                    let gain_left =
+                        release_step(L::load(target_l), release_left, &mut hot_left.reduction);
+                    let gain_right =
+                        release_step(L::load(target_r), release_right, &mut hot_right.reduction);
+                    output_step::<L>(
+                        left_frame,
+                        uniform_left.main_ring,
+                        main_base + step,
+                        gain_left,
+                        bypass,
+                    );
+                    output_step::<L>(
+                        right_frame,
+                        uniform_right.main_ring,
+                        main_base + step,
+                        gain_right,
+                        bypass,
+                    );
+                }
+'''
+        new_dual = '''                let main_words = main_base * width;
+                let delay_left = &mut uniform_left.main_ring[main_words..main_words + words];
+                let delay_right = &mut uniform_right.main_ring[main_words..main_words + words];
+                for (((((left_frame, right_frame), target_l), target_r), slot_left), slot_right) in
+                    left_segment
+                        .chunks_exact_mut(width)
+                        .zip(right_segment.chunks_exact_mut(width))
+                        .zip(targets_l.chunks_exact(width))
+                        .zip(targets_r.chunks_exact(width))
+                        .zip(delay_left.chunks_exact_mut(width))
+                        .zip(delay_right.chunks_exact_mut(width))
+                {
+                    let release_left = ramp_value::<DISPATCH, L>(stationary, &mut hot_left.release);
+                    let release_right =
+                        ramp_value::<DISPATCH, L>(stationary, &mut hot_right.release);
+                    let gain_left =
+                        release_step(L::load(target_l), release_left, &mut hot_left.reduction);
+                    let gain_right =
+                        release_step(L::load(target_r), release_right, &mut hot_right.reduction);
+                    delay_step::<L>(left_frame, slot_left, gain_left, bypass);
+                    delay_step::<L>(right_frame, slot_right, gain_right, bypass);
+                }
+'''
+        assert new.count(old_dual) == 1
+        new = new.replace(old_dual, new_dual)
+    if 'statonly' in parts:
+        # The new walk in the stationary dispatch only; the ramping dispatch keeps today's loop.
+        original = s[a:b]
+        s = (s[:a] + '                let run = if DISPATCH == DISPATCH_RAMPING {\n' + original
+             + '                run\n                } else {\n' + new
+             + '                run\n                };\n' + s[b:])
+    else:
+        s = s[:a] + new + s[b:]
+    if 'p2s' in parts:
+        anchor2 = '/// One ramp\'s value for this frame: [`ramp_values`] for a single ramp.'
+        rep(anchor2, '''/// Pass 2 over a delay-line stream: step 7 with the slot as a view (read before write).
+#[inline(always)]
+fn delay_step<L: Lane>(io_frame: &mut [f32], slot: &mut [f32], gain: L, bypass: <L as Lane>::Mask) {
+    let x = L::load(io_frame);
+    let delayed = L::load(slot);
+    x.store(slot);
+    L::select(bypass, delayed, delayed.mul(gain)).store(io_frame);
+}
+
+''' + anchor2)
+
+if 'nogain' in parts:
+    # Diagnostic truncation: skip the uniform gain frame loops; the detector's stores stay live.
+    body_start = s.index('fn limiter_block_uniform<const DISPATCH: u8, L: Lane>(')
+    start_marker = '                let run = walk.run;\n'
+    a = s.index(start_marker, body_start)
+    end_marker = """                frame += run;
+                ring_cursor = wrapped(ring_cursor + run, ring);
+                main_cursor = wrapped(main_cursor + run, main);
+            }
+        }
+"""
+    b = s.index(end_marker, a)
+    s = s[:a] + """                let run = walk.run;
+                core::hint::black_box(&mut peaks_left);
+                core::hint::black_box(&mut peaks_right);
+""" + s[b:]
+
+if 'nodet' in parts:
+    # Diagnostic truncation: skip the uniform body's detector passes (peaks stay as they were).
+    body_start = s.index('fn limiter_block_uniform<const DISPATCH: u8, L: Lane>(')
+    old = """            detector_chunk::<L>(
+                &mut hot_left.history,
+                &left_io[active_base..active_base + active_words],
+                &coef.fir,
+                &mut peaks_left[..active_words],
+            );
+            detector_chunk::<L>(
+                &mut hot_right.history,
+                &right_io[active_base..active_base + active_words],
+                &coef.fir,
+                &mut peaks_right[..active_words],
+            );
+"""
+    a = s.index(old, body_start)
+    s = s[:a] + """            let _ = active_base;
+            core::hint::black_box(&mut peaks_left[..active_words]);
+            core::hint::black_box(&mut peaks_right[..active_words]);
+""" + s[a + len(old):]
+
+open(path, 'w').write(s)
+print(f'variants2: {spec}')
