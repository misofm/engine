+++ b/docs/handoffs/effects-2026-09-27/verify-limiter-2-harness/summ.py
@@ -0,0 +1,48 @@
+"""Summarise kbench raw output: per (arm, width, shape) min and median over every round of every pass,
+and the change against the arm named `base` (or the first arm) by min and by median.
+
+usage: summ.py RAW [BASE_ARM]
+"""
+import collections
+import re
+import statistics
+import sys
+
+path = sys.argv[1]
+base_arm = sys.argv[2] if len(sys.argv) > 2 else 'base'
+rows = collections.defaultdict(list)
+order = []
+loads = []
+for line in open(path):
+    m = re.match(r'^\[(\S+)\] (W\d) (\S+)\s+cyc/ls med \S+ min \S+ rounds \[([^\]]*)\]', line)
+    if m:
+        arm, width, shape, rounds = m.groups()
+        vals = [float(v) for v in rounds.split()]
+        key = (width, shape)
+        rows[(arm, key)].extend(vals)
+        if arm not in order:
+            order.append(arm)
+    m = re.search(r'load (\d+\.\d+)', line)
+    if m:
+        loads.append(float(m.group(1)))
+keys = sorted({k for (_, k) in rows}, key=lambda k: (-int(k[0][1:]), k[1]))
+print(f'load average during run: {min(loads):.1f}-{max(loads):.1f}' if loads else '')
+header = f"{'row':<20}" + ''.join(f'{a:>22}' for a in order)
+print(header)
+for key in keys:
+    base = rows.get((base_arm, key))
+    line = f'{key[0] + " " + key[1]:<20}'
+    for arm in order:
+        vals = rows.get((arm, key))
+        if not vals:
+            line += f'{"-":>22}'
+            continue
+        mn, md = min(vals), statistics.median(vals)
+        if base and arm != base_arm:
+            dm = 100 * (mn / min(base) - 1)
+            dd = 100 * (md / statistics.median(base) - 1)
+            line += f'{mn:>7.2f}/{md:<6.2f}({dm:+.0f}/{dd:+.0f}%)'
+        else:
+            line += f'{mn:>7.2f}/{md:<6.2f}         '
+    print(line)
+print('cells: min/median cycles per lane-sample over all rounds (change against base by min/median)')
