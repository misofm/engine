+#!/bin/bash
+# usage: quiet.sh MAXLOAD MAXWAITSEC CMD...  -> waits until the 1-minute load average is below
+# MAXLOAD (or MAXWAITSEC passes), then runs CMD under the timing lock.
+L=/tmp/claude-1002/-home-bl-misofm-engine/43895396-e183-427f-b08f-a0b72f15ae5f/scratchpad/timing.lock
+max=$1; wait=$2; shift 2
+start=$(date +%s)
+while :; do
+  load=$(cut -d' ' -f1 /proc/loadavg)
+  if awk -v l="$load" -v m="$max" 'BEGIN { exit !(l < m) }'; then break; fi
+  if (( $(date +%s) - start > wait )); then echo "quiet.sh: waited ${wait}s, load still $load"; break; fi
+  sleep 10
+done
+echo "quiet.sh: start at load $(cat /proc/loadavg)"
+timeout 1150 flock -w 7200 "$L" "$@"
