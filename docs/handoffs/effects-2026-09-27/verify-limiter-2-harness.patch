+++ b/docs/handoffs/effects-2026-09-27/verify-limiter-2-harness/websumm.py
@@ -0,0 +1,40 @@
+"""Summarise webtime.sh output: per arm, the mean over processes of each isolate (cycles per
+lane-sample), its per-process values, and the change of the mean against the base arm.
+
+usage: websumm.py RAW BASE_ARM
+"""
+import collections
+import re
+import sys
+
+path, base = sys.argv[1], sys.argv[2]
+prefix = sys.argv[3] if len(sys.argv) > 3 else 'web'
+iso = collections.defaultdict(lambda: collections.defaultdict(list))
+order = []
+loads = []
+for line in open(path):
+    m = re.match(r'^' + prefix + r' (\S+)\s.*\| cyc/ls isolates: (.*)$', line)
+    if m:
+        arm = m.group(1)
+        if arm not in order:
+            order.append(arm)
+        for name, value in re.findall(r'(\S+) (-?\d+\.\d+)', m.group(2)):
+            iso[arm][name].append(float(value))
+    m = re.search(r'loadavg (\d+\.\d+)', line)
+    if m:
+        loads.append(float(m.group(1)))
+names = []
+for arm in order:
+    for n in iso[arm]:
+        if n not in names:
+            names.append(n)
+print(f'load average: {min(loads):.1f}-{max(loads):.1f}' if loads else '')
+for n in names:
+    print(f'-- {n} (mean over processes; per-process values; change of mean vs {base})')
+    b = iso[base][n]
+    bm = sum(b) / len(b)
+    for arm in order:
+        v = iso[arm][n]
+        mean = sum(v) / len(v)
+        d = '' if arm == base else f'{100 * (mean / bm - 1):+.1f}%'
+        print(f'   {arm:<16} {mean:7.2f}  [{" ".join(f"{x:.2f}" for x in v)}]  {d}')
