+//! Sol, round-2 verification: the Annex-2 detector shapes in isolation (L1-resident input), plus
+//! a port-throughput probe with the detector's operand mix. Scratch only.
+#![allow(clippy::all)]
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use lane::{Lane, Simd4, Simd8};
+
+const FIR: [[f32; 4]; 12] = [
+    [0.001_708_984_4, -0.029_174_805, -0.018_920_898, -0.008_300_781],
+    [0.010_986_328, 0.029_296_875, 0.033_081_055, 0.014_892_578],
+    [-0.019_653_32, -0.051_757_812, -0.058_227_54, -0.026_611_328],
+    [0.033_203_125, 0.089_111_33, 0.101_562_5, 0.047_607_422],
+    [-0.059_448_242, -0.166_503_9, -0.200_317_38, -0.102_294_92],
+    [0.137_329_1, 0.465_087_9, 0.779_785_16, 0.972_167_97],
+    [0.972_167_97, 0.779_785_16, 0.465_087_9, 0.137_329_1],
+    [-0.102_294_92, -0.200_317_38, -0.166_503_9, -0.059_448_242],
+    [0.047_607_422, 0.101_562_5, 0.089_111_33, 0.033_203_125],
+    [-0.026_611_328, -0.058_227_54, -0.051_757_812, -0.019_653_32],
+    [0.014_892_578, 0.033_081_055, 0.029_296_875, 0.010_986_328],
+    [-0.008_300_781, -0.018_920_898, -0.029_174_805, 0.001_708_984_4],
+];
+
+#[derive(Clone, Copy)]
+struct H<L: Lane> {
+    t: [L; 12],
+}
+
+impl<L: Lane> H<L> {
+    #[inline(always)]
+    fn shift(&mut self, x: L) {
+        let t = &mut self.t;
+        t[11] = t[10];
+        t[10] = t[9];
+        t[9] = t[8];
+        t[8] = t[7];
+        t[7] = t[6];
+        t[6] = t[5];
+        t[5] = t[4];
+        t[4] = t[3];
+        t[3] = t[2];
+        t[2] = t[1];
+        t[1] = t[0];
+        t[0] = x;
+    }
+}
+
+#[inline(always)]
+fn fold<L: Lane>(t6: L, p: [L; 4]) -> L {
+    let mut peak = t6.abs();
+    for v in p {
+        peak = peak.max(v.abs());
+    }
+    peak
+}
+
+#[inline(always)]
+fn phases<const SEED: bool, L: Lane>(t: &[L; 12], fir: &[[L; 4]; 12]) -> [L; 4] {
+    let (mut a0, mut a1, mut a2, mut a3);
+    if SEED {
+        a0 = fir[0][0].mul(t[0]);
+        a1 = fir[0][1].mul(t[0]);
+        a2 = fir[0][2].mul(t[0]);
+        a3 = fir[0][3].mul(t[0]);
+    } else {
+        let z = L::zero();
+        a0 = z.add(fir[0][0].mul(t[0]));
+        a1 = z.add(fir[0][1].mul(t[0]));
+        a2 = z.add(fir[0][2].mul(t[0]));
+        a3 = z.add(fir[0][3].mul(t[0]));
+    }
+    macro_rules! s {
+        ($k:literal) => {{
+            a0 = a0.add(fir[$k][0].mul(t[$k]));
+            a1 = a1.add(fir[$k][1].mul(t[$k]));
+            a2 = a2.add(fir[$k][2].mul(t[$k]));
+            a3 = a3.add(fir[$k][3].mul(t[$k]));
+        }};
+    }
+    s!(1);
+    s!(2);
+    s!(3);
+    s!(4);
+    s!(5);
+    s!(6);
+    s!(7);
+    s!(8);
+    s!(9);
+    s!(10);
+    s!(11);
+    [a0, a1, a2, a3]
+}
+
+#[inline(always)]
+fn tree<L: Lane>(t: &[L; 12], fir: &[[L; 4]; 12]) -> [L; 4] {
+    let phase = |p: usize| {
+        let m = |k: usize| fir[k][p].mul(t[k]);
+        let s01 = m(0).add(m(1));
+        let s23 = m(2).add(m(3));
+        let s45 = m(4).add(m(5));
+        let s67 = m(6).add(m(7));
+        let s89 = m(8).add(m(9));
+        let s1011 = m(10).add(m(11));
+        s01.add(s23).add(s45.add(s67)).add(s89.add(s1011))
+    };
+    [phase(0), phase(1), phase(2), phase(3)]
+}
+
+/// The shipped shape (`SEED` = false) or change 1 (`SEED` = true); `TREE` = round 1's class-B tree.
+#[inline(never)]
+fn chunk_plain<const SEED: bool, const TREE: bool, L: Lane>(
+    h: &mut H<L>,
+    io: &[f32],
+    fir: &[[L; 4]; 12],
+    peaks: &mut [f32],
+) {
+    let w = L::WIDTH;
+    let mut hh = *h;
+    for (input, out) in io.chunks_exact(w).zip(peaks.chunks_exact_mut(w)) {
+        hh.shift(L::load(input));
+        let p = if TREE { tree(&hh.t, fir) } else { phases::<SEED, L>(&hh.t, fir) };
+        fold(hh.t[6], p).store(out);
+    }
+    *h = hh;
+}
+
+#[inline(always)]
+fn first<L: Lane>(t: [L; 6], fir: &[[L; 4]; 12]) -> [L; 4] {
+    let (mut a0, mut a1, mut a2, mut a3) =
+        (fir[0][0].mul(t[0]), fir[0][1].mul(t[0]), fir[0][2].mul(t[0]), fir[0][3].mul(t[0]));
+    macro_rules! s {
+        ($k:literal) => {{
+            a0 = a0.add(fir[$k][0].mul(t[$k]));
+            a1 = a1.add(fir[$k][1].mul(t[$k]));
+            a2 = a2.add(fir[$k][2].mul(t[$k]));
+            a3 = a3.add(fir[$k][3].mul(t[$k]));
+        }};
+    }
+    s!(1);
+    s!(2);
+    s!(3);
+    s!(4);
+    s!(5);
+    [a0, a1, a2, a3]
+}
+
+#[inline(always)]
+fn second<L: Lane>(acc: [L; 4], t: [L; 6], fir: &[[L; 4]; 12]) -> L {
+    let [mut a0, mut a1, mut a2, mut a3] = acc;
+    macro_rules! s {
+        ($k:literal) => {{
+            a0 = a0.add(fir[$k][0].mul(t[$k - 6]));
+            a1 = a1.add(fir[$k][1].mul(t[$k - 6]));
+            a2 = a2.add(fir[$k][2].mul(t[$k - 6]));
+            a3 = a3.add(fir[$k][3].mul(t[$k - 6]));
+        }};
+    }
+    s!(6);
+    s!(7);
+    s!(8);
+    s!(9);
+    s!(10);
+    s!(11);
+    fold(t[0], [a0, a1, a2, a3])
+}
+
+/// Class A, seedless: software-pipelined by half a frame, taps in registers.
+#[inline(never)]
+fn chunk_skew<L: Lane>(h: &mut H<L>, io: &[f32], fir: &[[L; 4]; 12], peaks: &mut [f32]) {
+    let w = L::WIDTH;
+    let span = io.len() / w;
+    let mut hh = *h;
+    hh.shift(L::load(&io[..w]));
+    let t = hh.t;
+    let mut acc = first([t[0], t[1], t[2], t[3], t[4], t[5]], fir);
+    for (input, out) in io[w..].chunks_exact(w).zip(peaks.chunks_exact_mut(w)) {
+        let dropped = hh.t[11];
+        hh.shift(L::load(input));
+        let t = hh.t;
+        let peak = second(acc, [t[7], t[8], t[9], t[10], t[11], dropped], fir);
+        acc = first([t[0], t[1], t[2], t[3], t[4], t[5]], fir);
+        peak.store(out);
+    }
+    let t = hh.t;
+    let last = (span - 1) * w;
+    second(acc, [t[6], t[7], t[8], t[9], t[10], t[11]], fir).store(&mut peaks[last..last + w]);
+    *h = hh;
+}
+
+/// Class A, seedless: two frames per iteration, taps in registers.
+#[inline(never)]
+fn chunk_pair<L: Lane>(h: &mut H<L>, io: &[f32], fir: &[[L; 4]; 12], peaks: &mut [f32]) {
+    let w = L::WIDTH;
+    let mut hh = *h;
+    for (input, out) in io.chunks_exact(2 * w).zip(peaks.chunks_exact_mut(2 * w)) {
+        let e = hh.t[10];
+        hh.shift(L::load(&input[..w]));
+        hh.shift(L::load(&input[w..]));
+        let tb = hh.t;
+        let ta = [tb[1], tb[2], tb[3], tb[4], tb[5], tb[6], tb[7], tb[8], tb[9], tb[10], tb[11], e];
+        let (mut a, mut b) = ([L::zero(); 4], [L::zero(); 4]);
+        for p in 0..4 {
+            a[p] = fir[0][p].mul(ta[0]);
+            b[p] = fir[0][p].mul(tb[0]);
+        }
+        macro_rules! s {
+            ($k:literal) => {{
+                for p in 0..4 {
+                    let c = fir[$k][p];
+                    a[p] = a[p].add(c.mul(ta[$k]));
+                    b[p] = b[p].add(c.mul(tb[$k]));
+                }
+            }};
+        }
+        s!(1);
+        s!(2);
+        s!(3);
+        s!(4);
+        s!(5);
+        s!(6);
+        s!(7);
+        s!(8);
+        s!(9);
+        s!(10);
+        s!(11);
+        fold(ta[6], a).store(&mut out[..w]);
+        fold(tb[6], b).store(&mut out[w..]);
+    }
+    *h = hh;
+}
+
+/// Port probe: the detector's operand mix (48 `mul` with the coefficient reloaded from memory, 44
+/// `add`, 5 `abs`, 4 `max`) with short chains: 12 accumulators of depth mul + 3 adds, restarted
+/// every frame, every tap the frame's fresh input.
+#[inline(never)]
+fn probe<L: Lane>(io: &[f32], fir: &[[L; 4]; 12], peaks: &mut [f32]) {
+    let w = L::WIDTH;
+    for (input, out) in io.chunks_exact(w).zip(peaks.chunks_exact_mut(w)) {
+        let x = L::load(input);
+        let fir = black_box(fir);
+        let mut acc = [L::zero(); 12];
+        for k in 0..12 {
+            for p in 0..4 {
+                let slot = (k % 3) * 4 + p;
+                acc[slot] = if k < 3 { fir[k][p].mul(x) } else { acc[slot].add(fir[k][p].mul(x)) };
+            }
+        }
+        let mut peak = x.abs();
+        for p in 0..4 {
+            let v = acc[p].add(acc[4 + p]).add(acc[8 + p]);
+            peak = peak.max(v.abs());
+        }
+        peak.store(out);
+    }
+}
+
+fn core_hz() -> f64 {
+    const ADDS: u64 = 200_000_000;
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let mut x = black_box(0.0_f32);
+        let d = black_box(1.0e-3_f32);
+        let start = Instant::now();
+        for _ in 0..ADDS {
+            x += d;
+        }
+        best = best.min(start.elapsed().as_secs_f64());
+        black_box(x);
+    }
+    3.0 * ADDS as f64 / best
+}
+
+struct Case<L: Lane> {
+    name: &'static str,
+    f: fn(&mut H<L>, &[f32], &[[L; 4]; 12], &mut [f32]),
+}
+
+fn run_all<L: Lane>(hz: f64, cases: &[Case<L>], rounds: usize) {
+    let w = L::WIDTH;
+    let frames = 32;
+    let chunks = 8; // 8 channels' chunks, L1-resident
+    let mut io = vec![0.0_f32; chunks * frames * w];
+    let mut seed = 0x1234_5678_u32;
+    for v in io.iter_mut() {
+        seed ^= seed << 13;
+        seed ^= seed >> 17;
+        seed ^= seed << 5;
+        *v = (seed as f32 / u32::MAX as f32) * 2.0 - 1.0;
+    }
+    let mut fir = [[L::zero(); 4]; 12];
+    for k in 0..12 {
+        for p in 0..4 {
+            fir[k][p] = L::splat(FIR[k][p]);
+        }
+    }
+    let fir = black_box(fir);
+    let mut peaks = vec![0.0_f32; frames * w];
+    let mut hs = vec![H { t: [L::zero(); 12] }; chunks];
+    let reps = 1_000;
+    let mut all: Vec<Vec<f64>> = vec![Vec::new(); cases.len()];
+    for _ in 0..rounds {
+        for (i, case) in cases.iter().enumerate() {
+            let start = Instant::now();
+            for _ in 0..reps {
+                for (c, h) in hs.iter_mut().enumerate() {
+                    (case.f)(h, black_box(&io[c * frames * w..(c + 1) * frames * w]), &fir, &mut peaks);
+                }
+                black_box(&mut peaks);
+            }
+            all[i].push(start.elapsed().as_secs_f64() * hz / (reps * chunks * frames) as f64);
+        }
+    }
+    for (i, case) in cases.iter().enumerate() {
+        let mut v = all[i].clone();
+        v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        println!(
+            "W{w} {:<10} min {:6.2}  p10 {:6.2}  median {:6.2} cycles per channel-frame ({rounds} interleaved rounds)",
+            case.name,
+            v[0],
+            v[v.len() / 10],
+            v[v.len() / 2]
+        );
+    }
+}
+
+fn main() {
+    let hz = core_hz();
+    let load = || std::fs::read_to_string("/proc/loadavg").unwrap_or_default().trim().to_string();
+    println!("core {:.3} GHz, load {}", hz / 1e9, load());
+    let rounds = std::env::args().nth(1).and_then(|v| v.parse().ok()).unwrap_or(60);
+    run_all::<Simd8>(
+        hz,
+        &[
+            Case { name: "base", f: chunk_plain::<false, false, Simd8> },
+            Case { name: "seed", f: chunk_plain::<true, false, Simd8> },
+            Case { name: "skew-seed", f: chunk_skew::<Simd8> },
+            Case { name: "pair-seed", f: chunk_pair::<Simd8> },
+            Case { name: "tree(B)", f: chunk_plain::<false, true, Simd8> },
+            Case { name: "probe", f: |_h, io, f, p| probe::<Simd8>(io, f, p) },
+        ],
+        rounds,
+    );
+    run_all::<Simd4>(
+        hz,
+        &[
+            Case { name: "base", f: chunk_plain::<false, false, Simd4> },
+            Case { name: "seed", f: chunk_plain::<true, false, Simd4> },
+            Case { name: "skew-seed", f: chunk_skew::<Simd4> },
+            Case { name: "pair-seed", f: chunk_pair::<Simd4> },
+            Case { name: "tree(B)", f: chunk_plain::<false, true, Simd4> },
+            Case { name: "probe", f: |_h, io, f, p| probe::<Simd4>(io, f, p) },
+        ],
+        rounds,
+    );
+    println!("end load {}", load());
+}
+
