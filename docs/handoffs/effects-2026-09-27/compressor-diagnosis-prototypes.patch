+/// DIAGNOSIS PROTOTYPE: the collapsed body's settled arm, as `settled_main` for one plane.
+#[inline(always)]
+fn settled_main_mono<L: Lane>(
+    mode: u8,
+    left: &mut [f32],
+    start: usize,
+    end: usize,
+    link: LinkMode,
+    bypass: bool,
+    channel_left: &mut Channel<L>,
+) {
+    let width = L::WIDTH;
+    let invariants = Invariants::<L>::new(link, bypass);
+    let coef = Coef::load(&channel_left.words);
+    let dual_mono = mode & 2 != 0 && matches!(link, LinkMode::DualMono);
+    let wet = mode & 4 != 0 && !bypass && all_lanes::<L>(coef.wet_identity);
+    let two_pass = mode & 8 != 0;
+    let left = &mut left[start * width..end * width];
+    let mut g = channel_left.gain_reduction_db;
+    match (two_pass, dual_mono, wet) {
+        (false, false, false) => mono_one::<L, false, false>(left, &coef, &mut g, &invariants),
+        (false, true, false) => mono_one::<L, true, false>(left, &coef, &mut g, &invariants),
+        (false, false, true) => mono_one::<L, false, true>(left, &coef, &mut g, &invariants),
+        (false, true, true) => mono_one::<L, true, true>(left, &coef, &mut g, &invariants),
+        (true, false, false) => mono_two::<L, false, false>(left, &coef, &mut g, &invariants),
+        (true, true, false) => mono_two::<L, true, false>(left, &coef, &mut g, &invariants),
+        (true, false, true) => mono_two::<L, false, true>(left, &coef, &mut g, &invariants),
+        (true, true, true) => mono_two::<L, true, true>(left, &coef, &mut g, &invariants),
+    }
+    channel_left.gain_reduction_db = g;
+}
+
+#[inline(always)]
+fn detect_mono<L: Lane, const DM: bool>(main: L, invariants: &Invariants<L>) -> L {
+    if DM {
+        main.abs()
+    } else {
+        link_frame(Detector::Main, 0, main, main, invariants).0
+    }
+}
+
+#[inline(never)]
+fn mono_one<L: Lane, const DM: bool, const WET: bool>(
+    left: &mut [f32],
+    coef: &Coef<L>,
+    g: &mut L,
+    invariants: &Invariants<L>,
+) {
+    let mut gl = *g;
+    for l in left.chunks_exact_mut(L::WIDTH) {
+        let main = L::load(l);
+        let target = curve_target(detect_mono::<L, DM>(main, invariants), coef, invariants);
+        let smoothed = ballistic(target, &mut gl, coef);
+        output::<L, WET>(main, smoothed, coef, invariants).store(l);
+    }
+    *g = gl;
+}
+
+#[inline(never)]
+fn mono_two<L: Lane, const DM: bool, const WET: bool>(
+    left: &mut [f32],
+    coef: &Coef<L>,
+    g: &mut L,
+    invariants: &Invariants<L>,
+) {
+    const CH: usize = 32;
+    let width = L::WIDTH;
+    let mut gl = *g;
+    let mut targets = [L::zero(); CH];
+    for chunk in left.chunks_mut(CH * width) {
+        for (l, t) in chunk.chunks_exact(width).zip(targets.iter_mut()) {
+            *t = curve_target(detect_mono::<L, DM>(L::load(l), invariants), coef, invariants);
+        }
+        for (l, t) in chunk.chunks_exact_mut(width).zip(targets.iter()) {
+            let main = L::load(l);
+            let smoothed = ballistic(*t, &mut gl, coef);
+            output::<L, WET>(main, smoothed, coef, invariants).store(l);
+        }
     }
+    *g = gl;
 }
 
