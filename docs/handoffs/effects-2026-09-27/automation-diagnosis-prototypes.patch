 /// Factory entry point for the V1 compressor implementation.
+/// Automation diagnosis (2026-09-27) prototype switches, read once per block. Diagnosis patch
+/// only; never merged.
+#[doc(hidden)]
+pub mod diag {
+    use core::sync::atomic::AtomicU32;
+    /// The prototype bits.
+    pub static MODE: AtomicU32 = AtomicU32::new(0);
+    #[inline(always)]
+    #[allow(dead_code)]
+    pub(crate) fn mode() -> u32 {
+        MODE.load(core::sync::atomic::Ordering::Relaxed)
+    }
+}
