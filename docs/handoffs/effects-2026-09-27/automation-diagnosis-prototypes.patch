+#!/usr/bin/env python3
+"""Automation diagnosis: derive the V8 harness's session documents from the 64-track fixtures.
+
+usage: gen_docs.py REPO_ROOT OUT_DIR
+
+Writes web-{builtins,eq,comp,lim,console,mono}.json: the standing fixture with racks emptied as
+the console-workload decomposition rows do, the source stretched to 1,000 s so the harness never
+runs out, and automation cleared. `web-mono.json` is the mono fixture as written.
+"""
+import copy
+import json
+import sys
+
+root, out = sys.argv[1], sys.argv[2]
+stereo = json.load(open(f"{root}/fixtures/session/v1/console-sixty-four-track-intended.json"))
+mono = json.load(open(f"{root}/fixtures/session/v1/console-sixty-four-track-mono.json"))
+for doc in (stereo, mono):
+    doc["sources"][0]["frames"] = "48000000"
+    doc["automation"] = []
+
+
+def make(name, keep1, keep2, base=stereo):
+    doc = copy.deepcopy(base)
+    for track in doc["tracks"]:
+        track["simd1"]["effects"] = [
+            e for e in track["simd1"]["effects"] if e["identity"]["effect_id"] in keep1
+        ]
+        track["dynamic"]["effects"] = []
+        track["simd2"]["effects"] = [
+            e for e in track["simd2"]["effects"] if e["identity"]["effect_id"] in keep2
+        ]
+    with open(f"{out}/web-{name}.json", "w") as handle:
+        handle.write(json.dumps(doc, separators=(",", ":")))
+
+
+EQ, COMP, LIM = "miso.parametric-eq", "miso.compressor", "miso.true-peak-limiter"
+make("builtins", [], [])
+make("eq", [EQ], [])
+make("comp", [COMP], [])
+make("lim", [], [LIM])
+make("console", [EQ, COMP], [LIM])
+make("mono", [EQ, COMP], [LIM], base=mono)
