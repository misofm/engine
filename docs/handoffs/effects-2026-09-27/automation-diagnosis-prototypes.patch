+//! Automation diagnosis (2026-09-27): randomized bank-level differentials of the EQ prototypes
+//! E1 (ramping-block elision) and E2 (vector lane writes) against the unmodified path, with
+//! hostile input. Diagnosis patch only; never merged.
+//!
+//! `cargo test --release -p console-workload --test automation_diag_identity -- --ignored
+//! --nocapture --test-threads 1`
+
+use core::sync::atomic::Ordering::Relaxed;
+
+use effect_compiler::launch_native_effect_registry;
+use effect_contract::{
+    BankWidth, EffectBankProcessBlock, EffectQuality, EffectTargetRequest, InitialParameterValue,
+    LinkMode, ParameterChannel, PrepareEffectBankRequest, PrepareEffectLimits,
+    PrepareEffectRequest, PreparedEffectTarget, PreparedNativeEffectBank, PreparedPorts,
+    PreparedSidechainPort, StatePayloadOutput,
+};
+use lane::Backend;
+
+const QUANTUM: usize = 128;
+const RATE: u32 = 48_000;
+
+struct Rng(u64);
+
+impl Rng {
+    fn next(&mut self) -> u64 {
+        let mut x = self.0;
+        x ^= x >> 12;
+        x ^= x << 25;
+        x ^= x >> 27;
+        self.0 = x;
+        x.wrapping_mul(0x2545_f491_4f6c_dd1d)
+    }
+    fn unit(&mut self) -> f32 {
+        (self.next() >> 40) as f32 / (1u64 << 24) as f32
+    }
+    fn below(&mut self, n: usize) -> usize {
+        (self.next() % n as u64) as usize
+    }
+    fn chance(&mut self, p: f32) -> bool {
+        self.unit() < p
+    }
+    fn log(&mut self, low: f32, high: f32) -> f32 {
+        (low.ln() + self.unit() * (high.ln() - low.ln())).exp().clamp(low, high)
+    }
+}
+
+/// One lane's value for descriptor index `index`, drawn from the EQ's domains.
+fn draw(rng: &mut Rng, index: usize) -> f32 {
+    if index < 24 {
+        match index % 6 {
+            0 => f32::from(u8::from(rng.chance(0.6))),
+            1 => (1 + rng.below(6)) as f32,
+            2 => rng.log(20.0, 18_000.0),
+            3 => -24.0 + 48.0 * rng.unit(),
+            4 => rng.log(0.2, 12.0),
+            _ => 0.1 + 0.9 * rng.unit(),
+        }
+    } else {
+        match index - 24 {
+            0 | 3 => f32::from(u8::from(rng.chance(0.4))),
+            1 | 4 => rng.log(20.0, 18_000.0),
+            _ => rng.log(0.2, 12.0),
+        }
+    }
+}
+
+/// Automatable descriptor indices: band frequency, gain, Q, slope, and every cut parameter.
+fn automatable(index: usize) -> bool {
+    index >= 24 || index % 6 >= 2
+}
+
+fn request(values: &[InitialParameterValue]) -> PrepareEffectRequest<'_> {
+    PrepareEffectRequest {
+        sample_rate: RATE,
+        quantum: QUANTUM as u32,
+        quality: EffectQuality::Normal,
+        bypass: false,
+        link_mode: LinkMode::DualMono,
+        ports: PreparedPorts {
+            sidechain: PreparedSidechainPort::None,
+        },
+        initial_values: values,
+        limits: PrepareEffectLimits {
+            maximum_total_state_bytes: 1 << 16,
+            maximum_scratch_bytes: 1 << 16,
+            maximum_automation_spans_per_block: 48,
+        },
+    }
+}
+
+fn hostile(rng: &mut Rng, profile: usize) -> f32 {
+    match profile {
+        0 => 2.0 * rng.unit() - 1.0,
+        1 => 0.0,
+        2 => {
+            if rng.chance(0.3) {
+                -0.0
+            } else {
+                2.0 * rng.unit() - 1.0
+            }
+        }
+        3 => f32::from_bits((rng.next() as u32) & 0x807f_ffff),
+        4 => {
+            if rng.chance(0.05) {
+                [f32::INFINITY, f32::NEG_INFINITY, f32::NAN, 1.0e31, -3.0e38][rng.below(5)]
+            } else {
+                2.0 * rng.unit() - 1.0
+            }
+        }
+        _ => {
+            if rng.chance(0.02) {
+                -0.0
+            } else {
+                1.0e-3 * (2.0 * rng.unit() - 1.0)
+            }
+        }
+    }
+}
+
+fn snapshot(bank: &dyn PreparedNativeEffectBank, lanes: usize, sizes: [usize; 3]) -> Vec<u8> {
+    let mut out = Vec::new();
+    for lane in 0..lanes {
+        let mut common = vec![0_u8; sizes[0]];
+        let mut left = vec![0_u8; sizes[1]];
+        let mut right = vec![0_u8; sizes[2]];
+        bank.snapshot_track_state_payload(
+            lane as u32,
+            StatePayloadOutput {
+                common: &mut common,
+                left: &mut left,
+                right: &mut right,
+            },
+        )
+        .expect("snapshot");
+        out.extend_from_slice(&common);
+        out.extend_from_slice(&left);
+        out.extend_from_slice(&right);
+    }
+    out
+}
+
+fn same_words(a: &[f32], b: &[f32]) -> bool {
+    a.iter()
+        .zip(b)
+        .all(|(x, y)| x.to_bits() == y.to_bits())
+}
+
+#[allow(clippy::too_many_lines)]
+fn scenario(seed: u64, width: BankWidth, mode: u32, mono: bool) -> (u64, u64) {
+    let registry = launch_native_effect_registry().expect("registry");
+    let eq = registry
+        .get_shared_ascii("miso.parametric-eq")
+        .expect("eq");
+    let preparation = eq.target_preparation().expect("targets");
+    let sizes = eq.descriptor().qualities[0].maximum_state;
+    let sizes = [
+        sizes.common_bytes as usize,
+        sizes.left_bytes as usize,
+        sizes.right_bytes as usize,
+    ];
+    let lanes = width.lanes() as usize;
+    let backend = if lanes == 4 {
+        Backend::Simd4
+    } else {
+        Backend::Simd8
+    };
+    let mut rng = Rng(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1);
+    let parameters = eq.descriptor().parameters.len();
+    // Per-scenario shape: some bands off on every lane (so E1 has dead sections to drop), a
+    // shared kind per band most of the time, and cuts usually off.
+    let band_off: [bool; 4] = core::array::from_fn(|_| rng.chance(0.55));
+    let band_kind: [f32; 4] = core::array::from_fn(|_| (1 + rng.below(6)) as f32);
+    let shared_kind = rng.chance(0.7);
+    let cut_on: [bool; 2] = core::array::from_fn(|_| rng.chance(0.3));
+    let shape = |rng: &mut Rng, index: usize| -> f32 {
+        if index < 24 {
+            let band = index / 6;
+            match index % 6 {
+                0 => f32::from(u8::from(!band_off[band] && rng.chance(0.85))),
+                1 if shared_kind => band_kind[band],
+                _ => draw(rng, index),
+            }
+        } else {
+            match index - 24 {
+                0 => f32::from(u8::from(cut_on[0] && rng.chance(0.8))),
+                3 => f32::from(u8::from(cut_on[1] && rng.chance(0.8))),
+                _ => draw(rng, index),
+            }
+        }
+    };
+    // Per lane: descriptor-major, left then right.
+    let mut values: Vec<Vec<InitialParameterValue>> = (0..lanes)
+        .map(|_| {
+            let symmetric = mono || rng.chance(0.5);
+            let mut lane = Vec::with_capacity(parameters * 2);
+            for index in 0..parameters {
+                let left = shape(&mut rng, index);
+                let right = if symmetric || index % 6 < 2 && index < 24 {
+                    left
+                } else {
+                    shape(&mut rng, index)
+                };
+                for (channel, value) in [(ParameterChannel::Left, left), (ParameterChannel::Right, right)]
+                {
+                    lane.push(InitialParameterValue {
+                        parameter_index: index as u32,
+                        channel,
+                        value,
+                    });
+                }
+            }
+            lane
+        })
+        .collect();
+    let requests: Vec<PrepareEffectRequest<'_>> = values.iter().map(|v| request(v)).collect();
+    let bind = || {
+        eq.bind_homogeneous_bank(PrepareEffectBankRequest {
+            backend,
+            width,
+            requests: &requests,
+        })
+    };
+    let (Ok(Some(mut oracle)), Ok(Some(mut candidate))) = (bind(), bind()) else {
+        return (0, 0);
+    };
+    drop(requests);
+    let offsets = vec![0_u32; lanes + 1];
+    let mut compared = 0_u64;
+    let mut ramping_blocks = 0_u64;
+    for block in 0..96_u64 {
+        // Events: a batch of retargets through the production target preparation.
+        if rng.chance(0.55) {
+            ramping_blocks += 1;
+            for _ in 0..1 + rng.below(3) {
+                let lane = rng.below(lanes);
+                let mut index = rng.below(parameters);
+                while !automatable(index) {
+                    index = rng.below(parameters);
+                }
+                let value = draw(&mut rng, index);
+                let both = mono || rng.chance(0.5);
+                let sides: &[usize] = if both {
+                    &[0, 1]
+                } else if rng.chance(0.5) {
+                    &[0]
+                } else {
+                    &[1]
+                };
+                for &side in sides {
+                    let slot = index * 2 + side;
+                    let previous = values[lane][slot].value;
+                    values[lane][slot].value = value;
+                    let mut changed = vec![false; parameters * 2];
+                    changed[slot] = true;
+                    let mut targets = [PreparedEffectTarget {
+                        slot: 0,
+                        channel: ParameterChannel::Left,
+                        words: [0; 12],
+                    }; 12];
+                    match preparation.prepare_targets(
+                        EffectTargetRequest {
+                            sample_rate: RATE,
+                            values: &values[lane],
+                            changed: &changed,
+                        },
+                        &mut targets,
+                    ) {
+                        Ok(count) => {
+                            for target in &targets[..count] {
+                                let a = oracle.apply_prepared_target_lane(lane, target);
+                                let b = candidate.apply_prepared_target_lane(lane, target);
+                                assert_eq!(a, b, "seed {seed} block {block}: target application");
+                            }
+                        }
+                        Err(_) => values[lane][slot].value = previous,
+                    }
+                }
+            }
+        }
+        let frames = if rng.chance(0.6) {
+            QUANTUM
+        } else {
+            1 + rng.below(QUANTUM)
+        };
+        let words = frames * lanes;
+        let profile = if rng.chance(0.65) {
+            [0, 1, 5][rng.below(3)]
+        } else {
+            [2, 3, 4][rng.below(3)]
+        };
+        let mut left = vec![0.0_f32; words];
+        let mut right = vec![0.0_f32; words];
+        for sample in &mut left {
+            *sample = hostile(&mut rng, profile);
+        }
+        if mono {
+            right.copy_from_slice(&left);
+        } else {
+            for sample in &mut right {
+                *sample = hostile(&mut rng, profile);
+            }
+        }
+        let (mut oracle_left, mut oracle_right) = (left.clone(), right.clone());
+        let (mut candidate_left, mut candidate_right) = (left, right);
+        let run = |bank: &mut Box<dyn PreparedNativeEffectBank>, l: &mut [f32], r: &mut [f32]| {
+            let block_io = EffectBankProcessBlock::new(
+                l,
+                r,
+                None,
+                frames as u32,
+                width,
+                block * QUANTUM as u64,
+                &[],
+                &offsets,
+                QUANTUM as u32,
+            )
+            .expect("block");
+            if mono {
+                bank.process_bank_mono(block_io)
+            } else {
+                bank.process_bank(block_io)
+            }
+        };
+        parametric_eq::diag::MODE.store(0, Relaxed);
+        let oracle_report = run(&mut oracle, &mut oracle_left, &mut oracle_right);
+        parametric_eq::diag::MODE.store(mode, Relaxed);
+        let candidate_report = run(&mut candidate, &mut candidate_left, &mut candidate_right);
+        parametric_eq::diag::MODE.store(0, Relaxed);
+        assert_eq!(oracle_report, candidate_report, "seed {seed} block {block}: report");
+        assert!(
+            same_words(&oracle_left, &candidate_left),
+            "seed {seed} block {block} W{lanes} mode {mode} mono {mono}: left output"
+        );
+        if !mono {
+            assert!(
+                same_words(&oracle_right, &candidate_right),
+                "seed {seed} block {block} W{lanes} mode {mode}: right output"
+            );
+        }
+        assert!(
+            snapshot(&*oracle, lanes, sizes) == snapshot(&*candidate, lanes, sizes),
+            "seed {seed} block {block} W{lanes} mode {mode} mono {mono}: state"
+        );
+        compared += 1;
+    }
+    (compared, ramping_blocks)
+}
+
+#[test]
+#[ignore = "diagnosis differential; run by hand"]
+fn eq_prototypes_render_the_unmodified_bits() {
+    lane::diag::NATIVE_W4.store(true, Relaxed);
+    let scenarios: u64 = std::env::var("AUTO_DIAG_SCENARIOS")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(200);
+    for mode in [1_u32, 2, 3] {
+        for width in [BankWidth::Four, BankWidth::Eight] {
+            let mut blocks = 0;
+            let mut bound = 0;
+            let mut event_blocks = 0;
+            for seed in 0..scenarios {
+                let mono = seed % 4 == 3;
+                let (compared, events) = scenario(seed, width, mode, mono);
+                event_blocks += events;
+                if compared > 0 {
+                    bound += 1;
+                }
+                blocks += compared;
+            }
+            println!(
+                "mode {mode} W{}: {bound}/{scenarios} scenarios bound, {blocks} blocks bit-identical ({event_blocks} with retargets, {} E1-elided ramping blocks so far)",
+                width.lanes(),
+                parametric_eq::diag::E1_ELIDED.load(Relaxed)
+            );
+        }
+    }
+}
