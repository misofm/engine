+// ---------------------------------------------------------------------------------------------
+// Automation diagnosis (2026-09-27) prototypes C1 and C2: the ramping prefix with lane-wide
+// ramps. Diagnosis patch only; never merged.
+// ---------------------------------------------------------------------------------------------
+
+/// One parameter's (or one rate coefficient's) `LinearRamp`s across the lanes, as vectors.
+#[derive(Clone, Copy)]
+struct RampVec<L: Lane> {
+    current: L,
+    target: L,
+    step: L,
+    /// `remaining` as an exact small integer in `f32` (at most `SMOOTHING_SAMPLES`).
+    remaining: L,
+}
+
+impl<L: Lane> RampVec<L> {
+    #[inline(always)]
+    fn gather(ramps: &[LinearRamp; MAX_WIDTH]) -> Self {
+        let mut current = [0.0_f32; MAX_WIDTH];
+        let mut target = [0.0_f32; MAX_WIDTH];
+        let mut step = [0.0_f32; MAX_WIDTH];
+        let mut remaining = [0.0_f32; MAX_WIDTH];
+        for lane in 0..L::WIDTH {
+            current[lane] = ramps[lane].current;
+            target[lane] = ramps[lane].target;
+            step[lane] = ramps[lane].step;
+            remaining[lane] = ramps[lane].remaining as f32;
+        }
+        Self {
+            current: L::load(&current[..L::WIDTH]),
+            target: L::load(&target[..L::WIDTH]),
+            step: L::load(&step[..L::WIDTH]),
+            remaining: L::load(&remaining[..L::WIDTH]),
+        }
+    }
+
+    #[inline(always)]
+    fn scatter(self, ramps: &mut [LinearRamp; MAX_WIDTH]) {
+        let mut current = [0.0_f32; MAX_WIDTH];
+        let mut step = [0.0_f32; MAX_WIDTH];
+        let mut remaining = [0.0_f32; MAX_WIDTH];
+        self.current.store(&mut current[..L::WIDTH]);
+        self.step.store(&mut step[..L::WIDTH]);
+        self.remaining.store(&mut remaining[..L::WIDTH]);
+        for lane in 0..L::WIDTH {
+            ramps[lane].current = current[lane];
+            ramps[lane].step = step[lane];
+            ramps[lane].remaining = remaining[lane] as u32;
+        }
+    }
+
+    /// `LinearRamp::next_value` on every lane of `gate` whose ramp is in flight, and nothing on
+    /// any other lane: `remaining == 1` assigns the target and clears the step, `remaining > 1`
+    /// adds the step, `remaining == 0` leaves every word as it is. Returns the lanes that moved.
+    #[inline(always)]
+    fn advance_where(&mut self, gate: L::Mask) -> L::Mask {
+        let zero = L::zero();
+        let one = L::splat(1.0);
+        let moving = L::mask_and(gate, self.remaining.gt(zero));
+        let last = L::mask_and(moving, self.remaining.eq(one));
+        let next = L::select(last, self.target, self.current.add(self.step));
+        self.current = L::select(moving, next, self.current);
+        self.step = L::select(last, zero, self.step);
+        self.remaining = L::select(moving, self.remaining.sub(one), self.remaining);
+        moving
+    }
+}
+
+/// The lane-wide state of one channel's ramps for one ramping prefix.
+struct ChannelRamps<L: Lane> {
+    /// Parameters with a ramp in flight on some lane at the start of the prefix.
+    active: u8,
+    ramps: [RampVec<L>; RAMP_COUNT],
+    rates: [RampVec<L>; 2],
+    /// The eight coefficient words, as vectors.
+    words: [L; crate::design::COEF_COUNT],
+}
+
+const CURVE_BITS: u8 = 0b0000_0111;
+const RATE_PARAMETER: [usize; 2] = [3, 4];
+const RATE_WORD: [usize; 2] = [COEF_ATTACK, COEF_RELEASE];
+
+impl<L: Lane> ChannelRamps<L> {
+    #[inline(always)]
+    fn gather(channel: &Channel<L>) -> Self {
+        let mut active = 0_u8;
+        for (parameter, ramps) in channel.ramps.iter().enumerate() {
+            if ramps.iter().take(L::WIDTH).any(LinearRamp::is_ramping) {
+                active |= 1 << parameter;
+            }
+        }
+        // Lean gather (bit 2): only the ramps this prefix reads. A curve parameter's `current`
+        // is read by the redesign whenever any curve parameter moves.
+        let lean = crate::diag::mode() & 4 != 0;
+        let needed = |parameter: usize| {
+            !lean
+                || active & (1 << parameter) != 0
+                || (parameter < 3 && active & CURVE_BITS != 0)
+        };
+        let idle = RampVec {
+            current: L::zero(),
+            target: L::zero(),
+            step: L::zero(),
+            remaining: L::zero(),
+        };
+        Self {
+            active,
+            ramps: core::array::from_fn(|parameter| {
+                if needed(parameter) {
+                    RampVec::gather(&channel.ramps[parameter])
+                } else {
+                    idle
+                }
+            }),
+            rates: core::array::from_fn(|slot| {
+                if !lean || active & (1 << RATE_PARAMETER[slot]) != 0 {
+                    RampVec::gather(&channel.rate_ramps[slot])
+                } else {
+                    idle
+                }
+            }),
+            words: core::array::from_fn(|word| L::load(&channel.words[word][..L::WIDTH])),
+        }
+    }
+
+    #[inline(always)]
+    fn scatter(&self, channel: &mut Channel<L>) {
+        for parameter in 0..RAMP_COUNT {
+            if self.active & (1 << parameter) != 0 {
+                self.ramps[parameter].scatter(&mut channel.ramps[parameter]);
+            }
+        }
+        for slot in 0..2 {
+            if self.active & (1 << RATE_PARAMETER[slot]) != 0 {
+                self.rates[slot].scatter(&mut channel.rate_ramps[slot]);
+            }
+        }
+        for (word, value) in self.words.iter().enumerate() {
+            value.store(&mut channel.words[word][..L::WIDTH]);
+        }
+    }
+
+    /// One frame of `advance_ramps` for the curve parameters: advance, then redesign the static
+    /// curve on every lane where threshold, ratio or knee moved.
+    #[inline(always)]
+    fn advance_curve(&mut self) {
+        if self.active & CURVE_BITS == 0 {
+            return;
+        }
+        let all = L::zero().eq(L::zero());
+        if crate::diag::mode() & 8 != 0 {
+            // Per-word design (bit 3): each curve word depends on one parameter, and the words
+            // of an unmoved parameter already hold its design (the words are always the design
+            // of the ramps' `current` values).
+            if self.active & 1 != 0 {
+                let moved = self.ramps[0].advance_where(all);
+                self.words[COEF_THRESHOLD] =
+                    L::select(moved, self.ramps[0].current, self.words[COEF_THRESHOLD]);
+            }
+            if self.active & 2 != 0 {
+                let moved = self.ramps[1].advance_where(all);
+                let inv = L::splat(1.0).div(self.ramps[1].current).sub(L::splat(1.0));
+                self.words[COEF_INV_RATIO_MINUS_ONE] =
+                    L::select(moved, inv, self.words[COEF_INV_RATIO_MINUS_ONE]);
+            }
+            if self.active & 4 != 0 {
+                let moved = self.ramps[2].advance_where(all);
+                let curve = design_curve::<L>(
+                    self.ramps[0].current,
+                    self.ramps[1].current,
+                    self.ramps[2].current,
+                );
+                self.words[COEF_HALF_KNEE] =
+                    L::select(moved, curve.half_knee_db, self.words[COEF_HALF_KNEE]);
+                self.words[COEF_INV_TWO_KNEE] =
+                    L::select(moved, curve.inv_two_knee, self.words[COEF_INV_TWO_KNEE]);
+            }
+            return;
+        }
+        let mut moved = L::mask_not(all);
+        for parameter in 0..3 {
+            if self.active & (1 << parameter) != 0 {
+                moved = L::mask_or(moved, self.ramps[parameter].advance_where(all));
+            }
+        }
+        let curve = design_curve::<L>(
+            self.ramps[0].current,
+            self.ramps[1].current,
+            self.ramps[2].current,
+        );
+        self.words[COEF_THRESHOLD] = L::select(moved, curve.threshold_db, self.words[COEF_THRESHOLD]);
+        self.words[COEF_INV_RATIO_MINUS_ONE] = L::select(
+            moved,
+            curve.inv_ratio_minus_one,
+            self.words[COEF_INV_RATIO_MINUS_ONE],
+        );
+        self.words[COEF_HALF_KNEE] = L::select(moved, curve.half_knee_db, self.words[COEF_HALF_KNEE]);
+        self.words[COEF_INV_TWO_KNEE] =
+            L::select(moved, curve.inv_two_knee, self.words[COEF_INV_TWO_KNEE]);
+    }
+
+    /// One frame of `advance_ramps` for attack, release, makeup and mix.
+    #[inline(always)]
+    fn advance_output(&mut self) {
+        let all = L::zero().eq(L::zero());
+        for slot in 0..2 {
+            let parameter = RATE_PARAMETER[slot];
+            if self.active & (1 << parameter) != 0 {
+                let moved = self.ramps[parameter].advance_where(all);
+                self.rates[slot].advance_where(moved);
+                self.words[RATE_WORD[slot]] =
+                    L::select(moved, self.rates[slot].current, self.words[RATE_WORD[slot]]);
+            }
+        }
+        for (parameter, word) in [(5, COEF_MAKEUP), (6, COEF_MIX)] {
+            if self.active & (1 << parameter) != 0 {
+                let moved = self.ramps[parameter].advance_where(all);
+                self.words[word] = L::select(moved, self.ramps[parameter].current, self.words[word]);
+            }
+        }
+    }
+
+    #[inline(always)]
+    fn curve(&self) -> GainComputerCoef<L> {
+        GainComputerCoef {
+            threshold_db: self.words[COEF_THRESHOLD],
+            inv_ratio_minus_one: self.words[COEF_INV_RATIO_MINUS_ONE],
+            half_knee_db: self.words[COEF_HALF_KNEE],
+            inv_two_knee: self.words[COEF_INV_TWO_KNEE],
+        }
+    }
+
+    /// `Coef::load` from the word vectors.
+    #[inline(always)]
+    fn coef(&self) -> Coef<L> {
+        let makeup = self.words[COEF_MAKEUP];
+        let mix = self.words[COEF_MIX];
+        Coef {
+            curve: self.curve(),
+            attack: self.words[COEF_ATTACK],
+            release: self.words[COEF_RELEASE],
+            makeup,
+            mix,
+            wet_identity: mix.eq(L::splat(1.0)),
+            dry_mix_zero: mix.eq(L::zero()),
+            makeup_zero: makeup.eq(L::zero()),
+        }
+    }
+}
+
+/// `GainComputerCoef::new` on every lane: the same `f32` operations, the knee's finiteness branch
+/// as a select.
+#[inline(always)]
+fn design_curve<L: Lane>(threshold: L, ratio: L, knee: L) -> GainComputerCoef<L> {
+    let zero = L::zero();
+    let inv_ratio_minus_one = L::splat(1.0).div(ratio).sub(L::splat(1.0));
+    let inv = L::splat(1.0).div(L::splat(2.0).mul(knee));
+    let soft = L::mask_and(knee.gt(zero), inv.lt(L::splat(f32::INFINITY)));
+    GainComputerCoef {
+        threshold_db: threshold,
+        inv_ratio_minus_one,
+        half_knee_db: L::select(soft, L::splat(0.5).mul(knee), zero),
+        inv_two_knee: L::select(soft, inv, zero),
+    }
+}
+
+/// C1: `frames_loop::<L, true>` with lane-wide ramps kept in registers for the prefix.
+#[allow(clippy::too_many_arguments)]
+#[inline(always)]
+fn ramping_loop<L: Lane>(
+    left: &mut [f32],
+    right: &mut [f32],
+    detector: Detector<'_>,
+    end: usize,
+    link: LinkMode,
+    bypass: bool,
+    channel_left: &mut Channel<L>,
+    channel_right: &mut Channel<L>,
+) {
+    let width = L::WIDTH;
+    let invariants = Invariants::<L>::new(link, bypass);
+    let mut ramps_left = ChannelRamps::gather(channel_left);
+    let mut ramps_right = ChannelRamps::gather(channel_right);
+    let mut gain_left = channel_left.gain_reduction_db;
+    let mut gain_right = channel_right.gain_reduction_db;
+    for frame in 0..end {
+        ramps_left.advance_curve();
+        ramps_left.advance_output();
+        ramps_right.advance_curve();
+        ramps_right.advance_output();
+        let coef_left = ramps_left.coef();
+        let coef_right = ramps_right.coef();
+        let slot = frame * width;
+        let main_left = L::load(&left[slot..]);
+        let main_right = L::load(&right[slot..]);
+        let (detected_left, detected_right) =
+            link_frame(detector, slot, main_left, main_right, &invariants);
+        one_frame(main_left, detected_left, &coef_left, &mut gain_left, &invariants)
+            .store(&mut left[slot..]);
+        one_frame(main_right, detected_right, &coef_right, &mut gain_right, &invariants)
+            .store(&mut right[slot..]);
+    }
+    channel_left.gain_reduction_db = gain_left;
+    channel_right.gain_reduction_db = gain_right;
+    ramps_left.scatter(channel_left);
+    ramps_right.scatter(channel_right);
+}
+
+/// C2: the ramping prefix of a `Detector::Main` block as the settled body's two passes. Pass 1
+/// advances the curve ramps and computes every target of the chunk; pass 2 advances attack,
+/// release, makeup and mix and runs the recurrence and the output. Each ramp advances exactly
+/// once per frame, in the pass that reads it.
+#[allow(clippy::too_many_arguments)]
+#[inline(always)]
+fn ramping_main<L: Lane>(
+    left: &mut [f32],
+    right: &mut [f32],
+    end: usize,
+    link: LinkMode,
+    bypass: bool,
+    channel_left: &mut Channel<L>,
+    channel_right: &mut Channel<L>,
+) {
+    let width = L::WIDTH;
+    let invariants = Invariants::<L>::new(link, bypass);
+    let mut ramps_left = ChannelRamps::gather(channel_left);
+    let mut ramps_right = ChannelRamps::gather(channel_right);
+    let dual_mono = matches!(link, LinkMode::DualMono);
+    let mix_moves = (ramps_left.active | ramps_right.active) & (1 << 6) != 0;
+    let wet = !bypass
+        && !mix_moves
+        && every_lane::<L>(ramps_left.words[COEF_MIX].eq(L::splat(1.0)))
+        && every_lane::<L>(ramps_right.words[COEF_MIX].eq(L::splat(1.0)));
+    let mut gains = (
+        channel_left.gain_reduction_db,
+        channel_right.gain_reduction_db,
+    );
+    let left = &mut left[..end * width];
+    let right = &mut right[..end * width];
+    match (dual_mono, wet) {
+        (true, true) => ramping_frames::<L, true, true>(
+            left, right, &mut ramps_left, &mut ramps_right, &mut gains, &invariants,
+        ),
+        (true, false) => ramping_frames::<L, true, false>(
+            left, right, &mut ramps_left, &mut ramps_right, &mut gains, &invariants,
+        ),
+        (false, true) => ramping_frames::<L, false, true>(
+            left, right, &mut ramps_left, &mut ramps_right, &mut gains, &invariants,
+        ),
+        (false, false) => ramping_frames::<L, false, false>(
+            left, right, &mut ramps_left, &mut ramps_right, &mut gains, &invariants,
+        ),
+    }
+    channel_left.gain_reduction_db = gains.0;
+    channel_right.gain_reduction_db = gains.1;
+    ramps_left.scatter(channel_left);
+    ramps_right.scatter(channel_right);
+}
+
+#[inline(always)]
+fn ramping_frames<L: Lane, const DUAL_MONO: bool, const WET: bool>(
+    left: &mut [f32],
+    right: &mut [f32],
+    ramps_left: &mut ChannelRamps<L>,
+    ramps_right: &mut ChannelRamps<L>,
+    gains: &mut (L, L),
+    invariants: &Invariants<L>,
+) {
+    let width = L::WIDTH;
+    let (mut gain_left, mut gain_right) = *gains;
+    let mut targets = [(L::zero(), L::zero()); SETTLED_CHUNK];
+    for (chunk_left, chunk_right) in left
+        .chunks_mut(SETTLED_CHUNK * width)
+        .zip(right.chunks_mut(SETTLED_CHUNK * width))
+    {
+        for ((frame_left, frame_right), target) in chunk_left
+            .chunks_exact(width)
+            .zip(chunk_right.chunks_exact(width))
+            .zip(targets.iter_mut())
+        {
+            ramps_left.advance_curve();
+            ramps_right.advance_curve();
+            let (detected_left, detected_right) = settled_detect::<L, DUAL_MONO>(
+                L::load(frame_left),
+                L::load(frame_right),
+                invariants,
+            );
+            let coef_left = Coef {
+                curve: ramps_left.curve(),
+                ..DUMMY_COEF_FIELDS::<L>()
+            };
+            let coef_right = Coef {
+                curve: ramps_right.curve(),
+                ..DUMMY_COEF_FIELDS::<L>()
+            };
+            *target = (
+                curve_target(detected_left, &coef_left, invariants),
+                curve_target(detected_right, &coef_right, invariants),
+            );
+        }
+        for ((frame_left, frame_right), target) in chunk_left
+            .chunks_exact_mut(width)
+            .zip(chunk_right.chunks_exact_mut(width))
+            .zip(targets.iter())
+        {
+            ramps_left.advance_output();
+            ramps_right.advance_output();
+            let coef_left = ramps_left.coef();
+            let coef_right = ramps_right.coef();
+            let main_left = L::load(frame_left);
+            let main_right = L::load(frame_right);
+            let smoothed_left = ballistic(target.0, &mut gain_left, &coef_left);
+            let smoothed_right = ballistic(target.1, &mut gain_right, &coef_right);
+            settled_output::<L, WET>(main_left, smoothed_left, &coef_left, invariants)
+                .store(frame_left);
+            settled_output::<L, WET>(main_right, smoothed_right, &coef_right, invariants)
+                .store(frame_right);
+        }
+    }
+    *gains = (gain_left, gain_right);
+}
+
+/// The fields of `Coef` pass 1 does not read.
+#[allow(non_snake_case)]
+#[inline(always)]
+fn DUMMY_COEF_FIELDS<L: Lane>() -> Coef<L> {
+    let zero = L::zero();
+    let none = L::mask_not(zero.eq(zero));
+    Coef {
+        curve: GainComputerCoef {
+            threshold_db: zero,
+            inv_ratio_minus_one: zero,
+            half_knee_db: zero,
+            inv_two_knee: zero,
+        },
+        attack: zero,
+        release: zero,
+        makeup: zero,
+        mix: zero,
+        wet_identity: none,
+        dry_mix_zero: none,
+        makeup_zero: none,
+    }
+}
