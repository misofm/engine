+
+/// The realistic mixing subject's three controls, cycled over the automated tracks.
+fn mix_components() -> [Subject; 3] {
+    let find = |name: &str| *SUBJECTS.iter().find(|s| s.name == name).expect("subject");
+    [find("eq_gain"), find("comp_threshold"), find("lim_ceiling")]
+}
+
+/// The `(track, control)` pairs an arm automates.
+fn automations(subject: &Subject, arm: Arm) -> Vec<(usize, Subject)> {
+    let tracks = arm.tracks();
+    if subject.name == "console_mix" || subject.name == "mono_mix" {
+        let parts = mix_components();
+        tracks
+            .into_iter()
+            .map(|track| {
+                let part = if arm == Arm::All { track % 3 } else { (track / 8) % 3 };
+                (track, parts[part])
+            })
+            .collect()
+    } else {
+        tracks.into_iter().map(|track| (track, *subject)).collect()
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Arm {
+    Untouched,
+    Quiet,
+    One,
+    OneSegment,
+    OneLeft,
+    Eight,
+    All,
+}
+
+const ARMS: [Arm; 7] = [
+    Arm::Untouched,
+    Arm::Quiet,
+    Arm::One,
+    Arm::OneSegment,
+    Arm::OneLeft,
+    Arm::Eight,
+    Arm::All,
+];
+
+impl Arm {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Untouched => "untouched",
+            Self::Quiet => "settled",
+            Self::One => "one_point",
+            Self::OneSegment => "one_segment",
+            Self::OneLeft => "one_left_only",
+            Self::Eight => "eight_of_64",
+            Self::All => "all_64",
+        }
+    }
+    fn tracks(self) -> Vec<usize> {
+        match self {
+            Self::Quiet | Self::Untouched => vec![],
+            Self::One | Self::OneSegment | Self::OneLeft => vec![0],
+            Self::Eight => (0..8).map(|k| k * 8).collect(),
+            Self::All => (0..64).collect(),
+        }
+    }
+    fn channels(self) -> &'static [ParameterChannel] {
+        match self {
+            Self::OneLeft => &[ParameterChannel::Left],
+            _ => &[ParameterChannel::Left, ParameterChannel::Right],
+        }
+    }
+}
+
+impl Subject {
+    fn value(&self, arm: Arm, block: u64) -> f32 {
+        match arm {
+            Arm::OneSegment => {
+                let span = self.sweep_high - self.sweep_low;
+                let travelled = (block as f32 * self.sweep_rate) % (2.0 * span);
+                if travelled <= span {
+                    self.sweep_low + travelled
+                } else {
+                    self.sweep_high - (travelled - span)
+                }
+            }
+            _ => {
+                if block.is_multiple_of(2) {
+                    self.base + self.step
+                } else {
+                    self.base - self.step
+                }
+            }
+        }
+    }
+}
+
+struct ArmRuntime {
+    arm: Arm,
+    mode: u32,
+    runtime: SessionRuntime,
+    channels: Vec<(usize, Subject)>,
+    block: u64,
+    refused: u64,
+    digest: Sha256Sink,
+}
+
+fn track_id(track: usize) -> String {
+    format!("ch{track:02}")
+}
+
+/// Stores one prototype mode: bits 0-7 EQ, 8-15 compressor, 16-23 limiter.
+fn set_mode(mode: u32) {
+    use core::sync::atomic::Ordering::Relaxed;
+    parametric_eq::diag::MODE.store(mode & 0xff, Relaxed);
+    compressor::diag::MODE.store((mode >> 8) & 0xff, Relaxed);
+    true_peak_limiter::diag::MODE.store((mode >> 16) & 0xff, Relaxed);
+    effect_contract::live_diag::PAIRED.store(mode & 0x100_0000 != 0, Relaxed);
+}
+
+fn build(subject: &Subject, arm: Arm, mode: u32, dispatch: Backend) -> ArmRuntime {
+    set_mode(mode);
+    let mut runtime = SessionRuntime::build_with_dispatch(subject.workload, CONFIG, dispatch);
+    let parts: Vec<Subject> = if subject.name == "console_mix" || subject.name == "mono_mix" {
+        mix_components().to_vec()
+    } else {
+        vec![*subject]
+    };
+    // Every arm is settled at the same base on every track before anything is timed.
+    for part in parts.iter().filter(|_| arm != Arm::Untouched) {
+        for track in 0..64 {
+            let channel = runtime
+                .control_channel(&track_id(track), part.effect_id)
+                .expect("a control channel per track");
+            for side in [ParameterChannel::Left, ParameterChannel::Right] {
+                assert!(runtime.push_parameter(channel, part.parameter, side, part.base));
+            }
+        }
+        for block in 0..8 {
+            runtime.render(block).expect("pre-roll");
+        }
+    }
+    for block in 8..64 {
+        runtime.render(block).expect("pre-roll");
+    }
+    let channels = automations(subject, arm)
+        .into_iter()
+        .map(|(track, part)| {
+            (
+                runtime
+                    .control_channel(&track_id(track), part.effect_id)
+                    .expect("a control channel per track"),
+                part,
+            )
+        })
+        .collect();
+    ArmRuntime {
+        arm,
+        mode,
+        runtime,
+        channels,
+        block: 64,
+        refused: 0,
+        digest: Sha256Sink::new(),
+    }
+}
+
+fn run_blocks(subject: &Subject, arm: &mut ArmRuntime, blocks: usize, samples: &mut Vec<u64>) {
+    set_mode(arm.mode);
+    samples.clear();
+    let _ = subject;
+    for _ in 0..blocks {
+        for &(channel, part) in &arm.channels {
+            let value = part.value(arm.arm, arm.block);
+            for &side in arm.arm.channels() {
+                if !arm.runtime.push_parameter(channel, part.parameter, side, value) {
+                    arm.refused += 1;
+                }
+            }
+        }
+        let start = Instant::now();
+        let result = arm.runtime.render(arm.block);
+        let elapsed = start.elapsed().as_nanos() as u64;
+        result.expect("render");
+        samples.push(elapsed);
+        arm.block += 1;
+    }
+    arm.runtime.hash_output(&mut arm.digest);
+}
+
+fn p50(samples: &mut [u64]) -> f64 {
+    samples.sort_unstable();
+    samples[samples.len() / 2] as f64
+}
+
+fn median(values: &[f64]) -> f64 {
+    let mut sorted = values.to_vec();
+    sorted.sort_by(|a, b| a.partial_cmp(b).expect("finite"));
+    let n = sorted.len();
+    if n % 2 == 1 {
+        sorted[n / 2]
+    } else {
+        0.5 * (sorted[n / 2 - 1] + sorted[n / 2])
+    }
+}
+
+/// Core clock from a dependent scalar add chain (3 cycles per `vaddss` on Zen 3), in GHz.
+fn calibrate() -> f64 {
+    let mut best = f64::MAX;
+    for _ in 0..5 {
+        let mut acc = std::hint::black_box(1.0_f32);
+        let step = std::hint::black_box(1.0e-7_f32);
+        let n = 20_000_000_u64;
+        let start = Instant::now();
+        for _ in 0..n {
+            acc += step;
+        }
+        std::hint::black_box(acc);
+        let ns = start.elapsed().as_nanos() as f64;
+        best = best.min(ns / n as f64);
+    }
+    3.0 / best
+}
+
+fn loadavg() -> String {
+    std::fs::read_to_string("/proc/loadavg")
+        .unwrap_or_default()
+        .trim()
+        .to_owned()
+}
+
+fn env_list(name: &str, default: &str) -> Vec<String> {
+    std::env::var(name)
+        .unwrap_or_else(|_| default.to_owned())
+        .split(',')
+        .map(str::to_owned)
+        .filter(|item| !item.is_empty())
+        .collect()
+}
+
+fn env_usize(name: &str, default: usize) -> usize {
+    std::env::var(name)
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(default)
+}
+
+#[test]
+#[ignore = "timing harness; run by hand under the timing lock"]
+fn rows() {
+    let widths = env_list("AUTO_DIAG_WIDTHS", "8,4");
+    let names = env_list(
+        "AUTO_DIAG_SUBJECTS",
+        "eq_gain,comp_threshold,lim_ceiling",
+    );
+    let arm_names = env_list("AUTO_DIAG_ARMS", "");
+    let rounds = env_usize("AUTO_DIAG_ROUNDS", 6);
+    let modes: Vec<u32> = env_list("AUTO_DIAG_MODES", "0")
+        .iter()
+        .map(|mode| u32::from_str_radix(mode.trim_start_matches("0x"), 16).expect("hex mode"))
+        .collect();
+    let blocks = env_usize("AUTO_DIAG_BLOCKS", 800);
+    let ghz = calibrate();
+    println!("clock {ghz:.3} GHz loadavg {}", loadavg());
+    for width in &widths {
+        let dispatch = match width.as_str() {
+            "8" => Backend::Simd8,
+            "4" => {
+                lane::diag::NATIVE_W4.store(true, core::sync::atomic::Ordering::Relaxed);
+                Backend::Simd4
+            }
+            _ => panic!("width"),
+        };
+        let subjects: Vec<Subject> = SUBJECTS
+            .iter()
+            .copied()
+            .filter(|subject| names.iter().any(|name| name == subject.name))
+            .collect();
+        let arms: Vec<Arm> = ARMS
+            .iter()
+            .copied()
+            .filter(|arm| arm_names.is_empty() || arm_names.iter().any(|name| name == arm.name()))
+            .collect();
+        set_mode(0);
+        let mut baseline = SessionRuntime::build_with_dispatch(
+            Workload::SixtyFourTrackBuiltinsOnly,
+            CONFIG,
+            dispatch,
+        );
+        for block in 0..64 {
+            baseline.render(block).expect("pre-roll");
+        }
+        let mut baseline_block = 64_u64;
+        let mut runtimes: Vec<(Subject, Vec<ArmRuntime>)> = subjects
+            .iter()
+            .map(|subject| {
+                (
+                    *subject,
+                    arms.iter()
+                        .flat_map(|arm| modes.iter().map(move |mode| (*arm, *mode)))
+                        .map(|(arm, mode)| build(subject, arm, mode, dispatch))
+                        .collect(),
+                )
+            })
+            .collect();
+        let mut per_round: Vec<Vec<Vec<f64>>> = runtimes
+            .iter()
+            .map(|(_, arms)| arms.iter().map(|_| Vec::new()).collect())
+            .collect();
+        let mut base_rounds = Vec::new();
+        let mut samples = Vec::with_capacity(blocks);
+        let start_load = loadavg();
+        for round in 0..rounds {
+            // Baseline once per round, interleaved with the subjects.
+            set_mode(0);
+            samples.clear();
+            for _ in 0..blocks {
+                let start = Instant::now();
+                baseline.render(baseline_block).expect("render");
+                samples.push(start.elapsed().as_nanos() as u64);
+                baseline_block += 1;
+            }
+            base_rounds.push(p50(&mut samples));
+            for (index, (subject, arms)) in runtimes.iter_mut().enumerate() {
+                let count = arms.len();
+                for offset in 0..count {
+                    let arm_index = (offset + round) % count;
+                    let arm = &mut arms[arm_index];
+                    run_blocks(subject, arm, 64, &mut samples);
+                    run_blocks(subject, arm, blocks, &mut samples);
+                    per_round[index][arm_index].push(p50(&mut samples));
+                }
+            }
+        }
+        let end_load = loadavg();
+        let base = median(&base_rounds) / 1000.0;
+        println!(
+            "width {width} rounds {rounds} blocks {blocks} load start [{start_load}] end [{end_load}]"
+        );
+        println!("  builtins_only p50 {base:.2} us");
+        for (index, (subject, arms)) in runtimes.iter().enumerate() {
+            for (arm_index, arm) in arms.iter().enumerate() {
+                let settled_index = arms
+                    .iter()
+                    .position(|other| other.arm == Arm::Quiet && other.mode == arm.mode)
+                    .unwrap_or(0);
+                let settled = median(&per_round[index][settled_index]) / 1000.0;
+                let rounds_us: Vec<f64> = per_round[index][arm_index]
+                    .iter()
+                    .map(|ns| ns / 1000.0)
+                    .collect();
+                let row = median(&rounds_us);
+                // Isolate per round against the same round's baseline, then the median.
+                let isolates: Vec<f64> = rounds_us
+                    .iter()
+                    .zip(base_rounds.iter())
+                    .map(|(row, base)| row - base / 1000.0)
+                    .collect();
+                let isolate = median(&isolates);
+                let cyc = isolate * 1000.0 * ghz / LANE_SAMPLES;
+                let spread = rounds_us
+                    .iter()
+                    .fold((f64::MAX, f64::MIN), |(lo, hi), v| (lo.min(*v), hi.max(*v)));
+                let collapse = arm.runtime.bank_collapse_counters();
+                if subject.name == "mono_mix" {
+                    println!(
+                        "    collapse [{} block-cohorts, {} cohorts] over {} blocks",
+                        collapse[0], collapse[1], arm.block
+                    );
+                }
+                println!(
+                    "  w{width} m{:06x} {:<15} {:<14} row {row:8.2} us  isolate {isolate:8.2} us  {cyc:6.2} cyc/ls  vs settled {:+7.2} us ({:+6.1} %)  rounds [{:.2}..{:.2}] refused {}",
+                    arm.mode,
+                    subject.name,
+                    arm.arm.name(),
+                    row - settled,
+                    100.0 * (row - settled) / (settled - base),
+                    spread.0,
+                    spread.1,
+                    arm.refused,
+                );
+            }
+        }
+    }
+}
+
+/// Prototype identity: every arm renders the same bits under each prototype mode as under mode 0.
+#[test]
+#[ignore = "diagnosis identity check; run by hand"]
+fn identity() {
+    let widths = env_list("AUTO_DIAG_WIDTHS", "8,4");
+    let names = env_list(
+        "AUTO_DIAG_SUBJECTS",
+        "eq_gain,eq_freq,comp_threshold,comp_attack,lim_ceiling,lim_release",
+    );
+    let modes: Vec<u32> = env_list("AUTO_DIAG_MODES", "0")
+        .iter()
+        .map(|mode| u32::from_str_radix(mode.trim_start_matches("0x"), 16).expect("hex mode"))
+        .collect();
+    let blocks = env_usize("AUTO_DIAG_BLOCKS", 200);
+    let mut mismatches = 0;
+    for width in &widths {
+        let dispatch = match width.as_str() {
+            "8" => Backend::Simd8,
+            "4" => {
+                lane::diag::NATIVE_W4.store(true, core::sync::atomic::Ordering::Relaxed);
+                Backend::Simd4
+            }
+            _ => panic!("width"),
+        };
+        for subject in SUBJECTS
+            .iter()
+            .filter(|subject| names.iter().any(|name| name == subject.name))
+        {
+            for arm in ARMS {
+                let digests: Vec<String> = modes
+                    .iter()
+                    .map(|mode| {
+                        let mut runtime = build(subject, arm, *mode, dispatch);
+                        let mut hash = Sha256Sink::new();
+                        for _ in 0..blocks {
+                            set_mode(runtime.mode);
+                            for &(channel, part) in &runtime.channels {
+                                let value = part.value(runtime.arm, runtime.block);
+                                for &side in runtime.arm.channels() {
+                                    assert!(runtime.runtime.push_parameter(
+                                        channel,
+                                        part.parameter,
+                                        side,
+                                        value
+                                    ));
+                                }
+                            }
+                            runtime.runtime.render(runtime.block).expect("render");
+                            runtime.runtime.hash_output(&mut hash);
+                            runtime.block += 1;
+                        }
+                        hash.finish_hex()
+                    })
+                    .collect();
+                let same = digests.iter().all(|digest| *digest == digests[0]);
+                if !same {
+                    mismatches += 1;
+                }
+                println!(
+                    "w{width} {:<15} {:<14} {} {}",
+                    subject.name,
+                    arm.name(),
+                    if same { "SAME" } else { "DIFFERENT" },
+                    &digests[0][..16]
+                );
+            }
+        }
+    }
+    set_mode(0);
+    assert_eq!(mismatches, 0, "a prototype mode moved rendered bits");
+}
