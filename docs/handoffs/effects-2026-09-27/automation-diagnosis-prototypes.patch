@@ -0,0 +1,302 @@
+// Automation cost diagnosis (2026-09-27): time the shipped host_web.wasm render export while the
+// live console automates one effect parameter. Scratch harness, recorded in the diagnosis patch.
+//
+// usage: node --no-liftoff web_auto.mjs SUBJECTS ARMS base.wasm [proto.wasm ...]
+//   SUBJECTS: comma list of eq_gain,eq_freq,comp_threshold,comp_attack,lim_ceiling,lim_release
+//   ARMS: comma list of settled,one_point,one_segment,one_left_only,eight_of_64,all_64 (or "all")
+// env: ROUNDS (6), BLOCKS (600), WARM (64)
+import { readFileSync } from "node:fs";
+import { createHash } from "node:crypto";
+import { createPreparedControl } from "/home/bl/misofm/engine/.claude/worktrees/agent-ae53afa6e6b89a559/hosts/host-web/web/prepared-control.js";
+
+const ROOT = "/tmp/claude-1002/-home-bl-misofm-engine/43895396-e183-427f-b08f-a0b72f15ae5f/scratchpad/automation-diag/web";
+const ABI_LAYOUT = JSON.parse(readFileSync(
+  "/home/bl/misofm/engine/.claude/worktrees/agent-ae53afa6e6b89a559/sdk/assets/miso-engine-v1-abi-layout.json"));
+const ABI_VERSION = ABI_LAYOUT.abiVersion;
+const BOOT_OPTIONS_BYTES = 64, BUFFER_SOURCE_ID = 2, BUFFER_SOURCE_PCM = 3, BUFFER_COMMAND = 6;
+const Q = 128, RATE = 48000;
+const COMMAND_RECORD_BYTES = ABI_LAYOUT.commandRecord.bytes;
+const COMMAND_EFFECT_PARAM = 5;
+const commandField = (name) => ABI_LAYOUT.commandRecord.fields.find((f) => f.name === name).offset;
+const structureField = (s, name) => ABI_LAYOUT.structures[s].fields.find((f) => f.name === name).offset;
+const resultCode = (name) => ABI_LAYOUT.constants.resultCodes.find((r) => r.name === name).value;
+const commandReason = (name) => ABI_LAYOUT.constants.commandReasons.find((r) => r.name === name).value;
+
+const SUBJECTS = {
+  eq_gain: { doc: "eq", rack: 0, parameterId: 4, base: 3.0, step: 0.25, lo: -3, hi: 9, rate: 0.02 },
+  eq_freq: { doc: "eq", rack: 0, parameterId: 3, base: 200, step: 5, lo: 100, hi: 400, rate: 0.5 },
+  comp_threshold: { doc: "comp", rack: 0, parameterId: 1, base: -24, step: 0.5, lo: -30, hi: -18, rate: 0.05 },
+  comp_attack: { doc: "comp", rack: 0, parameterId: 4, base: 10, step: 1, lo: 5, hi: 20, rate: 0.05 },
+  comp_ratio: { doc: "comp", rack: 0, parameterId: 2, base: 4, step: 0.5, lo: 2, hi: 8, rate: 0.02 },
+  comp_knee: { doc: "comp", rack: 0, parameterId: 3, base: 6, step: 1, lo: 0, hi: 12, rate: 0.05 },
+  comp_release: { doc: "comp", rack: 0, parameterId: 5, base: 80, step: 5, lo: 40, hi: 200, rate: 0.5 },
+  comp_makeup: { doc: "comp", rack: 0, parameterId: 6, base: 2, step: 0.5, lo: 0, hi: 6, rate: 0.02 },
+  comp_mix: { doc: "comp", rack: 0, parameterId: 7, base: 0.5, step: 0.1, lo: 0, hi: 1, rate: 0.004 },
+  lim_ceiling: { doc: "lim", rack: 2, parameterId: 1, base: -3, step: 0.25, lo: -6, hi: -1, rate: 0.01 },
+  lim_release: { doc: "lim", rack: 2, parameterId: 2, base: 60, step: 5, lo: 40, hi: 120, rate: 0.2 },
+};
+SUBJECTS.console_mix = { doc: "console", mix: true };
+SUBJECTS.mono_mix = { doc: "mono", mix: true };
+const MIX_PARTS = [
+  { ...SUBJECTS.eq_gain, effectIndex: 0 },
+  { ...SUBJECTS.comp_threshold, effectIndex: 1 },
+  { ...SUBJECTS.lim_ceiling, effectIndex: 0 },
+];
+const ARMS = {
+  untouched: { tracks: [], channel: 2, untouched: true },
+  settled: { tracks: [], channel: 2 },
+  one_point: { tracks: [0], channel: 2 },
+  one_segment: { tracks: [0], channel: 2, segment: true },
+  one_left_only: { tracks: [0], channel: 0 },
+  eight_of_64: { tracks: [0, 8, 16, 24, 32, 40, 48, 56], channel: 2 },
+  all_64: { tracks: [...Array(64).keys()], channel: 2 },
+};
+
+function value(subject, arm, block) {
+  if (arm.segment) {
+    const span = subject.hi - subject.lo;
+    const travelled = (block * subject.rate) % (2 * span);
+    return Math.fround(travelled <= span ? subject.lo + travelled : subject.hi - (travelled - span));
+  }
+  return Math.fround(block % 2 === 0 ? subject.base + subject.step : subject.base - subject.step);
+}
+
+function encode(records) {
+  const bytes = new Uint8Array(records.length * COMMAND_RECORD_BYTES);
+  const view = new DataView(bytes.buffer);
+  records.forEach((r, i) => {
+    const o = i * COMMAND_RECORD_BYTES;
+    view.setUint8(o + commandField("kind"), COMMAND_EFFECT_PARAM);
+    view.setUint8(o + commandField("rack"), r.rack);
+    view.setUint8(o + commandField("channel"), r.channel);
+    view.setUint32(o + commandField("trackIndex"), r.track, true);
+    view.setUint32(o + commandField("effectIndex"), r.effectIndex ?? 0, true);
+    view.setUint32(o + commandField("parameterId"), r.parameterId, true);
+    view.setUint32(o + commandField("smoothingSamples"), 0, true);
+    view.setFloat32(o + commandField("values"), r.value, true);
+  });
+  return bytes;
+}
+
+function commandAck(e, handle, result, records) {
+  const report = new DataView(e.memory.buffer, e.miso_engine_web_v1_command_report_ptr(handle),
+    ABI_LAYOUT.structures.commandReport.bytes);
+  return {
+    result,
+    reason: report.getUint32(structureField("commandReport", "reason"), true),
+    rejectedIndex: report.getUint32(structureField("commandReport", "rejectedIndex"), true),
+    admitted: report.getUint32(structureField("commandReport", "admitted"), true),
+    appliedAtSample: report.getBigUint64(structureField("commandReport", "appliedAtSample"), true),
+    records: records.slice(),
+  };
+}
+
+function preparedControl(e, handle) {
+  const configBytes = ABI_LAYOUT.structures.eqTargetConfig.bytes;
+  const configCopySync = (address) => {
+    const result = e.miso_engine_web_v1_eq_target_config_copy(handle, address.trackIndex, address.rack, address.effectIndex);
+    if (result === resultCode("ok")) {
+      const pointer = e.miso_engine_web_v1_eq_target_config_ptr(handle);
+      return { result, reason: commandReason("none"), config: new Uint8Array(e.memory.buffer, pointer, configBytes).slice() };
+    }
+    return { result, reason: commandReason("none"), config: new Uint8Array(0) };
+  };
+  const stage = (records) => {
+    const pointer = e.miso_engine_web_v1_buffer_ptr(handle, BUFFER_COMMAND);
+    new Uint8Array(e.memory.buffer, pointer, records.byteLength).set(records);
+  };
+  const ordinarySubmitSync = (records, count) => {
+    stage(records);
+    return commandAck(e, handle, e.miso_engine_web_v1_command_submit(handle, count), records);
+  };
+  const preparedSubmitSync = (records, companion, count) => {
+    stage(records);
+    const pointer = e.miso_engine_web_v1_prepared_companion_ptr(handle);
+    new Uint8Array(e.memory.buffer, pointer, companion.byteLength).set(companion);
+    return commandAck(e, handle, e.miso_engine_web_v1_prepared_command_submit(handle, count, companion.byteLength), records);
+  };
+  const refusal = (records, _count, reason, rejectedIndex, result) => ({
+    result, reason, rejectedIndex: rejectedIndex ?? 0, admitted: 0, appliedAtSample: 0n, records: records.slice(),
+  });
+  return createPreparedControl({
+    instance: e, abiLayout: ABI_LAYOUT, sampleRateHz: RATE,
+    configCopySync, ordinarySubmitSync, preparedSubmitSync, preparedRefusalSync: refusal,
+  });
+}
+
+const docs = {};
+for (const name of ["builtins", "eq", "comp", "lim", "console", "mono"]) docs[name] = readFileSync(`${ROOT}/web-${name}.json`);
+
+function boot(module, docName) {
+  const e = new WebAssembly.Instance(module, {}).exports;
+  const doc = docs[docName];
+  const opt = e.miso_engine_web_v1_boot_options_ptr();
+  const view = new DataView(e.memory.buffer, opt, BOOT_OPTIONS_BYTES);
+  view.setUint32(0, BOOT_OPTIONS_BYTES, true); view.setUint32(4, ABI_VERSION, true);
+  view.setUint32(8, RATE, true); view.setUint32(12, Q, true); view.setUint32(16, 8192, true);
+  view.setUint32(20, 0, true); view.setBigUint64(24, 0n, true);
+  // console words: command queue 64 records per track, no meters, no observation, no master.
+  view.setBigUint64(32, 64n, true);
+  for (let i = 1; i < 4; i++) view.setBigUint64(32 + i * 8, 0n, true);
+  const p = e.miso_engine_web_v1_document_ptr(doc.byteLength);
+  new Uint8Array(e.memory.buffer, p, doc.byteLength).set(doc);
+  const handle = e.miso_engine_web_v1_boot(doc.byteLength);
+  if (handle === 0) {
+    const n = e.miso_engine_web_v1_boot_diagnostic_bytes();
+    throw new Error(`boot ${e.miso_engine_web_v1_boot_result()}: ${new TextDecoder().decode(new Uint8Array(e.memory.buffer, p, n))}`);
+  }
+  const arm = {
+    e, handle, frame: 0n, n: 0, left: new Float32Array(Q), right: new Float32Array(Q),
+    idPtr: e.miso_engine_web_v1_buffer_ptr(handle, BUFFER_SOURCE_ID),
+    pcmPtr: e.miso_engine_web_v1_buffer_ptr(handle, BUFFER_SOURCE_PCM),
+    id: new TextEncoder().encode("fixture-source"), control: null, block: 0, refused: 0,
+  };
+  arm.control = preparedControl(e, handle);
+  return arm;
+}
+
+function feed(a) {
+  for (let i = 0; i < Q; i++) { const t = (a.n * Q + i) * 0.017; a.left[i] = Math.sin(t) * 0.6; a.right[i] = -Math.sin(t) * 0.45; }
+  const mem = a.e.memory.buffer;
+  new Uint8Array(mem, a.idPtr, a.id.length).set(a.id);
+  const pcm = new Float32Array(mem, a.pcmPtr, 2 * Q);
+  pcm.set(a.left, 0); pcm.set(a.right, Q);
+  const r = a.e.miso_engine_web_v1_source_submit(a.handle, a.id.length, 1n, a.frame, 2, Q, 0);
+  if (r !== 0) throw new Error(`submit ${r}`);
+  a.frame += BigInt(Q); a.n++;
+}
+
+function submit(a, records) {
+  for (let start = 0; start < records.length; start += 128) {
+    const chunk = records.slice(start, start + 128);
+    const reply = a.control.submitSync(encode(chunk), chunk.length);
+    if (reply.result !== 0) { a.refused++; if (a.refused < 4) console.log(`refused ${reply.result} reason ${reply.reason} idx ${reply.rejectedIndex}`); }
+  }
+}
+
+function render(a) {
+  const r = a.e.miso_engine_web_v1_render(a.handle, Q);
+  if (r !== 0) throw new Error(`render ${r}`);
+}
+
+function parts(subject, arm, track) {
+  if (!subject.mix) return subject;
+  return MIX_PARTS[arm === ARMS.all_64 ? track % 3 : Math.floor(track / 8) % 3];
+}
+
+function records(subject, arm, block) {
+  const out = [];
+  for (const track of arm.tracks) {
+    const part = parts(subject, arm, track);
+    const v = block === null ? Math.fround(part.base) : value(part, arm, block);
+    out.push({ rack: part.rack, effectIndex: part.effectIndex ?? 0, channel: arm.channel, track, parameterId: part.parameterId, value: v });
+  }
+  return out;
+}
+
+function settleRecords(subject) {
+  const out = [];
+  for (const part of subject.mix ? MIX_PARTS : [subject]) {
+    for (let track = 0; track < 64; track++) {
+      out.push({ rack: part.rack, effectIndex: part.effectIndex ?? 0, channel: 2, track, parameterId: part.parameterId, value: Math.fround(part.base) });
+    }
+  }
+  return out;
+}
+
+function makeArm(module, subject, armName) {
+  const a = boot(module, subject.doc);
+  a.subject = subject; a.arm = ARMS[armName]; a.armName = armName;
+  for (let i = 0; i < 4; i++) feed(a);
+  // settle every track at the base value before timing
+  if (!ARMS[armName].untouched) submit(a, settleRecords(subject));
+  for (let i = 0; i < 64; i++) { feed(a); render(a); }
+  return a;
+}
+
+function measure(a, blocks) {
+  const s = new Float64Array(blocks);
+  for (let i = 0; i < blocks; i++) {
+    feed(a);
+    if (a.arm.tracks.length > 0) submit(a, records(a.subject, a.arm, a.block));
+    a.block++;
+    const t0 = process.hrtime.bigint();
+    render(a);
+    s[i] = Number(process.hrtime.bigint() - t0);
+  }
+  s.sort();
+  return s[blocks >> 1] / 1000;
+}
+
+function digestRun(module, subjectName, armName, blocks) {
+  const a = makeArm(module, SUBJECTS[subjectName], armName);
+  const hash = createHash("sha256");
+  const outPtr = a.e.miso_engine_web_v1_buffer_ptr(a.handle, 5);
+  for (let i = 0; i < blocks; i++) {
+    feed(a);
+    if (a.arm.tracks.length > 0) submit(a, records(a.subject, a.arm, a.block));
+    a.block++;
+    render(a);
+    hash.update(new Uint8Array(a.e.memory.buffer, outPtr, 2 * Q * 4));
+  }
+  return hash.digest("hex").slice(0, 16) + (a.refused ? ` refused=${a.refused}` : "");
+}
+
+const [subjectList, armList, ...files] = process.argv.slice(2);
+if (process.env.DIGEST) {
+  const mods = files.map((f) => [f.split("/").slice(-4, -3)[0].replace("t-web-", ""), new WebAssembly.Module(readFileSync(f))]);
+  const armsD = armList === "all" ? Object.keys(ARMS) : armList.split(",");
+  let bad = 0;
+  for (const s of subjectList.split(",")) for (const armName of armsD) {
+    const d = mods.map(([n, m]) => digestRun(m, s, armName, Number(process.env.DIGEST)));
+    const same = d.every((x) => x === d[0]);
+    if (!same) bad++;
+    console.log(`${s.padEnd(15)} ${armName.padEnd(14)} ${same ? "SAME" : "DIFFERENT"} ${d.join(" ")}`);
+  }
+  console.log(bad ? `MISMATCHES ${bad}` : "all identical");
+  process.exit(0);
+}
+const subjects = subjectList.split(",");
+const armNames = armList === "all" ? Object.keys(ARMS) : armList.split(",");
+const ROUNDS = Number(process.env.ROUNDS ?? 6), BLOCKS = Number(process.env.BLOCKS ?? 600), WARM = Number(process.env.WARM ?? 64);
+const modules = files.map((f) => [f.split("/").slice(-4, -3)[0].replace("t-web-", ""), new WebAssembly.Module(readFileSync(f))]);
+const med = (v) => { const x = [...v].sort((p, q) => p - q); return (x[(x.length - 1) >> 1] + x[x.length >> 1]) / 2; };
+console.log(`node ${process.version} loadavg ${readFileSync("/proc/loadavg", "utf8").trim()}`);
+const all = [];
+const baselines = [];
+for (const [modName, module] of modules) {
+  const baseline = boot(module, "builtins");
+  baseline.arm = ARMS.settled; baseline.subject = SUBJECTS.eq_gain; baseline.modName = modName; baseline.rounds = [];
+  for (let i = 0; i < 4; i++) feed(baseline);
+  for (let i = 0; i < 64; i++) { feed(baseline); render(baseline); }
+  baselines.push(baseline);
+  for (const s of subjects) for (const armName of armNames) {
+    const a = makeArm(module, SUBJECTS[s], armName);
+    a.subjectName = s; a.modName = modName; a.rounds = [];
+    all.push(a);
+  }
+}
+const everyone = [...baselines, ...all];
+for (const a of everyone) measure(a, 1000);
+for (let round = 0; round < ROUNDS; round++) {
+  for (let k = 0; k < everyone.length; k++) {
+    const a = everyone[(k + round) % everyone.length];
+    measure(a, WARM); a.rounds.push(measure(a, BLOCKS));
+  }
+}
+console.log(`end loadavg ${readFileSync("/proc/loadavg", "utf8").trim()}`);
+for (const [modName] of modules) {
+  const baseline = baselines.find((b) => b.modName === modName);
+  const base = med(baseline.rounds);
+  console.log(`module ${modName} builtins ${base.toFixed(2)} us`);
+  for (const s of subjects) {
+    const arms = all.filter((x) => x.modName === modName && x.subjectName === s);
+    const settled = arms.find((a) => a.armName === "settled");
+    const settledIso = settled ? med(settled.rounds.map((v, i) => v - baseline.rounds[i])) : NaN;
+    for (const a of arms) {
+      const iso = med(a.rounds.map((v, i) => v - baseline.rounds[i]));
+      const row = med(a.rounds);
+      console.log(`  ${modName} ${s.padEnd(15)} ${a.armName.padEnd(14)} row ${row.toFixed(2).padStart(8)} us  isolate ${iso.toFixed(2).padStart(8)} us  ${(iso * 1000 * 3.7 / 16384).toFixed(2).padStart(6)} cyc/ls@3.7  vs settled ${(iso - settledIso >= 0 ? "+" : "") + (iso - settledIso).toFixed(2)} us (${(100 * (iso - settledIso) / settledIso).toFixed(1)} %)  rounds [${Math.min(...a.rounds).toFixed(2)}..${Math.max(...a.rounds).toFixed(2)}] refused ${a.refused}`);
+    }
+  }
+}
