+/// Diagnosis: every state word is `+0.0` or finite with magnitude at least `FLUSH_EPS`, so an
+/// identity section's recurrence leaves it exactly where it is.
+#[cfg(test)]
+fn section_state_is_frozen<L: Lane>(section: &Section<L>) -> bool {
+    let ok = |value: L| {
+        let mut words = [0_u32; MAX_LANES];
+        value.store_bits(&mut words[..L::WIDTH]);
+        words[..L::WIDTH].iter().all(|word| {
+            let x = f32::from_bits(*word);
+            *word == 0 || (x.is_finite() && x.abs() >= lane::FLUSH_EPS)
+        })
+    };
+    ok(section.state.ic1) && ok(section.state.ic2)
+}
