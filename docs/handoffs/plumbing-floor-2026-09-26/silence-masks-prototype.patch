+/// PROTOTYPE: [`route_reduce`] that skips every input whose claim played no block this quantum.
+///
+/// Live inputs pair up in edge order as they come; each skipped input's silent mix is a signed
+/// zero, and if any of them is `+0.0` on a plane, that plane gets one `+ 0.0` after the chain.
+#[inline(never)]
+fn route_reduce_skip<L: Lane>(
+    lease: &ArenaLease,
+    inputs: &[u32],
+    routes: &[[f32; 4]],
+    sources: OutputSources<'_>,
+    left: &mut [f32],
+    right: &mut [f32],
+    skip: bool,
+) -> bool {
+    let frames = lease.frames();
+    if inputs.len() != routes.len()
+        || inputs.len() < 2
+        || (!sources.claims.is_empty() && sources.claims.len() != inputs.len())
+        || left.len() != frames
+        || right.len() != frames
+    {
+        return false;
+    }
+    let vectored = frames - frames % L::WIDTH;
+    let mut pending: Option<(usize, (&[f32], &[f32]))> = None;
+    let mut initial = true;
+    let mut fix = [false; 2];
+    for (position, (&input, &route)) in inputs.iter().zip(routes).enumerate() {
+        let planes = match sources.input_or_unplayed(lease, position, input) {
+            Some(planes) => planes,
+            None => {
+                let [zl, zr] = silent_mix(route);
+                if skip && zl == 0.0 && zr == 0.0 {
+                    fix[0] |= zl.to_bits() == 0;
+                    fix[1] |= zr.to_bits() == 0;
+                    continue;
+                }
+                lease.read_stereo(ARENA_SILENCE_BUFFER)
+            }
+        };
+        match pending.take() {
+            None => pending = Some((position, planes)),
+            Some((first, first_planes)) => {
+                if !route_pair_planes::<L, 2>(
+                    [first_planes, planes],
+                    &[routes[first], route],
+                    left,
+                    right,
+                    vectored,
+                    initial,
+                ) {
+                    return false;
+                }
+                initial = false;
+            }
+        }
+    }
+    if let Some((only, planes)) = pending {
+        if !route_pair_planes::<L, 1>([planes], &[routes[only]], left, right, vectored, initial) {
+            return false;
+        }
+        initial = false;
+    }
+    if initial {
+        left.fill(if fix[0] { 0.0 } else { -0.0 });
+        right.fill(if fix[1] { 0.0 } else { -0.0 });
+    } else {
+        if fix[0] {
+            plus_zero_plane::<L>(left, vectored);
+        }
+        if fix[1] {
+            plus_zero_plane::<L>(right, vectored);
+        }
+    }
+    true
+}
