+//! PROTOTYPE (silence-mask research, never committed).
+use std::hint::black_box;
+use std::sync::atomic::Ordering;
+use std::time::Instant;
+
+use bench_support::digest::Sha256Sink;
+use console_workload::{PROTO_FIRST_ABSENT_CLAIM, PlanConfig, SessionRuntime, Workload};
+
+fn core_hz() -> f64 {
+    const ADDS: u64 = 200_000_000;
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let mut x = black_box(0.0_f32);
+        let d = black_box(1.0e-3_f32);
+        let start = Instant::now();
+        for _ in 0..ADDS {
+            x += d;
+        }
+        best = best.min(start.elapsed().as_secs_f64());
+        black_box(x);
+    }
+    3.0 * ADDS as f64 / best
+}
+
+fn digest(runtime: &mut SessionRuntime, observation: &mut u64) -> String {
+    let mut sink = Sha256Sink::new();
+    for _ in 0..64 {
+        runtime.render(*observation).expect("block");
+        *observation += 1;
+        runtime.hash_output(&mut sink);
+    }
+    sink.finish_hex()
+}
+
+fn p50(runtime: &mut SessionRuntime, observation: &mut u64, hz: f64) -> (f64, f64) {
+    for _ in 0..256 {
+        runtime.render(*observation).expect("warm");
+        *observation += 1;
+    }
+    let mut samples = Vec::with_capacity(4000);
+    for _ in 0..4000 {
+        let start = Instant::now();
+        let result = runtime.render(*observation);
+        samples.push(start.elapsed().as_nanos() as f64);
+        result.expect("block");
+        *observation += 1;
+    }
+    samples.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    (samples[0] * hz / 1e9, samples[2000] * hz / 1e9)
+}
+
+#[test]
+#[ignore = "prototype measurement"]
+fn silence_proto() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz", hz / 1e9);
+    for first_absent in [usize::MAX, 63, 60, 56, 48, 32, 16, 8, 0] {
+        PROTO_FIRST_ABSENT_CLAIM.store(first_absent, Ordering::Relaxed);
+        let mut runtime =
+            SessionRuntime::build(Workload::SixtyFourTrackPlumbingRing, PlanConfig::BASELINE);
+        let mut observation = 0;
+        graph::test_only_set_silence_skip(0);
+        let off = digest(&mut runtime, &mut observation);
+        graph::test_only_set_silence_skip(1);
+        let on = digest(&mut runtime, &mut observation);
+        graph::test_only_set_silence_skip(2);
+        let restructured = digest(&mut runtime, &mut observation);
+        assert_eq!(off, on, "skip must render the same bits (first absent {first_absent})");
+        assert_eq!(off, restructured, "restructure must render the same bits");
+        let absent = 64 - first_absent.min(64);
+        let mut line = format!("absent {absent:2}: digest {}..", &on[..12]);
+        for _ in 0..3 {
+            for mode in [0_u8, 2, 1] {
+                graph::test_only_set_silence_skip(mode);
+                let (min, p50) = p50(&mut runtime, &mut observation, hz);
+                line += &format!(
+                    "  {} {:5.0}/{:5.0}",
+                    ["base", "skip", "restr"][mode as usize],
+                    min,
+                    p50
+                );
+            }
+        }
+        println!("{line}");
+    }
+    PROTO_FIRST_ABSENT_CLAIM.store(usize::MAX, Ordering::Relaxed);
+}
