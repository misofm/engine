+/// PROTOTYPE: the per-plane word the fused kernel adds for an all-`+0.0` input under `route`,
+/// computed with the kernel's own operations (`lr.fma(+0, ll.mul(+0))`, unfused).
+#[inline]
+fn silent_mix(route: [f32; 4]) -> [f32; 2] {
+    let [ll, lr, rl, rr] = route;
+    [
+        <f32 as Lane>::fma(lr, 0.0, <f32 as Lane>::mul(ll, 0.0)),
+        <f32 as Lane>::fma(rr, 0.0, <f32 as Lane>::mul(rl, 0.0)),
+    ]
+}
