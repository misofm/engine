+impl<'a> OutputSources<'a> {
+    /// PROTOTYPE: [`Self::input`], but `None` for an in-place claim whose source played no block.
+    #[inline]
+    fn input_or_unplayed<'b>(
+        self,
+        lease: &'b ArenaLease,
+        position: usize,
+        buffer: u32,
+    ) -> Option<(&'b [f32], &'b [f32])>
+    where
+        'a: 'b,
+    {
+        let claim = self
+            .claims
+            .get(position)
+            .copied()
+            .unwrap_or(NO_SOURCE_CLAIM);
+        if claim != NO_SOURCE_CLAIM
+            && let Some(planes) = self.planes
