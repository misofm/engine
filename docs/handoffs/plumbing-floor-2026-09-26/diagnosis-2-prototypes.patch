+// ---------------------------------------------------------------------------------------------
+// Verbatim copy of the engine's fused Output reduction (crates/graph/src/runtime.rs), with the
+// arena replaced by a trait object that serves each input's planes.
+// ---------------------------------------------------------------------------------------------
+
+trait PlaneSource {
+    fn planes(&self, position: usize) -> (&[f32], &[f32]);
+}
+
+struct DriverLike {
+    claims: Box<[Planes]>,
+}
+
+impl PlaneSource for DriverLike {
+    fn planes(&self, position: usize) -> (&[f32], &[f32]) {
+        let claim = &self.claims[position];
+        (&claim.0[..], &claim.1[..])
+    }
+}
+
+#[inline(never)]
+fn v_route_reduce<L: Lane>(
+    source: &dyn PlaneSource,
+    inputs: usize,
+    routes: &[[f32; 4]],
+    left: &mut [f32],
+    right: &mut [f32],
+) -> bool {
+    let frames = left.len();
+    if inputs != routes.len() || inputs < 2 || right.len() != frames {
+        return false;
+    }
+    let vectored = frames - frames % L::WIDTH;
+    let positions: Vec<usize> = (0..inputs).collect();
+    for (index, (pair, table)) in positions.chunks(2).zip(routes.chunks(2)).enumerate() {
+        let initial_store = index == 0;
+        let reduced = match (pair, table) {
+            (&[a, b], &[ra, rb]) => {
+                v_route_pair::<L, 2>(source, [a, b], &[ra, rb], left, right, vectored, initial_store)
+            }
+            (&[a], &[ra]) => {
+                v_route_pair::<L, 1>(source, [a], &[ra], left, right, vectored, initial_store)
+            }
+            _ => false,
+        };
+        if !reduced {
+            return false;
+        }
+    }
+    true
+}
+
+#[inline(always)]
+fn v_route_pair<L: Lane, const G: usize>(
+    source: &dyn PlaneSource,
+    ids: [usize; G],
+    table: &[[f32; 4]; G],
+    left: &mut [f32],
+    right: &mut [f32],
+    vectored: usize,
+    initial_store: bool,
+) -> bool {
+    let planes: [(&[f32], &[f32]); G] = core::array::from_fn(|member| source.planes(ids[member]));
+    let lefts = planes.map(|(left, _)| left);
+    let rights = planes.map(|(_, right)| right);
+    let frames = left.len();
+    if vectored > frames
+        || right.len() != frames
+        || lefts
+            .iter()
+            .chain(rights.iter())
+            .any(|plane| plane.len() != frames)
+    {
+        return false;
+    }
+    let (left_vectors, _left_tail) = left.split_at_mut(vectored);
+    let (right_vectors, _right_tail) = right.split_at_mut(vectored);
+    v_route_run::<L, G>(
+        left_vectors,
+        right_vectors,
+        lefts.map(|plane| &plane[..vectored]),
+        rights.map(|plane| &plane[..vectored]),
+        table,
+        initial_store,
+    )
+}
+
+#[inline(always)]
+fn v_route_run<L: Lane, const G: usize>(
+    left: &mut [f32],
+    right: &mut [f32],
+    lefts: [&[f32]; G],
+    rights: [&[f32]; G],
+    table: &[[f32; 4]; G],
+    initial_store: bool,
+) -> bool {
+    let coefficients = table.map(|route| route.map(L::splat));
+    let mut left_chunks = lefts.map(|plane| plane.chunks_exact(L::WIDTH));
+    let mut right_chunks = rights.map(|plane| plane.chunks_exact(L::WIDTH));
+    let outputs = left
+        .chunks_exact_mut(L::WIDTH)
+        .zip(right.chunks_exact_mut(L::WIDTH));
+    if initial_store {
+        let (Some((first, rest)), Some((first_left, rest_left)), Some((first_right, rest_right))) = (
+            coefficients.split_first(),
+            left_chunks.split_first_mut(),
+            right_chunks.split_first_mut(),
+        ) else {
+            return false;
+        };
+        for (out_left, out_right) in outputs {
+            let Some(acc) = first_left
+                .next()
+                .zip(first_right.next())
+                .map(|(l, r)| v_mix_chunk(first, l, r))
+                .and_then(|acc| v_add_mixed_chunks(acc, rest, rest_left, rest_right))
+            else {
+                return false;
+            };
+            acc.0.store(out_left);
+            acc.1.store(out_right);
+        }
+    } else {
+        for (out_left, out_right) in outputs {
+            let running = (L::load(out_left), L::load(out_right));
+            let Some(acc) =
+                v_add_mixed_chunks(running, &coefficients, &mut left_chunks, &mut right_chunks)
+            else {
+                return false;
+            };
+            acc.0.store(out_left);
+            acc.1.store(out_right);
+        }
+    }
+    true
+}
+
+#[inline(always)]
+fn v_mix_chunk<L: Lane>([ll, lr, rl, rr]: &[L; 4], left: &[f32], right: &[f32]) -> (L, L) {
+    let (l, r) = (L::load(left), L::load(right));
+    (lr.fma(r, ll.mul(l)), rr.fma(r, rl.mul(l)))
+}
+
+#[inline(always)]
+fn v_add_mixed_chunks<L: Lane>(
+    mut acc: (L, L),
+    coefficients: &[[L; 4]],
+    lefts: &mut [core::slice::ChunksExact<'_, f32>],
+    rights: &mut [core::slice::ChunksExact<'_, f32>],
+) -> Option<(L, L)> {
+    for ((route, left), right) in coefficients.iter().zip(lefts).zip(rights) {
+        let (mixed_left, mixed_right) = v_mix_chunk(route, left.next()?, right.next()?);
+        acc = (acc.0.add(mixed_left), acc.1.add(mixed_right));
+    }
+    Some(acc)
+}
+
+#[test]
+#[ignore = "measurement harness"]
+fn verbatim() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz", hz / 1e9);
+    let coefficients = coefficients();
+    for trial in 0..6 {
+        // Fresh allocations per trial, so alignment varies as the engine's does.
+        let pad: Vec<u8> = vec![0; 16 * trial + 1];
+        let driver = DriverLike { claims: sources() };
+        let mut output = vec![0.0_f32; 2 * QUANTUM];
+        let inputs: Vec<&Planes> = driver.claims.iter().collect();
