+        {
+            let (left, right) = output.split_at_mut(QUANTUM);
+            assert!(v_route_reduce::<Simd8>(&driver, TRACKS, &coefficients, left, right));
+            assert!(left.iter().zip(&rl).all(|(a, b)| a.to_bits() == b.to_bits()));
+            assert!(right.iter().zip(&rr).all(|(a, b)| a.to_bits() == b.to_bits()));
+        }
+        let v = time_min(30, 200, || {
+            let (left, right) = output.split_at_mut(QUANTUM);
+            v_route_reduce::<Simd8>(black_box(&driver), TRACKS, &coefficients, left, right);
+        });
+        let mut l = [0.0; QUANTUM];
+        let mut r = [0.0; QUANTUM];
+        let p = time_min(30, 200, || pairs(black_box(&inputs), &coefficients, &mut l, &mut r));
+        println!(
+            "trial {trial}: claims mod 64 = {:>2}, output mod 64 = {:>2}: verbatim {:>6.0} cycles, replica pairs {:>6.0} cycles",
+            driver.claims.as_ptr() as usize % 64,
+            output.as_ptr() as usize % 64,
+            v * hz / 1e9,
+            p * hz / 1e9
+        );
+        black_box(pad);
+    }
+}
