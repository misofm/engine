+            runtime.diag_output_address() % 64
+        );
+        let mut observation = 0_u64;
+        for flags in [0u32, 1] {
+            graph::test_only_set_experiment(flags);
+            for _ in 0..WARMUP_BLOCKS {
+                runtime.render(observation).expect("warmup");
+                observation += 1;
+            }
+            let mut p50s = Vec::new();
+            for _ in 0..3 {
+                let mut samples = Vec::with_capacity(PROFILED_BLOCKS as usize);
+                for _ in 0..PROFILED_BLOCKS {
+                    let start = Instant::now();
+                    let result = runtime.render(observation);
+                    let elapsed = start.elapsed().as_nanos() as u64;
+                    result.expect("block");
+                    observation += 1;
+                    samples.push(elapsed);
+                }
+                samples.sort_unstable();
+                p50s.push(pct(&samples, 500));
+            }
+            p50s.sort_unstable();
+            profile::enable(true);
+            profile::reset();
+            for _ in 0..PROFILED_BLOCKS {
+                runtime.render(observation).expect("block");
+                observation += 1;
+            }
+            profile::enable(false);
+            let (nanos, blocks, _) = profile::snapshot();
+            let output = nanos[profile::OUTPUT] as f64 / blocks as f64;
+            line += &format!(
+                " f{flags} p50 {:.0} (output {:.0})",
+                cyc(p50s[1] as f64),
+                cyc(output)
+            );
+            graph::test_only_set_experiment(0);
+        }
+        line += " | ";
+    }
+    println!("RESULT {line}");
+}
