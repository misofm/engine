+#[inline(never)]
+fn sum_stream(buffer: &[f32]) -> f32 {
+    let mut acc = [Simd8::zero(); 8];
+    for chunk in buffer.chunks_exact(64) {
+        for (j, a) in acc.iter_mut().enumerate() {
+            *a = a.add(Simd8::load(&chunk[8 * j..]));
+        }
+    }
+    let mut out = [0.0_f32; 8];
+    let mut total = Simd8::zero();
+    for a in acc {
+        total = total.add(a);
+    }
+    total.store(&mut out);
+    out.iter().sum()
+}
+
+/// Throughput of a 1:1 `vmulps`:`vaddps` stream with 12 independent chains (6 of each).
+#[inline(never)]
+fn fp_mix(iterations: u64) -> f32 {
+    let m = Simd8::splat(black_box(1.000_000_1));
+    let d = Simd8::splat(black_box(1.0e-30));
+    let mut a = [Simd8::splat(black_box(1.0)); 12];
+    for _ in 0..iterations {
+        for pair in a.chunks_exact_mut(2) {
+            pair[0] = pair[0].mul(m);
+            pair[1] = pair[1].add(d);
+        }
+    }
+    let mut total = Simd8::zero();
+    for v in a {
+        total = total.add(v);
+    }
+    let mut out = [0.0_f32; 8];
+    total.store(&mut out);
+    out[0]
+}
+
+/// Throughput of `vaddps` alone, 12 chains.
+#[inline(never)]
+fn fp_add(iterations: u64) -> f32 {
+    let d = Simd8::splat(black_box(1.0e-30));
+    let mut a = [Simd8::splat(black_box(1.0)); 12];
+    for _ in 0..iterations {
+        for v in &mut a {
+            *v = v.add(d);
+        }
+    }
+    let mut total = Simd8::zero();
+    for v in a {
+        total = total.add(v);
+    }
+    let mut out = [0.0_f32; 8];
+    total.store(&mut out);
+    out[0]
+}
+
+#[test]
