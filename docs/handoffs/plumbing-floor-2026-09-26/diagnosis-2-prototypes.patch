+//! Plumbing-floor diagnosis 2 harness (docs/handoffs/plumbing-floor-2026-09-26/DIAGNOSIS-2.md).
+//!
+//! Throwaway measurement harness, ignored by default. Run pinned:
+//!
+//! ```text
+//! CARGO_INCREMENTAL=0 taskset -c 31 cargo test --release -p console-workload \
+//!     --test plumbing_diag2 -- --ignored --nocapture --test-threads 1
+//! ```
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use bench_support::digest::Sha256Sink;
+use console_workload::{PlanConfig, QUANTUM, SessionRuntime, Workload, source_block};
+use graph::test_only_phase_profile as profile;
+use lane::{Lane, Simd8};
+
+const WARMUP_BLOCKS: u64 = 512;
+const PROFILED_BLOCKS: u64 = 4000;
+const REPEATS: usize = 3;
+const TRACKS: usize = 64;
+const FADD_LATENCY_CYCLES: f64 = 3.0;
+
+fn core_hz() -> f64 {
+    const ADDS: u64 = 200_000_000;
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let mut x = black_box(0.0_f32);
+        let d = black_box(1.0e-3_f32);
+        let start = Instant::now();
+        for _ in 0..ADDS {
+            x += d;
+        }
+        let elapsed = start.elapsed().as_secs_f64();
+        black_box(x);
+        best = best.min(elapsed);
+    }
+    FADD_LATENCY_CYCLES * ADDS as f64 / best
+}
+
+fn probe_cost_ns() -> f64 {
+    let mut deltas: Vec<u64> = (0..20_000)
+        .map(|_| {
+            let a = Instant::now();
+            let b = Instant::now();
+            b.duration_since(a).as_nanos() as u64
+        })
+        .collect();
+    deltas.sort_unstable();
+    deltas[deltas.len() / 2] as f64
+}
+
+const PHASE_SHORT: [&str; profile::COUNT] = [
+    "enter", "source", "bound", "route", "output", "id-copy", "id-alias", "other(no-op)", "bank",
+    "exit",
+];
+
+fn pct(sorted: &[u64], per_mille: usize) -> u64 {
+    bench_support::stats::per_mille(sorted, per_mille)
+}
+
+#[test]
+#[ignore = "measurement harness"]
+fn rows() {
+    let hz = core_hz();
+    let probe_ns = probe_cost_ns();
+    println!("core clock {:.3} GHz; Instant pair {probe_ns:.1} ns", hz / 1e9);
+    let cyc = |ns: f64| ns * hz / 1e9;
+    for workload in [
+        Workload::SixtyFourTrackPlumbingOnly,
+        Workload::SixtyFourTrackPlumbingRing,
+    ] {
+        println!("=== {}", workload.kind());
+        let mut runtime = SessionRuntime::build(workload, PlanConfig::BASELINE);
+        println!("units {}", runtime.unit_eligibility().len());
+        let mut observation = 0_u64;
+        profile::enable(false);
+        for _ in 0..WARMUP_BLOCKS {
+            runtime.render(observation).expect("warmup");
+            observation += 1;
+        }
+        for repeat in 0..REPEATS {
+            // Tight loop, one Instant pair per block.
+            let mut samples = Vec::with_capacity(PROFILED_BLOCKS as usize);
+            for _ in 0..PROFILED_BLOCKS {
+                let start = Instant::now();
+                let result = runtime.render(observation);
+                let elapsed = start.elapsed().as_nanos() as u64;
+                result.expect("block");
+                observation += 1;
+                samples.push(elapsed);
+            }
+            samples.sort_unstable();
+            let p50 = pct(&samples, 500);
+            println!(
+                "r{repeat} tight:  min {} p50 {p50} p95 {} ns  = {:.0} cycles p50",
+                samples[0],
+                pct(&samples, 950),
+                cyc(p50 as f64)
+            );
+            // Bench-shaped loop: timing::timed + SHA-256 of the output between blocks.
+            let mut samples = Vec::with_capacity(1000);
+            let mut sink = Sha256Sink::new();
+            for _ in 0..1000 {
+                let (ns, result) =
+                    bench_support::timing::timed(|| runtime.render(observation));
+                result.expect("block");
+                runtime.hash_output(&mut sink);
+                observation += 1;
+                samples.push(ns);
+            }
+            black_box(sink.finish_hex());
+            samples.sort_unstable();
+            let p50 = pct(&samples, 500);
+            println!(
+                "r{repeat} bench:  min {} p50 {p50} p95 {} ns  = {:.0} cycles p50",
+                samples[0],
+                pct(&samples, 950),
+                cyc(p50 as f64)
+            );
+            // Probes on.
+            profile::enable(true);
+            profile::reset();
+            let start = Instant::now();
+            for _ in 0..PROFILED_BLOCKS {
+                runtime.render(observation).expect("block");
+                observation += 1;
+            }
+            let total = start.elapsed().as_nanos() as f64 / PROFILED_BLOCKS as f64;
+            profile::enable(false);
+            let (nanos, blocks, probes) = profile::snapshot();
+            if repeat == 0 {
+                let runs: Vec<String> = profile::runs()
+                    .iter()
+                    .filter(|(k, u)| *k < profile::COUNT && *u > 0)
+                    .map(|(k, u)| format!("{u} x {}", PHASE_SHORT[*k]))
+                    .collect();
+                println!("runs: {}", runs.join(", "));
+            }
+            let mut line = format!(
+                "r{repeat} probes: mean {total:.0} ns, {:.1} probes/block;",
+                probes as f64 / blocks as f64
+            );
+            for (index, name) in PHASE_SHORT.iter().enumerate() {
+                let ns = nanos[index] as f64 / blocks as f64;
+                if ns > 0.0 {
+                    line += &format!(" {name} {ns:.1} ns ({:.0} cyc)", cyc(ns));
+                }
+            }
+            println!("{line}");
+        }
+    }
+}
+
+/// Throwaway in-engine experiments (flags in `graph::test_only_set_experiment`): bit 0 skips the
+/// inert source-input units, bit 1 resolves every Output input once before the pair loop, bit 2
+/// swaps the pair kernel for the frame-tiled T=4 kernel, bit 3 for T=2.
+#[test]
+#[ignore = "measurement harness"]
+fn experiments() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz", hz / 1e9);
+    let cyc = |ns: f64| ns * hz / 1e9;
+    for workload in [
+        Workload::SixtyFourTrackPlumbingOnly,
+        Workload::SixtyFourTrackPlumbingRing,
+    ] {
+        println!("=== {}", workload.kind());
+        let digest_of = |flags: u32| {
+            graph::test_only_set_experiment(flags);
+            let mut runtime = SessionRuntime::build(workload, PlanConfig::BASELINE);
+            let mut sink = Sha256Sink::new();
+            for block in 0..64 {
+                runtime.render(block).expect("block");
+                runtime.hash_output(&mut sink);
+            }
+            graph::test_only_set_experiment(0);
+            sink.finish_hex()
+        };
+        let base = digest_of(0);
+        const FLAGS: [u32; 8] = [0, 512, 512 | 1024, 512 | 1024 | 2048, 4096, 4096 | 1024, 8192, 512 | 1024 | 2048 | 16];
+        for flags in FLAGS {
+            assert_eq!(digest_of(flags), base, "flags {flags} moved a bit");
+        }
+        // Several runtimes alive at once, so each sits at different addresses; flags are read per
+        // block, so every flag is measured on the same runtime (same addresses).
+        let mut runtimes: Vec<SessionRuntime> = (0..4)
+            .map(|_| SessionRuntime::build(workload, PlanConfig::BASELINE))
+            .collect();
+        let mut observation = 0_u64;
+        for (index, runtime) in runtimes.iter_mut().enumerate() {
+            let mut line = format!(
+                "runtime {index} (output mod 64 = {}):",
+                runtime.diag_output_address() % 64
+            );
+            let mut phases = String::new();
+            for flags in FLAGS {
+                graph::test_only_set_experiment(flags);
+                for _ in 0..256 {
+                    runtime.render(observation).expect("warmup");
+                    observation += 1;
+                }
+                let mut samples = Vec::with_capacity(PROFILED_BLOCKS as usize);
+                for _ in 0..PROFILED_BLOCKS {
+                    let start = Instant::now();
+                    let result = runtime.render(observation);
+                    let elapsed = start.elapsed().as_nanos() as u64;
+                    result.expect("block");
+                    observation += 1;
+                    samples.push(elapsed);
+                }
+                samples.sort_unstable();
+                line += &format!(" f{flags}={:.0}", cyc(pct(&samples, 500) as f64));
+                if index == 0 {
+                    profile::enable(true);
+                    profile::reset();
+                    for _ in 0..PROFILED_BLOCKS {
+                        runtime.render(observation).expect("block");
+                        observation += 1;
+                    }
+                    profile::enable(false);
+                    let (nanos, blocks, _) = profile::snapshot();
+                    phases += &format!("\n    f{flags}:");
+                    for (kind, name) in PHASE_SHORT.iter().enumerate() {
+                        let ns = nanos[kind] as f64 / blocks as f64;
+                        if ns > 0.0 {
+                            phases += &format!(" {name} {:.0}", cyc(ns));
+                        }
+                    }
+                }
+                graph::test_only_set_experiment(0);
+            }
+            println!("{line} (p50 cycles){phases}");
+        }
+    }
+}
