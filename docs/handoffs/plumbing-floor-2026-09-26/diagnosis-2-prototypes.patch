+/// 4K-aliasing probe: the same kernels with the two output planes placed at a controlled offset,
+/// modulo 4 KiB, from the input block.
+#[test]
+#[ignore = "measurement harness"]
+fn aliasing() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz", hz / 1e9);
+    let sources = sources();
+    let coefficients = coefficients();
+    let inputs: Vec<&Planes> = sources.iter().collect();
+    let (rl, rr) = reference(&inputs, &coefficients);
+    let base = sources.as_ptr() as usize;
+    println!("input block at {:#x} (mod 4096 = {})", base, base % 4096);
+    let mut arena = vec![0.0_f32; 4 * 4096];
+    for delta in [0usize, 32, 64, 96, 128, 192, 256, 384, 512, 768, 1024, 1536, 2048, 3072, 3584, 4000] {
+        let arena_base = arena.as_ptr() as usize;
+        let want = (base + delta) % 4096;
+        let offset_bytes = (want + 4096 - arena_base % 4096) % 4096;
+        let start = offset_bytes / 4;
+        let (head, tail) = arena[start..].split_at_mut(QUANTUM);
+        let left: &mut [f32; QUANTUM] = head.try_into().unwrap();
+        let right: &mut [f32; QUANTUM] = (&mut tail[..QUANTUM]).try_into().unwrap();
+        pairs(&inputs, &coefficients, left, right);
+        assert!(same(left, &rl) && same(right, &rr));
+        let p = time_min(30, 200, || pairs(black_box(&inputs), &coefficients, left, right));
+        let t = time_min(30, 200, || {
+            tiled_broadcast::<4>(black_box(&inputs), &coefficients, left, right)
+        });
+        println!(
+            "  output at input+{delta:>4} mod 4096: pairs {:>6.0} cycles  tiled4-broadcast {:>6.0} cycles",
+            p * hz / 1e9,
+            t * hz / 1e9
+        );
+    }
+}
