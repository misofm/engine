+// ---------------------------------------------------------------------------------------------
+// Kernel candidates over the ring row's layout.
+// ---------------------------------------------------------------------------------------------
+
+type Planes = ([f32; QUANTUM], [f32; QUANTUM]);
+
+fn coefficients() -> Vec<[f32; 4]> {
+    let unit = |seed: u32| -> f32 {
+        let hashed = seed.wrapping_mul(2_654_435_761).rotate_left(13) ^ 0x9E37_79B9;
+        (hashed >> 8) as f32 / (1u32 << 24) as f32
+    };
+    (0..TRACKS)
+        .map(|track| {
+            let t = track as u32;
+            [
+                0.5 + 0.4 * unit(4 * t),
+                0.2 * unit(4 * t + 1) - 0.1,
+                0.2 * unit(4 * t + 2) - 0.1,
+                0.5 + 0.4 * unit(4 * t + 3),
+            ]
+        })
+        .collect()
+}
+
+fn sources() -> Box<[Planes]> {
+    (0..TRACKS)
+        .map(|track| {
+            let block = source_block(track, false);
+            let mut left = [0.0; QUANTUM];
+            let mut right = [0.0; QUANTUM];
+            left.copy_from_slice(&block[..QUANTUM]);
+            right.copy_from_slice(&block[QUANTUM..]);
+            (left, right)
+        })
+        .collect()
+}
+
+/// Reference: `mix2x2_block` then left-to-right sum, scalar.
+fn reference(inputs: &[&Planes], coefficients: &[[f32; 4]]) -> ([f32; QUANTUM], [f32; QUANTUM]) {
+    let mut left = [0.0_f32; QUANTUM];
+    let mut right = [0.0_f32; QUANTUM];
+    for frame in 0..QUANTUM {
+        for (index, (planes, c)) in inputs.iter().zip(coefficients).enumerate() {
+            let (l, r) = (planes.0[frame], planes.1[frame]);
+            let [ll, lr, rl, rr] = *c;
+            let ml = lr * r + ll * l;
+            let mr = rr * r + rl * l;
+            if index == 0 {
+                left[frame] = ml;
+                right[frame] = mr;
+            } else {
+                left[frame] += ml;
+                right[frame] += mr;
+            }
+        }
+    }
+    (left, right)
+}
+
+#[inline(always)]
+fn mix(c: &[Simd8; 4], l: Simd8, r: Simd8) -> (Simd8, Simd8) {
+    let [ll, lr, rl, rr] = *c;
+    (lr.fma(r, ll.mul(l)), rr.fma(r, rl.mul(l)))
+}
+
+/// Today's shape: pairs, hoisted splats, running sum stored and reloaded per pair.
+#[inline(never)]
+fn pairs(inputs: &[&Planes], coefficients: &[[f32; 4]], left: &mut [f32; QUANTUM], right: &mut [f32; QUANTUM]) {
+    for (pair, (group, table)) in inputs.chunks_exact(2).zip(coefficients.chunks_exact(2)).enumerate() {
+        let c0 = table[0].map(Simd8::splat);
+        let c1 = table[1].map(Simd8::splat);
+        let (a, b) = (group[0], group[1]);
+        for k in 0..QUANTUM / 8 {
+            let at = 8 * k;
+            let (m0l, m0r) = mix(&c0, Simd8::load(&a.0[at..]), Simd8::load(&a.1[at..]));
+            let (m1l, m1r) = mix(&c1, Simd8::load(&b.0[at..]), Simd8::load(&b.1[at..]));
+            let (sl, sr) = if pair == 0 {
+                (m0l, m0r)
+            } else {
+                (Simd8::load(&left[at..]).add(m0l), Simd8::load(&right[at..]).add(m0r))
+            };
+            sl.add(m1l).store(&mut left[at..]);
+            sr.add(m1r).store(&mut right[at..]);
+        }
+    }
+}
+
+/// Frame-tiled: `T` chunks of both planes held in registers across every input; the first input
+/// stores its mix as the value, every later one adds, in edge order. No master re-pass.
+/// Coefficients are pre-splatted in memory (one `[Simd8; 4]` per input).
+#[inline(never)]
+fn tiled<const T: usize>(
+    inputs: &[&Planes],
+    splats: &[[Simd8; 4]],
+    left: &mut [f32; QUANTUM],
+    right: &mut [f32; QUANTUM],
+) {
+    for tile in 0..QUANTUM / (8 * T) {
+        let base = tile * 8 * T;
+        let mut acc_l = [Simd8::zero(); T];
+        let mut acc_r = [Simd8::zero(); T];
+        let first = inputs[0];
+        for k in 0..T {
+            let at = base + 8 * k;
+            let (ml, mr) = mix(&splats[0], Simd8::load(&first.0[at..]), Simd8::load(&first.1[at..]));
+            acc_l[k] = ml;
+            acc_r[k] = mr;
+        }
+        for (planes, c) in inputs[1..].iter().zip(&splats[1..]) {
+            for k in 0..T {
+                let at = base + 8 * k;
+                let (ml, mr) = mix(c, Simd8::load(&planes.0[at..]), Simd8::load(&planes.1[at..]));
+                acc_l[k] = acc_l[k].add(ml);
+                acc_r[k] = acc_r[k].add(mr);
+            }
+        }
+        for k in 0..T {
+            let at = base + 8 * k;
+            acc_l[k].store(&mut left[at..]);
+            acc_r[k].store(&mut right[at..]);
+        }
+    }
+}
+
+/// Frame-tiled with the coefficients broadcast from the `[f32; 4]` table per input per tile.
+#[inline(never)]
+fn tiled_broadcast<const T: usize>(
+    inputs: &[&Planes],
+    coefficients: &[[f32; 4]],
+    left: &mut [f32; QUANTUM],
+    right: &mut [f32; QUANTUM],
+) {
+    for tile in 0..QUANTUM / (8 * T) {
+        let base = tile * 8 * T;
+        let mut acc_l = [Simd8::zero(); T];
+        let mut acc_r = [Simd8::zero(); T];
+        let first = inputs[0];
+        let c = coefficients[0].map(Simd8::splat);
+        for k in 0..T {
+            let at = base + 8 * k;
+            let (ml, mr) = mix(&c, Simd8::load(&first.0[at..]), Simd8::load(&first.1[at..]));
+            acc_l[k] = ml;
+            acc_r[k] = mr;
+        }
+        for (planes, c) in inputs[1..].iter().zip(&coefficients[1..]) {
+            let c = c.map(Simd8::splat);
+            for k in 0..T {
+                let at = base + 8 * k;
+                let (ml, mr) = mix(&c, Simd8::load(&planes.0[at..]), Simd8::load(&planes.1[at..]));
+                acc_l[k] = acc_l[k].add(ml);
+                acc_r[k] = acc_r[k].add(mr);
+            }
+        }
+        for k in 0..T {
+            let at = base + 8 * k;
+            acc_l[k].store(&mut left[at..]);
+            acc_r[k].store(&mut right[at..]);
+        }
+    }
+}
+
+fn same(a: &[f32; QUANTUM], b: &[f32; QUANTUM]) -> bool {
+    a.iter().zip(b).all(|(x, y)| x.to_bits() == y.to_bits())
+}
+
+#[test]
+#[ignore = "measurement harness"]
+fn kernels() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz", hz / 1e9);
+    let sources = sources();
+    let coefficients = coefficients();
+    let splats: Vec<[Simd8; 4]> = coefficients.iter().map(|c| c.map(Simd8::splat)).collect();
+    let l2_inputs: Vec<&Planes> = sources.iter().collect();
+    // L1-resident arm: 16 distinct tracks (16 KiB) read four times; same arithmetic.
+    let l1_inputs: Vec<&Planes> = (0..TRACKS).map(|t| &sources[t % 16]).collect();
+    let mut left = [0.0_f32; QUANTUM];
+    let mut right = [0.0_f32; QUANTUM];
+    for (name, inputs) in [("L2 (64 distinct)", &l2_inputs), ("L1 (16 distinct)", &l1_inputs)] {
+        let (rl, rr) = reference(inputs, &coefficients);
+        pairs(inputs, &coefficients, &mut left, &mut right);
+        assert!(same(&left, &rl) && same(&right, &rr), "pairs bits");
+        tiled::<1>(inputs, &splats, &mut left, &mut right);
+        assert!(same(&left, &rl) && same(&right, &rr), "tiled1 bits");
+        tiled::<2>(inputs, &splats, &mut left, &mut right);
+        assert!(same(&left, &rl) && same(&right, &rr), "tiled2 bits");
+        tiled::<4>(inputs, &splats, &mut left, &mut right);
+        assert!(same(&left, &rl) && same(&right, &rr), "tiled4 bits");
+        tiled_broadcast::<2>(inputs, &coefficients, &mut left, &mut right);
+        assert!(same(&left, &rl) && same(&right, &rr), "tiled_broadcast2 bits");
+        tiled_broadcast::<4>(inputs, &coefficients, &mut left, &mut right);
+        assert!(same(&left, &rl) && same(&right, &rr), "tiled_broadcast4 bits");
+        println!("{name}: every candidate bit-identical to the scalar mix-then-sum reference");
+    }
+    for repeat in 0..REPEATS {
+        println!("repeat {repeat}");
+        for (name, inputs) in [("L2", &l2_inputs), ("L1", &l1_inputs)] {
+            let report = |kernel: &str, ns: f64| {
+                println!("  {name} {kernel:<24} {ns:>8.1} ns {:>7.0} cycles", ns * hz / 1e9);
+            };
+            report(
+                "pairs (today)",
+                time_min(30, 200, || pairs(black_box(inputs), &coefficients, &mut left, &mut right)),
+            );
+            report(
+                "tiled T=1 splat-table",
+                time_min(30, 200, || tiled::<1>(black_box(inputs), &splats, &mut left, &mut right)),
+            );
+            report(
+                "tiled T=2 splat-table",
+                time_min(30, 200, || tiled::<2>(black_box(inputs), &splats, &mut left, &mut right)),
