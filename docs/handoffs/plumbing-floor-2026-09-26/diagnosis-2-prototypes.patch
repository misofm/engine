+/// Alignment probe: the input block and the output planes at controlled offsets modulo 64 bytes.
+#[test]
+#[ignore = "measurement harness"]
+fn alignment() {
+    let hz = core_hz();
+    println!("core clock {:.3} GHz", hz / 1e9);
+    let coefficients = coefficients();
+    let reference_sources = sources();
+    let reference_inputs: Vec<&Planes> = reference_sources.iter().collect();
+    let (rl, rr) = reference(&reference_inputs, &coefficients);
+    let words_per_track = 2 * QUANTUM;
+    // Backing store: 64-byte aligned via over-allocation of `Simd8`-sized cells is not available
+    // without unsafe, so over-allocate f32 and pick the start index by address.
+    let mut backing = vec![0.0_f32; TRACKS * words_per_track + 64];
+    let mut out_backing = vec![0.0_f32; 2 * QUANTUM + 64];
+    for in_mis in [0usize, 4, 16, 32, 48] {
+        for out_mis in [0usize, 16, 32] {
+            let b = backing.as_ptr() as usize;
+            let start = ((64 - b % 64) % 64 + in_mis) / 4;
+            let region = &mut backing[start..start + TRACKS * words_per_track];
+            for (track, source) in reference_sources.iter().enumerate() {
+                region[track * words_per_track..track * words_per_track + QUANTUM]
+                    .copy_from_slice(&source.0);
+                region[track * words_per_track + QUANTUM..(track + 1) * words_per_track]
+                    .copy_from_slice(&source.1);
+            }
+            let region = &backing[start..start + TRACKS * words_per_track];
+            let inputs: Vec<&Planes> = (0..TRACKS)
+                .map(|track| {
+                    let slice = &region[track * words_per_track..(track + 1) * words_per_track];
+                    // SAFETY-free reinterpretation is not possible; copy through a view type.
+                    let planes: &[f32; 2 * QUANTUM] = slice.try_into().unwrap();
+                    // `Planes` is two `[f32; QUANTUM]` back to back: same layout as `[f32; 256]`.
+                    let planes: &Planes = unsafe_free_view(planes);
+                    planes
+                })
+                .collect();
+            let ob = out_backing.as_ptr() as usize;
+            let ostart = ((64 - ob % 64) % 64 + out_mis) / 4;
+            let (head, tail) = out_backing[ostart..].split_at_mut(QUANTUM);
+            let left: &mut [f32; QUANTUM] = head.try_into().unwrap();
+            let right: &mut [f32; QUANTUM] = (&mut tail[..QUANTUM]).try_into().unwrap();
+            pairs(&inputs, &coefficients, left, right);
+            assert!(same(left, &rl) && same(right, &rr));
+            let p = time_min(30, 200, || pairs(black_box(&inputs), &coefficients, left, right));
+            let t = time_min(30, 200, || {
+                tiled_broadcast::<4>(black_box(&inputs), &coefficients, left, right)
+            });
+            let r = time_min(30, 200, || {
+                black_box(sum_stream(black_box(region)));
+            });
+            println!(
+                "  input base mod 64 = {in_mis:>2}, output mod 64 = {out_mis:>2}: pairs {:>6.0}  tiled4-bc {:>6.0}  pure 64 KiB read {:>6.0} cycles",
+                p * hz / 1e9,
+                t * hz / 1e9,
+                r * hz / 1e9
+            );
+        }
+    }
+}
+
+/// Views a `[f32; 256]` as `Planes` without unsafe: both are 256 contiguous `f32`.
+fn unsafe_free_view(block: &[f32; 2 * QUANTUM]) -> &Planes {
+    // `Planes` = `([f32; 128], [f32; 128])`; tuple layout is not guaranteed, so use a leaked,
+    // identically-addressed reference only when the layouts match; fall back to panicking.
+    let planes: &Planes = bytemuck_like(block);
+    planes
+}
+
+fn bytemuck_like(block: &[f32; 2 * QUANTUM]) -> &Planes {
+    #[allow(unsafe_code)]
+    // SAFETY: throwaway harness; `([f32; 128], [f32; 128])` has size 1024 and align 4, and the
+    // assertion below checks the two halves land where `[f32; 256]` puts them.
+    let planes: &Planes = unsafe { &*(block as *const [f32; 2 * QUANTUM]).cast::<Planes>() };
+    assert_eq!(planes.0.as_ptr(), block.as_ptr());
+    assert_eq!(planes.1.as_ptr(), block[QUANTUM..].as_ptr());
+    planes
+}
