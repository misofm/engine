+//! Issue #966 scratch: every console row's digest, census and bank shape, at every width.
+
+use bench_support::digest::Sha256Sink;
+use console_workload::{ObservationArm, PlanConfig, SessionRuntime, native_session_rows};
+use lane::Backend;
+
+#[test]
+fn zz_probe_966_console_fingerprints() {
+    let out = std::env::var("PROBE_966_OUT").unwrap_or_else(|_| "/dev/null".to_owned());
+    let mut lines = String::new();
+    for workload in native_session_rows() {
+        for dispatch in [Backend::Scalar, Backend::Simd4, Backend::Simd8] {
+            for config in [
+                PlanConfig::BASELINE,
+                PlanConfig {
+                    meters: true,
+                    control: true,
+                    observation: ObservationArm::Armed,
+                },
+            ] {
+                if workload.kind() == "sixty_four_track_console_metered"
+                    && config != PlanConfig::BASELINE
+                {
+                    continue;
+                }
+                let mut runtime = SessionRuntime::build_with_dispatch(workload, config, dispatch);
+                let mut digest = Sha256Sink::new();
+                for block in 0..24 {
+                    runtime.render(block).expect("console render");
+                    runtime.hash_output(&mut digest);
+                }
+                let meters = runtime.drain_meters();
+                lines.push_str(&format!(
+                    "{} {dispatch:?} meters={} control={} digest={} shape={:?} transposes={} \
+                     folds={} redirects={} symmetry={:?} bank_symmetry={:?} collapse={:?} \
+                     meters_drained={meters} units={:?}\n",
+                    workload.kind(),
+                    config.meters,
+                    config.control,
+                    digest.finish_hex(),
+                    runtime.bank_shape(),
+                    runtime.bank_transposes(),
+                    runtime.bank_route_folds(),
+                    runtime.bank_scatter_redirects(),
+                    runtime.symmetry_counters(),
+                    runtime.bank_symmetry_counters(),
+                    runtime.bank_collapse_counters(),
+                    runtime.unit_eligibility(),
+                ));
+            }
+        }
+    }
+    std::fs::write(out, lines).expect("write probe output");
+}
