+//! Issue #966 scratch host: run the probe guest under the pinned wasmtime.
+#![allow(missing_docs)]
+
+use wasmtime::{Config, Engine, Instance, Module, Store};
+
+#[test]
+fn zz_probe_966_wasm() {
+    let Ok(path) = std::env::var("ZZ966_GUEST") else {
+        return;
+    };
+    let start: u32 = std::env::var("ZZ966_START").map_or(0, |v| v.parse().unwrap());
+    let count: u32 = std::env::var("ZZ966_COUNT").map_or(100, |v| v.parse().unwrap());
+    let blocks: u32 = std::env::var("ZZ966_BLOCKS").map_or(2, |v| v.parse().unwrap());
+    let mut config = Config::new();
+    config.wasm_simd(true);
+    config.wasm_relaxed_simd(false);
+    let engine = Engine::new(&config).unwrap();
+    let module = Module::from_file(&engine, &path).unwrap();
+    let mut store = Store::new(&engine, ());
+    let instance = Instance::new(&mut store, &module, &[]).unwrap();
+    let backend = instance
+        .get_typed_func::<(), u32>(&mut store, "zz_backend")
+        .unwrap();
+    let stat = instance
+        .get_typed_func::<u32, u32>(&mut store, "zz_stat")
+        .unwrap();
+    let repro = instance
+        .get_typed_func::<u32, u32>(&mut store, "zz_repro")
+        .unwrap();
+    let probe = instance
+        .get_typed_func::<(u32, u32, u32), u32>(&mut store, "zz_probe")
+        .unwrap();
+    println!("guest {path}: backend lanes {}", backend.call(&mut store, ()).unwrap());
+    let names = [
+        "lines",
+        "bind refused",
+        "misaligned lines",
+        "cross-level bound",
+        "pcm moved vs scalar",
+        "compile refused",
+        "lines with effect banks",
+        "effect banks",
+    ];
+    for which in 0..3 {
+        let refused = repro.call(&mut store, which).unwrap();
+        let stats: Vec<String> = (0..8)
+            .map(|i| format!("{}={}", names[i], stat.call(&mut store, i as u32).unwrap()))
+            .collect();
+        println!("repro {which}: refused {refused}; {}", stats.join(", "));
+    }
+    let refused = probe.call(&mut store, (start, count, blocks)).unwrap();
+    let stats: Vec<String> = (0..8)
+        .map(|i| format!("{}={}", names[i], stat.call(&mut store, i as u32).unwrap()))
+        .collect();
+    println!(
+        "probe seeds {start}..{}: refused {refused}; {}",
+        start + count,
+        stats.join(", ")
+    );
+}
