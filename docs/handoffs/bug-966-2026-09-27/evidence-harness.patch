+#[test]
+fn probe() {
+    let start = env_u64("PROBE_START", 0);
+    let count = env_u64("PROBE_COUNT", 50);
+    let blocks = env_u64("PROBE_BLOCKS", 0);
+    let verbose = env_u64("PROBE_VERBOSE", 0) == 1;
+    let mut compile_fail: BTreeMap<String, u64> = BTreeMap::new();
+    let mut bind_fail: BTreeMap<(String, String), u64> = BTreeMap::new();
+    let mut xplanned = [0_u64; 3];
+    let mut xbound = [0_u64; 3];
+    let mut failing_seeds: BTreeMap<String, Vec<u64>> = BTreeMap::new();
+    let mut total = 0;
+    let mut pcm_mismatch = 0;
+    let mut banked_lines = 0;
+    let mut unbound_lanes = [0_usize; 3];
+    let mut lines = String::new();
+    let mut by_meta: BTreeMap<String, [u64; 3]> = BTreeMap::new();
+    for seed in start..start + count {
+        let (model, meta) = generate_with_meta(seed);
+        let mut seed_failed = false;
+        let mut seed_would_fail = false;
+        let mut scalar_pcm = None;
+        for (w, dispatch) in [Backend::Scalar, Backend::Simd4, Backend::Simd8]
+            .into_iter()
+            .enumerate()
+        {
+            total += 1;
+            let o = run(&model, dispatch, blocks, verbose);
+            lines.push_str(&format!(
+                "{seed} {dispatch:?} compile={:?} bind={:?} {}\n",
+                o.compile, o.bind, o.fingerprint
+            ));
+            unbound_lanes[w] += o.unbound_all_lane_slots;
+            if let Some(c) = &o.compile {
+                let key = c.chars().take(120).collect::<String>();
+                *compile_fail.entry(key).or_default() += 1;
+                continue;
+            }
+            if o.effect_banks > 0 {
+                banked_lines += 1;
+            }
+            if o.cross_level_planned > 0 {
+                xplanned[w] += 1;
+                seed_would_fail = true;
+            }
+            if o.bind.is_some() {
+                seed_failed = true;
+            }
+            if o.cross_level_bound > 0 {
+                xbound[w] += 1;
+            }
+            if let Some(b) = &o.bind {
+                *bind_fail
+                    .entry((format!("{dispatch:?}"), b.clone()))
+                    .or_default() += 1;
+                failing_seeds
+                    .entry(format!("{dispatch:?}"))
+                    .or_default()
+                    .push(seed);
+                continue;
+            }
+            if dispatch == Backend::Scalar {
+                scalar_pcm = o.pcm.clone();
+            } else if let (Some(a), Some(b)) = (&scalar_pcm, &o.pcm) {
+                if a != b {
+                    pcm_mismatch += 1;
+                    eprintln!("seed {seed} {dispatch:?}: PCM differs from scalar");
+                }
+            }
+        }
+        let entry = by_meta.entry(meta).or_default();
+        entry[0] += 1;
+        entry[1] += u64::from(seed_failed);
+        entry[2] += u64::from(seed_would_fail);
+    }
+    eprintln!("[seeds, seeds refused on this host, seeds with a cross-level full-group slot] by shape: {by_meta:#?}");
+    eprintln!("seeds {start}..{}: {total} compile+bind lines", start + count);
+    eprintln!("lines with effect banks: {banked_lines}");
+    eprintln!("compile rejections: {compile_fail:#?}");
+    eprintln!("bind refusals: {bind_fail:?}");
+    eprintln!("lines with a cross-level bound bank [scalar, simd4, simd8]: {xbound:?}");
+    eprintln!("lines with a cross-level planned full-group slot [scalar, simd4, simd8]: {xplanned:?}");
+    eprintln!("PCM mismatches vs scalar dispatch: {pcm_mismatch}");
+    eprintln!("lanes of unbound all-lanes slots in full groups [scalar, simd4, simd8]: {unbound_lanes:?}");
+    if let Ok(path) = std::env::var("PROBE_OUT") {
+        std::fs::write(path, lines).expect("write probe lines");
+    }
+    for (k, v) in &failing_seeds {
+        eprintln!("failing seeds {k}: {:?}", &v[..v.len().min(40)]);
+    }
+}
+
+#[test]
+fn experiment_relaxed_render() {
+    let mut model = parse_session_json(INTENDED).expect("fixture");
+    model.tracks[0].simd1.effects.remove(0);
+    let scalar = run(&model, Backend::Scalar, 12, false);
+    let banked = run(&model, Backend::Simd8, 12, true);
+    eprintln!("banked compile {:?} bind {:?}", banked.compile, banked.bind);
+    if let (Some(a), Some(b)) = (&scalar.pcm, &banked.pcm) {
+        let diffs = a.iter().zip(b).filter(|(x, y)| x != y).count();
+        let first = a.iter().zip(b).position(|(x, y)| x != y);
+        eprintln!("relaxed render: {diffs} of {} output samples differ from scalar; first at {first:?}", a.len());
+    }
+}
