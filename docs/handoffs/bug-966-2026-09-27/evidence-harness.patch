+//! Issue #966 scratch experiment: what a relaxed layout check would bind, and what it renders.
+#![allow(missing_docs)]
+
+#[path = "bank_levels.rs"]
+#[allow(dead_code, unreachable_pub)]
+mod probe;
+
+use graph_compiler::Backend;
+
+#[test]
+fn zz_relaxed_layout_check() {
+    let mode = std::env::var("X966_RELAX").unwrap_or_default();
+    for track in [0_usize, 63] {
+        let mut model = probe::sixty_four_track_console_less_one_eq();
+        if track == 63 {
+            // Put ch00's EQ back and remove ch63's instead.
+            model = session::parse_session_json(include_str!(
+                "../../../fixtures/session/v1/console-sixty-four-track-intended.json"
+            ))
+            .expect("fixture");
+            model.tracks[63].simd1.effects.remove(0);
+        }
+        let scalar = probe::compile_bind_render(&model, Backend::Scalar, 12);
+        let banked = probe::compile_bind_render(&model, Backend::Simd8, 12);
+        let differing = match (&scalar.pcm, &banked.pcm) {
+            (Some(a), Some(b)) => a.iter().zip(b).filter(|(x, y)| x != y).count(),
+            _ => usize::MAX,
+        };
+        println!(
+            "ZZ relax={mode:?} ragged=ch{track:02}: bind {:?}, cross-level banks {}, output samples \
+             differing from scalar {} of {}",
+            banked.bind,
+            banked.cross_level_banks,
+            if differing == usize::MAX { "n/a".to_owned() } else { differing.to_string() },
+            scalar.pcm.as_ref().map_or(0, Vec::len)
+        );
+    }
+}
