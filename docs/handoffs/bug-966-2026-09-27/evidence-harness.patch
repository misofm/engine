+//! Issue #966 scratch: the committed probe, run inside `wasm32-unknown-unknown` + `simd128`, where
+//! `Backend::current()` is `Simd4` and every launch effect's factory binds four-lane banks.
+#![allow(unsafe_code, dead_code, unused, missing_docs, unreachable_pub)]
+
+#[path = "../../../crates/graph-compiler/tests/bank_levels.rs"]
+mod probe;
+
+use lane::Backend;
+use std::sync::Mutex;
+
+/// [lines, refused, misaligned lines, cross-level bound, pcm moved, compile refused, banked lines]
+static STATS: Mutex<[u32; 8]> = Mutex::new([0; 8]);
+
+#[unsafe(no_mangle)]
+pub extern "C" fn zz_backend() -> u32 {
+    match Backend::current() {
+        Backend::Scalar => 1,
+        Backend::Simd4 => 4,
+        Backend::Simd8 => 8,
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn zz_stat(index: u32) -> u32 {
+    STATS.lock().unwrap()[index as usize]
+}
+
+fn account(model: &session::SessionModel, blocks: u64, stats: &mut [u32; 8]) {
+    let scalar = probe::compile_bind_render(model, Backend::Scalar, blocks);
+    let simd4 = probe::compile_bind_render(model, Backend::Simd4, blocks);
+    stats[0] += 1;
+    if simd4.compile.is_some() || scalar.compile.is_some() {
+        stats[5] += 1;
+        return;
+    }
+    if simd4.bind.is_some() {
+        stats[1] += 1;
+    }
+    if simd4.misaligned_slots > 0 {
+        stats[2] += 1;
+    }
+    if simd4.cross_level_banks > 0 {
+        stats[3] += 1;
+    }
+    if simd4.bind.is_none() && scalar.pcm != simd4.pcm {
+        stats[4] += 1;
+    }
+    if simd4.effect_banks > 0 {
+        stats[6] += 1;
+    }
+    stats[7] += simd4.effect_banks as u32;
+}
+
+/// Seeds `start..start + count` at `Simd4` against `Scalar`. Returns the bind refusals.
+#[unsafe(no_mangle)]
+pub extern "C" fn zz_probe(start: u32, count: u32, blocks: u32) -> u32 {
+    let mut stats = [0; 8];
+    for seed in start..start + count {
+        let (model, _) = probe::generate(u64::from(seed));
+        account(&model, u64::from(blocks), &mut stats);
+    }
+    *STATS.lock().unwrap() = stats;
+    stats[1]
+}
+
+/// Reproducer `which` (0: 64-track console less one EQ, 1: ragged soft-clip) at `Simd4`.
+#[unsafe(no_mangle)]
+pub extern "C" fn zz_repro(which: u32) -> u32 {
+    let model = match which {
+        0 => probe::sixty_four_track_console_less_one_eq(),
+        2 => probe::sixty_four_track_console_less_nine_eqs(),
+        _ => probe::ragged_dynamic_soft_clip(),
+    };
+    let mut stats = [0; 8];
+    account(&model, 8, &mut stats);
+    *STATS.lock().unwrap() = stats;
+    stats[1]
+}
