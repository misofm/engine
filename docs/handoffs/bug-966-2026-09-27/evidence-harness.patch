+#[test]
+fn repro_sixty_four_minus_one_eq() {
+    let mut model = parse_session_json(INTENDED).expect("fixture");
+    model.tracks[0].simd1.effects.remove(0);
+    for dispatch in [Backend::Scalar, Backend::Simd4, Backend::Simd8] {
+        let o = run(&model, dispatch, 0, true);
+        eprintln!(
+            "{dispatch:?}: compile {:?} bind {:?} banks {} xbound {} xplanned {}",
+            o.compile, o.bind, o.effect_banks, o.cross_level_bound, o.cross_level_planned
+        );
+    }
+}
