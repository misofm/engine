+//! Issue #966 scratch reproducer and randomized compile-then-bind probe.
+
+use builtins_compiler::{BuiltinCompileCaps, prepare_session_builtins};
+use effect_compiler::{
+    EffectCompileCaps, launch_native_effect_registry, prepare_native_session_effects,
+};
+use engine::realtime::{PlanarBufferMut, RenderIo, RenderTime};
+use graph::{
+    GraphBindingBlock, GraphCompileCaps, GraphNodeBinding, GraphNodeId, GraphRuntimeBindings,
+    GraphRuntimeProcessor, TrackStage,
+};
+use graph_compiler::{Backend, GraphBuiltinsCompileRequest, GraphCompiler};
+use session::{
+    ChannelMatrix, CompileCaps, Effect, EffectIdentity, EffectQuality, LinkMode, Route,
+    RouteDestination, RouteSource, SendTap, Sidechain, SidechainDeclaration, SessionModel,
+    StableId, Submix, compile_session, parse_session_json,
+};
+use std::collections::BTreeMap;
+
+const INTENDED: &str =
+    include_str!("../../../fixtures/session/v1/console-sixty-four-track-intended.json");
+
+fn graph_caps() -> GraphCompileCaps {
+    GraphCompileCaps {
+        maximum_nodes: u64::MAX,
+        maximum_edges: u64::MAX,
+        maximum_schedule_items: u64::MAX,
+        maximum_dependency_levels: u64::MAX,
+        maximum_audio_buffer_samples: u64::MAX,
+        maximum_delay_samples_per_edge: u64::MAX,
+        maximum_total_delay_samples: u64::MAX,
+        maximum_graph_bytes: u64::MAX,
+        maximum_plan_bytes: u64::MAX,
+        maximum_single_allocation_bytes: u64::MAX,
+        maximum_finite_tail_samples: u64::MAX,
+    }
+}
+
+fn builtin_caps() -> BuiltinCompileCaps {
+    BuiltinCompileCaps {
+        maximum_total_state_bytes: u64::MAX,
+        maximum_total_retained_payload_bytes: u64::MAX,
+        maximum_total_meter_items: u64::MAX,
+        maximum_total_meter_bytes: u64::MAX,
+        maximum_single_allocation_bytes: u64::MAX,
+        maximum_meter_streams: u64::MAX,
+        maximum_period_frames: u32::MAX,
+        maximum_peak_hold_frames: u32::MAX,
+        maximum_smoothing_samples: u32::MAX,
+    }
+}
+
+struct Impulse(f32, f32);
+impl GraphRuntimeProcessor for Impulse {
+    fn process(
+        &mut self,
+        block: GraphBindingBlock<'_>,
+    ) -> Result<(), engine::realtime::RenderError> {
+        let n = block.left.len();
+        for i in 0..n {
+            let t = (block.first_sample + i as u64) as f32;
+            block.left[i] = self.0 * ((t * 0.013).sin() + if t == 0.0 { 1.0 } else { 0.0 });
+            block.right[i] = self.1 * ((t * 0.021).cos());
+        }
+        Ok(())
+    }
+}
+struct Identity;
+impl GraphRuntimeProcessor for Identity {
+    fn process(
+        &mut self,
+        _block: GraphBindingBlock<'_>,
+    ) -> Result<(), engine::realtime::RenderError> {
+        Ok(())
+    }
+}
+
+#[derive(Debug, Default, Clone)]
+struct Outcome {
+    compile: Option<String>,
+    bind: Option<String>,
+    /// Bound effect banks whose members sit at different levels.
+    cross_level_bound: usize,
+    /// Full planned groups with an all-lanes slot whose members sit at different levels
+    /// (backend-independent: what a build whose factories bank at this width would bind).
+    cross_level_planned: usize,
+    effect_banks: usize,
+    pcm: Option<Vec<u32>>,
+    fingerprint: String,
+    /// Lanes of full-group, all-lanes slots left unbound (the cost of the fix).
+    unbound_all_lane_slots: usize,
+}
+
+fn level_map(graph: &graph::PreparedGraphPlan) -> BTreeMap<GraphNodeId, u64> {
+    graph
+        .dependency_levels
+        .iter()
+        .flat_map(|l| l.nodes.iter().cloned().map(move |n| (n, l.level)))
+        .collect()
+}
+
+fn run(model: &SessionModel, dispatch: Backend, blocks: u64, verbose: bool) -> Outcome {
+    let mut out = Outcome::default();
+    let session = match compile_session(
+        model,
+        CompileCaps {
+            max_compiled_model_bytes: u64::MAX,
+            max_requested_runtime_bytes: u64::MAX,
+            max_single_allocation_bytes: u64::MAX,
+            max_queue_items: u64::MAX,
+            max_source_ring_frames: u64::MAX,
+            max_source_ring_bytes: u64::MAX,
+        },
+    ) {
+        Ok(s) => s,
+        Err(e) => {
+            out.compile = Some(format!(
+                "session: {:?}",
+                e.diagnostics().iter().map(|d| format!("{:?} {:?}", d.code, d.path)).collect::<Vec<_>>()
+            ));
+            return out;
+        }
+    };
+    let registry = launch_native_effect_registry().expect("registry");
+    let effects = match prepare_native_session_effects(
+        &session,
+        &registry,
+        EffectCompileCaps {
+            maximum_total_state_bytes: 1 << 30,
+            maximum_scratch_bytes: 1 << 28,
+            maximum_automation_spans_per_block: 32,
+        },
+    ) {
+        Ok(e) => e,
+        Err(e) => {
+            out.compile = Some(format!(
+                "effects: {:?}",
+                e.0.iter().map(|d| (d.code, d.path.clone())).collect::<Vec<_>>()
+            ));
+            return out;
+        }
+    };
+    let builtins = match prepare_session_builtins(&session, &[], builtin_caps()) {
+        Ok(b) => b,
+        Err(e) => {
+            out.compile = Some(format!("builtins: {e:?}"));
+            return out;
+        }
+    };
+    let artifact = match GraphCompiler::compile_with_builtins(GraphBuiltinsCompileRequest {
+        plan_id: 1,
+        effects,
+        builtins,
+        caps: graph_caps(),
+        dispatch,
+    }) {
+        Ok(a) => a,
+        Err(f) => {
+            out.compile = Some(format!(
+                "graph: {:?}",
+                f.diagnostics
+                    .diagnostics()
+                    .iter()
+                    .map(|d| d.code)
+                    .collect::<Vec<_>>()
+            ));
+            return out;
+        }
+    };
+    let levels = level_map(artifact.graph());
+    out.effect_banks = artifact.graph().prepared_bank_count();
+    out.fingerprint = format!(
+        "sha={} levels={} effect_banks={:?} builtin_banks={:?} estimate={:?}",
+        GraphCompiler::sha256(artifact.graph(), artifact.report()),
+        artifact.graph().dependency_levels.len(),
+        artifact
+            .graph()
+            .effect_bank_members()
+            .map(|b| b.iter().map(|m| format!("{}/{:?}/{}", m.track_id.as_str(), m.rack, m.effect_id.as_str())).collect::<Vec<_>>())
+            .collect::<Vec<_>>(),
+        artifact
+            .graph()
+            .builtin_bank_info()
+            .map(|b| format!("{:?}{:?}", b.stage, b.members))
+            .collect::<Vec<_>>(),
+        artifact.report().estimate,
+    );
+    for bank in artifact.graph().effect_bank_members() {
+        let lv: Vec<u64> = bank
+            .iter()
+            .map(|m| levels[&GraphNodeId::Effect(m.clone())])
+            .collect();
+        if lv.windows(2).any(|p| p[0] != p[1]) {
+            out.cross_level_bound += 1;
+            if verbose {
+                eprintln!(
+                    "  {dispatch:?} cross-level bound bank {:?} levels {lv:?}",
+                    bank.iter()
+                        .map(|m| format!(
+                            "{}/{:?}/{}",
+                            m.track_id.as_str(),
+                            m.rack,
+                            m.effect_id.as_str()
+                        ))
+                        .collect::<Vec<_>>()
+                );
+            }
+        }
+    }
+    let report = &artifact.report().rack_cohorts;
+    for group in &report.plan.groups {
+        if !group.is_full() {
+            continue;
+        }
+        for slot in 0..group.program.len() {
+            if !group.active_slots.iter().all(|lane| lane[slot]) {
+                continue;
+            }
+            let mut lv = Vec::new();
+            for (lane, id) in group.members.iter().enumerate() {
+                let id = id.as_ref().unwrap();
+                let rank = group.active_slots[lane][..slot]
+                    .iter()
+                    .filter(|a| **a)
+                    .count();
+                let node = &report.chains[id][rank];
+                lv.push(levels[&GraphNodeId::Effect(node.clone())]);
+            }
+            if lv.windows(2).any(|p| p[0] != p[1]) {
+                out.cross_level_planned += 1;
+            }
+            let bound = report
+                .bound_slots
+                .iter()
+                .any(|b| std::ptr::eq(&report.plan.groups[b.group], group) && b.slot == slot);
+            if !bound {
+                out.unbound_all_lane_slots += group.members.len();
+            }
+        }
+    }
+    let envelope = artifact.envelope();
+    let frames = envelope.quantum.0 as usize;
+    let nodes = artifact
+        .external_binding_nodes()
+        .map(|node| {
+            let p: Box<dyn GraphRuntimeProcessor> = match node {
+                GraphNodeId::TrackStage {
+                    track_id,
+                    stage: TrackStage::Input,
+                } => {
+                    let h = track_id
+                        .as_str()
+                        .bytes()
+                        .fold(7_u32, |a, b| a.wrapping_mul(31).wrapping_add(u32::from(b)));
+                    Box::new(Impulse(
+                        0.05 + (h % 13) as f32 * 0.01,
+                        -0.04 - (h % 7) as f32 * 0.01,
+                    ))
+                }
+                _ => Box::new(Identity),
+            };
+            GraphNodeBinding::new(node.clone(), p)
+        })
+        .collect();
+    let bound = match artifact.into_bound(GraphRuntimeBindings {
+        envelope,
+        nodes,
+        observers: Vec::new(),
+    }) {
+        Ok(b) => b,
+        Err(f) => {
+            out.bind = Some(f.code.to_string());
+            return out;
+        }
+    };
+    let mut plan = bound.plan;
+    out.fingerprint.push_str(&format!(" units={:?}", plan.unit_eligibility()));
+    if blocks > 0 {
+        let mut bits = Vec::new();
+        for block in 0..blocks {
+            let mut pcm = vec![0.0_f32; frames * 2];
+            plan.render(
+                RenderIo {
+                    input: None,
+                    output: PlanarBufferMut::try_new(&mut pcm, 2, frames, frames).expect("out"),
+                },
+                RenderTime {
+                    absolute_sample: block * frames as u64,
+                },
+            )
+            .expect("render");
+            bits.extend(pcm.iter().map(|s| s.to_bits()));
+        }
+        let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+        for b in &bits {
+            h ^= u64::from(*b);
+            h = h.wrapping_mul(0x0100_0000_01b3);
+        }
+        out.fingerprint.push_str(&format!(
+            " shape={:?} transposes={} folds={} redirects={} pcm={h:016x}",
+            plan.bank_shape(),
+            plan.bank_transposes(),
+            plan.bank_route_folds(),
+            plan.bank_scatter_redirects()
+        ));
+        out.pcm = Some(bits);
+    }
+    out
+}
+
+// ---------------------------------------------------------------------------------------------
+// Session generator.
+
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        // xorshift64*
+        let mut x = self.0;
+        x ^= x >> 12;
+        x ^= x << 25;
+        x ^= x >> 27;
+        self.0 = x;
+        x.wrapping_mul(0x2545_f491_4f6c_dd1d)
+    }
+    fn below(&mut self, n: u64) -> u64 {
+        self.next() % n
+    }
+    fn chance(&mut self, per_mille: u64) -> bool {
+        self.below(1000) < per_mille
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum Kind {
+    Eq,
+    Comp,
+    Gate,
+    Multiband,
+    Limiter,
+    SoftClip,
+    Transient,
+    Delay,
+}
+const KINDS: [Kind; 8] = [
+    Kind::Eq,
+    Kind::Comp,
+    Kind::Gate,
+    Kind::Multiband,
+    Kind::Limiter,
+    Kind::SoftClip,
+    Kind::Transient,
+    Kind::Delay,
+];
+
+struct Templates {
+    eq: Effect,
+    comp: Effect,
+    limiter: Effect,
+}
+
+fn sid(s: &str) -> StableId {
+    StableId::parse(s).expect("stable id")
+}
+
+fn effect(t: &Templates, kind: Kind, id: &str) -> Effect {
+    let mut e = match kind {
+        Kind::Eq => t.eq.clone(),
+        Kind::Comp => t.comp.clone(),
+        Kind::Limiter => t.limiter.clone(),
+        _ => {
+            let mut e = t.comp.clone();
+            e.params.clear();
+            e
+        }
+    };
+    let native = match kind {
+        Kind::Eq => "miso.parametric-eq",
+        Kind::Comp => "miso.compressor",
+        Kind::Gate => "miso.gate-expander",
+        Kind::Multiband => "miso.multiband-compressor",
+        Kind::Limiter => "miso.true-peak-limiter",
+        Kind::SoftClip => "miso.soft-clip",
+        Kind::Transient => "miso.transient-shaper",
+        Kind::Delay => "miso.delay",
+    };
+    e.identity = EffectIdentity::Native {
+        effect_id: sid(native),
+    };
+    e.id = sid(id);
+    e.sidechain = SidechainDeclaration::None;
+    e
+}
+
+fn kind_name(kind: Kind) -> &'static str {
+    match kind {
+        Kind::Eq => "eq",
+        Kind::Comp => "comp",
+        Kind::Gate => "gate",
+        Kind::Multiband => "mb",
+        Kind::Limiter => "lim",
+        Kind::SoftClip => "clip",
+        Kind::Transient => "ts",
+        Kind::Delay => "dly",
+    }
+}
+
+const SIMD1_TEMPLATES: &[&[Kind]] = &[
+    &[],
+    &[Kind::Eq],
+    &[Kind::Eq, Kind::Comp],
+    &[Kind::Comp],
+    &[Kind::Gate, Kind::Eq, Kind::Comp],
+    &[Kind::Eq, Kind::Comp, Kind::Transient],
+    &[Kind::Eq, Kind::SoftClip],
+];
+const DYNAMIC_TEMPLATES: &[&[Kind]] = &[
+    &[],
+    &[],
+    &[Kind::SoftClip],
+    &[Kind::Comp],
+    &[Kind::Eq, Kind::SoftClip],
+    &[Kind::Delay],
+    &[Kind::Comp, Kind::Delay],
+];
+const SIMD2_TEMPLATES: &[&[Kind]] = &[
+    &[],
+    &[Kind::Limiter],
+    &[Kind::Limiter],
+    &[Kind::SoftClip, Kind::Limiter],
+    &[Kind::Multiband, Kind::Limiter],
+    &[Kind::Eq, Kind::Limiter],
+];
+
+const TAPS: [SendTap; 7] = [
+    SendTap::Input,
+    SendTap::PostInputBuiltins,
+    SendTap::PostSimd1,
+    SendTap::PostDynamic,
+    SendTap::PostSimd2PreFader,
+    SendTap::PostFader,
+    SendTap::PostMatrix,
+];
+
+fn identity_matrix() -> ChannelMatrix {
+    ChannelMatrix {
+        ll: 1.0,
+        lr: 0.0,
+        rl: 0.0,
+        rr: 1.0,
+    }
+}
+
+/// One randomized, realistic console session.
+fn generate(seed: u64) -> SessionModel {
+    generate_with_meta(seed).0
+}
+
+fn generate_with_meta(seed: u64) -> (SessionModel, String) {
+    let mut rng = Rng(seed.wrapping_mul(0x9e37_79b9_7f4a_7c15) | 1);
+    for _ in 0..4 {
+        rng.next();
+    }
+    let base = parse_session_json(INTENDED).expect("fixture");
+    let t = Templates {
+        eq: base.tracks[0].simd1.effects[0].clone(),
+        comp: base.tracks[0].simd1.effects[1].clone(),
+        limiter: base.tracks[0].simd2.effects[0].clone(),
+    };
+    let template_track = base.tracks[0].clone();
+    let mut model = base.clone();
+    model.tracks.clear();
+    model.routes.clear();
+    model.submixes.clear();
+    model.automation.clear();
+
+    let tracks = match rng.below(20) {
+        0..=11 => 1 + rng.below(24),
+        12..=16 => 25 + rng.below(16),
+        _ => 64,
+    } as usize;
+    let free = rng.chance(250);
+    let drop = [0, 30, 80, 200, 400][rng.below(5) as usize];
+    let mono = [0, 0, 300, 1000][rng.below(4) as usize];
+    let simd1 = SIMD1_TEMPLATES[rng.below(SIMD1_TEMPLATES.len() as u64) as usize];
+    let dynamic = DYNAMIC_TEMPLATES[rng.below(DYNAMIC_TEMPLATES.len() as u64) as usize];
+    let simd2 = SIMD2_TEMPLATES[rng.below(SIMD2_TEMPLATES.len() as u64) as usize];
+    let submixes = rng.below(3) as usize;
+    for s in 0..submixes {
+        model.submixes.push(Submix {
+            id: sid(&format!("bus{s}")),
+        });
+        model.routes.push(Route {
+            id: sid(&format!("bus{s}-main")),
+            source: RouteSource::SubmixOutput {
+                submix_id: sid(&format!("bus{s}")),
+            },
+            destination: RouteDestination::OutputInput {
+                output_id: sid("main-out"),
+            },
+            channel_matrix: identity_matrix(),
+            gain_db: 0.0,
+        });
+    }
+
+    let mut ids = Vec::new();
+    for index in 0..tracks {
+        let id = format!("ch{index:02}");
+        let mut track = template_track.clone();
+        track.id = sid(&id);
+        if rng.chance(mono) {
+            track.left_source_channel = 0;
+            track.right_source_channel = 0;
+        }
+        if rng.chance(80) {
+            track.builtins.left.delay_samples = 1 + rng.below(64) as u32;
+        }
+        if rng.chance(80) {
+            track.builtins.right.delay_samples = 1 + rng.below(64) as u32;
+        }
+        for (rack_index, template) in [simd1, dynamic, simd2].into_iter().enumerate() {
+            let mut kinds: Vec<Kind> = if free {
+                (0..rng.below(4))
+                    .map(|_| KINDS[rng.below(8) as usize])
+                    .collect()
+            } else {
+                let mut kinds: Vec<Kind> =
+                    template.iter().copied().filter(|_| !rng.chance(drop)).collect();
+                if rng.chance(drop / 4) {
+                    let at = rng.below(kinds.len() as u64 + 1) as usize;
+                    kinds.insert(at, KINDS[rng.below(8) as usize]);
+                }
+                kinds
+            };
+            kinds.truncate(4);
+            let effects: Vec<Effect> = kinds
+                .iter()
+                .enumerate()
+                .map(|(slot, kind)| {
+                    let mut e = effect(&t, *kind, &format!("{}{slot}", kind_name(*kind)));
+                    if rng.chance(60) {
+                        e.bypass = true;
+                    }
+                    if matches!(kind, Kind::Comp | Kind::Gate) && index > 0 && rng.chance(70) {
+                        let source = rng.below(index as u64) as usize;
+                        e.sidechain = SidechainDeclaration::Routed(Sidechain {
+                            source: RouteSource::Track {
+                                track_id: sid(&format!("ch{source:02}")),
+                                tap: TAPS[rng.below(7) as usize],
+                            },
+                            port_id: sid("sidechain-in"),
+                        });
+                    }
+                    e
+                })
+                .collect();
+            match rack_index {
+                0 => track.simd1.effects = effects,
+                1 => track.dynamic.effects = effects,
+                _ => track.simd2.effects = effects,
+            }
+        }
+        ids.push(id.clone());
+        model.tracks.push(track);
+        let to_bus = submixes > 0 && rng.chance(250);
+        if !to_bus || rng.chance(500) {
+            model.routes.push(Route {
+                id: sid(&format!("{id}-main")),
+                source: RouteSource::Track {
+                    track_id: sid(&id),
+                    tap: SendTap::PostMatrix,
+                },
+                destination: RouteDestination::OutputInput {
+                    output_id: sid("main-out"),
+                },
+                channel_matrix: identity_matrix(),
+                gain_db: 0.0,
+            });
+        }
+        if to_bus {
+            let bus = rng.below(submixes as u64);
+            model.routes.push(Route {
+                id: sid(&format!("{id}-bus")),
+                source: RouteSource::Track {
+                    track_id: sid(&id),
+                    tap: TAPS[rng.below(7) as usize],
+                },
+                destination: RouteDestination::SubmixInput {
+                    submix_id: sid(&format!("bus{bus}")),
+                },
+                channel_matrix: identity_matrix(),
+                gain_db: -6.0,
+            });
+        }
+    }
+    let _ = ids;
+    let _ = EffectQuality::Normal;
+    let _ = LinkMode::DualMono;
+    let meta = if free {
+        "free".to_owned()
+    } else {
+        format!("template drop={drop}")
+    };
+    (model, meta)
+}
+
+fn env_u64(name: &str, default: u64) -> u64 {
+    std::env::var(name)
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(default)
+}
