+//! Issue #966 evidence harness (never merged): run `wasm-pins-966-guest` under the pinned wasmtime
+//! and check the `Simd4` pins `crates/graph-compiler/tests/bank_levels.rs` asserts on four-lane
+//! builds, which an `x86-64-v3` host never runs.
+//!
+//! `WASM_PINS_966_GUEST` names the built guest; without it the test does nothing. The reproducers
+//! always run. `WASM_PINS_966_COUNT` seeds of the probe run from `WASM_PINS_966_START`, rendered
+//! for `WASM_PINS_966_BLOCKS` blocks (default 16), every seed when `WASM_PINS_966_RENDER_ALL=1`.
+#![allow(missing_docs, clippy::all)]
+
+use wasmtime::{Config, Engine, Instance, Module, Store};
+
+const STAT_NAMES: [&str; 16] = [
+    "compile_refused",
+    "bind_refused",
+    "cross_level",
+    "misaligned",
+    "effect_banks",
+    "moved_unarmed",
+    "moved_armed",
+    "silent",
+    "armed_collapsed_blocks",
+    "armed_collapsible",
+    "samples",
+    "seeds",
+    "misaligned_seeds",
+    "rendered",
+    "collapse_fired_seeds",
+    "seeds_bind_refused",
+];
+
+/// `(name, Simd4 effect banks, Simd4 misaligned planned slots)`, in the guest's `model` order.
+/// The bank counts are the `simd4` arguments of `bank_levels.rs`'s `native_bank_count` calls.
+const PINS: [(&str, u32, u32); 8] = [
+    ("64-track console less ch00's EQ", 45, 1),
+    ("64-track console less ch60's EQ", 45, 1),
+    ("64-track console less ch63's EQ", 45, 1),
+    ("64-track mono console less ch00's EQ", 45, 1),
+    ("seed-412 shape", 6, 1),
+    ("reduced mono console from the #970 probe", 1, 1),
+    ("64-track console less nine EQs", 43, 1),
+    ("sixteen tracks realigning after a misaligned compressor", 18, 2),
+];
+
+fn env_u32(name: &str, default: u32) -> u32 {
+    std::env::var(name).map_or(default, |value| value.parse().expect(name))
+}
+
+#[test]
+fn wasm_simd4_pins_966() {
+    let Ok(path) = std::env::var("WASM_PINS_966_GUEST") else {
+        return;
+    };
+    let blocks = env_u32("WASM_PINS_966_BLOCKS", 16);
+    let start = env_u32("WASM_PINS_966_START", 0);
+    let count = env_u32("WASM_PINS_966_COUNT", 0);
+    let render_all = env_u32("WASM_PINS_966_RENDER_ALL", 0);
+    let mut config = Config::new();
+    config.wasm_simd(true);
+    config.wasm_relaxed_simd(false);
+    let engine = Engine::new(&config).unwrap();
+    let module = Module::from_file(&engine, &path).unwrap();
+    let mut store = Store::new(&engine, ());
+    let instance = Instance::new(&mut store, &module, &[]).unwrap();
+    let backend = instance
+        .get_typed_func::<(), u32>(&mut store, "pins_966_backend")
+        .unwrap();
+    let stat = instance
+        .get_typed_func::<u32, u32>(&mut store, "pins_966_stat")
+        .unwrap();
+    let reproducer = instance
+        .get_typed_func::<(u32, u32), u32>(&mut store, "pins_966_reproducer")
+        .unwrap();
+    let probe = instance
+        .get_typed_func::<(u32, u32, u32, u32), u32>(&mut store, "pins_966_probe")
+        .unwrap();
+    let lanes = backend.call(&mut store, ()).unwrap();
+    println!("guest {path}: backend lanes {lanes}");
+    assert_eq!(lanes, 4, "the guest is a four-lane build");
+    let read = |store: &mut Store<()>| -> [u32; 16] {
+        std::array::from_fn(|index| stat.call(&mut *store, index as u32).unwrap())
+    };
+    let describe = |stats: &[u32; 16], upto: usize| -> String {
+        (0..upto)
+            .map(|index| format!("{}={}", STAT_NAMES[index], stats[index]))
+            .collect::<Vec<_>>()
+            .join(" ")
+    };
+
+    let mut failures = Vec::new();
+    for (which, (name, banks, misaligned)) in PINS.iter().enumerate() {
+        reproducer.call(&mut store, (which as u32, blocks)).unwrap();
+        let stats = read(&mut store);
+        println!("{name}, {blocks} blocks: {}", describe(&stats, 11));
+        let clean = stats[0] == 0 && stats[1] == 0 && stats[2] == 0 && stats[5..8] == [0, 0, 0];
+        if !clean || stats[4] != *banks || stats[3] != *misaligned {
+            failures.push(format!(
+                "{name}: expected {banks} banks and {misaligned} misaligned slots, clean"
+            ));
+        }
+    }
+    if count > 0 {
+        probe
+            .call(&mut store, (start, count, blocks, render_all))
+            .unwrap();
+        let stats = read(&mut store);
+        println!(
+            "probe seeds {start}..{} blocks {blocks} render_all {render_all}: {}",
+            start + count,
+            describe(&stats, 16)
+        );
+        if stats[0] != 0 || stats[1] != 0 || stats[15] != 0 || stats[5] != 0 || stats[6] != 0 {
+            failures.push(format!("probe seeds {start}..{}", start + count));
+        }
+    }
+    assert!(failures.is_empty(), "{failures:#?}");
+}
