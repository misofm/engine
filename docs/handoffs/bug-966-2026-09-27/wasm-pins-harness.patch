--- /dev/null
+++ b/tools/wasm-pins-966-guest/src/lib.rs
@@ -0,0 +1,120 @@
+//! Issue #966 evidence harness (never merged): the committed `bank_levels.rs` in a `Simd4` guest.
+//!
+//! Every export returns plain `u32`s so the host needs no memory contract. A reproducer or probe
+//! call stores its tallies, and `pins_966_stat` reads them back one index at a time.
+#![allow(unsafe_code, dead_code, unused, missing_docs, unreachable_pub, clippy::all)]
+
+#[path = "../../../crates/graph-compiler/tests/bank_levels.rs"]
+mod probe;
+
+use lane::Backend;
+use probe::{Collapse, compile_bind_render};
+use std::sync::Mutex;
+
+/// Tallies, indexed as `STAT_NAMES` in the host test lists them.
+static STATS: Mutex<[u32; 16]> = Mutex::new([0; 16]);
+
+/// The guest's own lane count: 4 under `simd128`.
+#[unsafe(no_mangle)]
+pub extern "C" fn pins_966_backend() -> u32 {
+    match Backend::current() {
+        Backend::Scalar => 1,
+        Backend::Simd4 => 4,
+        Backend::Simd8 => 8,
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn pins_966_stat(index: u32) -> u32 {
+    STATS.lock().unwrap()[index as usize]
+}
+
+/// The reproducers, in the order the host's pin table lists them.
+fn model(which: u32) -> Option<session::SessionModel> {
+    Some(match which {
+        0 => probe::sixty_four_track_console_less_eqs(&[0]),
+        1 => probe::sixty_four_track_console_less_eqs(&[60]),
+        2 => probe::sixty_four_track_console_less_eqs(&[63]),
+        3 => probe::mono_console_less_eqs(&[0]),
+        4 => probe::ragged_dynamic_soft_clip(),
+        5 => probe::reduced_mono_console(),
+        6 => probe::sixty_four_track_console_less_eqs(&[0, 56, 57, 58, 59, 60, 61, 62, 63]),
+        7 => probe::realigning_simd1_strips(),
+        _ => return None,
+    })
+}
+
+/// Adds one session's tallies: 0 compile refused, 1 bind refused (either leg), 2 cross-level
+/// banks, 3 misaligned slots, 4 effect banks, 5 unarmed renders that moved, 6 armed renders that
+/// moved, 7 silent scalar renders, 8 armed collapsed blocks, 9 armed collapsible cohorts,
+/// 10 samples compared. Everything but the scalar reference is at `Simd4`.
+fn account(model: &session::SessionModel, blocks: u64, stats: &mut [u32; 16]) {
+    let scalar = compile_bind_render(model, Backend::Scalar, blocks, Collapse::Unarmed);
+    let unarmed = compile_bind_render(model, Backend::Simd4, blocks, Collapse::Unarmed);
+    let armed = compile_bind_render(model, Backend::Simd4, blocks, Collapse::Armed);
+    if scalar.compile.is_some() || unarmed.compile.is_some() {
+        stats[0] += 1;
+        return;
+    }
+    stats[1] += u32::from(unarmed.bind.is_some() || armed.bind.is_some());
+    stats[2] += unarmed.cross_level_banks as u32;
+    stats[3] += unarmed.misaligned_slots as u32;
+    stats[4] += unarmed.effect_banks as u32;
+    stats[5] += u32::from(unarmed.bind.is_none() && unarmed.pcm != scalar.pcm);
+    stats[6] += u32::from(armed.bind.is_none() && armed.pcm != scalar.pcm);
+    stats[7] += u32::from(
+        !scalar
+            .pcm
+            .as_ref()
+            .is_some_and(|pcm| pcm.iter().any(|bits| f32::from_bits(*bits) != 0.0)),
+    );
+    stats[8] += armed.collapse[0] as u32;
+    stats[9] += armed.collapse[1] as u32;
+    stats[10] += scalar.pcm.as_ref().map_or(0, |pcm| pcm.len() as u32);
+}
+
+/// Reproducer `which` at `Simd4` against `Scalar`, `blocks` blocks. `u32::MAX` past the end,
+/// otherwise the bind refusals.
+#[unsafe(no_mangle)]
+pub extern "C" fn pins_966_reproducer(which: u32, blocks: u32) -> u32 {
+    let Some(model) = model(which) else {
+        return u32::MAX;
+    };
+    let mut stats = [0; 16];
+    account(&model, u64::from(blocks), &mut stats);
+    *STATS.lock().unwrap() = stats;
+    stats[1]
+}
+
+/// Generator seeds `start..start + count`: bind every one at `Simd4`, and render (unarmed and
+/// armed) the ones with a misaligned planned slot, or every one when `render_all` is nonzero.
+/// Adds 11 seeds, 12 misaligned seeds, 13 rendered seeds, 14 seeds whose armed collapse fired and
+/// 15 seeds bind refused at `Simd4` to `account`'s sums over the rendered seeds. Returns tally 15.
+#[unsafe(no_mangle)]
+pub extern "C" fn pins_966_probe(start: u32, count: u32, blocks: u32, render_all: u32) -> u32 {
+    let mut stats = [0; 16];
+    for seed in start..start + count {
+        let (model, _) = probe::generate(u64::from(seed));
+        let bound = compile_bind_render(&model, Backend::Simd4, 0, Collapse::Unarmed);
+        stats[11] += 1;
+        if bound.compile.is_some() {
+            stats[0] += 1;
+            continue;
+        }
+        stats[15] += u32::from(bound.bind.is_some());
+        let misaligned = bound.misaligned_slots > 0;
+        stats[12] += u32::from(misaligned);
+        if !(misaligned || render_all != 0) {
+            continue;
+        }
+        stats[13] += 1;
+        let mut seed_stats = [0; 16];
+        account(&model, u64::from(blocks), &mut seed_stats);
+        for index in 0..11 {
+            stats[index] += seed_stats[index];
+        }
+        stats[14] += u32::from(seed_stats[8] > 0);
+    }
+    *STATS.lock().unwrap() = stats;
+    stats[15]
+}
