    36	    )
    37	    return {"status": completed.returncode, "output": completed.stdout + completed.stderr}
    38	
    39	
    40	metadata = {
    41	    "argv": argv,
    42	    "cwd": str(root),
    43	    "head": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip(),
    44	    "branch": subprocess.check_output(["git", "branch", "--show-current"], cwd=root, text=True).strip(),
    45	    "status": subprocess.check_output(["git", "status", "--porcelain=v1"], cwd=root, text=True),
    46	    "env": {key: environment.get(key) for key in ["PATH", "RUSTFLAGS", "CARGO_TARGET_DIR"]},
    47	    "toolchain": {
    48	        "rustc": run_output(["rustc", "--version", "--verbose"]),
    49	        "cargo": run_output(["cargo", "--version"]),
    50	        "rustup_toolchain": run_output(["rustup", "show", "active-toolchain"]),
    51	    },
    52	    "source": {
    53	        path: {
    54	            "sha256": hashlib.sha256((root / path).read_bytes()).hexdigest(),
    55	            "git_blob": subprocess.check_output(["git", "hash-object", path], cwd=root, text=True).strip(),
    56	        }
    57	        for path in paths
    58	    },
    59	}
    60	with prefix.with_suffix(".command.json").open("x") as command_file:
    61	    json.dump(metadata, command_file, indent=2)
    62	    command_file.write("\n")
    63	with prefix.with_suffix(".stdout").open("xb") as stdout_file, prefix.with_suffix(".stderr").open("xb") as stderr_file:
    64	    result = subprocess.run(argv, cwd=root, env=environment, stdout=stdout_file, stderr=stderr_file, check=False)
    65	with prefix.with_suffix(".status").open("x") as status_file:
    66	    status_file.write(f"{result.returncode}\n")
    67	print(label, result.returncode, flush=True)
    68	sys.exit(result.returncode)
