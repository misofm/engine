   130	fn automation(block: usize) -> [PreparedAutomationSpan; 1] {
   131	    let value = if block.is_multiple_of(2) { -3.0 } else { -9.0 };
   132	    [PreparedAutomationSpan {
   133	        kind: AutomationSpanKind::Point,
   134	        channel: ParameterChannel::Left,
   135	        parameter_index: 0,
   136	        start_sample: (block * 128) as u64,
   137	        end_sample: (block * 128) as u64,
   138	        start_value: value,
   139	        end_value: value,
   140	    }]
   141	}
   142	
   143	#[test]
   144	fn the_render_path_allocates_nothing() {
   145	    let values = values();
   146	    let mut scalar = TruePeakLimiterFactory
   147	        .prepare(request(&values))
   148	        .expect("prepare");
   149	    let mut left = vec![0.0_f32; 128];
   150	    let mut right = vec![0.0_f32; 128];
   151	    // Warm every lazily initialised path once before arming the counter.
   152	    scalar
   153	        .process(EffectProcessBlock::new(&mut left, &mut right, None, 0, &[], 128).expect("block"));
   154	
   155	    let (allocations, deallocations) = measure(|| {
   156	        for block in 0..100 {
   157	            for (index, sample) in left.iter_mut().enumerate() {
   158	                // A hostile magnitude every twentieth block: the FIR overflows to infinity and the
   159	                // once-per-block boundary check zeroes, resets and counts — still without a heap.
   160	                *sample = if block % 20 == 19 {
   161	                    3.0e38
   162	                } else {
   163	                    ((index % 17) as f32 - 8.0) * 0.25
   164	                };
   165	            }
   166	            right.copy_from_slice(&left);
   167	            let spans = automation(block);
   168	            scalar.process(
   169	                EffectProcessBlock::new(
   170	                    &mut left,
   171	                    &mut right,
   172	                    None,
   173	                    (block * 128) as u64,
   174	                    &spans,
   175	                    128,
   176	                )
   177	                .expect("block"),
   178	            );
   179	            if block % 33 == 32 {
   180	                scalar.reset(ResetKind::DiscontinuityKeepParameters);
   181	            }
   182	        }
   183	        scalar.reset(ResetKind::FullToDefaults);
   184	    });
   185	    assert_eq!(
   186	        (allocations, deallocations),
   187	        (0, 0),
   188	        "scalar render path allocated"
   189	    );
   190	
   191	    let requests: Vec<PrepareEffectRequest<'_>> = (0..8).map(|_| request(&values)).collect();
   192	    let mut bank = TruePeakLimiterFactory
   193	        .bind_homogeneous_bank(PrepareEffectBankRequest {
   194	            backend: Backend::Simd8,
   195	            width: BankWidth::Eight,
   196	            requests: &requests,
   197	        })
   198	        .expect("bank binding")
   199	        .expect("bank available");
   200	    let mut left = vec![0.0_f32; 128 * 8];
   201	    let mut right = vec![0.0_f32; 128 * 8];
   202	    let offsets = [0_u32, 1, 1, 1, 1, 1, 1, 1, 1];
   203	    let spans = automation(0);
   204	    bank.process_bank(
   205	        EffectBankProcessBlock::new(
   206	            &mut left,
   207	            &mut right,
   208	            None,
   209	            128,
   210	            BankWidth::Eight,
   211	            0,
   212	            &spans,
   213	            &offsets,
   214	            128,
   215	        )
   216	        .expect("bank block"),
   217	    );
   218	
   219	    let (allocations, deallocations) = measure(|| {
   220	        for block in 0..100 {
   221	            for (index, sample) in left.iter_mut().enumerate() {
   222	                *sample = if block % 20 == 19 {
   223	                    3.0e38
   224	                } else {
   225	                    ((index % 23) as f32 - 11.0) * 0.2
   226	                };
   227	            }
   228	            right.copy_from_slice(&left);
   229	            let spans = automation(block);
   230	            bank.process_bank(
   231	                EffectBankProcessBlock::new(
   232	                    &mut left,
   233	                    &mut right,
   234	                    None,
   235	                    128,
   236	                    BankWidth::Eight,
   237	                    (block * 128) as u64,
   238	                    &spans,
   239	                    &offsets,
   240	                    128,
   241	                )
   242	                .expect("bank block"),
   243	            );
   244	            if block % 33 == 32 {
   245	                bank.reset(ResetKind::DiscontinuityKeepParameters);
   246	            }
   247	        }
   248	        bank.reset(ResetKind::FullToDefaults);
   249	    });
   250	    assert_eq!(
   251	        (allocations, deallocations),
   252	        (0, 0),
   253	        "bank render path allocated"
   254	    );
   255	}
--- mono_collapse.rs ---
     1	//! The mono-collapse body renders the dual body's left plane, and the disengage copy is complete.
     2	//!
     3	//! The crate-level statement of what the strip's console gates check end to end, and it is here as
     4	//! well as there for one reason: the console fixture carries no automation, so **no ramp is ever in
     5	//! flight while a track is collapse-eligible** -- every parameter write in this engine is addressed
     6	//! to one channel and therefore clears the witness' `LIVE` term on the block it lands. That makes
     7	//! the ramp-carrying entries of this effect's disengage copy list unreachable from the engine, and
     8	//! reachable from here, where the contract call is made directly.
     9	//!
    10	//! The content is deliberately **loud** and the ceiling deliberately low: a signal the limiter
    11	//! never reduces leaves `required_ring` at `1.0` and makes the twelve oversampling history taps
    12	//! unobservable, so a corpus below the ceiling would say nothing about half of this kernel's state.
    13	
    14	use effect_contract::{
    15	    AutomationSpanKind, BankWidth, EffectBankProcessBlock, EffectQuality, InitialParameterValue,
    16	    LinkMode, NativeEffectFactory, ParameterChannel, PrepareEffectBankRequest, PrepareEffectLimits,
    17	    PrepareEffectRequest, PreparedAutomationSpan, PreparedNativeEffectBank, PreparedPorts,
    18	    PreparedSidechainPort,
    19	};
    20	use lane::Backend;
    21	use true_peak_limiter::{
    22	    TRUE_PEAK_LIMITER_DESCRIPTOR, TRUE_PEAK_LIMITER_PARAMETERS, TruePeakLimiterFactory,
    23	};
    24	
    25	/// Enough blocks for the lookahead line, the van Herk window and the release to be full of
    26	/// collapsed-run samples before anything is compared.
    27	const BLOCKS: usize = 24;
    28	const FRAMES: usize = 128;
    29	
    30	fn native_bank() -> Option<(BankWidth, Backend)> {
    31	    let backend = Backend::current();
    32	    BankWidth::for_backend(backend).map(|width| (width, backend))
    33	}
    34	
    35	fn values() -> [InitialParameterValue; 6] {
    36	    core::array::from_fn(|index| InitialParameterValue {
    37	        parameter_index: (index / 2) as u32,
    38	        channel: if index % 2 == 0 {
    39	            ParameterChannel::Left
    40	        } else {
    41	            ParameterChannel::Right
    42	        },
    43	        value: TRUE_PEAK_LIMITER_PARAMETERS[index / 2].default_value,
    44	    })
    45	}
    46	
    47	fn request(values: &[InitialParameterValue]) -> PrepareEffectRequest<'_> {
    48	    let quality = TRUE_PEAK_LIMITER_DESCRIPTOR
    49	        .qualities
    50	        .iter()
    51	        .find(|quality| quality.sample_rate == 48_000)
    52	        .expect("launch rate");
    53	    PrepareEffectRequest {
    54	        sample_rate: 48_000,
    55	        quantum: FRAMES as u32,
    56	        quality: EffectQuality::Normal,
    57	        bypass: false,
    58	        link_mode: LinkMode::Maximum,
    59	        ports: PreparedPorts {
    60	            sidechain: PreparedSidechainPort::None,
    61	        },
    62	        initial_values: values,
    63	        limits: PrepareEffectLimits {
    64	            maximum_total_state_bytes: quality.maximum_state.total().expect("state total"),
    65	            maximum_scratch_bytes: 24,
    66	            maximum_automation_spans_per_block: 16,
    67	        },
    68	    }
    69	}
    70	
    71	fn bind(width: BankWidth, backend: Backend, lanes: usize) -> Box<dyn PreparedNativeEffectBank> {
    72	    let values = values();
    73	    let requests: Vec<_> = (0..lanes).map(|_| request(&values)).collect();
    74	    TruePeakLimiterFactory
    75	        .bind_homogeneous_bank(PrepareEffectBankRequest {
    76	            backend,
    77	            width,
    78	            requests: &requests,
    79	        })
    80	        .expect("valid bank request")
    81	        .expect("the native width must bind")
    82	}
    83	
    84	/// Loud, sign-alternating content with `-0.0` frames salted through it.
    85	fn sample(index: usize) -> f32 {
    86	    match index % 6 {
    87	        0 => 0.98,
    88	        1 => -0.93,
    89	        2 => -0.0,
    90	        3 => 0.0,
    91	        4 => 0.62,
    92	        _ => -0.87,
    93	    }
    94	}
    95	
    96	/// One block of content, with a per-block envelope.
    97	///
    98	/// The envelope matters: a steady loud signal drives the release recursion to a fixed point within
    99	/// a few blocks, and a frozen recursive word that has converged to the same value as a live one is
   100	/// a state difference no output can show. Alternating loud and quiet blocks keeps `reduction`
   101	/// moving for the whole run, which is what makes it a word the disengage copy has to carry.
   102	fn block(step: usize, lanes: usize) -> Vec<f32> {
   103	    let envelope = match step % 4 {
   104	        0 => 1.0,
   105	        1 => 0.04,
   106	        2 => 0.7,
   107	        _ => 0.01,
   108	    };
   109	    (0..FRAMES * lanes)
   110	        .map(|word| sample(step * FRAMES + word / lanes) * envelope)
   111	        .collect()
   112	}
   113	
   114	/// A ceiling and a release retarget on both channels, at this block's first sample, per lane.
   115	///
   116	/// Both channels take the same value, so the dual bank's two channels stay bit-equal: the point is
   117	/// not asymmetry, it is that `limit` and `release` are *moving* when the collapse disengages, and
   118	/// that only the collapsed channel's copies of them advanced.
   119	///
   120	/// The span order is the one this effect validates: strictly ascending `parameter_index * 2 +
   121	/// channel`.
   122	fn automation(step: usize, lanes: usize) -> (Vec<PreparedAutomationSpan>, Vec<u32>) {
   123	    let first = (step * FRAMES) as u64;
   124	    let ceiling = -18.0 - (step % 3) as f32 * 2.0;
   125	    let release = 260.0 + (step % 4) as f32 * 30.0;
   126	    let mut spans = Vec::new();
   127	    let mut offsets = vec![0_u32; lanes + 1];
   128	    for lane in 0..lanes {
   129	        for (parameter, value) in [(0_u32, ceiling), (1, release)] {
   130	            for channel in [ParameterChannel::Left, ParameterChannel::Right] {
   131	                spans.push(PreparedAutomationSpan {
   132	                    kind: AutomationSpanKind::Point,
   133	                    channel,
   134	                    parameter_index: parameter,
   135	                    start_sample: first,
   136	                    end_sample: first,
   137	                    start_value: value,
   138	                    end_value: value,
   139	                });
   140	            }
   141	        }
   142	        offsets[lane + 1] = spans.len() as u32;
   143	    }
   144	    (spans, offsets)
   145	}
   146	
   147	#[allow(clippy::too_many_arguments)]
   148	fn run_block(
   149	    bank: &mut dyn PreparedNativeEffectBank,
   150	    left: &mut [f32],
   151	    right: &mut [f32],
   152	    width: BankWidth,
   153	    first_sample: u64,
   154	    spans: &[PreparedAutomationSpan],
   155	    offsets: &[u32],
   156	    mono: bool,
   157	) {
   158	    let block = EffectBankProcessBlock::new(
   159	        left,
   160	        right,
   161	        None,
   162	        FRAMES as u32,
   163	        width,
   164	        first_sample,
   165	        spans,
   166	        offsets,
   167	        FRAMES as u32,
   168	    )
   169	    .expect("bounded bank block");
   170	    if mono {
   171	        bank.process_bank_mono(block);
   172	    } else {
   173	        bank.process_bank(block);
   174	    }
   175	}
   176	
   177	/// The collapsed body renders the dual body's left plane, ramping and stationary.
   178	///
   179	/// The stationary arm is the one that exercises `limiter_block_uniform_mono` -- the van Herk
   180	/// segment walk, whose collapsed form hands the walk one channel's window offsets for both of its
   181	/// arguments -- and the ramping arm the per-lane body beside it.
   182	#[test]
   183	fn the_collapsed_body_renders_the_dual_bodys_left_plane() {
   184	    let Some((width, backend)) = native_bank() else {
   185	        return;
   186	    };
   187	    let lanes = width.lanes() as usize;
   188	    for ramping in [true, false] {
   189	        let mut dual = bind(width, backend, lanes);
   190	        let mut collapsed = bind(width, backend, lanes);
   191	        let idle = vec![0_u32; lanes + 1];
   192	
   193	        for step in 0..BLOCKS {
   194	            let mut dual_left = block(step, lanes);
   195	            let mut dual_right = dual_left.clone();
   196	            let mut mono_left = dual_left.clone();
   197	            let mut stale = vec![f32::from_bits(0x7F7F_FFFF); FRAMES * lanes];
   198	            let first = (step * FRAMES) as u64;
   199	            let (spans, packed) = automation(step, lanes);
   200	            let (spans, packed): (&[PreparedAutomationSpan], &[u32]) = if ramping {
   201	                (&spans, &packed)
   202	            } else {
   203	                (&[], &idle)
   204	            };
   205	            run_block(
   206	                dual.as_mut(),
   207	                &mut dual_left,
   208	                &mut dual_right,
   209	                width,
   210	                first,
   211	                spans,
   212	                packed,
   213	                false,
   214	            );
   215	            run_block(
   216	                collapsed.as_mut(),
   217	                &mut mono_left,
   218	                &mut stale,
   219	                width,
   220	                first,
   221	                spans,
   222	                packed,
   223	                true,
   224	            );
   225	            for (word, (collapsed_word, dual_word)) in
   226	                mono_left.iter().zip(dual_left.iter()).enumerate()
   227	            {
   228	                assert_eq!(
   229	                    collapsed_word.to_bits(),
   230	                    dual_word.to_bits(),
   231	                    "ramping {ramping} block {step} word {word}"
   232	                );
   233	            }
   234	        }
   235	    }
   236	}
   237	
   238	/// After `desymmetrize_channels`, a bank that ran collapsed renders what a never-collapsed one does.
   239	///
   240	/// One retarget, early, and then none: the ramps open and close well before the transition, so at
   241	/// the disengage the right channel's `limit`, `release` and every ring are stale and nothing
   242	/// re-derives them afterwards.
   243	///
   244	/// Red mutation: delete any line of `ChannelState::copy_state_from`.
   245	#[test]
   246	fn a_desymmetrized_bank_is_a_never_collapsed_bank() {
   247	    let Some((width, backend)) = native_bank() else {
   248	        return;
   249	    };
   250	    let lanes = width.lanes() as usize;
   251	    let mut mixed = bind(width, backend, lanes);
   252	    let mut never = bind(width, backend, lanes);
   253	    let idle = vec![0_u32; lanes + 1];
   254	
   255	    for step in 0..BLOCKS {
   256	        let collapsed_half = step < BLOCKS / 2;
   257	        if step == BLOCKS / 2 {
   258	            mixed.desymmetrize_channels();
   259	        }
   260	        let mut never_left = block(step, lanes);
   261	        let mut never_right = never_left.clone();
   262	        let mut mixed_left = never_left.clone();
   263	        let mut mixed_right = if collapsed_half {
   264	            vec![f32::from_bits(0x7F7F_FFFF); FRAMES * lanes]
   265	        } else {
   266	            never_left.clone()
   267	        };
   268	        let first = (step * FRAMES) as u64;
   269	        let (spans, packed) = if step == 2 {
   270	            automation(step, lanes)
   271	        } else {
   272	            (Vec::new(), idle.clone())
   273	        };
   274	        run_block(
   275	            never.as_mut(),
   276	            &mut never_left,
   277	            &mut never_right,
   278	            width,
   279	            first,
   280	            &spans,
   281	            &packed,
   282	            false,
   283	        );
   284	        run_block(
   285	            mixed.as_mut(),
   286	            &mut mixed_left,
   287	            &mut mixed_right,
   288	            width,
   289	            first,
   290	            &spans,
   291	            &packed,
   292	            collapsed_half,
   293	        );
   294	        for (word, (mixed_word, never_word)) in mixed_left.iter().zip(never_left.iter()).enumerate()
   295	        {
   296	            assert_eq!(
   297	                mixed_word.to_bits(),
   298	                never_word.to_bits(),
   299	                "block {step} word {word}: left plane"
   300	            );
   301	        }
   302	        if !collapsed_half {
   303	            for (word, (mixed_word, never_word)) in
   304	                mixed_right.iter().zip(never_right.iter()).enumerate()
   305	            {
   306	                assert_eq!(
   307	                    mixed_word.to_bits(),
   308	                    never_word.to_bits(),
   309	                    "block {step} word {word}: the right plane after the disengage"
   310	                );
   311	            }
   312	        }
   313	    }
   314	}
