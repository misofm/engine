+                        None,
+                        128,
+                        BankWidth::Eight,
+                        (block * 128) as u64,
+                        &spans,
+                        &offsets,
+                        128,
+                    )
+                    .expect("mono bank block"),
+                );
+            if block % 33 == 32 {
+                mono_bank.reset(ResetKind::DiscontinuityKeepParameters);
+            }
+        }
+        mono_bank.reset(ResetKind::FullToDefaults);
+    });
+    assert_eq!(
+        (allocations, deallocations),
+        (0, 0),
+        "mono bank render path allocated"
+    );
 }

