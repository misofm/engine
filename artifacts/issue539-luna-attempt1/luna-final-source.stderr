   680	/// `true` when no lane of `ramps` has a window open and every lane holds exactly its target.
   681	///
   682	/// Issue #144 item 6. Both halves are needed and both are exact: `remaining == 0` is the D11
   683	/// statement that no ramp is in flight, and the bit compare is the statement that the value in
   684	/// force *is* the target, so that reading `current` for the whole block reproduces what
   685	/// [`RampLanes::advance`] would have produced sample by sample. Tolerances are not used anywhere
   686	/// in this decision -- an epsilon here would make the optimisation a re-tuning.
   687	fn ramps_are_stationary(ramps: &[LinearRamp]) -> bool {
   688	    ramps
   689	        .iter()
   690	        .all(|ramp| ramp.remaining == 0 && ramp.current.to_bits() == ramp.target.to_bits())
   691	}
