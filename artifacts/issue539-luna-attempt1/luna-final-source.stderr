+        .process_bank_mono(
+            EffectBankProcessBlock::new(
+                &mut mono_left,
+                &mut mono_right,
+                None,
+                128,
+                BankWidth::Eight,
+                0,
+                &spans,
+                &offsets,
+                128,
+            )
+            .expect("mono bank block"),
+        );
+
+    let (allocations, deallocations) = measure(|| {
+        for block in 0..100 {
+            for (index, sample) in mono_left.iter_mut().enumerate() {
