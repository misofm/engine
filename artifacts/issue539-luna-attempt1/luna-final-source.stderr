  3112	impl<L: Lane> PreparedTruePeakLimiterBank<L> {
  3113	    /// The one bank body, dual or collapsed. `MONO` chooses the render body and nothing else.
  3114	    ///
  3115	    /// A const generic rather than an argument, so the two monomorphise and the dual instantiation
  3116	    /// is the code that shipped before the collapse existed. See the parametric EQ's copy of this
  3117	    /// method for the measurement that settled it.
  3118	    fn process_bank_inner<const MONO: bool>(
  3119	        &mut self,
  3120	        block: EffectBankProcessBlock<'_>,
  3121	    ) -> BankProcessReport {
  3122	        debug_assert_eq!(block.width, self.metadata.width);
  3123	        debug_assert_eq!(block.width.lanes() as usize, L::WIDTH);
  3124	        debug_assert!(block.frames <= self.core.metadata.quantum);
  3125	        debug_assert!(block.sidechain.is_none());
  3126	        // #182 S2: an admitted span retargets a linear coefficient, and one whose smoothing
  3127	        // window resolves to zero updates snaps it outright while leaving `remaining` at zero — so
  3128	        // the `ramps_are_stationary` leg alone would not notice it. Withdraw the claim whenever
  3129	        // this block carries automation at all, valid or not; the next settled silent block earns
  3130	        // it back. This is the compressor's rule and it is the same hole at both effects.
  3131	        if !block.automation.is_empty() {
  3132	            self.core.silent_fixed_point = false;
  3133	        }
  3134	        let mut report = BankProcessReport::empty(self.metadata.width);
  3135	        for track in 0..L::WIDTH {
  3136	            let start = block.automation_offsets[track] as usize;
  3137	            let end = block.automation_offsets[track + 1] as usize;
  3138	            apply_automation(
  3139	                &block.automation[start..end],
  3140	                &self.core.metadata,
  3141	                block.first_sample,
  3142	                &mut self.core.left,
  3143	                &mut self.core.right,
  3144	                track,
  3145	                &mut report.reports[track],
  3146	            );
  3147	        }
  3148	        if MONO {
  3149	            self.core
  3150	                .process_block_mono(block.left, block.frames as usize);
  3151	        } else {
  3152	            self.core
  3153	                .process_block(block.left, block.right, block.frames as usize);
  3154	        }
  3155	        report
  3156	    }
  3157	}
  3158	
  3159	// ---------------------------------------------------------------------------------------------
  3160	// The mono-collapse one-plane bodies.
  3161	//
  3162	// Each is the dual body with the right channel's arguments deleted and every remaining line left
  3163	// where it was. Three things are restatements rather than deletions:
  3164	//
  3165	// * the peak **link** is computed on the one plane read twice, in the original operation order:
  3166	//   `peak_left.max(peak_left)`. This crate's link is `Maximum` only, and `max(p, p)` is `p` to the
  3167	//   bit for every finite `p` -- so this one is provably a no-op, and it is written out rather than
  3168	//   folded away so that the collapsed body and the dual body read the same;
  3169	// * `stationary` is the four-ramp conjunction with the right channel's two conjuncts dropped. On a
  3170	//   collapse-eligible bank the two channels' `limit` and `release` ramps are the same words (a
  3171	//   one-channel retarget clears the witness' `LIVE` term), so the left pair's answer *is* the
  3172	//   conjunction's;
  3173	// * `lanes_uniform` is the whole-bank branch, and it takes the same reading for the same reason:
  3174	//   `LaneShape` is derived from `lookahead_ms`, which the `DESIGNED` comparison covers.
  3175	//
  3176	// The right channel's state is untouched, and is restored by `ChannelState::copy_state_from` at
  3177	// the disengage boundary before any dual block runs.
  3178	// ---------------------------------------------------------------------------------------------
  3179	
  3180	/// [`limiter_block`] over one plane.
  3181	#[inline(always)]
  3182	fn limiter_block_mono<L: Lane>(
  3183	    left_io: &mut [f32],
  3184	    frames: usize,
  3185	    coef: &LimiterCoef<L>,
  3186	    shape: &Shape,
  3187	    left: &mut ChannelState,
  3188	    cursors: &mut Cursors,
  3189	) {
  3190	    let stationary = mono_stationary(left);
  3191	    if lanes_uniform(left) {
  3192	        if stationary {
  3193	            limiter_block_uniform_mono::<DISPATCH_STATIONARY, L>(
  3194	                left_io, frames, coef, shape, left, cursors, true,
  3195	            );
  3196	        } else {
  3197	            limiter_block_uniform_mono::<DISPATCH_RAMPING, L>(
  3198	                left_io, frames, coef, shape, left, cursors, false,
  3199	            );
  3200	        }
  3201	    } else {
  3202	        if stationary {
  3203	            limiter_block_per_lane_mono::<DISPATCH_STATIONARY, L>(
  3204	                left_io, frames, coef, shape, left, cursors, true,
  3205	            );
  3206	        } else {
  3207	            limiter_block_per_lane_mono::<DISPATCH_RAMPING, L>(
  3208	                left_io, frames, coef, shape, left, cursors, false,
  3209	            );
  3210	        }
  3211	    }
  3212	}
