   751	    }
   752	
   753	    /// This sample's value when the ramp is known to be stationary, advancing nothing.
   754	    ///
   755	    /// Issue #144 item 6. Unlike the compressor and the gate, this effect had no ramping split at
   756	    /// all: [`RampLanes::advance`] ran four times per frame, every frame, whether or not anything
   757	    /// was moving -- and outside a sixty-four-sample window after a ceiling or release change,
   758	    /// nothing ever is. At rest `advance` computes `remaining = max(0 - 1, 0) = 0`, `stepping =
   759	    /// false`, `current = select(false, .., target) = target` and `step = select(false, step, 0)
   760	    /// = 0`; with the rest invariant `current == target` bitwise and `step == 0` already true,
   761	    /// every one of those is the identity. Returning `current` is therefore the same value and
   762	    /// the same state, which is what makes the skip class A rather than a re-tuning.
   763	    #[inline(always)]
   764	    const fn resting_value(&self) -> L {
   765	        self.current
   766	    }
   767	}
