  2296	/// Reads the ordered six-value initial table into per-channel defaults.
  2297	fn initial_defaults(
  2298	    values: &[InitialParameterValue],
  2299	) -> Result<([f32; PARAMETER_COUNT], [f32; PARAMETER_COUNT]), EffectPrepareError> {
  2300	    if values.len() != PARAMETER_COUNT * 2 {
  2301	        return Err(EffectPrepareError {
  2302	            code: "effect.parameter.initial",
  2303	        });
  2304	    }
  2305	    let mut left = [0.0; PARAMETER_COUNT];
  2306	    let mut right = [0.0; PARAMETER_COUNT];
  2307	    for (index, spec) in PARAMETER_SPECS.iter().enumerate() {
  2308	        let left_value = values[index * 2];
  2309	        let right_value = values[index * 2 + 1];
  2310	        if left_value.parameter_index != index as u32
  2311	            || right_value.parameter_index != index as u32
  2312	            || left_value.channel != ParameterChannel::Left
  2313	            || right_value.channel != ParameterChannel::Right
  2314	            || !parameter_value_valid(spec, left_value.value)
  2315	            || !parameter_value_valid(spec, right_value.value)
  2316	            || is_negative_zero(left_value.value)
  2317	            || is_negative_zero(right_value.value)
  2318	        {
  2319	            return Err(EffectPrepareError {
  2320	                code: "effect.parameter.initial",
  2321	            });
  2322	        }
  2323	        left[index] = normalize_zero(left_value.value);
  2324	        right[index] = normalize_zero(right_value.value);
  2325	    }
  2326	    Ok((left, right))
  2327	}
