  4603	    // This crate is also the one where the fixed point is *exactly* reachable, which the compressor
  4604	    // records as the precondition for engaging at all and does not have: `gain_reduction_db`
  4605	    // approaches `0` dB geometrically, whereas the box terms here live on the `2^-14` grid with
  4606	    // `BOX_GRID * R` below `2^24` at every launch rate, so the running sum arrives at exactly `Wb`,
  4607	    // and the D7 flush terminates the release at exactly `+0.0` rather than near it.
  4608	    // ---------------------------------------------------------------------------------------
  4609	
  4610	    /// One block of signal, or a block filled with `quiet` — an exact `+0.0` or an exact `-0.0`.
  4611	    ///
  4612	    /// The signal is [`Noise`], the crate's SplitMix64, seeded from the block index so that two
  4613	    /// arms of the same comparison see the same samples and a corpus stays a seed rather than a
  4614	    /// file. It is deliberately *not* a sine: `f32::sin` is a platform transcendental, which
  4615	    /// decision D6 and `clippy.toml`'s `disallowed-methods` (formerly `scripts/check-math-policy.sh`)
  4616	    /// forbid anywhere in `src/` — including in a test module, since the lint scans the file and
  4617	    /// not the `cfg`.
  4618	    fn silence_plane(
  4619	        block: usize,
  4620	        frames: usize,
  4621	        width: usize,
  4622	        quiet: Option<f32>,
  4623	        amplitude: f32,
  4624	        negate: bool,
  4625	    ) -> Vec<f32> {
  4626	        if let Some(fill) = quiet {
  4627	            return vec![fill; frames * width];
  4628	        }
  4629	        let mut noise = Noise(0x5182_0000 ^ (block as u64).wrapping_mul(0x9E37_79B9));
  4630	        (0..frames * width)
  4631	            .map(|_| {
  4632	                let value = noise.next() * amplitude;
  4633	                if negate { -value } else { value }
  4634	            })
  4635	            .collect()
  4636	    }
  4637	
  4638	    /// A core of `L::WIDTH` identically prepared lanes, driven directly through `process_block`.
  4639	    ///
  4640	    /// The same construction `a_nonfinite_block_is_zeroed_reset_and_counted` uses, and for the same
  4641	    /// reason: `process_block` *is* the shipped path — `process` and `process_bank` both end in it
  4642	    /// — and reaching it directly is what lets the control arm suppress the fast path without
  4643	    /// having to change the signal or the parameters to do it.
  4644	    fn silent_core<L: Lane>(ceiling: f32, release: f32, lookahead: f32) -> LimiterCore<L> {
  4645	        let values = values_with(ceiling, release, lookahead);
  4646	        let mut preparation = request(&values);
  4647	        preparation.link_mode = LinkMode::DualMono;
  4648	        let metadata = expected_prepared_metadata(&TRUE_PEAK_LIMITER_DESCRIPTOR, preparation)
  4649	            .expect("metadata");
  4650	        let (left, right) = initial_defaults(&values).expect("defaults");
  4651	        LimiterCore::<L>::new(
  4652	            metadata,
  4653	            vec![left; L::WIDTH].into_boxed_slice(),
  4654	            vec![right; L::WIDTH].into_boxed_slice(),
  4655	        )
  4656	        .expect("core")
  4657	    }
  4658	
  4659	    /// Every word of one core's state, as bits: both cursors, then both channels' whole arenas.
  4660	    ///
  4661	    /// Comparing *this* between the two arms, and not only the rendered samples, is what makes the
  4662	    /// fast path's cursor and phase advances load-bearing. The compressor's version of this test
  4663	    /// records honestly that deleting its cursor advance passes every test in its file, because a
  4664	    /// ring of exact `+0.0` reads the same from every position; reading the state back directly
  4665	    /// closes that gap rather than restating it. `phase` is in the list for the same reason.
  4666	    fn state_bits<L: Lane>(core: &LimiterCore<L>) -> Vec<u32> {
  4667	        let mut words = vec![core.cursors.main, core.cursors.ring];
  4668	        for channel in [&core.left, &core.right] {
  4669	            for plane in [
  4670	                &channel.history,
  4671	                &channel.main_ring,
  4672	                &channel.required_ring,
  4673	                &channel.box_ring,
  4674	                &channel.reduction,
  4675	                &channel.prefix,
  4676	                &channel.box_sum,
  4677	            ] {
  4678	                words.extend(plane.iter().map(|value| value.to_bits()));
  4679	            }
  4680	            words.extend(channel.phase.iter().copied());
  4681	            // The two coefficient ramps, which the fast path must not freeze. A skipped block
  4682	            // advances no ramp, so a claim admitted while a de-zipper window was still open would
  4683	            // strand `current` short of its target for as long as the silence lasted.
  4684	            for ramps in [&channel.limit, &channel.release] {
  4685	                for ramp in ramps.iter() {
  4686	                    words.push(ramp.current.to_bits());
  4687	                    words.push(ramp.target.to_bits());
  4688	                    words.push(ramp.step.to_bits());
  4689	                    words.push(ramp.remaining);
  4690	                }
  4691	            }
  4692	        }
  4693	        words
  4694	    }
  4695	
  4696	    /// Builds the two route shapes this witness needs without changing the production factory.
  4697	    fn dispatch_witness_core<L: Lane>(uniform: bool) -> LimiterCore<L> {
  4698	        let mut values = vec![values_with(-6.0, 100.0, 5.0); L::WIDTH];
  4699	        if !uniform {
  4700	            for (lane, values) in values.iter_mut().enumerate().skip(1) {
  4701	                *values = values_with(-6.0, 100.0, if lane.is_multiple_of(2) { 1.0 } else { 5.0 });
  4702	            }
  4703	        }
  4704	        let mut preparation = request(&values[0]);
  4705	        preparation.link_mode = LinkMode::DualMono;

diff --git a//tmp/issue539-luna2-capture.py b//tmp/issue539-luna2-capture.py
new file mode 100644
index 0000000000000000000000000000000000000000..71126b1309bd5d551e8fb9cead794402fae34653
--- /dev/null
+++ b//tmp/issue539-luna2-capture.py
@@ -0,0 +1,68 @@
+from pathlib import Path
+import hashlib
+import json
+import os
+import subprocess
+import sys
+
+label = sys.argv[1]
+argv = sys.argv[2:]
+assert label and all(character.isalnum() or character == "-" for character in label)
+assert argv
+root = Path("/home/bl/misofm/engine-limiter-stationary-dispatch")
+prefix = Path("/tmp/issue539-luna2") / label
+prefix.parent.mkdir(parents=True, exist_ok=True)
+paths = [
+    "crates/true-peak-limiter/src/lib.rs",
+    "crates/true-peak-limiter/Cargo.toml",
+    "Cargo.toml",
+    "Cargo.lock",
+    ".cargo/config.toml",
+    "rust-toolchain.toml",
+]
+environment = os.environ.copy()
+environment["PATH"] = "/home/bl/.cargo/bin:" + environment.get("PATH", "")
+environment["CARGO_TARGET_DIR"] = "/tmp/issue539-luna2-target"
+
+
+def run_output(command):
+    completed = subprocess.run(
+        command,
+        cwd=root,
+        env=environment,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    return {"status": completed.returncode, "output": completed.stdout + completed.stderr}
+
+
+metadata = {
+    "argv": argv,
+    "cwd": str(root),
+    "head": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip(),
+    "branch": subprocess.check_output(["git", "branch", "--show-current"], cwd=root, text=True).strip(),
+    "status": subprocess.check_output(["git", "status", "--porcelain=v1"], cwd=root, text=True),
+    "env": {key: environment.get(key) for key in ["PATH", "RUSTFLAGS", "CARGO_TARGET_DIR"]},
+    "toolchain": {
+        "rustc": run_output(["rustc", "--version", "--verbose"]),
+        "cargo": run_output(["cargo", "--version"]),
+        "rustup_toolchain": run_output(["rustup", "show", "active-toolchain"]),
+    },
+    "source": {
+        path: {
+            "sha256": hashlib.sha256((root / path).read_bytes()).hexdigest(),
+            "git_blob": subprocess.check_output(["git", "hash-object", path], cwd=root, text=True).strip(),
+        }
+        for path in paths
+    },
+}
+with prefix.with_suffix(".command.json").open("x") as command_file:
+    json.dump(metadata, command_file, indent=2)
+    command_file.write("\n")
+with prefix.with_suffix(".stdout").open("xb") as stdout_file, prefix.with_suffix(".stderr").open("xb") as stderr_file:
+    result = subprocess.run(argv, cwd=root, env=environment, stdout=stdout_file, stderr=stderr_file, check=False)
+with prefix.with_suffix(".status").open("x") as status_file:
+    status_file.write(f"{result.returncode}\n")
+print(label, result.returncode, flush=True)
+sys.exit(result.returncode)
