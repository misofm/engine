  2376	/// The `[minimum, maximum]` a stored coefficient may occupy, with a four-ulp relaxation.
  2377	///
  2378	/// A ramped `current` lies mathematically between two in-domain coefficients, but the iterated
  2379	/// `current + step` of D11 can round a hair past an endpoint on its last step before the snap. The
  2380	/// relaxation is exactly that rounding budget; it is not a domain widening, and a value outside a
  2381	/// coefficient's real range by more than a few ulps is still rejected.
  2382	fn coefficient_bounds(low: f32, high: f32) -> (f32, f32) {
  2383	    let slack = 4.0 * f32::EPSILON;
  2384	    (low - low.abs() * slack, high + high.abs() * slack)
  2385	}
