+                left_io, right_io, frames, coef, shape, left, right, cursors, true,
+            );
+        } else {
+            limiter_block_uniform::<{ StationaryDispatch::Ramping }, L>(
+                left_io, right_io, frames, coef, shape, left, right, cursors, false,
+            );
+        }
+    } else {
+        if stationary {
+            limiter_block_per_lane::<{ StationaryDispatch::Stationary }, L>(
+                left_io, right_io, frames, coef, shape, left, right, cursors, true,
+            );
+        } else {
+            limiter_block_per_lane::<{ StationaryDispatch::Ramping }, L>(
+                left_io, right_io, frames, coef, shape, left, right, cursors, false,
+            );
+        }
+    }
