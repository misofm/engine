   642	            && block_is_positive_zero(&self.main_ring)
   643	            && block_is_positive_zero(&self.reduction)
   644	            && all_exactly_one(&self.required_ring)
   645	            && all_exactly_one(&self.box_ring)
   646	            && all_exactly_one(&self.prefix)
   647	            && self
   648	                .box_sum
   649	                .iter()
