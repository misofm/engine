   699	impl<L: Lane> RampLanes<L> {
   700	    /// Gathers `width` scalar ramps into one lane-wide ramp.
   701	    #[inline]
   702	    fn gather(ramps: &[LinearRamp]) -> Self {
   703	        let mut current = [0.0_f32; MAXIMUM_WIDTH];
   704	        let mut target = [0.0_f32; MAXIMUM_WIDTH];
   705	        let mut step = [0.0_f32; MAXIMUM_WIDTH];
   706	        let mut remaining = [0.0_f32; MAXIMUM_WIDTH];
   707	        for (lane, ramp) in ramps.iter().enumerate() {
   708	            current[lane] = ramp.current;
   709	            target[lane] = ramp.target;
   710	            step[lane] = ramp.step;
   711	            remaining[lane] = f32::from(ramp.remaining as u16);
   712	        }
   713	        Self {
   714	            current: L::load(&current),
   715	            target: L::load(&target),
   716	            step: L::load(&step),
   717	            remaining: L::load(&remaining),
   718	        }
   719	    }
   720	
   721	    /// Writes the lane-wide ramp back into `width` scalar ramps.
   722	    #[inline]
   723	    fn scatter(self, ramps: &mut [LinearRamp]) {
   724	        let mut current = [0.0_f32; MAXIMUM_WIDTH];
   725	        let mut remaining = [0.0_f32; MAXIMUM_WIDTH];
   726	        let mut step = [0.0_f32; MAXIMUM_WIDTH];
   727	        self.current.store(&mut current);
   728	        self.remaining.store(&mut remaining);
   729	        self.step.store(&mut step);
   730	        for (lane, ramp) in ramps.iter_mut().enumerate() {
   731	            ramp.current = current[lane];
   732	            ramp.step = step[lane];
   733	            ramp.remaining = remaining[lane] as u32;
   734	        }
   735	    }
   736	
   737	    /// Produces this sample's value and advances the ramp (decision D11).
   738	    ///
   739	    /// `remaining = max(remaining - 1, 0)` then `current = select(remaining > 0, current + step,
   740	    /// target)`: the last ramping sample is an assignment of the target, never an addition, which
   741	    /// is exactly `LinearRamp::next_value` and is why a block boundary is not observable. `step` is
   742	    /// cleared on the snap so a resting ramp cannot drift.
   743	    #[inline(always)]
   744	    fn advance(&mut self) -> L {
   745	        let zero = L::zero();
   746	        self.remaining = self.remaining.sub(L::splat(1.0)).max(zero);
   747	        let stepping = self.remaining.gt(zero);
   748	        self.current = L::select(stepping, self.current.add(self.step), self.target);
   749	        self.step = L::select(stepping, self.step, zero);
