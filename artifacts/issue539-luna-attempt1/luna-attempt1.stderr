   654	    /// Advances each lane's van Herk phase by a whole block, as the frame loop would (#182 S2).
   655	    ///
   656	    /// Per lane, because `window` is a per-lane preparation parameter — this is the control-plane
   657	    /// mirror of the same fact [`lanes_uniform`] gates on. The phase cycles `0 .. Wb - 1` one step
   658	    /// per frame, so `frames` steps land on `(phase + frames) mod Wb`.
   659	    fn advance_rest_phase(&mut self, frames: usize) {
   660	        for (phase, shape) in self.phase.iter_mut().zip(self.lane.iter()) {
   661	            let window = shape.window as usize;
   662	            *phase = ((*phase as usize + frames % window) % window) as u32;
   663	        }
   664	    }
   665	}
