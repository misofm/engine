  4625	        assert_eq!(
  4626	            (scalar.engagements, four.engagements),
  4627	            (eight.engagements, eight.engagements),
  4628	            "engagement rate depends on the lane width"
  4629	        );
  4630	        assert_eq!(
  4631	            eight.engagements, 35,
  4632	            "the fast path engaged on {} of {SILENT_BLOCKS} silent blocks, not the 35 the 486-sample \
  4633	             delay line allows",
  4634	            eight.engagements
  4635	        );
  4636	
  4637	        // Anti-vacuity: the trailing tone is really rendered, so the comparison above had
  4638	        // something other than silence to compare. Without it the test would pass on a fast path
  4639	        // that simply stopped rendering.
  4640	        let per_block = 128 * 8 * 2;
  4641	        assert!(
  4642	            eight.rendered[eight.rendered.len() - per_block..]
  4643	                .iter()
  4644	                .any(|word| *word != 0),
  4645	            "the block after the silence rendered nothing at all"
  4646	        );
  4647	    }
