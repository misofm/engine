+            left_io, right_io, frames, coef, shape, left, right, cursors, stationary,
+        );
+    } else {
+        limiter_block_per_lane::<DISPATCH_RUNTIME, L>(
+            left_io, right_io, frames, coef, shape, left, right, cursors, stationary,
+        );
+    }
