   633	    /// ends the silence are estimated against samples from before it, so the fast path has to wait
   634	    /// for the history to drain like everything else.
   635	    ///
   636	    /// Bits, not values, at every word. `-0.0 == 0.0` and `1.0 - 2^-24 != 1.0`, but the fast path
   637	    /// promises not to move a bit, so the test that licenses it has to be a bit test.
   638	    ///
   639	    /// [`clear_runtime`]: ChannelState::clear_runtime
   640	    fn is_at_silent_rest(&self) -> bool {
