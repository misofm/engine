  1211	    /// Loads every lane-wide word of `state` into registers for the block loop.
  1212	    #[inline]
  1213	    fn load(state: &ChannelState) -> Self {
  1214	        let history = History::<L>::load(state);
  1215	        let mut window = [0.0_f32; MAXIMUM_WIDTH];
  1216	        for (lane, shape) in state.lane.iter().enumerate() {
  1217	            window[lane] = shape.window as f32;
  1218	        }
  1219	        Self {
  1220	            history,
  1221	            reduction: L::load(&state.reduction),
  1222	            box_sum: L::load(&state.box_sum),
  1223	            window: L::load(&window),
  1224	            limit: RampLanes::gather(&state.limit),
  1225	            release: RampLanes::gather(&state.release),
  1226	        }
  1227	    }
  1228	
  1229	    /// Writes every lane-wide word back into `state` at the end of the block.
  1230	    #[inline]
  1231	    fn store(self, state: &mut ChannelState) {
  1232	        self.history.store(state);
  1233	        self.reduction.store(&mut state.reduction);
  1234	        self.box_sum.store(&mut state.box_sum);
  1235	        self.limit.scatter(&mut state.limit);
  1235	        self.limit.scatter(&mut state.limit);
  1236	        self.release.scatter(&mut state.release);
  1237	    }
