   514	    /// Copies every word `source` carries onto this channel: the collapse's disengage boundary.
   515	    ///
   516	    /// # The copy list, term by term
   517	    ///
   518	    /// This kernel's per-channel state is **all** of it, and the reason the list is exhaustive
   519	    /// rather than selective is that a collapsed block touches nearly every word: the detector
   520	    /// writes `history`, `channel_frame` writes `main_ring`, `required_ring`, `box_ring` and
   521	    /// `reduction`, and the uniform body additionally writes `prefix`, `box_sum` and `phase`. The
   522	    /// two ramps are advanced per frame off the hot copy and stored back, and `lane`/`lookahead_ms`
   523	    /// are the window shape the segment walk reads.
   524	    ///
   525	    /// | word | why it is here |
   526	    /// |---|---|
   527	    /// | `history` | the twelve oversampling taps -- the detector's whole cross-block state. |
   528	    /// | `main_ring` | the `B`-sample delay line the output is read out of. A partial copy would emit pre-collapse samples `N + 6` frames later. |
   529	    /// | `required_ring`, `box_ring` | the van Herk sliding-minimum rings. |
   530	    /// | `reduction` | the recursive release word, the only one the D7 flush applies to. |
   531	    /// | `prefix`, `box_sum`, `phase` | the uniform body's three van Herk registers, written back once per block. |
   532	    /// | `limit`, `release` | all four fields of each ramp: only the collapsed channel's were advanced. |
   533	    /// | `lookahead_ms`, `lane` | the window shape `segment` and `LaneShape` read. Not moved by a rendered block, and copied anyway, because "whole per-channel state" is the rule that survives a later field being added. |
   534	    ///
   535	    /// `width` is a preparation shape both channels share and is asserted rather than copied.
   536	    /// # Which entries are individually gated, and which are here by the rule
   537	    ///
   538	    /// `crates/true-peak-limiter/tests/mono_collapse.rs` fails if any of `history`,
   539	    /// `main_ring`, `required_ring`, `box_ring`, `reduction`, `box_sum`, `limit` or `release` is
   540	    /// dropped.
   541	    ///
   542	    /// Four entries are **not** individually red, and the two groups are not the same kind of
   543	    /// thing:
   544	    ///
   545	    /// * `lookahead_ms` and `lane` are the prepared window shape. No rendered block writes them --
   546	    ///   they move only at prepare, restore and a full reset, none of which is reachable on a bound
   547	    ///   bank -- so nothing can make them diverge today.
   548	    /// * `prefix` and `phase` are the uniform body's two van Herk registers, and they *are* running
   549	    ///   state: `UniformHot::new` loads them out of this arena and the block write-back stores them
   550	    ///   into it. A collapsed block advances only the left channel's. Dropping either IS red --
   551	    ///   via the whole-strip transition oracle
   552	    ///   (`chain_shape::a_run_that_stops_collapsing_renders_what_a_never_collapsed_run_renders`),
   553	    ///   not this crate's local corpus -- which is why an earlier draft mislabelled them ungated.
   554	    ///   (A yet-earlier draft asserted re-derivation at the next block boundary, which is not true
   555	    ///   of either word.)
   556	    ///
   557	    /// All four are copied because the rule is *whole per-channel state*, which is the rule
   558	    /// precisely so that a word nobody has a divergence for is still carried.
   559	    fn copy_state_from(&mut self, source: &Self) {
   560	        debug_assert_eq!(self.width, source.width);
   561	        debug_assert_eq!(self.main_ring.len(), source.main_ring.len());
   562	        self.history.copy_from_slice(&source.history);
   563	        self.main_ring.copy_from_slice(&source.main_ring);
   564	        self.required_ring.copy_from_slice(&source.required_ring);
   565	        self.box_ring.copy_from_slice(&source.box_ring);
   566	        self.reduction.copy_from_slice(&source.reduction);
   567	        self.prefix.copy_from_slice(&source.prefix);
   568	        self.box_sum.copy_from_slice(&source.box_sum);
   569	        self.phase.copy_from_slice(&source.phase);
   570	        self.limit.copy_from_slice(&source.limit);
   571	        self.release.copy_from_slice(&source.release);
   572	        self.lookahead_ms.copy_from_slice(&source.lookahead_ms);
   573	        self.lane.copy_from_slice(&source.lane);
   574	    }
   575	
   576	    /// `FullToDefaults`: every runtime word cleared and every ramp snapped to the prepared value.
   577	    fn reset_to_defaults(&mut self, shape: &Shape, defaults: &[[f32; PARAMETER_COUNT]], rate: u32) {
   578	        for (lane, values) in defaults.iter().enumerate() {
   579	            self.lookahead_ms[lane] = values[2];
   580	            self.lane[lane] = LaneShape::new(lookahead_samples(values[2], rate, shape.n), shape);
   580	            self.lane[lane] = LaneShape::new(lookahead_samples(values[2], rate, shape.n), shape);
   581	            self.limit[lane] = LinearRamp::fixed(limit_coefficient(values[0]));
   582	            self.release[lane] = LinearRamp::fixed(release_coefficient(values[1], rate));
   583	        }
   584	        self.clear_runtime(shape);
   585	    }
   586	
   587	    /// `DiscontinuityKeepParameters`: the same runtime words, ramps snapped to their targets.
   588	    fn reset_keeping_parameters(&mut self, shape: &Shape) {
   589	        for (limit, release) in self.limit.iter_mut().zip(self.release.iter_mut()) {
   590	            limit.snap();
   591	            release.snap();
   592	        }
   593	        self.clear_runtime(shape);
   594	    }
   595	
   596	    /// Clears history, rings and the recursive word to the state a silent lane rests in.
   597	    ///
   598	    /// The box ring rests at `1.0` and the box sum at `Wb`, which is the only pair consistent with
   599	    /// "nothing has ever been limited": `S / Wb` is then exactly `1.0`, `d` is exactly `+0.0` and
   600	    /// the first output sample is the delayed input bit for bit.
   601	    fn clear_runtime(&mut self, shape: &Shape) {
   602	        debug_assert_eq!(self.main_ring.len(), shape.main * self.width);
   603	        self.history.fill(0.0);
   604	        self.main_ring.fill(0.0);
   605	        self.required_ring.fill(1.0);
   606	        self.box_ring.fill(1.0);
   607	        self.reduction.fill(0.0);
   608	        self.prefix.fill(1.0);
   609	        self.phase.fill(0);
   610	        for (sum, shape) in self.box_sum.iter_mut().zip(self.lane.iter()) {
   611	            *sum = shape.window as f32;
   612	        }
   613	    }
   614	
   615	    /// `true` when every runtime word of this channel is exactly what [`clear_runtime`] writes.
   616	    ///
   617	    /// Issue #182 S2, the observation half of the silent fixed point. The list is
   618	    /// [`clear_runtime`]'s own, word for word, and that is the point: the rest state is not a
   619	    /// property this function invents, it is the state the crate already documents a silent lane
   620	    /// rests in, read back rather than assumed.
   621	    ///
   622	    /// The one member of [`clear_runtime`]'s list that is deliberately **absent** is `phase`. A
   623	    /// resting channel is at whatever van Herk position its history left it at, and the position is
   624	    /// unobservable while the rest of the state holds: with `required_ring` and `prefix` entirely
   625	    /// `1.0`, [`sliding_minimum`] returns `1.0` from every position and its backward pass writes
   626	    /// `1.0` over `1.0`. Requiring `phase == 0` would refuse the claim for all but one frame in
   627	    /// `Wb`, which is a correctness-free way to never engage.
   628	    ///
   629	    /// `history` is *not* absent, and it is the one entry that is not obvious. A channel can reach
   630	    /// `required_ring == 1.0` everywhere with a non-zero detector history — that only needs the
