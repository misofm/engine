+#[test]
+fn the_own_thread_allocator_observes_an_allocate_and_free() {
+    let (allocations, deallocations) = measure(|| {
+        let mut bytes = Vec::with_capacity(64);
+        bytes.extend_from_slice(&[0xA5; 64]);
+        std::hint::black_box(&bytes);
