for n in ['simd128-limiter-production-func-755','simd128-limiter-production-func-756','scalar-limiter-production-func-716','simd128-limiter-production-func-757']:
 ls=Path('artifacts/issue539-candidate-lowering/'+n+'.wat.txt').read_text().splitlines();ops=[l.split('|')[-1].strip() if '|' in l else '' for l in ls];stack=[];ends={};targets={};loops=[]
 for i,op in enumerate(ops):
  if op in ['block','loop'] or op.startswith('if '):
   stack.append(i)
   if op=='loop':loops.append(i)
  elif op=='end' and stack:ends[stack.pop()]=i
  elif re.match(r'br(_if)? \\d+"'$'"',op):
