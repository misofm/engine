command=for path in crates/protocol/src/controller/tests.rs crates/protocol/src/message_wire/tests.rs crates/protocol/src/session_wire/tests.rs; do count=$(rg -c "^[[:space:]]*#\\[test\\]" "$path" || true); ignored=$(rg -c "^[[:space:]]*#\\[ignore" "$path" || true); [[ -n "$count" ]] || count=0; [[ -n "$ignored" ]] || ignored=0; printf "%s tests=%s ignored=%s\\n" "$path" "$count" "$ignored"; test "$ignored" -eq 0; done; if rg -n "^[[:space:]]*#\\[ignore" crates/protocol/src/controller/tests.rs crates/protocol/src/message_wire/tests.rs crates/protocol/src/session_wire/tests.rs; then exit 1; else test $? -eq 1; fi; printf "extracted_ignored_rows=0\\n"
