[toolchain]
channel = "1.97.1"
profile = "minimal"
components = ["clippy", "rustfmt"]
targets = [
    "wasm32-unknown-unknown",
]
# Master plan #83 D4 (revision 4): native x86-64 is pinned to x86-64-v3 at compile time so that
# `wide` selects its AVX2 backend and `Lane::fma` is the fused `vfmadd` instruction. There is no
# runtime SIMD dispatch; `lane::attest_host` refuses to start a host whose CPU lacks
# the pinned features, and `crates/lane/src/lib.rs` fails to compile without them.
# This is the only approved global ISA configuration (scripts/check-workspace-policy.sh enforces
# that exact shape); `-C target-cpu` and a global `[build] rustflags` remain forbidden.
[target.'cfg(target_arch = "x86_64")']
rustflags = ["-C", "target-feature=+avx2,+fma"]
129:[profile.release]
130-lto = "fat"
131-codegen-units = 1
132-panic = "abort"
133-debug = 1
134-
135-# Benchmarks measure the shipped profile, never a separately tuned one.
136-[profile.bench]
137-inherits = "release"
[package]
name = "true-peak-limiter"
version.workspace = true
license.workspace = true
edition.workspace = true
rust-version.workspace = true
publish.workspace = true

[lib]
name = "true_peak_limiter"

[dependencies]
effect-contract.workspace = true
effect-runtime.workspace = true
lane.workspace = true
math.workspace = true

[dev-dependencies]
# Issue #105 phase 2: the workspace's one audited global allocator (#104 phase B). It is what
# makes the conformance harness's `process.allocation` gate a real measurement; the harness
# refuses to run without it.
