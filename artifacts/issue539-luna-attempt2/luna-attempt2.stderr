+            if step == BLOCKS / 2 {
+                assert_eq!(
+                    snapshots(mixed.as_ref(), lanes),
+                    snapshots(never.as_ref(), lanes),
+                    "complete state after the first resumed dual block"
+                );
+            }
         }
     }
 }

