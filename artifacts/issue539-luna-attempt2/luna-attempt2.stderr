+                has_nonzero_word(&channel[HISTORY_START..RINGS_START])
+                    && has_nonzero_word(&channel[RINGS_START..])
+                    && has_non_one_word(&channel[RINGS_START..])
+            })
+        }),
+        "{label}: fixture did not populate history and gain rings"
+    );
+}
+
