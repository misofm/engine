def sha256: type == "string" and test("^[0-9a-f]{64}$");
def positive_integer: type == "number" and floor == . and . >= 0;
def metadata_names: ["architecture","background_load_note","codegen_units","cpu_model","governor_or_power_mode","kernel","llvm_version","logical_cores","lto","opt_level","os","physical_cores","profile","rust_version","target_features","target_triple"];
def exact_keys: ["architecture","background_load_note","bank_backend","bank_count","bank_width","binary_sha256","candidate_commit_sha256","codegen_units","cpu_model","descriptive_only","fixture_id","fixture_sha256","forbidden_operation_total","governor_or_power_mode","identity_lane_count","input_sha256","issue","kernel","llvm_version","logical_cores","lto","max_ns_per_frame","min_ns_per_frame","missing_metadata","observations","opt_level","os","output_sha256","p50_ns_per_frame","p95_ns_per_frame","p99_9_ns_per_frame","p99_ns_per_frame","percentile_method","physical_cores","profile","quantum_frames","render_allocations","render_deallocations","render_errors","render_feature_detection_calls","render_file_io","render_locks","render_logs","render_network_io","render_panic_unwinds","render_syscalls","round","rust_version","sample_rate_hz","scalar_fallback_count","scalar_tail_count","schema_version","target_features","target_triple","tracks","units","workload_id","workload_kind"];
def kind_shape:
  if .workload_kind == "scalar_eight_tracks" then .workload_id == "issue038.scalar_eight_tracks.48000hz.q128" and .tracks == 8 and .bank_backend == "Scalar" and .bank_width == 1 and .bank_count == 0 and .scalar_tail_count == 8 and .scalar_fallback_count == 0 and .identity_lane_count == 0
  elif .workload_kind == "host_selected_eight_track_bank" then .workload_id == "issue038.host_selected_eight_track_bank.48000hz.q128" and .tracks == 8 and (.bank_backend == "X86Avx2" or .bank_backend == "X86Avx2Fma") and .bank_width == 8 and .bank_count == 1 and .scalar_tail_count == 0 and .scalar_fallback_count == 0 and .identity_lane_count == 0
  elif .workload_kind == "mixed_twelve_track_graph" then .workload_id == "issue038.mixed_twelve_track_graph.48000hz.q128" and .tracks == 12 and (.bank_backend == "X86Avx2" or .bank_backend == "X86Avx2Fma") and .bank_width == 8 and .bank_count == 1 and .scalar_tail_count == 2 and .scalar_fallback_count == 2 and .identity_lane_count == 2
  else false end;
def honest_metadata:
  . as $r | (metadata_names | map(select(. as $key | $r[$key] == null))) as $missing |
  (.missing_metadata == $missing) and
  (metadata_names | all(. as $key | ($r[$key] == null or ($r[$key] | type == "string" and length > 0 and . != "unknown" and . != "default"))));
def rack_benchmark_record_valid_lib:
  (keys | sort) == exact_keys and .schema_version == 2 and .issue == 38 and (.round == 1 or .round == 2) and .sample_rate_hz == 48000 and .quantum_frames == 128 and .observations == 1000 and .percentile_method == "nearest_rank" and .units == "ns_per_frame" and .descriptive_only == true and kind_shape and
  ([.min_ns_per_frame,.p50_ns_per_frame,.p95_ns_per_frame,.p99_ns_per_frame,.p99_9_ns_per_frame,.max_ns_per_frame] | all(positive_integer)) and (.min_ns_per_frame <= .p50_ns_per_frame and .p50_ns_per_frame <= .p95_ns_per_frame and .p95_ns_per_frame <= .p99_ns_per_frame and .p99_ns_per_frame <= .p99_9_ns_per_frame and .p99_9_ns_per_frame <= .max_ns_per_frame) and
  (.candidate_commit_sha256 | sha256) and (.binary_sha256 | sha256) and (.fixture_sha256 | sha256) and (.input_sha256 | sha256) and (.output_sha256 | sha256) and .fixture_id == "fixtures/rack/issue038-v1/MANIFEST.tsv" and
  ([.render_errors,.render_allocations,.render_deallocations,.render_locks,.render_feature_detection_calls,.render_logs,.render_file_io,.render_network_io,.render_syscalls,.render_panic_unwinds,.forbidden_operation_total] | all(positive_integer)) and .render_errors == 0 and .forbidden_operation_total == (.render_allocations + .render_deallocations + .render_locks + .render_feature_detection_calls + .render_logs + .render_file_io + .render_network_io + .render_syscalls + .render_panic_unwinds) and honest_metadata;
